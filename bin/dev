#!/usr/bin/env sh

# 1. Clean up stale pidfile or kill orphan server process
PIDFILE="tmp/pids/server.pid"
if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE" 2>/dev/null)
  if [ -n "$PID" ]; then
    if kill -0 "$PID" 2>/dev/null; then
      echo "Liberando servidor previo en segundo plano (PID: $PID)..."
      kill -9 "$PID" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
  fi
fi

# 2. Free port 3000 if still held by an orphan process
PORT_PID=$(lsof -ti :3000 2>/dev/null)
if [ -n "$PORT_PID" ]; then
  echo "Liberando proceso huérfano en puerto 3000 (PID: $PORT_PID)..."
  kill -9 $PORT_PID 2>/dev/null || true
fi

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

exec foreman start -f Procfile.dev "$@"
