<div style="max-width: 800px; margin: 0 auto; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <div style="margin-bottom: 25px;">
    <%= link_to '← Volver al Show', gig_path(@payment.gig), style: "text-decoration: none; color: #64748b; font-weight: 700; font-size: 0.9em;" %>
    <h1 style="color: #0f172a; margin: 5px 0 0 0; font-weight: 800; font-size: 2em; letter-spacing: -0.5px;">
      ✏️ Editar Abono de Show
    </h1>
    <p style="color: #64748b; margin: 5px 0 0 0;">
      Folio: <strong><%= @payment.receipt_display_number %></strong> · Show: <strong><%= @payment.gig&.client_display_name || 'Show' %></strong>
    </p>
  </div>

  <div class="custom-card" style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 28px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
    <% if @payment.errors.any? %>
      <div style="margin-bottom: 16px; padding: 12px 16px; border-radius: 8px; background: #fff1f2; color: #981b1b; border: 1px solid #fecaca;">
        <strong>No se pudo actualizar el pago:</strong>
        <ul style="margin: 6px 0 0 16px; font-size: 0.9em;">
          <% @payment.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @payment, local: true do |f| %>
      <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div class="form-group-custom">
          <%= f.label :amount, "Monto del Abono ($ USD) *", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.text_field :amount,
            inputmode: 'decimal',
            placeholder: "0.00",
            class: "form-input-custom",
            style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1.1em; font-weight: 700;",
            required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :payment_method, "Canal / Método de Pago *", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.select :payment_method, GigPayment::PAYMENT_METHODS.map { |k, v| ["#{v[:emoji]} #{v[:label]}", k] }, {}, { class: "form-input-custom", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95em; font-weight: 600;" } %>
        </div>
      </div>

      <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div class="form-group-custom">
          <%= f.label :date_paid, "Fecha de Pago *", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.date_field :date_paid, class: "form-input-custom", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px;", required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :payer_name, "Nombre del Pagador", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.text_field :payer_name, placeholder: "Nombre del pagador...", class: "form-input-custom", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px;" %>
        </div>
      </div>

      <div class="form-group-custom d-flex align-items-center gap-2 py-2" style="margin-bottom: 16px;">
        <%= f.check_box :is_advance, style: "width: 18px; height: 18px; cursor: pointer;" %>
        <%= f.label :is_advance, "Es una seña / anticipo de reserva", style: "margin: 0; cursor: pointer; font-weight: 700; color: #475569; font-size: 0.9em;" %>
      </div>

      <div class="form-group-custom" style="margin-bottom: 16px;">
        <%= f.label :notes, "Notas / Referencia", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
        <%= f.text_area :notes, placeholder: "Detalles adicionales sobre la transacción...", class: "form-input-custom", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px;", rows: 2 %>
      </div>

      <%# Campo de Auditoría: Motivo de la Modificación %>
      <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 16px; margin-bottom: 20px;">
        <label style="display: block; font-size: 0.85em; font-weight: 800; color: #92400e; margin-bottom: 4px;">
          🛡️ Motivo de la Modificación (Registro de Auditoría)
        </label>
        <p style="font-size: 0.8em; color: #b45309; margin: 0 0 8px 0;">
          Para mantener la contabilidad transparente, describe por qué estás modificando este registro (ej. corrección de monto, cambio de fecha, etc.).
        </p>
        <%= f.text_field :audit_reason, placeholder: "Ej. Corrección de error de tipeo en monto acordado", style: "width: 100%; padding: 8px 12px; border: 1px solid #fcd34d; border-radius: 6px; font-size: 0.9em; background: white;" %>
      </div>

      <div style="margin-top: 20px; border-top: 1px solid #f1f5f9; padding-top: 18px; display: flex; gap: 12px; justify-content: flex-end;">
        <%= link_to 'Cancelar', gig_path(@payment.gig), style: "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 10px 18px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9em;" %>
        <%= f.submit "💾 Guardar Cambios y Registrar Auditoría", style: "background: #2563eb; color: white; border: none; padding: 10px 22px; border-radius: 8px; font-weight: 800; font-size: 0.95em; cursor: pointer;" %>
      </div>
    <% end %>
  </div>
</div>
