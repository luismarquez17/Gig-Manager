<%
  rate_info = (@gig.company&.exchange_rate_details rescue nil) || ExchangeRateService.today_rate_info
  effective_rate = rate_info[:effective_rate].to_f
  formatted_rate = rate_info[:formatted_effective_rate]
%>

<div style="max-width: 880px; margin: 0 auto; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  
  <%# --- HEADER --- %>
  <div style="margin-bottom: 22px;">
    <%= link_to '← Volver a los Pagos del Show', gig_gig_payments_path(@gig), style: "text-decoration: none; color: #64748b; font-weight: 700; font-size: 0.9em; display: inline-flex; align-items: center; gap: 4px;" %>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px; margin-top: 8px;">
      <div>
        <h1 style="color: #0f172a; margin: 0; font-weight: 800; font-size: 2em; letter-spacing: -0.5px;">
          💵 Registrar Abono de Show
        </h1>
        <p style="color: #64748b; margin: 4px 0 0 0; font-size: 0.95em;">
          <%= company_term(:event_singular, 'Show') %>: <strong><%= @gig.client_display_name %></strong> (<%= @gig.date&.strftime('%d/%m/%Y') || 'Fecha por coordinar' %>)
        </p>
      </div>

      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 16px; text-align: right;">
        <span style="display: block; font-size: 0.75em; color: #64748b; font-weight: 700; text-transform: uppercase;">Saldo Pendiente</span>
        <strong style="font-size: 1.25em; color: <%= @gig.remaining_amount > 0 ? '#b45309' : '#10b981' %>;">
          $<%= sprintf('%.2f', @gig.remaining_amount) %> USD
        </strong>
      </div>
    </div>
  </div>

  <%# --- BARRA DE ASISTENTE DE TASA DEL DÍA --- %>
  <div style="background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 14px; padding: 12px 18px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <span style="font-size: 1.3em;">💱</span>
      <div>
        <span style="font-size: 0.8em; font-weight: 800; text-transform: uppercase; color: #15803d; letter-spacing: 0.5px;">Tasa Oficial del Día:</span>
        <strong style="font-size: 1.05em; color: #14532d; margin-left: 4px;">
          1 USD = <span id="global-rate-number"><%= formatted_rate %></span> Bs.
        </strong>
        <span style="font-size: 0.75em; background: #dcfce7; color: #166534; font-weight: 700; padding: 2px 8px; border-radius: 99px; margin-left: 6px;">
          🟢 <%= rate_info[:source].to_s.include?('bcv') ? 'BCV' : (rate_info[:mode] == 'custom' ? 'Personalizada' : 'Actualizada') %>
        </span>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 8px;">
      <button type="button" onclick="toggleRateCalculator()" style="background: white; border: 1px solid #86efac; color: #15803d; font-weight: 700; font-size: 0.82em; padding: 6px 12px; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;">
        <span>🧮</span> <span id="calc-toggle-text">Abrir Calculadora VES</span>
      </button>
      <%= link_to payment_methods_settings_path, title: "Ajustar configuración de tasa", style: "color: #15803d; text-decoration: none; font-size: 0.82em; font-weight: 700; padding: 6px 10px;" do %>
        ⚙️
      <% end %>
    </div>
  </div>

  <%# --- WIDGET INTERACTIVO DE CALCULADORA DE CONVERSIÓN --- %>
  <div id="currency-converter-widget" style="display: none; background: #ffffff; border: 2px solid #bbf7d0; border-radius: 16px; padding: 18px 22px; margin-bottom: 22px; box-shadow: 0 4px 15px rgba(22, 163, 74, 0.08);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
      <h4 style="margin: 0; color: #14532d; font-size: 1rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
        <span>📱</span> Asistente de Conversión de Moneda (Pago Móvil / Transferencia)
      </h4>
      <span style="font-size: 0.78em; color: #64748b;">Escribe en Bolívares o en Dólares</span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 14px; align-items: center;">
      <%# Entrada Bolívares %>
      <div>
        <label style="display: block; font-size: 0.8em; font-weight: 800; color: #15803d; margin-bottom: 4px; text-transform: uppercase;">
          Monto en Bolívares (Bs.):
        </label>
        <div style="display: flex; align-items: center; background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 8px; padding: 6px 10px;">
          <span style="font-weight: 800; color: #166534; font-size: 0.9em; margin-right: 6px;">Bs.</span>
          <input type="number" step="0.01" min="0" id="calc_ves_input" placeholder="0.00" style="width: 100%; border: none; background: transparent; font-size: 1.05em; font-weight: 800; color: #14532d; outline: none;" oninput="calcVesToUsd()">
        </div>
      </div>

      <div style="font-size: 1.3em; color: #16a34a; font-weight: 800; padding-top: 18px;">
        ⇄
      </div>

      <%# Salida/Entrada Dólares %>
      <div>
        <label style="display: block; font-size: 0.8em; font-weight: 800; color: #0284c7; margin-bottom: 4px; text-transform: uppercase;">
          Equivalente en Dólares ($ USD):
        </label>
        <div style="display: flex; align-items: center; background: #f0f9ff; border: 1.5px solid #7dd3fc; border-radius: 8px; padding: 6px 10px;">
          <span style="font-weight: 800; color: #0369a1; font-size: 0.9em; margin-right: 6px;">$</span>
          <input type="number" step="0.01" min="0" id="calc_usd_input" placeholder="0.00" style="width: 100%; border: none; background: transparent; font-size: 1.05em; font-weight: 800; color: #075985; outline: none;" oninput="calcUsdToVes()">
        </div>
      </div>
    </div>

    <%# Botones de Acción Rápida de la Calculadora %>
    <div style="margin-top: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-top: 1px dashed #dcfce7; padding-top: 12px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <button type="button" onclick="applyConvertedToSingle()" style="background: #16a34a; color: white; border: none; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85em; cursor: pointer;">
          ✅ Aplicar este Monto al Pago
        </button>
        <button type="button" onclick="copyWhatsAppRateSummary(this)" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 6px 12px; border-radius: 8px; font-weight: 700; font-size: 0.82em; cursor: pointer;">
          📋 Copiar para WhatsApp
        </button>
      </div>

      <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82em; color: #475569; font-weight: 600; cursor: pointer;">
        <input type="checkbox" id="calc_auto_note_checkbox" checked style="accent-color: #16a34a;">
        Añadir detalle de conversión a las notas del recibo
      </label>
    </div>
  </div>

  <%# --- SELECTOR DE PESTAÑAS (PAGO ÚNICO VS PAGO DIVIDIDO) --- %>
  <div style="display: flex; gap: 10px; margin-bottom: 18px; border-bottom: 2px solid #e2e8f0; padding-bottom: 2px;">
    <button type="button" id="tab-btn-single" onclick="switchTab('single')" style="background: transparent; border: none; border-bottom: 3px solid #059669; padding: 10px 16px; font-weight: 800; font-size: 0.95em; color: #059669; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
      <span>💵</span> Pago Único
    </button>
    <button type="button" id="tab-btn-split" onclick="switchTab('split')" style="background: transparent; border: none; border-bottom: 3px solid transparent; padding: 10px 16px; font-weight: 700; font-size: 0.95em; color: #64748b; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
      <span>⚡</span> Pago Dividido / Mixto (Varios Métodos)
    </button>
  </div>

  <%# --- CONTENIDO PESTAÑA 1: PAGO ÚNICO --- %>
  <div id="tab-content-single" class="custom-card" style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 26px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
    <% if @payment && @payment.errors.any? %>
      <div style="margin-bottom: 16px; padding: 12px 16px; border-radius: 8px; background: #fff1f2; color: #981b1b; border: 1px solid #fecaca;">
        <strong>No se pudo guardar el pago:</strong>
        <ul style="margin: 6px 0 0 16px; font-size: 0.9em;">
          <% @payment.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [@gig, @payment], local: true do |f| %>
      <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div class="form-group-custom">
          <%= f.label :amount, "Monto del Abono ($ USD) *", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.number_field :amount,
            step: "0.01",
            min: "0.01",
            max: @gig.remaining_amount > 0 ? @gig.remaining_amount : nil,
            value: @gig.remaining_amount > 0 ? @gig.remaining_amount : nil,
            placeholder: "0.00",
            id: "single_payment_amount",
            style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1.1em; font-weight: 700; box-sizing: border-box;",
            oninput: "updateSingleRemaining(); syncSingleToCalculator();",
            required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :payment_method, "Método / Canal *", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.select :payment_method, GigPayment::PAYMENT_METHODS.map { |k, v| ["#{v[:emoji]} #{v[:label]}", k] }, {}, { id: "single_payment_method", onchange: "handlePaymentMethodChange(this.value)", class: "form-input-custom", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95em; font-weight: 600; background: white;" } %>
        </div>
      </div>

      <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div class="form-group-custom">
          <%= f.label :date_paid, "Fecha del Pago *", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.date_field :date_paid, value: Date.today, style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box;", required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :payer_name, "Nombre del Pagador / Titular", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
          <%= f.text_field :payer_name, placeholder: @gig.client_display_name, style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box;" %>
        </div>
      </div>

      <div class="form-group-custom" style="margin-bottom: 16px;">
        <%= f.label :notes, "Número de Referencia / Notas", style: "display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;" %>
        <%= f.text_field :notes, id: "single_payment_notes", placeholder: "Ej. Referencia Zelle #48291, pago en efectivo en tarima...", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box;" %>
      </div>

      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 0.9em; color: #475569; font-weight: 600;">Saldo restante del show tras este abono:</span>
        <strong id="single_remaining_preview" style="font-size: 1.1em; color: #059669;">
          $<%= sprintf('%.2f', [(@gig.remaining_amount - (@gig.remaining_amount > 0 ? @gig.remaining_amount : 0)), 0.0].max) %> USD
        </strong>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end; align-items: center;">
        <%= link_to 'Cancelar', gig_gig_payments_path(@gig), style: "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 10px 18px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9em;" %>
        <%= f.submit "✨ Registrar Abono y Generar Recibo", style: "background: #059669; color: white; border: none; padding: 11px 24px; border-radius: 8px; font-weight: 800; font-size: 0.95em; cursor: pointer; box-shadow: 0 2px 6px rgba(5, 150, 105, 0.3);" %>
      </div>
    <% end %>
  </div>

  <%# --- CONTENIDO PESTAÑA 2: PAGO DIVIDIDO / MIXTO --- %>
  <div id="tab-content-split" class="custom-card" style="display: none; background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 26px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; color: #1e40af; font-size: 0.9em;">
      💡 <strong>Pago Dividido:</strong> Utiliza esta opción cuando el cliente te abone una parte en efectivo y otra parte en Zelle, Pago Móvil o Transferencia. Cada método generará su comprobante correspondiente.
    </div>

    <%= form_with url: create_split_gig_payments_path(gig_id: @gig.id), method: :post, local: true do %>
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 0.85em; font-weight: 700; color: #334155; margin-bottom: 6px;">Fecha de los Pagos *</label>
        <input type="date" name="date_paid" value="<%= Date.today %>" style="width: 200px; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 600;" required>
      </div>

      <div style="border-top: 1px solid #f1f5f9; padding-top: 16px; margin-bottom: 16px;">
        <h4 style="margin: 0 0 12px 0; color: #0f172a; font-size: 1em; font-weight: 800;">Desglose de Métodos</h4>
        
        <div id="split-rows-container" style="display: flex; flex-direction: column; gap: 12px;">
          
          <%# Fila 1 %>
          <div class="split-row" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; display: grid; grid-template-columns: 180px 140px 1fr 40px; gap: 12px; align-items: center;">
            <div>
              <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Método 1</label>
              <select name="split_payments[][payment_method]" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 600; font-size: 0.9em; background: white;" onchange="handleSplitMethodChange(this)">
                <option value="cash" selected>💵 Efectivo</option>
                <option value="zelle">⚡ Zelle</option>
                <option value="mobile_pay">📱 Pago Móvil</option>
                <option value="bank_transfer">🏦 Transferencia</option>
              </select>
            </div>
            <div>
              <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Monto ($ USD)</label>
              <input type="number" step="0.01" min="0" name="split_payments[][amount]" class="split-amount-input" placeholder="0.00" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 700; font-size: 1em; box-sizing: border-box;" oninput="recalculateSplitTotal()">
            </div>
            <div>
              <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Referencia / Detalle</label>
              <input type="text" name="split_payments[][reference_number]" class="split-reference-input" placeholder="Ej. Ref #9842" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85em; box-sizing: border-box;">
            </div>
            <div style="text-align: center; padding-top: 18px;">
              <span style="color: #94a3b8; font-size: 0.85em;">-</span>
            </div>
          </div>

          <%# Fila 2 %>
          <div class="split-row" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; display: grid; grid-template-columns: 180px 140px 1fr 40px; gap: 12px; align-items: center;">
            <div>
              <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Método 2</label>
              <select name="split_payments[][payment_method]" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 600; font-size: 0.9em; background: white;" onchange="handleSplitMethodChange(this)">
                <option value="mobile_pay" selected>📱 Pago Móvil</option>
                <option value="zelle">⚡ Zelle</option>
                <option value="cash">💵 Efectivo</option>
                <option value="bank_transfer">🏦 Transferencia</option>
              </select>
            </div>
            <div>
              <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Monto ($ USD)</label>
              <input type="number" step="0.01" min="0" name="split_payments[][amount]" class="split-amount-input" placeholder="0.00" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 700; font-size: 1em; box-sizing: border-box;" oninput="recalculateSplitTotal()">
            </div>
            <div>
              <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Referencia / Detalle</label>
              <input type="text" name="split_payments[][reference_number]" class="split-reference-input" placeholder="Ej. Ref Pago Móvil" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85em; box-sizing: border-box;">
            </div>
            <div style="text-align: center; padding-top: 18px;">
              <button type="button" onclick="this.closest('.split-row').remove(); recalculateSplitTotal();" style="background: transparent; border: none; color: #ef4444; font-weight: 800; cursor: pointer; font-size: 1.1em;">✕</button>
            </div>
          </div>

        </div>

        <div style="margin-top: 14px;">
          <button type="button" onclick="addSplitRow()" style="background: #f1f5f9; color: #334155; border: 1px dashed #cbd5e1; padding: 8px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85em; cursor: pointer;">
            ➕ Añadir Otro Método de Pago
          </button>
        </div>
      </div>

      <%# Resumen Split %>
      <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 14px 18px; margin-bottom: 22px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <span style="font-size: 0.8em; color: #64748b; font-weight: 700; text-transform: uppercase;">Total a Abonar Sumado:</span>
          <div id="split-total-sum" style="font-size: 1.4em; font-weight: 900; color: #059669;">$0.00 USD</div>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 0.8em; color: #64748b; font-weight: 700; text-transform: uppercase;">Nuevo Saldo del Show:</span>
          <div id="split-remaining-after" style="font-size: 1.15em; font-weight: 800; color: #0f172a;">$<%= sprintf('%.2f', @gig.remaining_amount) %> USD</div>
        </div>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end; align-items: center;">
        <%= link_to 'Cancelar', gig_gig_payments_path(@gig), style: "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 10px 18px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9em;" %>
        <button type="submit" style="background: #059669; color: white; border: none; padding: 11px 24px; border-radius: 8px; font-weight: 800; font-size: 0.95em; cursor: pointer; box-shadow: 0 2px 6px rgba(5, 150, 105, 0.3);">
          ✨ Registrar Abono Dividido y Generar Recibos
        </button>
      </div>
    <% end %>
  </div>

</div>

<script>
  const totalRemainingGig = <%= @gig.remaining_amount.to_f %>;
  const currentDailyRate = <%= effective_rate %>;
  const currentFormattedRate = "<%= formatted_rate %>";

  function switchTab(tab) {
    const singleTabBtn = document.getElementById('tab-btn-single');
    const splitTabBtn = document.getElementById('tab-btn-split');
    const singleContent = document.getElementById('tab-content-single');
    const splitContent = document.getElementById('tab-content-split');

    if (tab === 'single') {
      singleTabBtn.style.color = '#059669';
      singleTabBtn.style.borderBottom = '3px solid #059669';
      splitTabBtn.style.color = '#64748b';
      splitTabBtn.style.borderBottom = '3px solid transparent';
      singleContent.style.display = 'block';
      splitContent.style.display = 'none';
    } else {
      splitTabBtn.style.color = '#059669';
      splitTabBtn.style.borderBottom = '3px solid #059669';
      singleTabBtn.style.color = '#64748b';
      singleTabBtn.style.borderBottom = '3px solid transparent';
      singleContent.style.display = 'block';
      splitContent.style.display = 'none';
    }
  }

  function toggleRateCalculator() {
    const widget = document.getElementById('currency-converter-widget');
    const toggleText = document.getElementById('calc-toggle-text');
    if (widget.style.display === 'none' || !widget.style.display) {
      widget.style.display = 'block';
      toggleText.innerText = 'Cerrar Calculadora';
      syncSingleToCalculator();
    } else {
      widget.style.display = 'none';
      toggleText.innerText = 'Abrir Calculadora VES';
    }
  }

  function handlePaymentMethodChange(val) {
    const widget = document.getElementById('currency-converter-widget');
    const toggleText = document.getElementById('calc-toggle-text');
    if (val === 'mobile_pay' || val === 'bank_transfer') {
      widget.style.display = 'block';
      toggleText.innerText = 'Cerrar Calculadora';
      syncSingleToCalculator();
    }
  }

  function calcVesToUsd() {
    const vesInput = document.getElementById('calc_ves_input');
    const usdInput = document.getElementById('calc_usd_input');
    const vesVal = parseFloat(vesInput.value) || 0;
    if (currentDailyRate > 0) {
      const usdVal = (vesVal / currentDailyRate).toFixed(2);
      usdInput.value = usdVal > 0 ? usdVal : '';
    }
  }

  function calcUsdToVes() {
    const vesInput = document.getElementById('calc_ves_input');
    const usdInput = document.getElementById('calc_usd_input');
    const usdVal = parseFloat(usdInput.value) || 0;
    if (currentDailyRate > 0) {
      const vesVal = (usdVal * currentDailyRate).toFixed(2);
      vesInput.value = vesVal > 0 ? vesVal : '';
    }
  }

  function syncSingleToCalculator() {
    const singleInp = document.getElementById('single_payment_amount');
    const usdCalcInp = document.getElementById('calc_usd_input');
    if (singleInp && usdCalcInp) {
      usdCalcInp.value = singleInp.value;
      calcUsdToVes();
    }
  }

  function applyConvertedToSingle() {
    const usdCalcInp = document.getElementById('calc_usd_input');
    const vesCalcInp = document.getElementById('calc_ves_input');
    const singleInp = document.getElementById('single_payment_amount');
    const singleNotes = document.getElementById('single_payment_notes');
    const autoNote = document.getElementById('calc_auto_note_checkbox')?.checked;

    if (usdCalcInp && singleInp && parseFloat(usdCalcInp.value) > 0) {
      singleInp.value = parseFloat(usdCalcInp.value).toFixed(2);
      updateSingleRemaining();

      if (autoNote && vesCalcInp && singleNotes) {
        const vesFormatted = parseFloat(vesCalcInp.value).toLocaleString('es-VE', { minimumFractionDigits: 2 });
        const noteTag = `(Pago en Bs: ${vesFormatted} Bs @ Tasa ${currentFormattedRate})`;
        if (!singleNotes.value.includes(noteTag)) {
          singleNotes.value = (singleNotes.value ? singleNotes.value + ' - ' : '') + noteTag;
        }
      }
    }
  }

  function copyWhatsAppRateSummary(btn) {
    const usdInp = document.getElementById('calc_usd_input');
    const vesInp = document.getElementById('calc_ves_input');
    const usd = parseFloat(usdInp?.value) || totalRemainingGig;
    const ves = parseFloat(vesInp?.value) || (usd * currentDailyRate);
    const vesFormatted = ves.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    const text = `💵 *Abono de Evento / Show*\n` +
                 `• Monto: *$${usd.toFixed(2)} USD*\n` +
                 `• Equivalente en Bolívares: *${vesFormatted} Bs.*\n` +
                 `• Tasa oficial del día: *${currentFormattedRate} Bs/USD*\n\n` +
                 `Por favor envía tu comprobante al realizar la transferencia o Pago Móvil. ¡Muchas gracias!`;

    navigator.clipboard.writeText(text).then(() => {
      const orig = btn.innerHTML;
      btn.innerHTML = '✅ ¡Copiado!';
      setTimeout(() => { btn.innerHTML = orig; }, 2000);
    });
  }

  function updateSingleRemaining() {
    const input = document.getElementById('single_payment_amount');
    const preview = document.getElementById('single_remaining_preview');
    if (input && preview) {
      const val = parseFloat(input.value) || 0;
      const rem = Math.max(totalRemainingGig - val, 0);
      preview.innerText = '$' + rem.toFixed(2) + ' USD';
    }
  }

  function recalculateSplitTotal() {
    let sum = 0;
    document.querySelectorAll('.split-amount-input').forEach(inp => {
      sum += parseFloat(inp.value) || 0;
    });

    const sumEl = document.getElementById('split-total-sum');
    const remEl = document.getElementById('split-remaining-after');

    if (sumEl) sumEl.innerText = '$' + sum.toFixed(2) + ' USD';
    if (remEl) {
      const rem = Math.max(totalRemainingGig - sum, 0);
      remEl.innerText = '$' + rem.toFixed(2) + ' USD';
    }
  }

  function handleSplitMethodChange(select) {
    if (select.value === 'mobile_pay' || select.value === 'bank_transfer') {
      const widget = document.getElementById('currency-converter-widget');
      if (widget) widget.style.display = 'block';
    }
  }

  function addSplitRow() {
    const container = document.getElementById('split-rows-container');
    const newRow = document.createElement('div');
    newRow.className = 'split-row';
    newRow.style = 'background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; display: grid; grid-template-columns: 180px 140px 1fr 40px; gap: 12px; align-items: center;';
    newRow.innerHTML = `
      <div>
        <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Método Adicional</label>
        <select name="split_payments[][payment_method]" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 600; font-size: 0.9em; background: white;" onchange="handleSplitMethodChange(this)">
          <option value="mobile_pay" selected>📱 Pago Móvil</option>
          <option value="cash">💵 Efectivo</option>
          <option value="zelle">⚡ Zelle</option>
          <option value="bank_transfer">🏦 Transferencia</option>
        </select>
      </div>
      <div>
        <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Monto ($ USD)</label>
        <input type="number" step="0.01" min="0" name="split_payments[][amount]" class="split-amount-input" placeholder="0.00" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 700; font-size: 1em; box-sizing: border-box;" oninput="recalculateSplitTotal()">
      </div>
      <div>
        <label style="font-size: 0.78em; color: #64748b; font-weight: 700; display: block; margin-bottom: 4px;">Referencia / Detalle</label>
        <input type="text" name="split_payments[][reference_number]" class="split-reference-input" placeholder="Ej. Ref #5021" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85em; box-sizing: border-box;">
      </div>
      <div style="text-align: center; padding-top: 18px;">
        <button type="button" onclick="this.closest('.split-row').remove(); recalculateSplitTotal();" style="background: transparent; border: none; color: #ef4444; font-weight: 800; cursor: pointer; font-size: 1.1em;">✕</button>
      </div>
    `;
    container.appendChild(newRow);
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateSingleRemaining();
    recalculateSplitTotal();
    syncSingleToCalculator();
  });
</script>
