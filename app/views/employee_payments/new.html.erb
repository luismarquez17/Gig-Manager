<% if flash[:payment_success].present?
     success_data = JSON.parse(flash[:payment_success]) rescue {}
%>
  <div style="max-width: 800px; margin: 0 auto;">
    <div style="background: #f0fdf4; border: 2px solid #86efac; border-radius: 20px; padding: 36px 32px; text-align: center; box-shadow: 0 8px 30px rgba(34,197,94,0.1);">
      <div style="font-size: 3em; margin-bottom: 12px;">✅</div>
      <h2 style="margin: 0 0 8px 0; font-size: 1.5em; font-weight: 900; color: #15803d;">¡Pago registrado!</h2>
      <p style="margin: 0 0 28px 0; font-size: 1.05em; color: #166534;">
        <%= success_data["message"] %>
      </p>

      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <%= link_to '🎵 Ir a Shows', gigs_path,
            style: "background: #16a34a; color: #fff; padding: 12px 26px; border-radius: 12px; font-weight: 800; font-size: 1em; text-decoration: none;" %>

        <%= link_to '💳 Registrar otro pago',
            new_employee_payment_path(user_id: success_data["worker_id"]),
            style: "background: #fff; color: #15803d; padding: 12px 26px; border-radius: 12px; font-weight: 800; font-size: 1em; text-decoration: none; border: 2px solid #86efac;" %>

        <%= link_to '👁️ Ver pagos del trabajador',
            employee_payments_path(user_id: success_data["worker_id"]),
            style: "background: #fff; color: #64748b; padding: 12px 26px; border-radius: 12px; font-weight: 700; font-size: 0.95em; text-decoration: none; border: 2px solid #e2e8f0;" %>
      </div>
    </div>
  </div>
<% else %>
<div style="max-width: 800px; margin: 0 auto;">
  <div style="margin-bottom: 22px;">
    <%= link_to '← Volver a Pagos a Trabajadores', employee_payments_path, style: "text-decoration: none; color: #64748b; font-weight: 700; font-size: 0.9em;" %>
    <h2 style="margin: 8px 0 0 0; color: #0f172a; font-weight: 800; font-size: 1.8em;">💳 Registrar Pago a Trabajador</h2>
  </div>

  <% if @payment.errors.any? %>
    <div style="margin-bottom: 20px; padding: 14px 18px; border-radius: 12px; background: #fff1f2; color: #991b1b; border: 1px solid #fecaca;">
      <strong>No se pudo registrar el pago:</strong>
      <ul style="margin: 6px 0 0 16px;">
        <% @payment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% elsif flash[:alert].present? %>
    <div style="margin-bottom: 20px; padding: 14px 18px; border-radius: 12px; background: #fff1f2; color: #991b1b; border: 1px solid #fecaca;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="custom-card">
    <%= form_with model: @payment, local: true do |f| %>
      <div class="form-group-custom">
        <%= f.label :user_id, 'Trabajador / Músico / Staff' %>
        <%= f.collection_select :user_id, current_company.users.workers.order(:email), :id, :display_name, { include_blank: "-- Selecciona un trabajador --" }, { class: 'form-input-custom', required: true } %>
      </div>

      <div class="form-group-custom">
        <%= f.label :gig_id, 'Relacionado a show (opcional)' %>
        <%= f.collection_select :gig_id, @gigs, :id, ->(g) { "#{g.client&.name || 'Sin cliente'} - #{g.date&.strftime('%d/%m/%Y')}" }, { include_blank: "-- Ninguno / Pago General --" }, { class: 'form-input-custom' } %>
      </div>

      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 15px;">
        <div class="form-group-custom">
          <%= f.label :amount, 'Monto a pagar' %>
          <%= f.text_field :amount,
            inputmode: 'decimal',
            data: { controller: 'currency', action: 'input->currency#format blur->currency#format' },
            class: 'form-input-custom',
            placeholder: '0.00',
            required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :currency, 'Moneda' %>
          <%= f.select :currency, [['USD ($)', 'USD'], ['BS (Bs)', 'BS']], {}, { class: 'form-input-custom' } %>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
        <div class="form-group-custom">
          <%= f.label :date_paid, 'Fecha de Pago' %>
          <%= f.date_field :date_paid, class: 'form-input-custom', required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :payment_method, 'Método de Pago' %>
          <%= f.select :payment_method, [
            ['Transferencia Bancaria', 'Transferencia Bancaria'],
            ['Efectivo / Cash', 'Efectivo'],
            ['Zelle', 'Zelle'],
            ['Pago Móvil', 'Pago Móvil'],
            ['PayPal / Binance', 'Digital'],
            ['Otro', 'Otro']
          ], { prompt: '-- Selecciona método --' }, { class: 'form-input-custom' } %>
        </div>
      </div>

      <div class="form-group-custom">
        <%= f.label :notes, 'Notas / Observaciones' %>
        <%= f.text_area :notes, class: 'form-input-custom', rows: 3, placeholder: 'Ej. Anticipo show bodas, pago fin de semana...' %>
      </div>

      <div style="margin-top: 20px; display: flex; gap: 12px;">
        <%= link_to 'Cancelar', employee_payments_path, class: 'btn-main btn-gray-custom' %>
        <%= f.submit '💾 Registrar Pago', class: 'btn-main btn-primary-custom' %>
      </div>
    <% end %>
  </div>
</div>
<% end %>

