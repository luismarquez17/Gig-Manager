<div style="max-width: 800px; margin: 0 auto;">
  <div style="margin-bottom: 22px;">
    <%= link_to '← Volver a Pagos a Trabajadores', employee_payments_path(user_id: @payment.user_id), style: "text-decoration: none; color: #64748b; font-weight: 700; font-size: 0.9em;" %>
    <h2 style="margin: 8px 0 0 0; color: #0f172a; font-weight: 800; font-size: 1.8em;">✏️ Editar Pago a <%= venue_mode? ? 'Personal / Staff' : 'Trabajador' %></h2>
  </div>

  <% if @payment.errors.any? %>
    <div style="margin-bottom: 20px; padding: 14px 18px; border-radius: 12px; background: #fff1f2; color: #991b1b; border: 1px solid #fecaca;">
      <strong>No se pudo actualizar el pago:</strong>
      <ul style="margin: 6px 0 0 16px;">
        <% @payment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="custom-card">
    <%= form_with model: @payment, local: true do |f| %>
      <div class="form-group-custom">
        <%= f.label :user_id, (venue_mode? ? 'Personal / Staff / Modelo' : 'Trabajador / Músico / Staff') %>
        <%= f.collection_select :user_id, current_company.users.workers.order(:name, :email), :id, ->(w) { "#{w.display_name} (#{w.role.to_s.capitalize})" }, { include_blank: (venue_mode? ? "-- Selecciona personal --" : "-- Selecciona un trabajador --") }, { id: 'payment_user_select', class: 'form-input-custom', required: true, onchange: 'updateWorkerShows(this.value)' } %>
      </div>

      <div class="form-group-custom">
        <%= f.label :gig_id, (venue_mode? ? 'Relacionado a evento (opcional)' : 'Relacionado a show (opcional)') %>
        <% 
          options = [["-- Ninguno / Pago General --", ""]]
          if @available_gigs.present?
            options += @available_gigs.map { |g| [g[:title], g[:id], { 'data-pending' => g[:pending_amount], 'data-currency' => g[:currency] }] }
          end
        %>
        <%= f.select :gig_id, options, { selected: @payment.gig_id }, { id: 'payment_gig_select', class: 'form-input-custom', onchange: 'onGigSelected(this)' } %>
        <small id="gig_select_hint" style="color: #64748b; font-size: 0.82em; display: block; margin-top: 4px;">
          Solo se muestran los <%= venue_mode? ? 'eventos' : 'shows' %> donde este trabajador tiene saldo pendiente por cobrar.
        </small>
      </div>

      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 15px;">
        <div class="form-group-custom">
          <%= f.label :amount, 'Monto pagado ($ USD)' %>
          <%= f.text_field :amount,
            inputmode: 'decimal',
            id: 'payment_amount_input',
            data: { controller: 'currency', action: 'input->currency#format blur->currency#format' },
            class: 'form-input-custom',
            placeholder: '0.00',
            required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :currency, 'Moneda' %>
          <div style="padding: 12px 14px; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; font-weight: 800; color: #1e293b; text-align: center;">
            USD ($)
          </div>
          <%= f.hidden_field :currency, value: 'USD', id: 'payment_currency_select' %>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
        <div class="form-group-custom">
          <%= f.label :date_paid, 'Fecha de Pago' %>
          <%= f.date_field :date_paid, class: 'form-input-custom', required: true %>
        </div>

        <div class="form-group-custom">
          <%= f.label :payment_method, 'Método de Pago' %>
          <%= f.select :payment_method, [
            ['Transferencia Bancaria', 'Transferencia Bancaria'],
            ['Efectivo / Cash', 'Efectivo'],
            ['Zelle', 'Zelle'],
            ['Pago Móvil', 'Pago Móvil'],
            ['PayPal / Binance', 'Digital'],
            ['Otro', 'Otro']
          ], { prompt: '-- Selecciona método --' }, { class: 'form-input-custom' } %>
        </div>
      </div>

      <div class="form-group-custom">
        <%= f.label :notes, 'Notas / Observaciones' %>
        <%= f.text_area :notes, class: 'form-input-custom', rows: 3 %>
      </div>

      <div style="margin-top: 20px; display: flex; gap: 12px;">
        <%= link_to 'Cancelar', employee_payments_path(user_id: @payment.user_id), class: 'btn-main btn-gray-custom' %>
        <%= f.submit '💾 Guardar Cambios', class: 'btn-main btn-primary-custom' %>
      </div>
    <% end %>
  </div>
</div>

<script>
  const WORKER_SHOWS_MAP = <%= raw (@worker_unpaid_gigs_map || {}).to_json %>;

  function updateWorkerShows(workerId, selectedGigId = null) {
    const gigSelect = document.getElementById('payment_gig_select');
    const hint = document.getElementById('gig_select_hint');
    if (!gigSelect) return;

    const currentSelected = selectedGigId || gigSelect.value;
    gigSelect.innerHTML = '';

    const workerGigs = WORKER_SHOWS_MAP[workerId] || [];

    const defaultOpt = document.createElement('option');
    defaultOpt.value = '';
    defaultOpt.textContent = workerGigs.length > 0 ? '-- Ninguno / Pago General --' : '-- Ninguno / Pago General (Sin shows pendientes) --';
    gigSelect.appendChild(defaultOpt);

    workerGigs.forEach(g => {
      const opt = document.createElement('option');
      opt.value = g.id;
      opt.textContent = g.title;
      opt.setAttribute('data-pending', g.pending_amount);
      opt.setAttribute('data-currency', g.currency);
      if (currentSelected && g.id == currentSelected) {
        opt.selected = true;
      }
      gigSelect.appendChild(opt);
    });

    if (hint) {
      if (workerGigs.length === 0 && workerId) {
        hint.textContent = 'ℹ️ Este trabajador no tiene shows pendientes por cobrar. Puedes registrar un pago general o anticipo.';
        hint.style.color = '#15803d';
      } else {
        hint.textContent = 'Solo se muestran los shows donde este trabajador tiene saldo pendiente por cobrar.';
        hint.style.color = '#64748b';
      }
    }
  }

  function onGigSelected(select) {
    const selectedOpt = select.options[select.selectedIndex];
    if (!selectedOpt || !selectedOpt.value) return;

    const pending = selectedOpt.getAttribute('data-pending');
    const currency = selectedOpt.getAttribute('data-currency');
    const amountInput = document.getElementById('payment_amount_input');
    const currencySelect = document.getElementById('payment_currency_select');

    if (pending && amountInput) {
      amountInput.value = parseFloat(pending).toFixed(2);
    }
    if (currency && currencySelect) {
      currencySelect.value = currency;
    }
  }
</script>

