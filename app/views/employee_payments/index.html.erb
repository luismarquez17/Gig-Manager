<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 14px;">
  <div>
    <h1 style="color: #0f172a; margin: 0; font-size: 1.85em; font-weight: 800; letter-spacing: -0.5px;">
      💼 Pagos a Trabajadores
    </h1>
    <p style="color: #64748b; margin: 4px 0 0 0; font-size: 0.95em;">
      Control de nóminas, honorarios por show, capital externo y confirmación de pagos.
    </p>
  </div>

  <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
    <%= link_to '➕ Registrar Nuevo Pago', new_employee_payment_path, class: 'btn-main btn-primary-custom' %>
  </div>
</div>

<%# --- SECCIÓN: NOTIFICACIÓN DE PAGOS REPORTADOS POR TRABAJADORES PENDIENTES DE APROBACIÓN --- %>
<% if @pending_approvals.any? %>
  <div style="background: #fffbeb; border: 2px solid #fde68a; border-radius: 18px; padding: 22px; margin-bottom: 25px; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.1);">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 2em; line-height: 1;">🔔</span>
        <div>
          <h3 style="margin: 0; font-size: 1.2em; font-weight: 800; color: #92400e;">
            Notificación: <%= @pending_approvals.count %> pago(s) reportado(s) por trabajadores
          </h3>
          <p style="margin: 3px 0 0 0; font-size: 0.88em; color: #b45309;">
            Un trabajador asignó que ya se le pagó. Confirma si es cierto para aprobarlo o rechazarlo:
          </p>
        </div>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <% @pending_approvals.each do |p| %>
        <div style="background: white; border-radius: 14px; padding: 16px 20px; border: 1px solid #fef3c7; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
          
          <div>
            <div style="font-size: 1.05em; font-weight: 800; color: #0f172a;">
              👤 <%= p.user.display_name rescue p.user.email %> 
              <span style="font-weight: 500; color: #64748b; font-size: 0.85em;">(<%= p.user.email %>)</span>
            </div>
            
            <div style="margin-top: 4px; font-size: 0.9em; color: #334155;">
              <strong>Evento / Show:</strong> 
              <% if p.gig.present? %>
                <%= link_to gig_path(p.gig), style: "color: #2563eb; text-decoration: none; font-weight: 700;" do %>
                  <%= p.gig.client&.name || "Show" %> (<%= p.gig.date&.strftime("%d/%m/%Y") %>)
                <% end %>
              <% else %>
                <span style="color: #64748b; font-style: italic;">Pago general / Anticipo</span>
              <% end %>
              &nbsp;•&nbsp;
              <strong>Fecha:</strong> <%= p.date_paid&.strftime("%d/%m/%Y") %>
              &nbsp;•&nbsp;
              <strong>Método:</strong> <%= p.payment_method.presence || "No especificado" %>
            </div>

            <% if p.notes.present? %>
              <div style="margin-top: 4px; font-size: 0.84em; color: #64748b;">
                📝 <em>"<%= p.notes %>"</em>
              </div>
            <% end %>
          </div>

          <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
            <div style="text-align: right;">
              <span style="font-size: 1.35em; font-weight: 900; color: #059669; display: block;">
                <%= number_to_currency(p.amount, unit: p.currency) %>
              </span>
              <span style="font-size: 0.75em; font-weight: 700; color: #b45309; text-transform: uppercase;">
                Pendiente de Aprobación
              </span>
            </div>

            <div style="display: flex; gap: 8px;">
              <%= button_to approve_employee_payment_path(p), method: :post, data: { turbo_confirm: "¿Confirmas que el pago de #{number_to_currency(p.amount, unit: p.currency)} a #{p.user.display_name} es correcto y deseas aceptarlo?" }, class: "btn-main btn-success-custom", style: "padding: 8px 16px; font-size: 0.88em; font-weight: 800;" do %>
                ✅ Aceptar y Confirmar
              <% end %>

              <%= button_to reject_employee_payment_path(p), method: :post, data: { turbo_confirm: "¿Estás seguro de rechazar este reporte de pago?" }, class: "btn-main btn-danger-custom", style: "padding: 8px 14px; font-size: 0.88em; font-weight: 700;" do %>
                ❌ Rechazar
              <% end %>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# --- RESUMEN GENERAL DE PAGOS Y DEUDAS --- %>
<div class="custom-card" style="margin-bottom: 20px;">
  <h3 style="margin: 0 0 12px 0;">Resumen general</h3>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px;">
      <div style="font-size: 0.8em; color: #64748b; font-weight: 700; text-transform: uppercase;">💰 Total pagado</div>
      <div style="font-size: 1.15em; font-weight: 800; color: #065f46; margin-top: 4px;"><%= number_to_currency(@worker_metrics.sum { |m| m[:total_paid] }, unit: 'USD') %></div>
    </div>
    <div style="background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 12px; padding: 12px;">
      <div style="font-size: 0.8em; color: #0369a1; font-weight: 700; text-transform: uppercase;">📅 Pendiente (shows futuros)</div>
      <div style="font-size: 1.15em; font-weight: 800; color: #0369a1; margin-top: 4px;"><%= number_to_currency(@worker_metrics.sum { |m| m[:future_balance] }, unit: 'USD') %></div>
    </div>
    <div style="background: #fff7ed; border: 1px solid #fed7aa; border-radius: 12px; padding: 12px;">
      <div style="font-size: 0.8em; color: #c2410c; font-weight: 700; text-transform: uppercase;">⏳ Deuda (shows pasados)</div>
      <div style="font-size: 1.15em; font-weight: 800; color: #ea580c; margin-top: 4px;"><%= number_to_currency(@worker_metrics.sum { |m| m[:past_balance] }, unit: 'USD') %></div>
    </div>
    <% settled_count = @worker_metrics.count { |m| m[:past_balance] <= 0 && m[:future_balance] <= 0 } %>
    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 12px;">
      <div style="font-size: 0.8em; color: #15803d; font-weight: 700; text-transform: uppercase;">✅ Al día</div>
      <div style="font-size: 1.15em; font-weight: 800; color: #15803d; margin-top: 4px;"><%= settled_count %> / <%= @worker_metrics.size %> trabajadores</div>
    </div>
    <% total_worker_owes = @worker_metrics.sum { |m| m[:overpaid] } %>
    <% if total_worker_owes > 0 %>
      <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 12px;">
        <div style="font-size: 0.8em; color: #b91c1c; font-weight: 700; text-transform: uppercase;">⚠️ Trabajadores nos deben</div>
        <div style="font-size: 1.15em; font-weight: 800; color: #dc2626; margin-top: 4px;"><%= number_to_currency(total_worker_owes, unit: 'USD') %></div>
      </div>
    <% end %>
  </div>
</div>


<%# --- ESTADO POR TRABAJADOR --- %>
<div class="custom-card" style="margin-bottom: 20px;">
  <h3 style="margin-top: 0;">Estado por trabajador</h3>
  <div style="display: grid; gap: 10px;">
    <% @worker_metrics.each_with_index do |metric, idx| %>
      <% past_balance   = metric[:past_balance] %>
      <% future_balance = metric[:future_balance] %>
      <% worker_owes    = metric[:overpaid] %>
      <% gig_debts      = metric[:gig_debts] %>
      <% future_gigs    = metric[:future_gigs] %>
      <% is_settled     = past_balance <= 0 && future_balance <= 0 && worker_owes <= 0 %>

      <div style="border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; overflow: hidden;">

        <%# ── Fila principal del trabajador ── %>
        <div style="padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
          <div>
            <div style="font-weight: 800; color: #1e293b; font-size: 1.05em;"><%= metric[:worker].display_name rescue metric[:worker].email %></div>
            <div style="font-size: 0.82em; color: #94a3b8; margin-top: 2px;"><%= metric[:worker].email %></div>
          </div>

          <%# ── Tres apartados ── %>
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">

            <%# 1. PENDIENTE: shows futuros que se le deben %>
            <% if future_balance > 0 %>
              <div style="display: flex; align-items: center; gap: 6px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px; padding: 7px 13px;">
                <div>
                  <div style="font-size: 0.7em; font-weight: 800; color: #0369a1; text-transform: uppercase; letter-spacing: 0.4px;">📅 Pendiente</div>
                  <div style="font-size: 1em; font-weight: 900; color: #0369a1;"><%= number_to_currency(future_balance, unit: 'USD') %></div>
                  <div style="font-size: 0.7em; color: #7dd3fc;">Shows futuros</div>
                </div>
              </div>
            <% else %>
              <div style="display: flex; align-items: center; gap: 6px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 7px 13px; opacity: 0.6;">
                <div>
                  <div style="font-size: 0.7em; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.4px;">📅 Pendiente</div>
                  <div style="font-size: 1em; font-weight: 900; color: #cbd5e1;">$0.00</div>
                  <div style="font-size: 0.7em; color: #cbd5e1;">Shows futuros</div>
                </div>
              </div>
            <% end %>

            <%# Separador %>
            <div style="width: 1px; height: 38px; background: #e2e8f0; flex-shrink: 0;"></div>

            <%# 2. DEUDA: shows pasados sin pagar %>
            <% if past_balance > 0 %>
              <div style="display: flex; align-items: center; gap: 6px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; padding: 7px 13px;">
                <div>
                  <div style="font-size: 0.7em; font-weight: 800; color: #c2410c; text-transform: uppercase; letter-spacing: 0.4px;">⏳ Deuda</div>
                  <div style="font-size: 1em; font-weight: 900; color: #ea580c;"><%= number_to_currency(past_balance, unit: 'USD') %></div>
                  <div style="font-size: 0.7em; color: #fdba74;">Shows pasados</div>
                </div>
              </div>
            <% else %>
              <div style="display: flex; align-items: center; gap: 6px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 7px 13px; opacity: 0.6;">
                <div>
                  <div style="font-size: 0.7em; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.4px;">⏳ Deuda</div>
                  <div style="font-size: 1em; font-weight: 900; color: #cbd5e1;">$0.00</div>
                  <div style="font-size: 0.7em; color: #cbd5e1;">Shows pasados</div>
                </div>
              </div>
            <% end %>

            <%# 2b. NOS DEBE: trabajador fue pagado más de lo acordado en shows pasados %>
            <% if worker_owes > 0 %>
              <div style="display: flex; align-items: center; gap: 6px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 7px 13px;">
                <div>
                  <div style="font-size: 0.7em; font-weight: 800; color: #b91c1c; text-transform: uppercase; letter-spacing: 0.4px;">⚠️ Nos debe</div>
                  <div style="font-size: 1em; font-weight: 900; color: #dc2626;"><%= number_to_currency(worker_owes, unit: 'USD') %></div>
                  <div style="font-size: 0.7em; color: #fca5a5;">Pagado de más</div>
                </div>
              </div>
            <% end %>

            <%# Separador %>
            <div style="width: 1px; height: 38px; background: #e2e8f0; flex-shrink: 0;"></div>

            <%# 3. AL DÍA %>
            <% if is_settled %>
              <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 7px 13px;">
                <div style="font-size: 0.7em; font-weight: 800; color: #15803d; text-transform: uppercase; letter-spacing: 0.4px;">✅ Al día</div>
                <div style="font-size: 0.82em; font-weight: 700; color: #16a34a; margin-top: 2px;">Sin deudas</div>
              </div>
            <% else %>
              <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 7px 13px; opacity: 0.5;">
                <div style="font-size: 0.7em; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.4px;">✅ Al día</div>
                <div style="font-size: 0.82em; font-weight: 700; color: #cbd5e1; margin-top: 2px;">Pendiente</div>
              </div>
            <% end %>

            <%# Separador %>
            <div style="width: 1px; height: 38px; background: #e2e8f0; flex-shrink: 0;"></div>

            <%# ── Acciones ── %>
            <%= link_to '👁️ Historial', employee_payments_path(user_id: metric[:worker].id), class: 'btn-main btn-gray-custom py-1 px-3 fs-7' %>
            <%= link_to '💳 Pagar', new_employee_payment_path(user_id: metric[:worker].id), class: 'btn-main btn-primary-custom py-1 px-3 fs-7' %>

            <% worker_display = begin; metric[:worker].display_name; rescue; metric[:worker].email; end %>
            <button
              type="button"
              class="btn-main py-1 px-3 fs-7"
              style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-weight: 700; cursor: pointer;"
              onclick="openResetModal('<%= metric[:worker].id %>', '<%= j(worker_display) %>', '<%= metric[:past_balance].round(2) %>')"
              title="Editar la deuda de shows pasados de este trabajador"
            >
              ✏️ Editar deuda
            </button>

            <% if gig_debts.any? %>
              <button
                type="button"
                class="btn-main py-1 px-3 fs-7"
                style="background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; font-weight: 700; cursor: pointer;"
                onclick="togglePanel('debt-<%= idx %>', this)"
              >
                📋 Deuda por show (<%= gig_debts.size %>)
              </button>
            <% end %>

            <% if future_gigs.any? %>
              <button
                type="button"
                class="btn-main py-1 px-3 fs-7"
                style="background: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700; cursor: pointer;"
                onclick="togglePanel('future-<%= idx %>', this)"
              >
                📅 Pendiente por show (<%= future_gigs.size %>)
              </button>
            <% end %>
          </div>
        </div>

        <%# ── Panel: desglose deuda (shows pasados) ── %>
        <% if gig_debts.any? %>
          <div id="debt-<%= idx %>" style="display:none; border-top: 1px solid #fed7aa; background: #fff7ed; padding: 14px 18px;">
            <div style="font-size: 0.75em; font-weight: 800; color: #c2410c; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px;">
              ⏳ Deuda — shows ya ocurridos sin pagar
            </div>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <% gig_debts.each do |debt| %>
                <div style="background: #fff; border: 1px solid #fed7aa; border-radius: 10px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
                  <div style="flex: 1; min-width: 160px;">
                    <% if debt[:gig].present? %>
                      <div style="font-weight: 700; color: #1e293b; font-size: 0.92em;">🎵 <%= debt[:gig].client&.name.presence || "Show sin cliente" %></div>
                      <div style="font-size: 0.8em; color: #64748b; margin-top: 2px;">
                        <%= debt[:gig].date&.strftime("%d/%m/%Y") %> &nbsp;•&nbsp;
                        <%= link_to "Ver evento →", gig_path(debt[:gig]), style: "color: #2563eb; text-decoration: none; font-weight: 600; font-size: 0.95em;" %>
                      </div>
                    <% else %>
                      <div style="font-weight: 700; color: #1e293b; font-size: 0.92em;">📦 Ajuste / Sin show</div>
                    <% end %>
                  </div>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                    <span style="background: #eff6ff; color: #1d4ed8; padding: 4px 10px; border-radius: 999px; font-size: 0.8em; font-weight: 700;">Acordado: <%= number_to_currency(debt[:agreed_amount], unit: 'USD') %></span>
                    <span style="background: #ecfdf5; color: #065f46; padding: 4px 10px; border-radius: 999px; font-size: 0.8em; font-weight: 700;">Pagado: <%= number_to_currency(debt[:paid_amount], unit: 'USD') %></span>
                    <span style="background: #fff7ed; color: #c2410c; padding: 4px 10px; border-radius: 999px; font-size: 0.8em; font-weight: 800; border: 1px solid #fed7aa;">Debe: <%= number_to_currency(debt[:pending_amount], unit: 'USD') %></span>
                    <% if debt[:gig].present? %>
                      <%= link_to '💳 Pagar', new_employee_payment_path(user_id: metric[:worker].id, gig_id: debt[:gig].id),
                          style: "background:#ea580c; color:#fff; padding:4px 12px; border-radius:999px; font-size:0.8em; font-weight:800; text-decoration:none;" %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ── Panel: desglose pendiente (shows futuros) ── %>
        <% if future_gigs.any? %>
          <div id="future-<%= idx %>" style="display:none; border-top: 1px solid #bae6fd; background: #f0f9ff; padding: 14px 18px;">
            <div style="font-size: 0.75em; font-weight: 800; color: #0369a1; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px;">
              📅 Pendiente — shows futuros que aún no han pasado
            </div>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <% future_gigs.each do |fg| %>
                <div style="background: #fff; border: 1px solid #bae6fd; border-radius: 10px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
                  <div style="flex: 1; min-width: 160px;">
                    <div style="font-weight: 700; color: #1e293b; font-size: 0.92em;">🎵 <%= fg[:gig].client&.name.presence || "Show sin cliente" %></div>
                    <div style="font-size: 0.8em; color: #64748b; margin-top: 2px;">
                      <%= fg[:gig].date&.strftime("%d/%m/%Y") %> &nbsp;•&nbsp;
                      <%= link_to "Ver evento →", gig_path(fg[:gig]), style: "color: #2563eb; text-decoration: none; font-weight: 600; font-size: 0.95em;" %>
                    </div>
                  </div>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                    <span style="background: #eff6ff; color: #1d4ed8; padding: 4px 10px; border-radius: 999px; font-size: 0.8em; font-weight: 700;">Acordado: <%= number_to_currency(fg[:agreed_amount], unit: 'USD') %></span>
                    <span style="background: #ecfdf5; color: #065f46; padding: 4px 10px; border-radius: 999px; font-size: 0.8em; font-weight: 700;">Pagado: <%= number_to_currency(fg[:paid_amount], unit: 'USD') %></span>
                    <span style="background: #e0f2fe; color: #0369a1; padding: 4px 10px; border-radius: 999px; font-size: 0.8em; font-weight: 800; border: 1px solid #bae6fd;">Por cobrar: <%= number_to_currency(fg[:pending_amount], unit: 'USD') %></span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    <% end %>
  </div>
</div>


<script>
  function togglePanel(panelId, btn) {
    var panel = document.getElementById(panelId);
    if (!panel) return;
    var isOpen = panel.style.display !== 'none';
    panel.style.display = isOpen ? 'none' : 'block';
    btn.style.opacity = isOpen ? '1' : '0.75';
  }
</script>


<%# ===== MODAL: AJUSTE DE SALDO POR EL LÍDER ===== %>
<div id="reset-balance-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(15,23,42,0.55); backdrop-filter:blur(4px); align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:20px; padding:32px 28px; max-width:480px; width:92%; box-shadow:0 20px 60px rgba(0,0,0,0.18); position:relative; animation: slideUpModal 0.22s ease;">
    
    <%# Botón cerrar %>
    <button onclick="closeResetModal()" type="button" style="position:absolute; top:16px; right:18px; background:none; border:none; font-size:1.4em; color:#94a3b8; cursor:pointer; line-height:1;" title="Cerrar">✕</button>

    <%# Encabezado %>
    <div style="margin-bottom:20px;">
      <div style="font-size:2em; margin-bottom:8px;">✏️</div>
      <h2 style="margin:0 0 4px 0; font-size:1.25em; font-weight:900; color:#0f172a;">Editar deuda del trabajador</h2>
      <p id="reset-modal-subtitle" style="margin:0; font-size:0.9em; color:#64748b;"></p>
    </div>

    <%# Deuda actual %>
    <div style="background:#fff7ed; border:1px solid #fed7aa; border-radius:12px; padding:14px 16px; margin-bottom:18px;">
      <div style="font-size:0.78em; font-weight:700; color:#c2410c; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">Deuda actual (shows pasados)</div>
      <div id="reset-modal-current-balance" style="font-size:1.4em; font-weight:900; color:#0f172a;"></div>
      <div style="font-size:0.8em; color:#94a3b8; margin-top:2px;">Lo que la empresa le debe al trabajador por shows ya realizados</div>
    </div>

    <%# Formulario %>
    <%= form_with url: reset_balance_employee_payments_path, method: :post, local: true, id: "reset-balance-form" do |f| %>
      <%= f.hidden_field :user_id, id: "reset-user-id" %>

      <div style="margin-bottom:18px;">
        <label for="reset-new-balance" style="display:block; font-size:0.88em; font-weight:700; color:#374151; margin-bottom:6px;">
          Nueva deuda (el trabajador quedará con este monto pendiente por cobrar)
        </label>
        <div style="position:relative;">
          <span style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#64748b; font-weight:700; font-size:1em;">$</span>
          <input
            type="number"
            name="new_balance"
            id="reset-new-balance"
            step="0.01"
            min="0"
            placeholder="0.00"
            required
            style="width:100%; padding:12px 14px 12px 30px; border:2px solid #e2e8f0; border-radius:10px; font-size:1.05em; font-weight:700; color:#0f172a; outline:none; box-sizing:border-box; transition:border-color 0.15s;"
            onfocus="this.style.borderColor='#3b82f6'"
            onblur="this.style.borderColor='#e2e8f0'"
          >
        </div>
        <p style="margin:6px 0 0 0; font-size:0.8em; color:#64748b;">
          Ingresa <strong>$0</strong> para saldar la deuda completamente, o el monto real que sigue pendiente.
        </p>
      </div>

      <%# Aviso %>
      <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:12px 14px; margin-bottom:20px; font-size:0.83em; color:#1d4ed8; line-height:1.5;">
        📋 <strong>El historial anterior se conserva para auditoría.</strong><br>
        Se registrará un ajuste contable etiquetado como "Ajuste por el Líder" en el historial. El trabajador <strong>no necesita aprobar</strong> este cambio.
      </div>

      <%# Botones %>
      <div style="display:flex; gap:10px; justify-content:flex-end;">
        <button type="button" onclick="closeResetModal()" style="padding:10px 20px; border:1px solid #e2e8f0; border-radius:10px; background:#fff; color:#64748b; font-weight:700; cursor:pointer; font-size:0.92em;">
          Cancelar
        </button>
        <button type="submit" style="padding:10px 22px; border:none; border-radius:10px; background:#2563eb; color:#fff; font-weight:800; cursor:pointer; font-size:0.92em; display:flex; align-items:center; gap:6px;">
          ✅ Guardar cambio
        </button>
      </div>
    <% end %>
  </div>
</div>

<style>
  @keyframes slideUpModal {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function openResetModal(workerId, workerName, currentDebt) {
    var debt = parseFloat(currentDebt);
    document.getElementById('reset-user-id').value = workerId;
    document.getElementById('reset-modal-subtitle').textContent = 'Trabajador: ' + workerName;

    var formatted = '$' + debt.toFixed(2);
    var label = debt > 0
      ? 'Le debemos: ' + formatted
      : '✅ Sin deuda pendiente';
    document.getElementById('reset-modal-current-balance').textContent = label;
    document.getElementById('reset-modal-current-balance').style.color =
      debt > 0 ? '#ea580c' : '#15803d';

    // Precargar con 0 como punto de partida
    document.getElementById('reset-new-balance').value = '0.00';

    var modal = document.getElementById('reset-balance-modal');
    modal.style.display = 'flex';
    setTimeout(function() {
      document.getElementById('reset-new-balance').focus();
      document.getElementById('reset-new-balance').select();
    }, 80);
  }

  function closeResetModal() {
    document.getElementById('reset-balance-modal').style.display = 'none';
  }

  // Cerrar al hacer clic fuera del modal
  document.getElementById('reset-balance-modal').addEventListener('click', function(e) {
    if (e.target === this) closeResetModal();
  });

  // Cerrar con Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeResetModal();
  });
</script>

<%# --- TABLA DE HISTORIAL DE PAGOS --- %>
<div class="custom-card">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
    <h3 style="margin: 0;">Historial de pagos registrados</h3>
    
    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <% if @selected_worker.present? %>
        <span style="background: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 999px; font-size: 0.85em; font-weight: 700;">
          Mostrando: <%= @selected_worker.display_name rescue @selected_worker.email %>
        </span>
      <% end %>

      <%= link_to "Todos", employee_payments_path(user_id: params[:user_id]), class: "btn-main py-1 px-3 fs-7 #{params[:status].blank? ? 'btn-primary-custom' : 'btn-gray-custom'}" %>
      <%= link_to "⏳ Pendientes (#{@pending_approvals.count})", employee_payments_path(user_id: params[:user_id], status: 'pending_approval'), class: "btn-main py-1 px-3 fs-7 #{params[:status] == 'pending_approval' ? 'btn-primary-custom' : 'btn-gray-custom'}" %>
      <%= link_to "✅ Confirmados", employee_payments_path(user_id: params[:user_id], status: 'approved'), class: "btn-main py-1 px-3 fs-7 #{params[:status] == 'approved' ? 'btn-primary-custom' : 'btn-gray-custom'}" %>
    </div>
  </div>

  <div class="table-custom-wrapper">
    <div style="overflow-x: auto;">
      <% if @payments.any? %>
        <table class="table-custom" style="min-width: 750px;">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Trabajador</th>
              <th>Show relacionado</th>
              <th>Monto pagado</th>
              <th>Estado</th>
              <th>Origen de Fondos</th>
              <th>Método</th>
              <th>Notas</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @payments.each do |p| %>
              <tr style="<%= p.pending_approval? ? 'background: #fffdf5;' : '' %>">
                <td><%= p.date_paid&.strftime("%d/%m/%Y") || "---" %></td>
                <td style="font-weight: 700; color: #1e293b;">
                  <%= p.user.display_name rescue p.user.email %>
                  <% if p.reported_by_worker? %>
                    <span style="font-size: 0.72em; background: #f1f5f9; color: #64748b; padding: 2px 5px; border-radius: 4px; display: block; margin-top: 2px; font-weight: 600;">
                      Reportado por trabajador
                    </span>
                  <% end %>
                </td>
                <td>
                  <% if p.gig.present? %>
                    <%= link_to gig_path(p.gig), style: "color: #2563eb; text-decoration: none; font-weight: 600;" do %>
                      <%= p.gig.client&.name %> (<%= p.gig.date&.strftime("%d/%m/%Y") %>)
                    <% end %>
                  <% else %>
                    <span style="color: #94a3b8; font-style: italic;">Pago general / Sin show</span>
                  <% end %>
                </td>
                <td style="font-weight: 800; color: #059669;">
                  +<%= number_to_currency(p.amount, unit: p.currency) %>
                </td>
                <td>
                  <% if p.approved? %>
                    <span style="background: #ecfdf5; color: #15803d; border: 1px solid #bbf7d0; padding: 4px 9px; border-radius: 99px; font-size: 0.78em; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">
                      ✅ Confirmado
                    </span>
                  <% elsif p.pending_approval? %>
                    <span style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a; padding: 4px 9px; border-radius: 99px; font-size: 0.78em; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">
                      ⏳ Pendiente
                    </span>
                  <% elsif p.rejected? %>
                    <span style="background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; padding: 4px 9px; border-radius: 99px; font-size: 0.78em; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">
                      ❌ Rechazado
                    </span>
                  <% end %>
                </td>
                <td>
                  <% if p.from_external_capital? %>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 4px 9px; border-radius: 99px; font-size: 0.78em; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;" title="<%= p.funding_source_label %>">
                      💼 <%= p.external_source_name.presence || "Capital Externo" %>
                    </span>
                  <% else %>
                    <span style="background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; padding: 4px 9px; border-radius: 99px; font-size: 0.78em; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">
                      🏢 Fondo Nómina
                    </span>
                  <% end %>
                </td>
                <td><%= p.payment_method.presence || "---" %></td>
                <td><%= p.notes %></td>
                <td class="text-center">
                  <div style="display: flex; gap: 6px; justify-content: center; align-items: center; flex-wrap: wrap;">
                    <% if p.pending_approval? %>
                      <%= button_to '✅', approve_employee_payment_path(p), method: :post, data: { turbo_confirm: '¿Aprobar y confirmar este pago?' }, class: 'btn-main btn-success-custom py-1 px-2 fs-7', title: 'Aprobar pago' %>
                      <%= button_to '❌', reject_employee_payment_path(p), method: :post, data: { turbo_confirm: '¿Rechazar este reporte de pago?' }, class: 'btn-main btn-danger-custom py-1 px-2 fs-7', title: 'Rechazar pago' %>
                    <% end %>
                    <%= link_to '✏️', edit_employee_payment_path(p), class: 'btn-main btn-gray-custom py-1 px-2 fs-7', title: 'Editar' %>
                    <%= button_to '🗑️', employee_payment_path(p), method: :delete, data: { turbo_confirm: '¿Eliminar este pago? Esta acción no se puede deshacer.' }, class: 'btn-main py-1 px-2 fs-7', style: 'background:#fff1f2; color:#e11d48; border:1px solid #fecaca; cursor:pointer;', title: 'Eliminar' %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p style="margin: 0; color: #64748b; padding: 20px;">No hay pagos registrados con estos filtros.</p>
      <% end %>
    </div>
  </div>

  <div style="margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap;">
    <%= link_to '➕ Registrar nuevo pago', new_employee_payment_path, class: 'btn-main btn-primary-custom' %>
    <% if @selected_worker.present? || params[:status].present? %>
      <%= link_to 'Ver todos los pagos', employee_payments_path, class: 'btn-main btn-gray-custom' %>
    <% end %>
  </div>
</div>

