<%# Partial: _form.html.erb %>
<%= form_with model: shopping_item, local: true, html: { multipart: true, id: "shopping-item-form" }, style: "display: flex; flex-direction: column; gap: 22px;" do |f| %>

  <% if shopping_item.errors.any? %>
    <div style="background: #fff1f2; border: 1px solid #fecdd3; border-radius: 14px; padding: 16px 20px; color: #be123c;">
      <strong>⚠️ Por favor corrige los siguientes errores:</strong>
      <ul style="margin: 8px 0 0 18px; padding: 0;">
        <% shopping_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Fila 0: Vincular a Meta de Reinversión %>
  <% if @goals.present? && @goals.any? %>
    <div style="background: #eef2ff; border: 1.5px solid #c7d2fe; border-radius: 14px; padding: 16px 20px;">
      <label style="display: block; font-size: 0.82rem; font-weight: 800; color: #4338ca; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
        🎯 Vincular a Meta de Reinversión &amp; Ahorro (Opcional)
      </label>
      <%= f.select :reinvestment_goal_id,
          options_for_select([["-- Compra General / Sin Meta Específica --", ""]] + @goals.map { |g| ["🎯 #{g.title} (Ahorrado: $#{sprintf('%.2f', g.saved_amount)} / Meta: $#{sprintf('%.2f', g.effective_target_amount)})", g.id] }, shopping_item.reinvestment_goal_id),
          {},
          style: "width: 100%; padding: 12px 14px; border-radius: 10px; border: 1.5px solid #a5b4fc; font-weight: 700; color: #1e1b4b; background: white; outline: none; font-size: 0.95rem;" %>
      <small style="color: #6366f1; font-size: 0.78rem; margin-top: 4px; display: block;">
        Al vincularlo a una meta, este ítem sumará a su presupuesto y el recomendador inteligente te avisará cuando haya suficiente dinero ahorrado para comprarlo.
      </small>
    </div>
  <% end %>

  <%# Fila 1: Nombre, Categoría y Foto %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div>
      <label style="display: block; font-size: 0.8em; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
        🏷️ Nombre del artículo <span style="color: #e11d48;">*</span>
      </label>
      <%= f.text_field :name,
          placeholder: "Ej: Luces Móviles Beam 7R o 4 Metros Estructura Truss",
          required: true,
          style: "width: 100%; padding: 13px 16px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 1em; outline: none; color: #0f172a; box-sizing: border-box; transition: border-color 0.2s;",
          onfocus: "this.style.borderColor='#6366f1'",
          onblur: "this.style.borderColor='#e2e8f0'" %>
    </div>

    <div>
      <label style="display: block; font-size: 0.8em; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
        📂 Categoría
      </label>
      <%= f.select :category,
          options_for_select(@categories, shopping_item.category),
          { include_blank: "Seleccionar categoría..." },
          style: "width: 100%; padding: 13px 16px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 1em; background: white; color: #0f172a; box-sizing: border-box; cursor: pointer;" %>
    </div>
  </div>

  <%# Fila: Foto del Ítem %>
  <div style="background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 14px; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div style="display: flex; align-items: center; gap: 16px;">
      <div id="item-photo-preview-box" style="width: 68px; height: 68px; border-radius: 12px; background: white; border: 1.5px solid #cbd5e1; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <% if shopping_item.image_attached? %>
          <img id="item-photo-preview-img" src="<%= shopping_item.image_url_or_data %>" alt="Foto" style="width: 100%; height: 100%; object-fit: cover;">
        <% else %>
          <img id="item-photo-preview-img" src="" alt="Foto" style="width: 100%; height: 100%; object-fit: cover; display: none;">
          <span id="item-photo-placeholder" style="font-size: 1.8rem; color: #94a3b8;">📷</span>
        <% end %>
      </div>
      <div>
        <div style="font-weight: 800; font-size: 0.9rem; color: #0f172a;">📸 Foto del Artículo</div>
        <small style="color: #64748b; font-size: 0.8rem;">Sube una foto referencial del equipo o producto que se va a comprar.</small>
      </div>
    </div>

    <input type="file" id="item-photo-input" accept="image/*" style="display: none;" onchange="handleItemPhotoUpload(this)">
    <%= f.hidden_field :image_base64, id: "item_image_base64" %>

    <div style="display: flex; gap: 8px;">
      <button type="button" onclick="document.getElementById('item-photo-input').click()" style="background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; padding: 8px 14px; border-radius: 8px; font-weight: 800; font-size: 0.82rem; cursor: pointer;">
        📁 Seleccionar Foto
      </button>
      <button type="button" onclick="clearItemPhoto()" id="clear-item-photo-btn" style="background: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; padding: 8px 12px; border-radius: 8px; font-weight: 700; font-size: 0.82rem; cursor: pointer; <%= 'display: none;' unless shopping_item.image_attached? %>">
        ✕ Quitar
      </button>
    </div>
  </div>

  <%# Fila 2: Razón y Para qué %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div>
      <label style="display: block; font-size: 0.8em; font-weight: 700; color: #dc2626; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
        ❓ ¿Por qué comprarlo?
      </label>
      <p style="font-size: 0.8em; color: #94a3b8; margin: 0 0 8px 0;">Explica la necesidad o por qué se requiere este equipo.</p>
      <%= f.text_area :reason,
          rows: 3,
          placeholder: "Ej: Las luces fijas actuales ya no impactan; necesitamos efectos robóticos modernos.",
          style: "width: 100%; padding: 13px 16px; border: 2px solid #fecdd3; border-radius: 12px; font-size: 0.95em; outline: none; color: #0f172a; box-sizing: border-box; resize: vertical; transition: border-color 0.2s;",
          onfocus: "this.style.borderColor='#dc2626'",
          onblur: "this.style.borderColor='#fecdd3'" %>
    </div>

    <div>
      <label style="display: block; font-size: 0.8em; font-weight: 700; color: #7c3aed; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
        🎯 ¿Para qué se usará?
      </label>
      <p style="font-size: 0.8em; color: #94a3b8; margin: 0 0 8px 0;">Describe el uso o función específica en los eventos.</p>
      <%= f.text_area :purpose,
          rows: 3,
          placeholder: "Ej: Para iluminar la tarima y el baile de los novios con secuencias automáticas y control DMX.",
          style: "width: 100%; padding: 13px 16px; border: 2px solid #e9d5ff; border-radius: 12px; font-size: 0.95em; outline: none; color: #0f172a; box-sizing: border-box; resize: vertical; transition: border-color 0.2s;",
          onfocus: "this.style.borderColor='#7c3aed'",
          onblur: "this.style.borderColor='#e9d5ff'" %>
    </div>
  </div>

  <%# Fila 3: Cantidad, Precio Unitario, Precio Total %>
  <div style="background: white; border: 2px solid #e2e8f0; border-radius: 16px; padding: 20px;">
    <div style="font-size: 0.85rem; font-weight: 800; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">
      💰 Cantidad &amp; Costos Detallados
    </div>
    <div style="display: grid; grid-template-columns: 1fr 1.3fr 1.5fr; gap: 16px; align-items: end;">
      <div>
        <label style="display: block; font-size: 0.8em; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
          🔢 Cantidad
        </label>
        <%= f.number_field :quantity,
            min: 1,
            id: "shopping_item_quantity",
            value: shopping_item.quantity.presence || 1,
            style: "width: 100%; padding: 12px 14px; border: 2px solid #cbd5e1; border-radius: 10px; font-size: 1.05rem; font-weight: 800; color: #0f172a; box-sizing: border-box;",
            oninput: "calculateTotalPrice()" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.8em; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
          💵 Precio Unitario ($ USD)
        </label>
        <%= f.number_field :unit_price,
            step: 0.01,
            min: 0,
            id: "shopping_item_unit_price",
            value: shopping_item.unit_price.presence || shopping_item.effective_unit_price,
            placeholder: "0.00",
            style: "width: 100%; padding: 12px 14px; border: 2px solid #cbd5e1; border-radius: 10px; font-size: 1.05rem; font-weight: 800; color: #0f172a; box-sizing: border-box;",
            oninput: "calculateTotalPrice()" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.8em; font-weight: 800; color: #059669; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
          💳 Costo Total Estimado ($ USD)
        </label>
        <%= f.number_field :estimated_price,
            step: 0.01,
            min: 0,
            id: "shopping_item_estimated_price",
            placeholder: "0.00",
            style: "width: 100%; padding: 12px 14px; border: 2px solid #10b981; border-radius: 10px; font-size: 1.15rem; font-weight: 900; color: #065f46; background: #ecfdf5; box-sizing: border-box;" %>
      </div>
    </div>
  </div>

  <%# Fila 4: Prioridad, Estado y Moneda %>
  <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; align-items: start;">
    <div>
      <label style="display: block; font-size: 0.8em; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
        🔴 Nivel de Prioridad
      </label>
      <div style="display: flex; gap: 8px;">
        <% [["🔴 Alta", "high", "#ef4444", "#fee2e2"], ["🟡 Media", "medium", "#f59e0b", "#fef3c7"], ["🟢 Baja", "low", "#10b981", "#d1fae5"]].each do |label, val, color, bg| %>
          <label style="flex: 1; cursor: pointer;">
            <%= f.radio_button :priority, val, style: "display: none;", id: "priority_#{val}" %>
            <div id="priority_label_<%= val %>"
                 onclick="selectPriority('<%= val %>')"
                 style="text-align: center; padding: 11px 4px; border-radius: 10px; font-size: 0.8em; font-weight: 700;
                        border: 2px solid <%= shopping_item.priority.to_s == val ? color : '#e2e8f0' %>;
                        background: <%= shopping_item.priority.to_s == val ? bg : 'white' %>;
                        color: <%= shopping_item.priority.to_s == val ? color : '#94a3b8' %>;
                        transition: all 0.15s;"
                 data-val="<%= val %>"
                 data-color="<%= color %>"
                 data-bg="<%= bg %>">
              <%= label %>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <div>
      <label style="display: block; font-size: 0.8em; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
        ✅ Estado
      </label>
      <%= f.select :status,
          options_for_select([["⏳ Pendiente de Compra", "pending"], ["✅ Comprado", "purchased"]], shopping_item.status),
          {},
          style: "width: 100%; padding: 13px 16px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 1em; background: white; color: #0f172a; box-sizing: border-box;" %>
    </div>
  </div>

  <%# Fila 5: Notas adicionales %>
  <div>
    <label style="display: block; font-size: 0.8em; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
      📝 Notas adicionales
    </label>
    <%= f.text_area :notes,
        rows: 2,
        placeholder: "Enlaces de compra, proveedor, marca sugerida o especificaciones...",
        style: "width: 100%; padding: 13px 16px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 0.95em; outline: none; color: #0f172a; box-sizing: border-box; resize: vertical;" %>
  </div>

  <%# Botones %>
  <div style="display: flex; gap: 12px; justify-content: flex-end; padding-top: 10px; border-top: 1px solid #f1f5f9; margin-top: 4px;">
    <%= link_to "Cancelar", (shopping_item.reinvestment_goal_id ? reinvestment_goal_path(shopping_item.reinvestment_goal_id) : shopping_items_path),
        style: "padding: 13px 28px; border-radius: 12px; font-weight: 700; font-size: 0.95em; color: #64748b; background: #f1f5f9; text-decoration: none; transition: all 0.2s;",
        onmouseover: "this.style.background='#e2e8f0'",
        onmouseout:  "this.style.background='#f1f5f9'" %>
    <%= f.submit shopping_item.new_record? ? "🛒 Agregar a la Lista" : "💾 Guardar Cambios",
        style: "padding: 13px 28px; border-radius: 12px; font-weight: 800; font-size: 0.95em; background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35); transition: all 0.2s;",
        onmouseover: "this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 20px rgba(99,102,241,0.45)'",
        onmouseout:  "this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 14px rgba(99,102,241,0.35)'" %>
  </div>

<% end %>

<script>
  function calculateTotalPrice() {
    const qtyInput = document.getElementById('shopping_item_quantity');
    const unitPriceInput = document.getElementById('shopping_item_unit_price');
    const totalPriceInput = document.getElementById('shopping_item_estimated_price');

    const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;
    const unitPrice = parseFloat(unitPriceInput ? unitPriceInput.value : 0) || 0;

    if (unitPrice > 0 && totalPriceInput) {
      totalPriceInput.value = (qty * unitPrice).toFixed(2);
    }
  }

  function handleItemPhotoUpload(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        const base64Data = e.target.result;
        document.getElementById('item_image_base64').value = base64Data;
        const img = document.getElementById('item-photo-preview-img');
        const placeholder = document.getElementById('item-photo-placeholder');
        const clearBtn = document.getElementById('clear-item-photo-btn');
        
        img.src = base64Data;
        img.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';
        if (clearBtn) clearBtn.style.display = 'block';
      };
      reader.readAsDataURL(file);
    }
  }

  function clearItemPhoto() {
    document.getElementById('item_image_base64').value = '';
    const fileInput = document.getElementById('item-photo-input');
    if (fileInput) fileInput.value = '';
    const img = document.getElementById('item-photo-preview-img');
    const placeholder = document.getElementById('item-photo-placeholder');
    const clearBtn = document.getElementById('clear-item-photo-btn');
    img.src = '';
    img.style.display = 'none';
    if (placeholder) placeholder.style.display = 'block';
    if (clearBtn) clearBtn.style.display = 'none';
  }

  function selectPriority(val) {
    document.getElementById('priority_' + val).checked = true;

    ['high', 'medium', 'low'].forEach(function(v) {
      var lbl = document.getElementById('priority_label_' + v);
      lbl.style.borderColor = '#e2e8f0';
      lbl.style.background  = 'white';
      lbl.style.color       = '#94a3b8';
    });

    var selected = document.getElementById('priority_label_' + val);
    selected.style.borderColor = selected.dataset.color;
    selected.style.background  = selected.dataset.bg;
    selected.style.color       = selected.dataset.color;
  }
</script>
