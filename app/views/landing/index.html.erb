            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 text-xs font-bold">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              En Vivo
            </div>
          </div>

          <!-- Mockup Grid Content -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            
            <!-- Card 1: Próximo Evento -->
            <div class="p-5 rounded-2xl bg-slate-950/70 border border-slate-800">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-extrabold text-cyan-400 uppercase tracking-wider">Próximo Show / Evento</span>
                <span class="text-lg">🗓️</span>
              </div>
              <h4 class="text-white font-extrabold text-base mb-1">Gala Corporativa Anual</h4>
              <p class="text-xs text-slate-400 mb-4">📍 Hotel Eurobuilding • Sábado, 21:00</p>
              <div class="flex items-center justify-between text-xs pt-3 border-t border-slate-800/80">
                <span class="text-slate-400">Personal Asignado:</span>
                <span class="text-emerald-400 font-bold">9 / 9 Confirmados</span>
              </div>
            </div>

            <!-- Card 2: Flujo Financiero -->
            <div class="p-5 rounded-2xl bg-slate-950/70 border border-slate-800">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-extrabold text-emerald-400 uppercase tracking-wider">Caja General & Fondo</span>
                <span class="text-lg">💰</span>
              </div>
              <div class="text-2xl font-black text-white mb-1">$4,850.00 <span class="text-xs font-semibold text-slate-400">USD</span></div>
              <p class="text-xs text-emerald-400/90 mb-4">↑ +$1,200 cobrados esta semana</p>
              <div class="flex items-center justify-between text-xs pt-3 border-t border-slate-800/80">
                <span class="text-slate-400">Nómina por Liquidar:</span>
                <span class="text-indigo-400 font-bold">$950.00 USD</span>
              </div>
            </div>

            <!-- Card 3: Inventario QR -->
            <div class="p-5 rounded-2xl bg-slate-950/70 border border-slate-800">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-extrabold text-indigo-400 uppercase tracking-wider">Inventario & Tarima</span>
                <span class="text-lg">📦</span>
              </div>
              <div class="text-2xl font-black text-white mb-1">100% <span class="text-xs font-semibold text-slate-400">Verificado</span></div>
              <p class="text-xs text-slate-400 mb-4">Checklist QR completado</p>
              <div class="flex items-center justify-between text-xs pt-3 border-t border-slate-800/80">
                <span class="text-slate-400">Kits en Tarima:</span>
                <span class="text-cyan-400 font-bold">3 Kits Activos</span>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<!-- Sección: Todas las Opciones y Módulos de GigManager -->
<section id="modulos" class="py-24 border-t border-slate-900 bg-slate-950/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 text-xs font-extrabold uppercase tracking-wider mb-4">
        Arquitectura & Funciones Completas
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
        Todas las Herramientas Disponibles en GigManager
      </h2>
      <p class="text-base sm:text-lg text-slate-400">
        Herramientas modulares de alto impacto. Elige un paquete prediseñado para tu tipo de actividad o arma tu combinación a medida.
      </p>
    </div>

    <!-- Grid de Módulos con Desglose de Funciones -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @modules.each do |mod| %>
        <div class="group p-7 rounded-3xl bg-slate-900/50 hover:bg-slate-900/90 border border-slate-800 hover:border-cyan-500/50 transition-all duration-300 flex flex-col justify-between hover:shadow-xl hover:shadow-cyan-950/40">
          <div>
            <div class="flex items-center justify-between mb-5">
              <div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700/70 flex items-center justify-center text-2xl group-hover:scale-110 group-hover:bg-cyan-950 group-hover:border-cyan-500/40 transition-all">
                <%= mod[:icon] %>
              </div>
              <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-800/80 text-slate-300 group-hover:bg-cyan-950 group-hover:text-cyan-300 transition-colors">
                <%= mod[:category] %>
              </span>
            </div>

            <h3 class="text-xl font-extrabold text-white mb-2 group-hover:text-cyan-300 transition-colors">
              <%= mod[:name] %>
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-5">
              <%= mod[:description] %>
            </p>

            <!-- Lista de Sub-Funciones / Opciones Incluidas -->
            <% if mod[:features].present? %>
              <div class="mb-6 space-y-2 pt-3 border-t border-slate-800/80">
                <div class="text-[11px] font-black uppercase tracking-wider text-slate-400 mb-2">Herramientas en tu Menú:</div>
                <% mod[:features].each do |feat| %>
                  <div class="flex items-start gap-2 text-xs text-slate-300">
                    <span class="text-cyan-400 font-black flex-shrink-0">✓</span>
                    <span><%= feat %></span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-semibold text-slate-400">
            <span class="flex items-center gap-1.5 text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Incluido en Free Trial
            </span>
            <span class="text-slate-500 group-hover:text-cyan-400 transition-colors">Probar 30 días →</span>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>

<!-- Sección: Calculadora Modular Interactiva & Paquetes Pre-Establecidos con Descuento -->
<section id="calculadora" class="py-24 border-t border-slate-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 text-xs font-extrabold uppercase tracking-wider mb-4">
        Planes Inteligentes con Descuento
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
        Elige un Paquete a tu Medida
      </h2>
      <p class="text-base sm:text-lg text-slate-400">
        Ahorra contratando un paquete pre-diseñado para tu sector o personaliza tus módulos individualmente. Todos incluyen <strong>30 días de prueba gratuita</strong>.
      </p>
    </div>

    <!-- Pestañas Rápidas de Selección de Paquetes -->
    <div class="max-w-5xl mx-auto mb-10">
      <div class="text-xs font-black uppercase tracking-wider text-slate-400 mb-3 text-center sm:text-left">
        💡 Selecciona tu tipo de actividad para aplicar descuento de paquete:
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" id="packages-selector">
        
        <!-- Paquete 1: Bandas & Músicos -->
        <button type="button" data-package="banda" class="pkg-tab active p-3.5 rounded-2xl bg-slate-900 border-2 border-cyan-500 text-left transition-all hover:scale-[1.02] cursor-pointer">
          <div class="text-2xl mb-1">🎸</div>
          <div class="text-xs font-black text-white leading-tight mb-1">Bandas & Orquestas</div>
          <div class="text-[11px] font-bold text-cyan-400">$15 / mes</div>
          <span class="inline-block mt-1 text-[10px] font-black px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-500/30">Ahorras $2</span>
        </button>

        <!-- Paquete 2: Productoras & Logística -->
        <button type="button" data-package="productora" class="pkg-tab p-3.5 rounded-2xl bg-slate-950/80 border-2 border-slate-800 text-left transition-all hover:scale-[1.02] hover:border-slate-700 cursor-pointer">
          <div class="text-2xl mb-1">🎬</div>
          <div class="text-xs font-black text-white leading-tight mb-1">Productoras & Audio</div>
          <div class="text-[11px] font-bold text-cyan-400">$18 / mes</div>
          <span class="inline-block mt-1 text-[10px] font-black px-1.5 py-0.5 rounded bg-indigo-950 text-indigo-300 border border-indigo-500/30">Ahorras $2</span>
        </button>

        <!-- Paquete 3: Salones de Fiesta -->
        <button type="button" data-package="salon" class="pkg-tab p-3.5 rounded-2xl bg-slate-950/80 border-2 border-slate-800 text-left transition-all hover:scale-[1.02] hover:border-slate-700 cursor-pointer">
          <div class="text-2xl mb-1">🏛️</div>
          <div class="text-xs font-black text-white leading-tight mb-1">Salones & Venues</div>
          <div class="text-[11px] font-bold text-cyan-400">$15 / mes</div>
          <span class="inline-block mt-1 text-[10px] font-black px-1.5 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-500/30">Ahorras $2</span>
        </button>

        <!-- Paquete 4: Empresas & Negocios (Sin música) -->
        <button type="button" data-package="negocio" class="pkg-tab p-3.5 rounded-2xl bg-slate-950/80 border-2 border-slate-800 text-left transition-all hover:scale-[1.02] hover:border-slate-700 cursor-pointer">
          <div class="text-2xl mb-1">💼</div>
          <div class="text-xs font-black text-white leading-tight mb-1">Empresas & Negocios</div>
          <div class="text-[11px] font-bold text-cyan-400">$14 / mes</div>
          <span class="inline-block mt-1 text-[10px] font-black px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-500/30">Ahorras $3</span>
        </button>

        <!-- Paquete 5: Full Suite -->
        <button type="button" data-package="full" class="pkg-tab p-3.5 rounded-2xl bg-slate-950/80 border-2 border-slate-800 text-left transition-all hover:scale-[1.02] hover:border-slate-700 cursor-pointer">
          <div class="text-2xl mb-1">👑</div>
          <div class="text-xs font-black text-white leading-tight mb-1">Full Suite Total</div>
          <div class="text-[11px] font-bold text-cyan-400">$22 / mes</div>
          <span class="inline-block mt-1 text-[10px] font-black px-1.5 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-500/30">Ahorras $4</span>
        </button>

      </div>
    </div>

    <!-- Calculadora Dinámica & Detalle de Selección -->
    <div class="max-w-5xl mx-auto rounded-3xl bg-slate-900/70 border border-slate-800 p-6 sm:p-10 shadow-2xl backdrop-blur-xl">
      
      <!-- Banner Informativo del Paquete Activo -->
      <div id="package-info-banner" class="mb-8 p-4 rounded-2xl bg-slate-950 border border-slate-800 flex items-start gap-4">
        <div id="pkg-banner-icon" class="text-3xl">🎸</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <h4 id="pkg-banner-title" class="text-base font-black text-white">Paquete Bandas & Orquestas</h4>
            <span id="pkg-banner-badge" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-500/30">
              Músicos & Shows
            </span>
          </div>
          <p id="pkg-banner-desc" class="text-xs text-slate-400 leading-relaxed m-0">
            Diseñado para directores, bandas y orquestas: Agenda de shows, liquidación de nóminas a músicos, cancionero digital y fondo de reserva de la agrupación.
          </p>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row gap-10 items-start">
        
        <!-- Lista de Selección de Módulos con Checkboxes -->
        <div class="flex-1 w-full space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <h3 class="text-sm font-black text-white flex items-center gap-2">
              <span>🧩</span> Módulos incluidos en esta selección:
            </h3>
            <button type="button" id="select-all-btn" class="text-xs font-bold text-cyan-400 hover:text-cyan-300">
              Seleccionar Todos
            </button>
          </div>

          <div class="space-y-3" id="modules-container">
            <% @modules.each do |mod| %>
              <label class="module-choice flex items-center justify-between p-3.5 rounded-2xl bg-slate-950/60 border border-slate-800/90 hover:border-slate-700 cursor-pointer transition-all">
                <div class="flex items-center gap-3.5">
                  <input type="checkbox" name="calc_module" value="<%= mod[:key] %>" class="w-5 h-5 rounded-lg text-cyan-500 bg-slate-900 border-slate-700 focus:ring-0 focus:ring-offset-0 cursor-pointer accent-cyan-500">
                  <span class="text-xl"><%= mod[:icon] %></span>
                  <div>
                    <strong class="text-white text-sm block"><%= mod[:name] %></strong>
                    <span class="text-slate-400 text-xs"><%= mod[:category] %> • <%= mod[:features]&.count.to_i %> herramientas</span>
                  </div>
                </div>
                <span class="text-xs font-bold text-slate-400 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800">
                  +$3 / mes
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Panel Lateral con Resumen de Precio y CTA -->
        <div class="w-full lg:w-80 p-6 rounded-2xl bg-gradient-to-b from-slate-950 to-slate-900 border border-slate-700/80 flex flex-col justify-between">
          <div>
            <div class="inline-block px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-400 text-[11px] font-black uppercase tracking-wider mb-4">
              ✨ 30 Días de Prueba Gratis
            </div>
            
            <h4 class="text-slate-300 text-xs font-bold mb-1">Precio Mensual Estimado:</h4>
            
            <div class="flex items-baseline gap-2 mb-1">
              <span id="calculated-price" class="text-4xl font-black text-white">$15</span>
              <span id="strikethrough-price" class="text-slate-500 line-through text-sm font-semibold">$17</span>
              <span class="text-slate-400 text-xs font-semibold">USD / mes</span>
            </div>

            <div id="savings-tag" class="inline-flex items-center gap-1 text-xs font-bold text-emerald-400 mb-3">
              <span>⚡</span> <span>Ahorras $2 USD/mes en este paquete</span>
            </div>

            <p id="modules-count-text" class="text-xs text-cyan-400 font-semibold mb-6">
              4 módulos seleccionados
            </p>

            <ul class="space-y-2 text-xs text-slate-300 mb-8 border-t border-slate-800 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span>30 Días de Free Trial sin compromiso</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Sin tarjeta de crédito requerida</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Personal y usuarios ilimitados</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span>Cambia o añade módulos cuando quieras</span>
              </li>
            </ul>
          </div>

          <a id="signup-cta-link" href="<%= new_user_registration_path %>" class="w-full inline-flex items-center justify-center gap-2 py-4 px-5 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-slate-950 font-black text-sm shadow-xl shadow-cyan-500/25 transition-all text-center">
            <span>Iniciar 30 Días Gratis</span>
            <span>⚡</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Sección: Preguntas Frecuentes (FAQ) -->
<section id="faq" class="py-24 border-t border-slate-900 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300 text-xs font-extrabold uppercase tracking-wider mb-4">
        Dudas Frecuentes
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
