          <span class="text-lg">⚡</span>
        </a>
        <a href="#modulos" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-bold text-base border border-slate-700/60 hover:border-slate-600 transition-all">
          <span>Ver Todas las Funciones</span>
          <span class="text-cyan-400">↓</span>
        </a>
      </div>

      <!-- Badges de Confianza -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs sm:text-sm font-semibold text-slate-400">
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-black">✓</span>
          <span>30 Días de Prueba Completa</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-black">✓</span>
          <span>Sin Tarjeta de Crédito</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-black">✓</span>
          <span>Configuración en 1 Minuto</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-black">✓</span>
          <span>Personal y Músicos Ilimitados</span>
        </div>
      </div>

    </div>

    <!-- Mockup Visual del Dashboard en Vivo -->
    <div class="mt-16 sm:mt-20 max-w-5xl mx-auto">
      <div class="relative rounded-3xl p-1 bg-gradient-to-b from-cyan-500/30 via-indigo-500/20 to-transparent shadow-2xl shadow-cyan-950/50">
        <div class="rounded-[22px] bg-slate-900/90 border border-slate-800/80 backdrop-blur-xl p-6 sm:p-8 overflow-hidden">
          
          <!-- Mockup Header Bar -->
          <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-800/80">
            <div class="flex items-center gap-3">
              <div class="flex gap-1.5">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
