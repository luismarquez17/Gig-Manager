<%# --- MODAL: CENTRO DE MENSAJES RÁPIDOS WHATSAPP (VIP) --- %>
<%
  modal_id = "whatsapp-share-modal-#{gig.id}"
  portal_url = public_portal_url(token: gig.portal_token)
  stage_url = stage_mode_gig_url(gig)
  client_phone = gig.client&.formatted_phone_for_whatsapp.presence

  # Plantillas generadas
  tpl_welcome = gig.whatsapp_client_welcome_text(portal_url)
  tpl_statement = gig.whatsapp_payment_statement_text(portal_url)
  tpl_schedule = gig.whatsapp_client_schedule_text(portal_url)
  tpl_call_sheet_general = gig.whatsapp_staff_call_sheet_text(nil, stage_url)
%>

<div id="<%= modal_id %>" class="whatsapp-share-modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 9999; overflow-y: auto; padding: 20px 12px;" onclick="closeWhatsAppShareModal('<%= modal_id %>')">
  
  <div style="max-width: 640px; margin: 30px auto; background: #ffffff; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4); overflow: hidden; border: 1px solid #e2e8f0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;" onclick="event.stopPropagation();">
    
    <!-- Modal Header -->
    <div style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 22px 26px; color: white; display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #25d366;">
      <div style="display: flex; align-items: center; gap: 14px;">
        <div style="background: #25d366; color: white; width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5em; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);">
          💬
        </div>
        <div>
          <h3 style="margin: 0; font-size: 1.25em; font-weight: 800; letter-spacing: -0.3px;">Centro de Mensajes WhatsApp</h3>
          <p style="margin: 3px 0 0 0; color: #94a3b8; font-size: 0.85em;">Plantillas inteligentes listas para enviar en 1 clic</p>
        </div>
      </div>
      <button type="button" onclick="closeWhatsAppShareModal('<%= modal_id %>')" style="background: rgba(255,255,255,0.1); border: none; color: #cbd5e1; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1em; cursor: pointer; transition: 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'">
        ✕
      </button>
    </div>

    <!-- Tabs Header -->
    <div style="display: flex; background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 6px 12px; gap: 8px;">
      <button type="button" id="tab-btn-client-<%= gig.id %>" onclick="switchWhatsAppTab('<%= gig.id %>', 'client')" style="flex: 1; padding: 10px 16px; border: none; background: white; color: #0f172a; font-weight: 800; font-size: 0.88em; border-radius: 12px; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.05); transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span>👤</span> Para el Cliente
      </button>
      <button type="button" id="tab-btn-staff-<%= gig.id %>" onclick="switchWhatsAppTab('<%= gig.id %>', 'staff')" style="flex: 1; padding: 10px 16px; border: none; background: transparent; color: #64748b; font-weight: 700; font-size: 0.88em; border-radius: 12px; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span>🎸</span> Para Músicos &amp; Staff
      </button>
    </div>

    <!-- Modal Body -->
    <div style="padding: 24px; max-height: 65vh; overflow-y: auto;">
      
      <!-- ============================================== -->
      <!-- TAB 1: MENSAJES PARA EL CLIENTE                -->
      <!-- ============================================== -->
      <div id="tab-pane-client-<%= gig.id %>" style="display: block;">
        
        <!-- Recipient Info Card -->
        <div style="background: #f1f5f9; border-radius: 12px; padding: 12px 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
          <div>
            <span style="font-size: 0.72em; text-transform: uppercase; font-weight: 800; color: #64748b; letter-spacing: 0.5px;">Destinatario</span>
            <div style="font-weight: 800; color: #1e293b; font-size: 0.98em;">
              👤 <%= gig.client_display_name %> 
              <% if client_phone.present? %>
                <span style="color: #059669; font-size: 0.88em; font-weight: 600;">(WA: +<%= client_phone %>)</span>
              <% else %>
                <span style="color: #94a3b8; font-size: 0.82em; font-weight: 500;">(Sin número registrado - abrirá selector de chat)</span>
              <% end %>
            </div>
          </div>
          <span style="background: #e0f2fe; color: #0369a1; padding: 4px 10px; border-radius: 99px; font-size: 0.75em; font-weight: 800;">
            📅 <%= gig.date&.strftime("%d/%m/%Y") || 'Próximo' %>
          </span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 20px;">
          
          <!-- Template 1: Portal VIP & Bienvenida -->
          <div style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 18px; transition: border-color 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
              <div>
                <h4 style="margin: 0; color: #0f172a; font-size: 1em; font-weight: 800; display: flex; align-items: center; gap: 6px;">
                  <span>✨</span> Portal VIP &amp; Acceso Exclusivo
                </h4>
                <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.82em;">Ideal para enviar recién agendado el evento o como recordatorio.</p>
              </div>
              <span style="background: #dbeafe; color: #1e40af; font-size: 0.72em; font-weight: 800; padding: 3px 8px; border-radius: 99px;">Bienvenida</span>
            </div>

            <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; font-family: monospace; font-size: 0.82em; color: #334155; white-space: pre-wrap; max-height: 120px; overflow-y: auto; line-height: 1.45; margin-bottom: 12px;" id="text-welcome-<%= gig.id %>"><%= tpl_welcome %></div>

            <div style="display: flex; gap: 8px; justify-content: flex-end;">
              <button type="button" onclick="copySnippetText('text-welcome-<%= gig.id %>', this)" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 8px 14px; border-radius: 8px; font-size: 0.82em; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;">
                📋 Copiar
              </button>
              <a href="<%= whatsapp_url_for_message(client_phone, tpl_welcome) %>" target="_blank" style="background: #25d366; color: white; padding: 8px 16px; border-radius: 8px; font-size: 0.82em; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(37, 211, 102, 0.3);">
                <span>📲</span> Enviar por WhatsApp
              </a>
            </div>
          </div>

          <!-- Template 2: Estado de Cuenta & Saldo Pendiente -->
          <div style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 18px; transition: border-color 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
              <div>
                <h4 style="margin: 0; color: #0f172a; font-size: 1em; font-weight: 800; display: flex; align-items: center; gap: 6px;">
                  <span>💳</span> Estado de Cuenta &amp; Resumen de Pagos
                </h4>
                <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.82em;">Muestra el total, los abonos recibidos, recibos y saldo pendiente.</p>
              </div>
              <span style="background: <%= gig.paid_in_full? ? '#dcfce7' : '#fef3c7' %>; color: <%= gig.paid_in_full? ? '#166534' : '#92400e' %>; font-size: 0.72em; font-weight: 800; padding: 3px 8px; border-radius: 99px;">
                <%= gig.paid_in_full? ? 'Saldado' : 'Cobranza' %>
              </span>
            </div>

            <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; font-family: monospace; font-size: 0.82em; color: #334155; white-space: pre-wrap; max-height: 120px; overflow-y: auto; line-height: 1.45; margin-bottom: 12px;" id="text-statement-<%= gig.id %>"><%= tpl_statement %></div>

            <div style="display: flex; gap: 8px; justify-content: flex-end;">
              <button type="button" onclick="copySnippetText('text-statement-<%= gig.id %>', this)" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 8px 14px; border-radius: 8px; font-size: 0.82em; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;">
                📋 Copiar
              </button>
              <a href="<%= whatsapp_url_for_message(client_phone, tpl_statement) %>" target="_blank" style="background: #25d366; color: white; padding: 8px 16px; border-radius: 8px; font-size: 0.82em; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(37, 211, 102, 0.3);">
                <span>📲</span> Enviar por WhatsApp
              </a>
            </div>
          </div>

          <!-- Template 3: Itinerario & Ficha Técnica -->
          <div style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 18px; transition: border-color 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
              <div>
                <h4 style="margin: 0; color: #0f172a; font-size: 1em; font-weight: 800; display: flex; align-items: center; gap: 6px;">
                  <span>⏰</span> Cronograma &amp; Horarios Técnicos
                </h4>
                <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.82em;">Horarios de llegada, prueba de sonido y sets de música para el organizador.</p>
              </div>
              <span style="background: #f3e8ff; color: #6b21a8; font-size: 0.72em; font-weight: 800; padding: 3px 8px; border-radius: 99px;">Itinerario</span>
            </div>

            <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; font-family: monospace; font-size: 0.82em; color: #334155; white-space: pre-wrap; max-height: 120px; overflow-y: auto; line-height: 1.45; margin-bottom: 12px;" id="text-schedule-<%= gig.id %>"><%= tpl_schedule %></div>

            <div style="display: flex; gap: 8px; justify-content: flex-end;">
              <button type="button" onclick="copySnippetText('text-schedule-<%= gig.id %>', this)" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 8px 14px; border-radius: 8px; font-size: 0.82em; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;">
                📋 Copiar
              </button>
              <a href="<%= whatsapp_url_for_message(client_phone, tpl_schedule) %>" target="_blank" style="background: #25d366; color: white; padding: 8px 16px; border-radius: 8px; font-size: 0.82em; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(37, 211, 102, 0.3);">
                <span>📲</span> Enviar por WhatsApp
              </a>
            </div>
          </div>

        </div>

      </div>

      <!-- ============================================== -->
      <!-- TAB 2: MENSAJES PARA MÚSICOS & STAFF           -->
      <!-- ============================================== -->
      <div id="tab-pane-staff-<%= gig.id %>" style="display: none;">
        
        <!-- Call Sheet General -->
        <div style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 18px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
            <div>
              <h4 style="margin: 0; color: #0f172a; font-size: 1.05em; font-weight: 800; display: flex; align-items: center; gap: 6px;">
                <span>📢</span> Pauta General para el Grupo / Chat de la Banda
              </h4>
              <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.82em;">Texto completo con hora de convocatoria, show, lugar, dress code y link en vivo.</p>
            </div>
            <span style="background: #e0e7ff; color: #3730a3; font-size: 0.72em; font-weight: 800; padding: 3px 8px; border-radius: 99px;">Call Sheet Grupal</span>
          </div>

          <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; font-family: monospace; font-size: 0.82em; color: #334155; white-space: pre-wrap; max-height: 130px; overflow-y: auto; line-height: 1.45; margin-bottom: 12px;" id="text-callsheet-general-<%= gig.id %>"><%= tpl_call_sheet_general %></div>

          <div style="display: flex; gap: 8px; justify-content: flex-end;">
            <button type="button" onclick="copySnippetText('text-callsheet-general-<%= gig.id %>', this)" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 8px 14px; border-radius: 8px; font-size: 0.82em; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;">
              📋 Copiar
            </button>
            <a href="<%= whatsapp_url_for_message(nil, tpl_call_sheet_general) %>" target="_blank" style="background: #25d366; color: white; padding: 8px 16px; border-radius: 8px; font-size: 0.82em; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(37, 211, 102, 0.3);">
              <span>📲</span> Compartir en Grupo WA
            </a>
          </div>
        </div>

        <!-- Call Sheets Individuales por Músico / Trabajador Asignado -->
        <h4 style="margin: 20px 0 12px 0; color: #1e293b; font-size: 0.95em; font-weight: 800; display: flex; align-items: center; gap: 6px;">
          <span>👤</span> Pautas Individuales con Pago Acordado (<%= gig.staff_assignments.count %> asignados)
        </h4>

        <% if gig.staff_assignments.any? %>
          <div style="display: flex; flex-direction: column; gap: 12px;">
            <% gig.staff_assignments.includes(:user).each do |assignment| %>
              <%
                user = assignment.user
                ind_text = gig.whatsapp_staff_call_sheet_text(user, stage_url)
                user_phone = user.phone_number
                user_snippet_id = "text-staff-#{gig.id}-#{assignment.id}"
              %>
              <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap;">
                <div>
                  <div style="font-weight: 800; color: #0f172a; font-size: 0.95em;">
                    <%= user.display_name %> 
                    <span style="font-size: 0.8em; font-weight: 600; color: #64748b;">(<%= user.specialty.presence || user.role_name rescue 'Músico' %>)</span>
                  </div>
                  <div style="font-size: 0.82em; color: #059669; font-weight: 700; margin-top: 2px;">
                    💰 Pago Acordado: $<%= number_with_precision(assignment.agreed_amount, precision: 2) %> <%= gig.currency %>
                  </div>
                  <div id="<%= user_snippet_id %>" style="display: none;"><%= ind_text %></div>
                </div>

                <div style="display: flex; gap: 6px; align-items: center;">
                  <button type="button" onclick="copySnippetText('<%= user_snippet_id %>', this)" style="background: white; color: #475569; border: 1px solid #cbd5e1; padding: 6px 12px; border-radius: 8px; font-size: 0.8em; font-weight: 700; cursor: pointer;">
                    📋 Copiar Pauta
                  </button>
                  <a href="<%= whatsapp_url_for_message(user_phone, ind_text) %>" target="_blank" style="background: #25d366; color: white; padding: 6px 12px; border-radius: 8px; font-size: 0.8em; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                    <span>📲</span> Enviar WA
                  </a>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 16px; text-align: center; color: #64748b; font-size: 0.88em;">
            Aún no has asignado personal a este evento. Asigna músicos y staff para generarles pautas individuales con su pago acordado.
          </div>
        <% end %>

      </div>

    </div>

    <!-- Modal Footer -->
    <div style="padding: 14px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
      <span style="font-size: 0.78em; color: #94a3b8;">✨ Formateado con saltos de línea y emojis para WhatsApp</span>
      <button type="button" onclick="closeWhatsAppShareModal('<%= modal_id %>')" style="background: #e2e8f0; color: #475569; border: none; padding: 8px 18px; border-radius: 10px; font-size: 0.85em; font-weight: 700; cursor: pointer;">
        Cerrar
      </button>
    </div>

  </div>
</div>

<script>
  function openWhatsAppShareModal(id) {
    var modal = document.getElementById(id);
    if (modal) {
      modal.style.display = 'block';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeWhatsAppShareModal(id) {
    var modal = document.getElementById(id);
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  function switchWhatsAppTab(gigId, tabName) {
    var clientTabBtn = document.getElementById('tab-btn-client-' + gigId);
    var staffTabBtn = document.getElementById('tab-btn-staff-' + gigId);
    var clientPane = document.getElementById('tab-pane-client-' + gigId);
    var staffPane = document.getElementById('tab-pane-staff-' + gigId);

    if (tabName === 'client') {
      clientPane.style.display = 'block';
      staffPane.style.display = 'none';
      clientTabBtn.style.background = 'white';
      clientTabBtn.style.color = '#0f172a';
      clientTabBtn.style.boxShadow = '0 2px 6px rgba(0,0,0,0.05)';
      staffTabBtn.style.background = 'transparent';
      staffTabBtn.style.color = '#64748b';
      staffTabBtn.style.boxShadow = 'none';
    } else {
      clientPane.style.display = 'none';
      staffPane.style.display = 'block';
      staffTabBtn.style.background = 'white';
      staffTabBtn.style.color = '#0f172a';
      staffTabBtn.style.boxShadow = '0 2px 6px rgba(0,0,0,0.05)';
      clientTabBtn.style.background = 'transparent';
      clientTabBtn.style.color = '#64748b';
      clientTabBtn.style.boxShadow = 'none';
    }
  }

  function copySnippetText(elementId, buttonEl) {
    var el = document.getElementById(elementId);
    if (!el) return;
    var textToCopy = el.innerText || el.textContent;

    navigator.clipboard.writeText(textToCopy).then(function() {
      var originalHTML = buttonEl.innerHTML;
      buttonEl.innerHTML = '✅ ¡Copiado!';
      buttonEl.style.background = '#dcfce7';
      buttonEl.style.color = '#15803d';
      buttonEl.style.borderColor = '#86efac';

      setTimeout(function() {
        buttonEl.innerHTML = originalHTML;
        buttonEl.style.background = '';
        buttonEl.style.color = '';
        buttonEl.style.borderColor = '';
      }, 2000);
    }).catch(function(err) {
      alert('No se pudo copiar automáticamente: ' + err);
    });
  }
</script>
