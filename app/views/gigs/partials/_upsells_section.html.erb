<%# --- PERSONALIZACIÓN Y ACTIVACIÓN DE ADICIONALES (UPSELLS) PARA ESTE EVENTO (DESPLEGABLE) --- %>
<% if current_user.leader? %>
  <div style="background: white; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px; overflow: hidden;">
    
    <%# Cabecera Desplegable %>
    <div onclick="toggleUpsellsPanel()" style="padding: 20px 25px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: #ffffff; user-select: none; transition: background 0.2s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#ffffff'">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 1.5em; background: #eff6ff; color: #3b82f6; width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">🚀</span>
        <div>
          <h3 style="margin: 0; color: #1e293b; font-size: 1.05em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
            Adicionales (Upsells) Disponibles
            <span style="background: #e0e7ff; color: #4338ca; font-size: 0.72em; padding: 2px 8px; border-radius: 12px; font-weight: 700;"><%= @gig.available_upsells.size %> Activos</span>
          </h3>
          <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.85em;">
            Haz clic para desplegar y activar/desactivar o personalizar los adicionales de este evento.
          </p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;" onclick="event.stopPropagation();">
        <%= link_to '⚙️ Catálogo Global', standard_upsells_path, style: "background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 8px; font-weight: bold; font-size: 0.82em; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: 0.2s;" %>
        
        <button type="button" onclick="toggleUpsellsPanel()" id="upsells-toggle-btn" style="background: #eef2ff; color: #4f46e5; border: 1px solid #c7d2fe; padding: 6px 14px; border-radius: 8px; font-weight: bold; font-size: 0.82em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: 0.2s;">
          <span id="upsells-toggle-text">Desplegar</span>
          <span id="upsells-toggle-icon" style="font-size: 0.8em; transition: transform 0.2s;">▼</span>
        </button>
      </div>
    </div>

    <%# Contenido Desplegable (Oculto por defecto para optimizar espacio) %>
    <div id="upsells-collapsible-content" style="display: none; border-top: 1px solid #e2e8f0; padding: 25px; background: #fafafa;">
      <p style="margin: 0 0 20px 0; color: #64748b; font-size: 0.88em; line-height: 1.4;">
        <%= venue_mode? ? 'Todos los adicionales del catálogo estándar están activos automáticamente para este evento. Desactiva los que no desees mostrar en el portal de este cliente o modifica su precio/título si este evento lo requiere.' : 'Todos los adicionales del catálogo estándar están activos automáticamente para este toque. Desactiva los que no desees mostrar en el portal de este cliente o modifica su precio/título si este evento lo requiere.' %>
      </p>

      <%# --- HISTORIAL DE SOLICITUDES DE CLIENTES --- %>
      <% if @gig.gig_upsell_requests.any? %>
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px; margin-bottom: 25px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
          <h4 style="margin: 0 0 12px 0; color: #1e293b; font-size: 1.02em; font-weight: 800; display: flex; align-items: center; justify-content: space-between;">
            <span>✨ Adicionales & Solicitudes del Evento (<%= @gig.gig_upsell_requests.count %>)</span>
          </h4>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <% @gig.gig_upsell_requests.ordered.each do |req| %>
              <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <span style="font-size: 1.6em;"><%= req.emoji.presence || '🚀' %></span>
                  <div>
                    <strong style="color: #0f172a; font-size: 0.95em;"><%= req.title %></strong>
                    <div style="font-size: 0.8em; color: #64748b;">
                      Solicitado: <%= req.requested_at&.strftime("%d/%m/%Y %I:%M %p") || req.created_at.strftime("%d/%m/%Y %I:%M %p") %>
                      <% if req.notes.present? %> • "<%= req.notes %>"<% end %>
                    </div>
                  </div>
                </div>

                <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                  <strong style="color: #059669; font-size: 1em;">+ $<%= number_with_precision(req.price, precision: 2) %> <%= req.currency %></strong>
                  
                  <% case req.status %>
                  <% when 'approved' %>
                    <span style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 4px 10px; border-radius: 99px; font-weight: 800; font-size: 0.78em; display: inline-flex; align-items: center; gap: 4px;">
                      <%= venue_mode? ? '✓ Activo en Evento' : '✓ Activo en Show' %>
                    </span>
                    <% if current_user.leader? %>
                      <% is_time_item = req.is_extra_time? %>
                      <%= button_to revert_gig_upsell_request_path(req), method: :post, style: "background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; padding: 5px 11px; border-radius: 8px; font-weight: 800; font-size: 0.78em; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: 0.15s;", data: { turbo_confirm: "¿Quitar y cancelar '#{req.title}' de este evento?\n\nSe restarán $#{number_with_precision(req.price, precision: 2)} #{req.currency} del presupuesto total#{' y se restará 1 hora al horario del evento' if is_time_item}." }, title: "Cancelar y descontar este adicional" do %>
                        <span>🗑️</span> Quitar / Cancelar
                      <% end %>
                    <% end %>
                  <% when 'rejected' %>
                    <span style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 4px 10px; border-radius: 99px; font-weight: 800; font-size: 0.78em;">
                      ✕ Cancelado / Removido
                    </span>
                    <% if current_user.leader? %>
                      <%= button_to gig_upsell_request_path(req), method: :delete, style: "background: none; border: none; color: #94a3b8; font-size: 0.75rem; cursor: pointer; text-decoration: underline; padding: 0 4px;", data: { turbo_confirm: "¿Eliminar definitivamente este registro del historial?" }, title: "Eliminar registro" do %>
                        Eliminar registro
                      <% end %>
                    <% end %>
                  <% else %>
                    <span style="background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 4px 10px; border-radius: 99px; font-weight: 800; font-size: 0.78em;">
                      ⏳ Pendiente
                    </span>
                    <div style="display: flex; gap: 6px;">
                      <%= button_to "Añadir", approve_gig_upsell_request_path(req), method: :post, style: "background: #10b981; color: white; border: none; padding: 5px 10px; border-radius: 6px; font-weight: 700; font-size: 0.78em; cursor: pointer;", onclick: "return confirm('¿Aprobar y sumar al #{venue_mode? ? 'evento' : 'show'}?');" %>
                      <%= button_to "No añadir", reject_gig_upsell_request_path(req), method: :post, style: "background: #f1f5f9; color: #dc2626; border: 1px solid #cbd5e1; padding: 5px 10px; border-radius: 6px; font-weight: 700; font-size: 0.78em; cursor: pointer;", onclick: "return confirm('¿Rechazar adicional?');" %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if current_user.leader? %>
        <%# --- BARRA DE ACCIÓN RÁPIDA PARA LÍDERES: AÑADIR ADICIONAL AL EVENTO --- %>
        <div style="background: #ffffff; border: 1px solid #c7d2fe; border-radius: 16px; padding: 20px; margin-bottom: 25px; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.05);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
            <div>
              <h4 style="margin: 0; color: #1e293b; font-size: 1.02em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                ⚡ Añadir Adicional / Hora Extra al Evento
              </h4>
              <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.84em;">
                Haz clic en un botón para sumar el adicional cobrado. El presupuesto final aumentará automáticamente y si es una hora extra, se extenderá el horario.
              </p>
            </div>
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
            <% standard_catalog_list = (@gig.company || current_company).standard_upsells.all_with_defaults %>
            <% custom_upsells_map = @gig.custom_upsells || {} %>
            <% standard_catalog_list.each do |std| %>
              <% 
                key_name = std.key.to_s
                c_data = custom_upsells_map[key_name] || custom_upsells_map[std.id.to_s] || {}
                card_active = std.active? && c_data['disabled'] != '1' && c_data['disabled'] != true
                next unless card_active
                item_title = c_data['title'].presence || std.title
                item_emoji = c_data['emoji'].presence || std.emoji || '🚀'
                item_price = c_data['price'].present? ? c_data['price'].to_f : std.price.to_f
                item_currency = c_data['currency'].presence || std.currency || @gig.currency || 'USD'
                is_time = key_name == 'extra_time' || key_name.include?('hora')
              %>
              <%= form_with url: add_upsell_gig_path(@gig), method: :post, local: true, style: "display: inline-block;", data: { turbo_confirm: "¿Añadir '#{item_title}' (+ $ #{number_with_precision(item_price, precision: 2)} #{item_currency}) a este evento?#{' Se agregará 1 hora al horario final.' if is_time}" } do |f| %>
                <%= hidden_field_tag :upsell_key, key_name %>
                <%= hidden_field_tag :price, item_price %>
                <%= hidden_field_tag :title, item_title %>
                <button type="submit" style="background: <%= is_time ? '#4f46e5' : '#059669' %>; color: white; border: none; padding: 9px 16px; border-radius: 12px; font-weight: 700; font-size: 0.86em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); transition: transform 0.15s, opacity 0.15s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                  <span><%= item_emoji %></span>
                  <span>+ <%= item_title %> (+ $ <%= number_with_precision(item_price, precision: 0) %> <%= item_currency %>)</span>
                </button>
              <% end %>
            <% end %>
          </div>

          <%# Formulario para monto u hora extra personalizada a medida %>
          <details style="margin-top: 10px; background: #f8fafc; padding: 14px 16px; border-radius: 12px; border: 1px solid #e2e8f0;">
            <summary style="font-weight: 700; font-size: 0.86em; color: #475569; cursor: pointer; user-select: none;">
              ⚙️ Añadir adicional o descuento personalizado a medida...
            </summary>
            <%= form_with url: add_upsell_gig_path(@gig), method: :post, local: true, style: "margin-top: 12px; display: flex; flex-direction: column; gap: 12px;" do |f| %>
              <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.85em; font-weight: 700; color: #047857; cursor: pointer;">
                  <%= radio_button_tag :operation, 'add', true, id: 'op-add', onchange: "document.getElementById('custom-upsell-submit').value='➕ Registrar Adicional'; document.getElementById('custom-upsell-submit').style.background='#1e293b';" %>
                  <span>➕ Sumar al presupuesto (Adicional / Hora Extra)</span>
                </label>
                <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.85em; font-weight: 700; color: #b91c1c; cursor: pointer;">
                  <%= radio_button_tag :operation, 'subtract', false, id: 'op-sub', onchange: "document.getElementById('custom-upsell-submit').value='➖ Aplicar Descuento / Deducción'; document.getElementById('custom-upsell-submit').style.background='#dc2626';" %>
                  <span>➖ Descontar del presupuesto (Deducción / Descuento)</span>
                </label>
              </div>

              <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
                <div style="flex: 2; min-width: 180px;">
                  <label style="display: block; font-size: 0.78em; font-weight: bold; color: #64748b; margin-bottom: 4px;">Concepto / Título</label>
                  <%= text_field_tag :title, nil, placeholder: "Ej: Hora Extra Especial, Descuento especial, Tarima...", required: true, style: "width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em;" %>
                </div>
                <div style="flex: 1; min-width: 120px;">
                  <label style="display: block; font-size: 0.78em; font-weight: bold; color: #64748b; margin-bottom: 4px;">Monto ($ USD)</label>
                  <%= number_field_tag :price, nil, step: :any, min: 0, placeholder: "0.00", required: true, style: "width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em;" %>
                </div>
                <div style="flex: 1; min-width: 130px;">
                  <label style="display: block; font-size: 0.78em; font-weight: bold; color: #64748b; margin-bottom: 4px;">¿Ajustar Horario?</label>
                  <%= select_tag :hours, options_for_select([["No modificar tiempo", 0], ["1 Hora de evento", 1], ["2 Horas de evento", 2], ["3 Horas de evento", 3]]), style: "width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; background: white;" %>
                </div>
                <div>
                  <%= f.submit "➕ Registrar Adicional", id: "custom-upsell-submit", style: "background: #1e293b; color: white; border: none; padding: 9px 18px; border-radius: 8px; font-weight: 700; font-size: 0.85em; cursor: pointer; transition: 0.2s;" %>
                </div>
              </div>
            <% end %>
          </details>
        </div>
      <% end %>

      <%= form_with model: @gig, local: true do |f| %>
        <div id="upsells-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 20px;">
          <% 
            standard_catalog = (@gig.company || current_company).standard_upsells.all_with_defaults
            custom_map = @gig.custom_upsells || {}
          %>
          <% standard_catalog.each do |std| %>
            <% 
              key = std.key.to_s
              custom_data = custom_map[key] || custom_map[std.id.to_s] || {}
              is_active = std.active? && custom_data['disabled'] != '1' && custom_data['disabled'] != true
              custom_emoji = custom_data['emoji'].presence || std.emoji || '🚀'
            %>
            <div class="upsell-card-container" style="background: <%= is_active ? '#ffffff' : '#f1f5f9' %>; border: 1px solid <%= is_active ? '#cbd5e1' : '#e2e8f0' %>; border-radius: 14px; padding: 15px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #1e293b; font-size: 0.9em;">
                  <span style="font-size: 1.2em;"><%= custom_emoji %></span>
                  <span><%= std.title %></span>
                </div>
                <div>
                  <%= hidden_field_tag "gig[custom_upsells][#{key}][disabled]", "1" %>
                  <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.82em; font-weight: bold; color: <%= is_active ? '#15803d' : '#64748b' %>; cursor: pointer;">
                    <%= check_box_tag "gig[custom_upsells][#{key}][disabled]", "0", is_active %>
                    Activo <%= company_term(:in_this_gig, (venue_mode? ? 'en este evento' : 'en este toque')) %>
                  </label>
                </div>
              </div>
              
              <div>
                <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Nombre (Personalizado para este <%= venue_mode? ? 'evento' : 'show' %>)</label>
                <%= text_field_tag "gig[custom_upsells][#{key}][title]", custom_data['title'], placeholder: "Estándar: #{std.title}", style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; outline: none; background: white;" %>
              </div>

              <div style="display: flex; gap: 10px;">
                <div style="flex: 1;">
                  <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Precio Adicional</label>
                  <%= number_field_tag "gig[custom_upsells][#{key}][price]", custom_data['price'], step: :any, placeholder: "Estándar: $#{std.price.to_f}", style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; outline: none; background: white;" %>
                </div>
                <div style="width: 80px;">
                  <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Moneda</label>
                  <%= text_field_tag "gig[custom_upsells][#{key}][currency]", custom_data['currency'] || std.currency || 'USD', style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; outline: none; background: white; text-transform: uppercase;" %>
                </div>
              </div>

              <div>
                <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Descripción (Personalizada para este <%= venue_mode? ? 'evento' : 'show' %>)</label>
                <%= text_area_tag "gig[custom_upsells][#{key}][description]", custom_data['description'], rows: 2, placeholder: "Dejar vacío para usar la descripción estándar...", style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85em; outline: none; background: white; resize: vertical;" %>
              </div>

              <% if key.include?('smoke') || std.title.to_s.downcase.include?('humo') %>
                <div style="padding: 8px 12px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; font-size: 0.78em; color: #92400e; line-height: 1.4; display: flex; align-items: center; gap: 6px;">
                  <span>💨</span>
                  <span><strong>Recordatorio de Uso:</strong> La máquina de humo no se debe usar en lugares muy al aire libre porque el viento dispersa el humo y no se aprecia el efecto de luces.</span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div style="text-align: right;">
          <%= f.submit "Guardar Cambios de Adicionales", style: "background: #4f46e5; color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; cursor: pointer; font-size: 0.9em; box-shadow: 0 4px 6px rgba(79, 70, 229, 0.15); transition: 0.2s;" %>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    function toggleUpsellsPanel() {
      const content = document.getElementById('upsells-collapsible-content');
      const text = document.getElementById('upsells-toggle-text');
      const icon = document.getElementById('upsells-toggle-icon');

      if (content.style.display === 'none' || !content.style.display) {
        content.style.display = 'block';
        text.textContent = 'Plegar';
        icon.style.transform = 'rotate(180deg)';
      } else {
        content.style.display = 'none';
        text.textContent = 'Desplegar';
        icon.style.transform = 'rotate(0deg)';
      }
    }
  </script>
<% end %>
