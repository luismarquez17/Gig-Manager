<%# --- ASIGNACIÓN DE TRABAJADORES Y PROVEEDORES (LÍDERES) --- %>
<% if current_user.leader? %>
  <div style="background: white; padding: 25px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px;">
    <h3 style="margin: 0 0 15px 0; color: #1e293b; font-size: 1.1em; display: flex; align-items: center; justify-content: space-between;">
      <span>👷 <%= company_term(:assigned_workers_title, (venue_mode? ? 'Trabajadores y Proveedores asignados' : 'Trabajadores asignados')) %></span>
      <span style="font-size: 0.85em; color: #64748b; font-weight: 600;">Total acordado: $<%= number_with_precision(@gig.staff_assignments.sum(:agreed_amount), precision: 2) %></span>
    </h3>

    <%= form_with url: assign_staff_gig_path(@gig), method: :post, local: true, id: "assign-staff-form", style: "background: #f8fafc; padding: 16px; border-radius: 14px; border: 1px solid #e2e8f0; margin-bottom: 12px;" do |f| %>
      
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
        <label style="font-size: 0.85em; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: 0.5px;">
          <%= company_term(:assign_worker_label, (venue_mode? ? 'Asignar Personal o Proveedor a este Evento' : 'Asignar Personal o Músico a este Show')) %>
        </label>
        <button type="button" onclick="toggleQuickEventualWorker()" id="toggle-eventual-btn" style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.78rem; font-weight: 800; padding: 3px 10px; border-radius: 8px; cursor: pointer;">
          ⚡ Crear Nuevo Trabajador Eventual Rápido
        </button>
      </div>

      <%# Opción 1: Seleccionar Personal Existente %>
      <div id="assign-existing-worker-box" style="display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 1.3; min-width: 240px;">
          <label style="display: block; font-size: 0.82em; font-weight: 700; color: #64748b; margin-bottom: 4px;">Seleccionar integrante:</label>
          <%= f.select :staff_id, current_company.users.workers.order(:is_eventual, :name, :email).map { |w| [w.eventual? ? "⚡ #{w.display_name} (Eventual - #{w.role.to_s.capitalize})" : "#{w.display_name} (#{w.role.to_s.capitalize})", w.id] }, { prompt: company_term(:assign_worker_prompt, (venue_mode? ? "-- Seleccionar trabajador o proveedor --" : "-- Seleccionar personal --")) }, id: "gig-staff-select-input", style: "width: 100%; padding: 9px 12px; border-radius: 8px; border: 1.5px solid #cbd5e1; outline: none; background: white;" %>
        </div>
        <div style="flex: 1; min-width: 180px;">
          <label style="display: block; font-size: 0.82em; font-weight: 700; color: #64748b; margin-bottom: 4px;"><%= company_term(:assign_worker_help, 'Pago acordado ($ USD):') %></label>
          <%= f.text_field :agreed_amount, id: "gig-staff-agreed-amount-input", inputmode: 'decimal', placeholder: '0.00', style: "width: 100%; padding: 9px 12px; border-radius: 8px; border: 1.5px solid #cbd5e1; outline: none; background: white;" %>
        </div>
        <div>
          <%= f.submit company_term(:assign_worker_btn, (venue_mode? ? "➕ Asignar al Evento" : "➕ Asignar al Show")), style: "background: #2563eb; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 800; cursor: pointer; font-size: 0.88rem; box-shadow: 0 2px 8px rgba(37,99,235,0.25);" %>
        </div>
      </div>

      <%# Opción 2: Crear Trabajador Eventual en 1 paso %>
      <div id="assign-new-eventual-box" style="display: none; background: #fffbeb; border: 1.5px solid #fde68a; border-radius: 12px; padding: 14px; margin-top: 10px;">
        <div style="font-size: 0.82rem; font-weight: 800; color: #92400e; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
          <span>⚡</span> Crear y Asignar Trabajador Eventual (Sin pedirle correo)
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; align-items: flex-end;">
          <div>
            <label style="display: block; font-size: 0.8em; font-weight: 700; color: #78350f; margin-bottom: 3px;">Nombre / Apodo *</label>
            <input type="text" name="new_eventual_worker_name" id="new_eventual_worker_name" disabled placeholder="Ej: Pedro Mesonero / DJ Carlos" style="width: 100%; padding: 8px 10px; border-radius: 7px; border: 1.5px solid #cbd5e1; font-size: 0.88rem; background: white;">
          </div>
          <div>
            <label style="display: block; font-size: 0.8em; font-weight: 700; color: #78350f; margin-bottom: 3px;">Rol / Función</label>
            <select name="new_eventual_worker_role" id="new_eventual_worker_role" disabled style="width: 100%; padding: 8px 10px; border-radius: 7px; border: 1.5px solid #cbd5e1; font-size: 0.88rem; background: white;">
              <option value="staff">Staff (Técnico / Salón)</option>
              <option value="musician">Músico / Artista</option>
            </select>
          </div>
          <div>
            <label style="display: block; font-size: 0.8em; font-weight: 700; color: #78350f; margin-bottom: 3px;">Teléfono WhatsApp (Opcional)</label>
            <input type="tel" name="new_eventual_worker_phone" id="new_eventual_worker_phone" disabled placeholder="Ej: 04121234567" style="width: 100%; padding: 8px 10px; border-radius: 7px; border: 1.5px solid #cbd5e1; font-size: 0.88rem; background: white;">
          </div>
          <div>
            <label style="display: block; font-size: 0.8em; font-weight: 700; color: #78350f; margin-bottom: 3px;">Pago Acordado ($ USD) *</label>
            <input type="text" name="eventual_agreed_amount" id="eventual_agreed_amount" disabled inputmode="decimal" placeholder="0.00" style="width: 100%; padding: 8px 10px; border-radius: 7px; border: 1.5px solid #cbd5e1; font-size: 0.88rem; background: white;">
          </div>
          <div>
            <button type="submit" style="width: 100%; background: linear-gradient(135deg, #d97706 0%, #b45309 100%); color: white; border: none; padding: 9px 14px; border-radius: 7px; font-weight: 800; cursor: pointer; font-size: 0.88rem; box-shadow: 0 2px 8px rgba(180,83,9,0.25);">
              ⚡ Crear y Asignar
            </button>
          </div>
        </div>
      </div>

    <% end %>

    <script>
      function toggleQuickEventualWorker() {
        const existingBox = document.getElementById('assign-existing-worker-box');
        const eventualBox = document.getElementById('assign-new-eventual-box');
        const toggleBtn = document.getElementById('toggle-eventual-btn');
        const selectStaff = document.getElementById('gig-staff-select-input');
        const existingAgreed = document.getElementById('gig-staff-agreed-amount-input');
        const newNameInput = document.getElementById('new_eventual_worker_name');
        const newRoleInput = document.getElementById('new_eventual_worker_role');
        const newPhoneInput = document.getElementById('new_eventual_worker_phone');
        const eventualAgreed = document.getElementById('eventual_agreed_amount');

        if (eventualBox.style.display === 'none') {
          eventualBox.style.display = 'block';
          existingBox.style.display = 'none';
          toggleBtn.textContent = '👤 Elegir Integrante Existente';
          toggleBtn.style.background = '#e0f2fe';
          toggleBtn.style.color = '#0369a1';
          toggleBtn.style.borderColor = '#bae6fd';
          if (selectStaff) { selectStaff.value = ''; selectStaff.disabled = true; }
          if (existingAgreed) { existingAgreed.disabled = true; }
          if (newNameInput) { newNameInput.disabled = false; newNameInput.focus(); }
          if (newRoleInput) { newRoleInput.disabled = false; }
          if (newPhoneInput) { newPhoneInput.disabled = false; }
          if (eventualAgreed) { eventualAgreed.disabled = false; }
        } else {
          eventualBox.style.display = 'none';
          existingBox.style.display = 'flex';
          toggleBtn.textContent = '⚡ Crear Nuevo Trabajador Eventual Rápido';
          toggleBtn.style.background = '#fef3c7';
          toggleBtn.style.color = '#92400e';
          toggleBtn.style.borderColor = '#fde68a';
          if (selectStaff) { selectStaff.disabled = false; }
          if (existingAgreed) { existingAgreed.disabled = false; }
          if (newNameInput) { newNameInput.value = ''; newNameInput.disabled = true; }
          if (newRoleInput) { newRoleInput.disabled = true; }
          if (newPhoneInput) { newPhoneInput.disabled = true; }
          if (eventualAgreed) { eventualAgreed.value = ''; eventualAgreed.disabled = true; }
        }
      }
    </script>

    <div style="margin-bottom: 20px; font-size: 0.82rem; color: #64748b; padding-left: 4px;">
      💡 <%= company_term(:assign_worker_tip, (venue_mode? ? '¿Deseas gestionar todos tus trabajadores y proveedores?' : '¿Deseas gestionar tu equipo y roles?')) %> <%= link_to "Ir a Gestión de Usuarios y Personal →", users_path, style: "color: #2563eb; font-weight: 700; text-decoration: underline;" %>
    </div>

    <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px;">
      <% @gig.staff_assignments.includes(:user).each do |sa| %>
        <% staff = sa.user %>
        <% paid = sa.total_paid %>
        <% agreed = sa.agreed_amount.to_f %>
        <% balance = sa.balance %>
        <div style="background: <%= staff.eventual? ? '#fffbeb' : '#f8fafc' %>; padding: 12px 16px; border-radius: 12px; border: 1.5px solid <%= staff.eventual? ? '#fde68a' : '#e2e8f0' %>; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.25em;"><%= staff.eventual? ? '⚡' : '👤' %></span>
            <div>
              <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                <%= link_to staff.display_name, user_path(staff), style: "color: #0f172a; font-weight: 800; text-decoration: none; font-size: 0.95rem;" %>
                <% if staff.eventual? %>
                  <span style="font-size: 0.7rem; font-weight: 800; padding: 1px 6px; border-radius: 4px; background: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                    ⚡ Eventual
                  </span>
                <% end %>
                <% if staff.specialty.present? %>
                  <span style="font-size: 0.72rem; font-weight: 600; color: #64748b; background: rgba(0,0,0,0.04); padding: 1px 6px; border-radius: 4px;">
                    <%= staff.specialty %>
                  </span>
                <% end %>
              </div>
              
              <div style="font-size: 0.78em; color: #64748b; margin-top: 1px;">
                <% if staff.eventual? %>
                  <span style="color: #92400e; font-weight: 600;">Sin cuenta</span>
                  <% if staff.phone.present? %>
                    • <span style="color: #059669; font-weight: 700;">📱 <%= staff.phone %></span>
                  <% end %>
                <% else %>
                  <%= staff.email %>
                  <% if staff.phone.present? %>
                    • <span style="color: #059669; font-weight: 700;">📱 <%= staff.phone %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 16px; font-size: 0.88em; flex-wrap: wrap;">
            <div>
              <span style="color: #64748b; font-weight: 600;">Acordado:</span>
              <strong style="color: #1e293b;">$ <%= number_with_precision(agreed, precision: 2) %></strong>
              <% if current_user.leader? %>
                <button type="button" onclick="openEditStaffPayModal('<%= sa.id %>', '<%= staff.display_name.to_s.gsub("'", "\\\\'") %>', '<%= number_with_precision(agreed, precision: 2) %>')" style="background: none; border: none; cursor: pointer; color: #2563eb; font-size: 0.9em; padding: 0 4px;" title="Editar pago acordado">
                  ✏️
                </button>
              <% end %>
            </div>

            <div>
              <span style="color: #64748b; font-weight: 600;">Pagado:</span>
              <strong style="color: #059669;">$ <%= number_with_precision(paid, precision: 2) %></strong>
            </div>

            <div>
              <span style="color: #64748b; font-weight: 600;">Estado:</span>
              <% is_future_gig = @gig.has_not_occurred? %>
              <% if balance > 0 %>
                <% if is_future_gig %>
                  <% if paid > 0 %>
                    <strong style="color: #1d4ed8; background: #eff6ff; padding: 4px 10px; border-radius: 8px; border: 1px solid #bfdbfe;">
                      📅 Anticipo abonado (Próximo <%= venue_mode? ? 'Evento' : 'Show' %> • Resta: $ <%= number_with_precision(balance, precision: 2) %> al celebrarse)
                    </strong>
                  <% else %>
                    <strong style="color: #475569; background: #f1f5f9; padding: 4px 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
                      📅 Próximo <%= venue_mode? ? 'Evento' : 'Show' %> ($ <%= number_with_precision(agreed, precision: 2) %> al celebrarse)
                    </strong>
                  <% end %>
                <% else %>
                  <strong style="color: #dc2626; background: #fef2f2; padding: 4px 10px; border-radius: 8px; border: 1px solid #fecaca;">
                    ⏳ Pendiente: $ <%= number_with_precision(balance, precision: 2) %>
                  </strong>
                <% end %>
              <% elsif balance < 0 %>
                <strong style="color: #b45309; background: #fffbe6; padding: 4px 10px; border-radius: 8px; border: 1px solid #fef08a;">
                  ⚠️ Le debe a la empresa: $ <%= number_with_precision(balance.abs, precision: 2) %> (Vuelto)
                </strong>
              <% else %>
                <% if agreed > 0 && paid >= agreed %>
                  <% if is_future_gig %>
                    <strong style="color: #059669; background: #ecfdf5; padding: 4px 10px; border-radius: 8px; border: 1px solid #a7f3d0;">
                      ✅ Pagado por adelantado
                    </strong>
                  <% else %>
                    <strong style="color: #059669; background: #ecfdf5; padding: 4px 10px; border-radius: 8px; border: 1px solid #a7f3d0;">
                      ✅ Pagado completo
                    </strong>
                  <% end %>
                <% else %>
                  <strong style="color: #64748b; background: #f1f5f9; padding: 4px 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
                    ℹ️ Sin pago acordado ($0.00)
                  </strong>
                <% end %>
              <% end %>
            </div>

            <div style="display: flex; align-items: center; gap: 6px;">
              <%= link_to (is_future_gig ? '💳 Registrar Anticipo' : '💳 Registrar Pago'), new_employee_payment_path(gig_id: @gig.id, user_id: staff.id), style: 'background: #2563eb; color: white; padding: 6px 12px; border-radius: 8px; font-size: 0.82em; font-weight: bold; text-decoration: none;' %>
              <%= button_to '❌ Desasignar', remove_staff_gig_path(@gig, staff_id: staff.id), method: :delete, data: { confirm: '¿Seguro que deseas desasignar a este personal?' }, style: 'background: #f1f5f9; color: #ef4444; border: 1px solid #cbd5e1; padding: 5px 10px; border-radius: 6px; font-size: 0.8em; font-weight: bold; cursor: pointer;' %>
            </div>
          </div>
        </div>
      <% end %>

      <% if @gig.staff_assignments.empty? %>
        <p style="margin: 0; color: #94a3b8; font-size: 0.9em; font-style: italic;">No hay personal asignado a este <%= venue_mode? ? 'evento' : 'show' %>.</p>
      <% end %>
    </div>
  </div>
<% end %>

<%# --- SECCIÓN PARA TRABAJADORES ASIGNADOS (Músicos y Staff): SU PAGO Y BOTÓN DE REPORTAR --- %>
<% if (current_user.musician? || current_user.staff?) %>
  <% my_assignment = @gig.staff_assignments.find_by(user_id: current_user.id) %>
  <% if my_assignment.present? %>
    <%
      my_agreed = my_assignment.agreed_amount.to_f
      my_paid = my_assignment.total_paid
      my_pending = my_assignment.pending_balance
      my_pending_report = current_user.employee_payments.pending_approval.where(gig_id: @gig.id).first
    %>
    <div style="background: white; padding: 25px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 16px;">
        <div>
          <h3 style="margin: 0; color: #0f172a; font-size: 1.2em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
            <span>💵</span> Tu Pago por este <%= venue_mode? ? 'Evento' : 'Show' %>
          </h3>
          <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.9em;">
            Honorarios y registro de pagos para tu cuenta en este evento.
          </p>
        </div>

        <%= link_to new_worker_report_employee_payments_path(gig_id: @gig.id), class: "btn-main btn-success-custom", style: "padding: 10px 18px; font-weight: 800; font-size: 0.88em; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); display: inline-flex; align-items: center; gap: 6px;" do %>
          <span>➕</span> Reportar Pago Recibido
        <% end %>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 14px;">
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px;">
          <div style="font-size: 0.75em; color: #64748b; font-weight: 700; text-transform: uppercase;">Acordado</div>
          <div style="font-size: 1.4em; font-weight: 900; color: #1e293b; margin-top: 2px;">$ <%= number_with_precision(my_agreed, precision: 2) %></div>
        </div>
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 14px;">
          <div style="font-size: 0.75em; color: #15803d; font-weight: 700; text-transform: uppercase;">Cobrado Confirmado</div>
          <div style="font-size: 1.4em; font-weight: 900; color: #16a34a; margin-top: 2px;">$ <%= number_with_precision(my_paid, precision: 2) %></div>
        </div>
        <% is_future_gig = @gig.has_not_occurred? %>
        <div style="background: <%= my_pending > 0 ? (is_future_gig ? '#f8fafc' : '#fffbeb') : '#f0fdf4' %>; border: 1px solid <%= my_pending > 0 ? (is_future_gig ? '#cbd5e1' : '#fde68a') : '#bbf7d0' %>; border-radius: 12px; padding: 14px;">
          <div style="font-size: 0.75em; color: <%= my_pending > 0 ? (is_future_gig ? '#475569' : '#b45309') : '#15803d' %>; font-weight: 700; text-transform: uppercase;">
            <%= my_pending > 0 ? (is_future_gig ? "📅 Próximo #{venue_mode? ? 'Evento' : 'Show'} (Por cobrar al celebrarse)" : 'Pendiente') : 'Al Día' %>
          </div>
          <div style="font-size: 1.4em; font-weight: 900; color: <%= my_pending > 0 ? (is_future_gig ? '#1e293b' : '#d97706') : '#16a34a' %>; margin-top: 2px;">$ <%= number_with_precision(my_pending > 0 ? my_pending : 0, precision: 2) %></div>
        </div>
      </div>

      <% if my_pending_report.present? %>
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
          <div>
            <div style="font-weight: 700; color: #92400e; font-size: 0.9em;">
              ⏳ Tienes un reporte de pago por <strong><%= number_to_currency(my_pending_report.amount, unit: my_pending_report.currency) %></strong> enviado al líder
            </div>
            <div style="font-size: 0.8em; color: #b45309; margin-top: 2px;">
              Fecha: <%= my_pending_report.date_paid&.strftime("%d/%m/%Y") %> • Método: <%= my_pending_report.payment_method %>
              <% if my_pending_report.notes.present? %> • "<%= my_pending_report.notes %>"<% end %>
            </div>
          </div>
          <span style="background: white; border: 1px solid #fde68a; color: #92400e; font-size: 0.75em; font-weight: 800; padding: 4px 10px; border-radius: 99px;">
            En revisión
          </span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
