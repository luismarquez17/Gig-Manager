<%# --- BANNER DE COMPROBANTES DE PAGO REPORTADOS POR EL CLIENTE --- %>
<% if current_user.leader? %>
  <% pending_vouchers = @gig.gig_payments.pending_approval.order(created_at: :desc) %>
  <% if pending_vouchers.any? %>
    <div style="background: linear-gradient(135deg, #fefce8 0%, #fef3c7 100%); border: 2px solid #f59e0b; border-radius: 20px; padding: 22px 26px; margin-bottom: 30px; box-shadow: 0 8px 24px rgba(245, 158, 11, 0.15);">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.6em; background: #d97706; color: white; width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(217, 119, 6, 0.3);">💳</span>
          <div>
            <h3 style="margin: 0; color: #78350f; font-size: 1.2em; font-weight: 800;">
              ¡Comprobante de Abono Recibido del Cliente! (<%= pending_vouchers.count %> pendiente<%= 's' if pending_vouchers.count > 1 %>)
            </h3>
            <p style="margin: 2px 0 0 0; color: #92400e; font-size: 0.88em; font-weight: 600;">
              El cliente ha enviado una foto/captura de su transferencia. Revisa el comprobante y confirma el abono:
            </p>
          </div>
        </div>
        <span style="background: #d97706; color: white; padding: 5px 14px; border-radius: 99px; font-weight: 800; font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.5px;">
          Revisión Inmediata
        </span>
      </div>

      <div style="display: grid; gap: 14px;">
        <% pending_vouchers.each do |p| %>
          <div style="background: white; border: 1px solid #fde68a; border-radius: 16px; padding: 18px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);">
            <div style="display: flex; align-items: center; gap: 16px; min-width: 280px;">
              <% if p.voucher_attached? %>
                <a href="<%= p.voucher_url_or_data %>" target="_blank" title="Hacer clic para ver foto en tamaño completo" style="display: block; width: 68px; height: 68px; border-radius: 10px; overflow: hidden; border: 2px solid #f59e0b; flex-shrink: 0; position: relative; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                  <img src="<%= p.voucher_url_or_data %>" alt="Comprobante" style="width: 100%; height: 100%; object-fit: cover;">
                  <div style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.6); color: white; font-size: 9px; text-align: center; font-weight: 800; padding: 1px 0;">VER 🔍</div>
                </a>
              <% else %>
                <div style="width: 68px; height: 68px; border-radius: 10px; background: #fef3c7; display: flex; align-items: center; justify-content: center; font-size: 2em; border: 2px dashed #f59e0b; flex-shrink: 0;">
                  📄
                </div>
              <% end %>
              
              <div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="display: inline-flex; align-items: center; gap: 4px; background: <%= p.payment_method_badge_bg %>; color: <%= p.payment_method_badge_color %>; padding: 2px 8px; border-radius: 6px; font-size: 0.78em; font-weight: 800;">
                    <%= p.payment_method_emoji %> <%= p.payment_method_label %>
                  </span>
                  <span style="font-size: 0.82em; color: #64748b; font-weight: 600;">Fecha: <%= p.date_paid&.strftime('%d/%m/%Y') %></span>
                </div>

                <div style="font-size: 1.25em; font-weight: 900; color: #0f172a; margin: 4px 0 2px 0;">
                  $ <%= number_with_precision(p.amount, precision: 2) %> <span style="font-size: 0.65em; color: #64748b;"><%= p.currency %></span>
                </div>

                <div style="font-size: 0.85em; color: #475569;">
                  <% if p.reference_number.present? %>
                    <strong>Ref:</strong> <%= p.reference_number %> · 
                  <% end %>
                  <span>Pagado por: <strong><%= p.payer_name %></strong></span>
                  <% if p.notes.present? %>
                    · <em>"<%= p.notes %>"</em>
                  <% end %>
                </div>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <%= button_to approve_gig_payment_path(p), method: :post, data: { turbo_confirm: "¿Confirmar la recepción de este abono de $#{number_with_precision(p.amount, precision: 2)}? Se generará el recibo oficial y se sumará a caja." }, style: "background: #16a34a; color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 800; font-size: 0.9em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 10px rgba(22, 163, 74, 0.25);" do %>
                <span>✅</span> Aprobar Abono
              <% end %>

              <%= button_to reject_gig_payment_path(p), method: :post, data: { turbo_confirm: "¿Deseas rechazar este comprobante?" }, style: "background: #fff1f2; color: #dc2626; border: 1px solid #fecaca; padding: 10px 16px; border-radius: 10px; font-weight: 800; font-size: 0.9em; cursor: pointer;" do %>
                <span>✕</span> Rechazar
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<%# --- BANNER DE SOLICITUDES DE ADICIONALES (UPSELLS) DEL CLIENTE --- %>
<% if current_user.leader? %>
  <% pending_upsell_requests = @gig.gig_upsell_requests.pending.order(created_at: :desc) %>
  <% if pending_upsell_requests.any? %>
    <div style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 2px solid #3b82f6; border-radius: 20px; padding: 22px 26px; margin-bottom: 30px; box-shadow: 0 8px 24px rgba(59, 130, 246, 0.12);">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.6em; background: #2563eb; color: white; width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);">🚀</span>
          <div>
            <h3 style="margin: 0; color: #1e3a8a; font-size: 1.2em; font-weight: 800;">
              ¡Solicitud de Adicional del Cliente! (<%= pending_upsell_requests.count %> pendiente<%= 's' if pending_upsell_requests.count > 1 %>)
            </h3>
            <p style="margin: 2px 0 0 0; color: #2563eb; font-size: 0.88em; font-weight: 600;">
              El cliente <%= @gig.client&.name || "del evento" %> solicitó añadir servicios adicionales desde su portal. Puedes aceptarlo o rechazarlo con un solo clic:
            </p>
          </div>
        </div>
        <span style="background: #2563eb; color: white; padding: 5px 14px; border-radius: 99px; font-weight: 800; font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.5px;">
          Decisión en 1 Clic
        </span>
      </div>

      <div style="display: grid; gap: 12px;">
        <% pending_upsell_requests.each do |req| %>
          <div style="background: white; border: 1px solid #bfdbfe; border-radius: 16px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);">
            <div style="display: flex; align-items: center; gap: 14px; min-width: 240px;">
              <span style="font-size: 2.2em; line-height: 1;"><%= req.emoji.presence || '🚀' %></span>
              <div>
                <h4 style="margin: 0 0 2px 0; color: #0f172a; font-size: 1.1em; font-weight: 800;">
                  <%= req.title %>
                </h4>
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85em; color: #64748b;">
                  <span>Solicitado: <strong><%= req.requested_at&.strftime("%d/%m/%Y %I:%M %p") || req.created_at.strftime("%d/%m/%Y %I:%M %p") %></strong></span>
                  <% if req.notes.present? %>
                    <span>• "<%= req.notes %>"</span>
                  <% end %>
                </div>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
              <div style="text-align: right;">
                <span style="display: block; font-size: 0.75em; color: #64748b; font-weight: 700; text-transform: uppercase;">Monto a Sumar</span>
                <span style="font-size: 1.35em; font-weight: 900; color: #059669; font-family: 'Inter', sans-serif;">
                  + $<%= number_with_precision(req.price, precision: 2) %> <span style="font-size: 0.65em; color: #64748b;"><%= req.currency %></span>
                </span>
              </div>

              <div style="display: flex; gap: 8px; align-items: center;">
                <%= button_to approve_gig_upsell_request_path(req), method: :post, style: "background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; padding: 10px 18px; border-radius: 12px; font-weight: 800; font-size: 0.9em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3); transition: transform 0.15s;", data: { turbo_confirm: "¿Añadir '#{req.title}' (+ $#{number_with_precision(req.price, precision: 2)} #{req.currency}) a este evento?\n\nEl monto acordado del #{venue_mode? ? 'evento' : 'show'} se incrementará automáticamente." } do %>
                  <span>✅ <%= venue_mode? ? 'Añadir al Evento' : 'Añadir al Show' %></span>
                <% end %>

                <%= button_to reject_gig_upsell_request_path(req), method: :post, style: "background: #f8fafc; color: #dc2626; border: 1px solid #cbd5e1; padding: 10px 18px; border-radius: 12px; font-weight: 800; font-size: 0.9em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: background 0.15s;", data: { turbo_confirm: "¿Rechazar esta solicitud de adicional (ej. por no tener disponibilidad de equipos)?\n\nEl presupuesto del #{venue_mode? ? 'evento' : 'show'} permanecerá sin cambios." } do %>
                  <span>❌ No añadir</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<% if current_user.leader? %>
  <%# --- PORTAL DEL CLIENTE Y FIRMA DIGITAL --- %>
  <div style="background: white; padding: 25px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px;">
    
    <div>
      <h3 style="margin: 0 0 10px 0; color: #1e293b; font-size: 1.1em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
        🔗 Portal Público del Cliente
      </h3>
      <p style="margin: 0 0 15px 0; color: #64748b; font-size: 0.9em; line-height: 1.4;">
        Comparte este enlace con tu cliente para que consulte su cuenta regresiva, estado de pagos y cronograma, o inicie sesión directamente para tener el control total de su evento.
      </p>
      
      <%
        portal_url = public_portal_url(token: @gig.portal_token)
      %>
      <div style="display: flex; gap: 10px; align-items: center; background: #f8fafc; padding: 10px 14px; border-radius: 12px; border: 1px solid #cbd5e1; margin-bottom: 15px;">
        <span style="font-size: 0.85em; color: #475569; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-grow: 1;" id="portal-url-text"><%= portal_url %></span>
        <button onclick="copyPortalLink()" style="background: #e0f2fe; color: #0369a1; border: none; padding: 8px 12px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.85em; white-space: nowrap;">
          📋 Copiar
        </button>
      </div>

      <%
        # Mensaje predefinido para WhatsApp
        feat_items = ["los detalles contratados"]
        feat_items << "el estado de tus abonos" if @gig.company&.module_enabled?(:finances)
        feat_items << "el cronograma del día" if @gig.company&.module_enabled?(:gigs)
        wa_msg = "¡Hola #{@gig.client&.name}! Te comparto el link de tu Portal de Cliente para tu evento del #{@gig.date&.strftime('%d/%m/%Y')}. Podrás ver #{feat_items.to_sentence} e iniciar sesión directamente para controlar todas las opciones de tu evento: #{portal_url}"
        
        # Si tenemos el teléfono formateado del cliente, generamos el link directo, de lo contrario a WhatsApp Web general
        wa_share_url = @gig.client&.formatted_phone_for_whatsapp.present? ? "https://wa.me/#{@gig.client.formatted_phone_for_whatsapp}?text=#{ERB::Util.url_encode(wa_msg)}" : "https://web.whatsapp.com/send?text=#{ERB::Util.url_encode(wa_msg)}"
      %>
      <a href="<%= wa_share_url %>" target="_blank" style="background: #25d366; color: white; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 12px; font-weight: bold; text-decoration: none; font-size: 0.9em; box-shadow: 0 4px 6px rgba(37, 211, 102, 0.15); transition: 0.2s;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 2px;">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        Enviar por WhatsApp
      </a>
      <%= link_to portal_url, target: "_blank", style: "background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; padding: 10px 18px; border-radius: 12px; font-weight: bold; text-decoration: none; font-size: 0.9em; box-shadow: 0 4px 6px rgba(22, 101, 52, 0.08); display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: 0.2s;" do %>
        🌐 Ver Portal
      <% end %>
      <button type="button" onclick="openFlashcardModal('flashcard-modal-<%= @gig.id %>')" style="background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; padding: 10px 18px; border-radius: 12px; font-weight: bold; font-size: 0.9em; box-shadow: 0 4px 6px rgba(67, 56, 202, 0.08); display: inline-flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; transition: 0.2s;">
        <%= company_term(:event_sheet, (venue_mode? ? '📸 Ficha del Evento' : '📸 Ficha de Show')) %>
      </button>
      <%= link_to print_contract_gig_path(@gig), target: "_blank", style: "background: #f1f5f9; color: #475569; padding: 10px 18px; border-radius: 12px; font-weight: bold; text-decoration: none; font-size: 0.9em; box-shadow: 0 4px 6px rgba(0,0,0,0.05); display: inline-flex; align-items: center; justify-content: center; transition: 0.2s;" do %>
        🖨️ Imprimir Físico
      <% end %>
    </div>

    <div style="border-left: 1px dashed #e2e8f0; padding-left: 25px;">
      <h3 style="margin: 0 0 10px 0; color: #1e293b; font-size: 1.1em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
        ✍️ Estado del Contrato
      </h3>
      <p style="margin: 0 0 15px 0; color: #64748b; font-size: 0.9em; line-height: 1.4;">
        El cliente puede firmar digitalmente el acuerdo directamente desde su portal público de cliente.
      </p>

      <% if @gig.contract_signed? %>
        <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 15px; border-radius: 14px; font-size: 0.9em;">
          <p style="margin: 0 0 5px 0; font-weight: 800; display: flex; align-items: center; gap: 6px;">
            ✓ Firmado Digitalmente
          </p>
          <div style="color: #047857; font-size: 0.9em; line-height: 1.5;">
            <strong>Firmante:</strong> <%= @gig.contract_signed_name %><br>
            <strong>Fecha/Hora:</strong> <%= @gig.contract_signed_at&.strftime("%d/%m/%Y %I:%M %p") %><br>
            <strong>IP:</strong> <%= @gig.contract_signed_ip %>
          </div>
        </div>
      <% else %>
        <div style="background: #fffbeb; border: 1px solid #fef3c7; color: #78350f; padding: 15px; border-radius: 14px; font-size: 0.95em; font-weight: 700; display: inline-flex; align-items: center; gap: 8px;">
          ⚠️ Pendiente de Firma por el Cliente
        </div>
      <% end %>
    </div>

  </div>

  <script>
    function copyPortalLink() {
      const text = document.getElementById('portal-url-text').textContent;
      navigator.clipboard.writeText(text).then(() => {
        alert("Enlace copiado al portapapeles con éxito.");
      }).catch(err => {
        console.error('Error al copiar el enlace: ', err);
      });
    }
  </script>
<% end %>
