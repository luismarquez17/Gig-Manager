          <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
              <tr style="background: #f8fafc; font-size: 0.85em; font-weight: 800; color: #475569; text-transform: uppercase;">
                <th style="padding: 12px 18px; border-bottom: 1px solid #e2e8f0;">Hora</th>
                <th style="padding: 12px 18px; border-bottom: 1px solid #e2e8f0;">Título de Actividad</th>
