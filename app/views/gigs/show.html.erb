<div style="max-width: 1200px; margin: 0 auto; font-family: 'Inter', 'Segoe UI', sans-serif;">

  <%# --- HEADER Y ACCIONES BASICAS --- %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <div>
      <div style="display: flex; gap: 15px; align-items: center; margin-bottom: 10px;">
        <%= link_to '⬅ Volver al Historial', gigs_path, style: "color: #64748b; text-decoration: none; font-weight: bold; font-size: 0.9em;" %>
        <% if current_user.leader? %>
          <span style="color: #cbd5e1;">|</span>
          <%= link_to '✏️ Editar Evento', edit_gig_path(@gig), style: "color: #2563eb; text-decoration: none; font-weight: bold; font-size: 0.9em;" %>
        <% end %>
      </div>
      <h1 style="color: #2c3e50; margin: 0; font-weight: 800; font-size: 2em; letter-spacing: -0.5px;">📋 Panel del Evento</h1>
    </div>
    <div style="text-align: right;">
      <% if @gig.client %>
        <%
          priority_color = case @gig.client.priority
                           when 'alta' then '#10b981'
                           when 'media' then '#f59e0b'
                           when 'baja' then '#ef4444'
                           else '#64748b'
                           end
        %>
        <span style="background: <%= priority_color %>; padding: 8px 18px; border-radius: 20px; color: white; font-weight: bold; font-size: 0.85em; box-shadow: 0 4px 6px <%= priority_color %>33;">
          Prioridad: <%= @gig.client.priority.capitalize %>
        </span>
      <% else %>
        <span style="background: #94a3b8; padding: 8px 18px; border-radius: 20px; color: white; font-weight: bold; font-size: 0.85em; box-shadow: 0 4px 6px rgba(148, 163, 184, 0.2);">
          Sin Cliente
        </span>
      <% end %>
    </div>
  </div>

  <%# --- DETALLES PRINCIPALES DEL EVENTO --- %>
  <div style="background: white; padding: 25px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
    
    <div>
      <p style="margin: 0; color: #64748b; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Cliente</p>
      <% if @gig.client %>
        <p style="margin: 5px 0 0 0; font-size: 1.2em; font-weight: bold; color: #1e293b;"><%= link_to @gig.client.name, client_path(@gig.client), style: "color: #0ea5e9; text-decoration: none;" %></p>
        <small style="color: #94a3b8;"><%= @gig.client.phone %></small>
      <% else %>
        <p style="margin: 5px 0 0 0; font-size: 1.2em; font-weight: bold; color: #64748b;">Sin Cliente Registrado</p>
        <small style="color: #94a3b8;"><%= @gig.client_email %></small>
      <% end %>
    </div>

    <div>
      <p style="margin: 0; color: #64748b; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Fecha &amp; Ubicación</p>
      <p style="margin: 5px 0 0 0; font-size: 1.1em; font-weight: bold; color: #1e293b;">📅 <%= @gig.date&.strftime("%d/%m/%Y") || "---" %></p>
      <p style="margin: 2px 0 0 0; color: #475569;">📍 <%= @gig.location.presence || "No especificada" %></p>
      <% if @gig.start_time.present? && @gig.end_time.present? %>
        <p style="margin: 4px 0 0 0; color: #4f46e5; font-size: 0.9em; font-weight: 600;">🕐 <%= @gig.formatted_time_range %></p>
      <% end %>
    </div>

    <% if current_user.leader? %>
      <div style="min-width: 240px;">
        <p style="margin: 0; color: #64748b; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Monto Acordado &amp; Pagos</p>
        <p style="margin: 5px 0 10px 0; font-size: 1.4em; font-weight: bold; color: #10b981;">
          <%= number_with_precision(@gig.amount, precision: 2) %> 
          <span style="font-size: 0.6em; color: #94a3b8; vertical-align: middle;"><%= @gig.currency %></span>
        </p>
        
        <div style="background: #f8fafc; padding: 12px 14px; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 12px;">
          <%= render 'gigs/payment_progress', gig: @gig, size: :normal, show_details: true, show_footer: true %>
        </div>

        <div style="display:flex; gap:8px; flex-wrap: wrap;">
          <%= link_to 'Ver pagos', gig_gig_payments_path(@gig), style: 'background: #eef2ff; color: #3730a3; padding: 8px 14px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.85em;' %>
          <%= link_to '➕ Registrar pago', new_gig_gig_payment_path(@gig), style: 'background: #dcfce7; color: #065f46; padding: 8px 14px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.85em;' %>
        </div>
      </div>
    <% end %>

    <% if @gig.details.present? %>
      <div style="grid-column: 1 / -1; background: #f8fafc; padding: 15px; border-radius: 12px; border-left: 4px solid #3b82f6;">
        <p style="margin: 0; color: #64748b; font-size: 0.85em; font-weight: bold; text-transform: uppercase;">Detalles o Paquete Contratado</p>
        <p style="margin: 5px 0 0 0; color: #334155; line-height: 1.5; font-size: 0.95em;"><%= @gig.details %></p>
      </div>
    <% end %>

  </div>

  <%# --- BANNER DE SOLICITUDES DE ADICIONALES (UPSELLS) DEL CLIENTE --- %>
  <% if current_user.leader? %>
    <% pending_upsell_requests = @gig.gig_upsell_requests.pending.order(created_at: :desc) %>
    <% if pending_upsell_requests.any? %>
      <div style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 2px solid #3b82f6; border-radius: 20px; padding: 22px 26px; margin-bottom: 30px; box-shadow: 0 8px 24px rgba(59, 130, 246, 0.12);">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 1.6em; background: #2563eb; color: white; width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);">🚀</span>
            <div>
              <h3 style="margin: 0; color: #1e3a8a; font-size: 1.2em; font-weight: 800;">
                ¡Solicitud de Adicional del Cliente! (<%= pending_upsell_requests.count %> pendiente<%= 's' if pending_upsell_requests.count > 1 %>)
              </h3>
              <p style="margin: 2px 0 0 0; color: #2563eb; font-size: 0.88em; font-weight: 600;">
                El cliente <%= @gig.client&.name || "del evento" %> solicitó añadir servicios adicionales desde su portal. Puedes aceptarlo o rechazarlo con un solo clic:
              </p>
            </div>
          </div>
          <span style="background: #2563eb; color: white; padding: 5px 14px; border-radius: 99px; font-weight: 800; font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.5px;">
            Decisión en 1 Clic
          </span>
        </div>

        <div style="display: grid; gap: 12px;">
          <% pending_upsell_requests.each do |req| %>
            <div style="background: white; border: 1px solid #bfdbfe; border-radius: 16px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);">
              <div style="display: flex; align-items: center; gap: 14px; min-width: 240px;">
                <span style="font-size: 2.2em; line-height: 1;"><%= req.emoji.presence || '🚀' %></span>
                <div>
                  <h4 style="margin: 0 0 2px 0; color: #0f172a; font-size: 1.1em; font-weight: 800;">
                    <%= req.title %>
                  </h4>
                  <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85em; color: #64748b;">
                    <span>Solicitado: <strong><%= req.requested_at&.strftime("%d/%m/%Y %I:%M %p") || req.created_at.strftime("%d/%m/%Y %I:%M %p") %></strong></span>
                    <% if req.notes.present? %>
                      <span>• "<%= req.notes %>"</span>
                    <% end %>
                  </div>
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
                <div style="text-align: right;">
                  <span style="display: block; font-size: 0.75em; color: #64748b; font-weight: 700; text-transform: uppercase;">Monto a Sumar</span>
                  <span style="font-size: 1.35em; font-weight: 900; color: #059669; font-family: 'Inter', sans-serif;">
                    + $<%= number_with_precision(req.price, precision: 2) %> <span style="font-size: 0.65em; color: #64748b;"><%= req.currency %></span>
                  </span>
                </div>

                <div style="display: flex; gap: 8px; align-items: center;">
                  <%= button_to approve_gig_upsell_request_path(req), method: :post, style: "background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; padding: 10px 18px; border-radius: 12px; font-weight: 800; font-size: 0.9em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3); transition: transform 0.15s;", onclick: "return confirm('¿Añadir \\'#{escape_javascript(req.title)}\\' (+ $#{number_with_precision(req.price, precision: 2)} #{req.currency}) a este evento?\\n\\nEl monto acordado del show se incrementará automáticamente.');" do %>
                    <span>✅ Añadir al Show</span>
                  <% end %>

                  <%= button_to reject_gig_upsell_request_path(req), method: :post, style: "background: #f8fafc; color: #dc2626; border: 1px solid #cbd5e1; padding: 10px 18px; border-radius: 12px; font-weight: 800; font-size: 0.9em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: background 0.15s;", onclick: "return confirm('¿Rechazar esta solicitud de adicional (ej. por no tener disponibilidad de equipos)?\\n\\nEl presupuesto del show permanecerá sin cambios.');" do %>
                    <span>❌ No añadir</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if current_user.leader? %>
    <%# --- PORTAL DEL CLIENTE Y FIRMA DIGITAL --- %>
    <div style="background: white; padding: 25px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px;">
      
      <div>
        <h3 style="margin: 0 0 10px 0; color: #1e293b; font-size: 1.1em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
          🔗 Portal Público del Cliente
        </h3>
        <p style="margin: 0 0 15px 0; color: #64748b; font-size: 0.9em; line-height: 1.4;">
          Comparte este enlace seguro con tu cliente para que vea su cuenta regresiva, estado de pagos y cronograma sin necesidad de registrarse.
        </p>
        
        <%
          portal_url = public_portal_url(token: @gig.portal_token)
        %>
        <div style="display: flex; gap: 10px; align-items: center; background: #f8fafc; padding: 10px 14px; border-radius: 12px; border: 1px solid #cbd5e1; margin-bottom: 15px;">
          <span style="font-size: 0.85em; color: #475569; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-grow: 1;" id="portal-url-text"><%= portal_url %></span>
          <button onclick="copyPortalLink()" style="background: #e0f2fe; color: #0369a1; border: none; padding: 8px 12px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.85em; white-space: nowrap;">
            📋 Copiar
          </button>
        </div>

        <%
          # Mensaje predefinido para WhatsApp
          wa_msg = "¡Hola #{@gig.client&.name}! Te comparto el link de tu Portal del Cliente personalizado para tu evento del #{@gig.date&.strftime('%d/%m/%Y')}. Podrás ver los detalles contratados, el estado de tus abonos y el cronograma del día: #{portal_url}"
          
          # Si tenemos el teléfono formateado del cliente, generamos el link directo, de lo contrario a WhatsApp Web general
          wa_share_url = @gig.client&.formatted_phone_for_whatsapp.present? ? "https://wa.me/#{@gig.client.formatted_phone_for_whatsapp}?text=#{ERB::Util.url_encode(wa_msg)}" : "https://web.whatsapp.com/send?text=#{ERB::Util.url_encode(wa_msg)}"
        %>
        <a href="<%= wa_share_url %>" target="_blank" style="background: #25d366; color: white; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 12px; font-weight: bold; text-decoration: none; font-size: 0.9em; box-shadow: 0 4px 6px rgba(37, 211, 102, 0.15); transition: 0.2s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 2px;">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Enviar por WhatsApp
        </a>
        <%= link_to print_contract_gig_path(@gig), target: "_blank", style: "background: #f1f5f9; color: #475569; padding: 10px 18px; border-radius: 12px; font-weight: bold; text-decoration: none; font-size: 0.9em; box-shadow: 0 4px 6px rgba(0,0,0,0.05); display: inline-flex; align-items: center; justify-content: center; transition: 0.2s;" do %>
          🖨️ Imprimir Físico
        <% end %>
      </div>

      <div style="border-left: 1px dashed #e2e8f0; padding-left: 25px;">
        <h3 style="margin: 0 0 10px 0; color: #1e293b; font-size: 1.1em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
          ✍️ Estado del Contrato
        </h3>
        <p style="margin: 0 0 15px 0; color: #64748b; font-size: 0.9em; line-height: 1.4;">
          El cliente puede firmar digitalmente el acuerdo directamente desde su portal público de cliente.
        </p>

        <% if @gig.contract_signed? %>
          <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 15px; border-radius: 14px; font-size: 0.9em;">
            <p style="margin: 0 0 5px 0; font-weight: 800; display: flex; align-items: center; gap: 6px;">
              ✓ Firmado Digitalmente
            </p>
            <div style="color: #047857; font-size: 0.9em; line-height: 1.5;">
              <strong>Firmante:</strong> <%= @gig.contract_signed_name %><br>
              <strong>Fecha/Hora:</strong> <%= @gig.contract_signed_at&.strftime("%d/%m/%Y %I:%M %p") %><br>
              <strong>IP:</strong> <%= @gig.contract_signed_ip %>
            </div>
          </div>
        <% else %>
          <div style="background: #fffbeb; border: 1px solid #fef3c7; color: #78350f; padding: 15px; border-radius: 14px; font-size: 0.95em; font-weight: 700; display: inline-flex; align-items: center; gap: 8px;">
            ⚠️ Pendiente de Firma por el Cliente
          </div>
        <% end %>
      </div>

    </div>

    <script>
      function copyPortalLink() {
        const text = document.getElementById('portal-url-text').textContent;
        navigator.clipboard.writeText(text).then(() => {
          alert("Enlace copiado al portapapeles con éxito.");
        }).catch(err => {
          console.error('Error al copiar el enlace: ', err);
        });
      }
    </script>

    <%# --- PERSONALIZACIÓN Y ACTIVACIÓN DE ADICIONALES (UPSELLS) PARA ESTE EVENTO (DESPLEGABLE) --- %>
    <div style="background: white; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px; overflow: hidden;">
      
      <%# Cabecera Desplegable %>
      <div onclick="toggleUpsellsPanel()" style="padding: 20px 25px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: #ffffff; user-select: none; transition: background 0.2s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#ffffff'">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.5em; background: #eff6ff; color: #3b82f6; width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">🚀</span>
          <div>
            <h3 style="margin: 0; color: #1e293b; font-size: 1.05em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
              Adicionales (Upsells) Disponibles
              <span style="background: #e0e7ff; color: #4338ca; font-size: 0.72em; padding: 2px 8px; border-radius: 12px; font-weight: 700;"><%= @gig.available_upsells.size %> Activos</span>
            </h3>
            <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.85em;">
              Haz clic para desplegar y activar/desactivar o personalizar los adicionales de este evento.
            </p>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px;" onclick="event.stopPropagation();">
          <%= link_to '⚙️ Catálogo Global', standard_upsells_path, style: "background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 8px; font-weight: bold; font-size: 0.82em; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: 0.2s;" %>
          
          <button type="button" onclick="toggleUpsellsPanel()" id="upsells-toggle-btn" style="background: #eef2ff; color: #4f46e5; border: 1px solid #c7d2fe; padding: 6px 14px; border-radius: 8px; font-weight: bold; font-size: 0.82em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: 0.2s;">
            <span id="upsells-toggle-text">Desplegar</span>
            <span id="upsells-toggle-icon" style="font-size: 0.8em; transition: transform 0.2s;">▼</span>
          </button>
        </div>
      </div>

      <%# Contenido Desplegable (Oculto por defecto para optimizar espacio) %>
      <div id="upsells-collapsible-content" style="display: none; border-top: 1px solid #e2e8f0; padding: 25px; background: #fafafa;">
        <p style="margin: 0 0 20px 0; color: #64748b; font-size: 0.88em; line-height: 1.4;">
          Todos los adicionales del catálogo estándar están activos automáticamente para este toque. Desactiva los que no desees mostrar en el portal de este cliente o modifica su precio/título si este evento lo requiere.
        </p>

        <%# --- HISTORIAL DE SOLICITUDES DE CLIENTES --- %>
        <% if @gig.gig_upsell_requests.any? %>
          <div style="background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px; margin-bottom: 25px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
            <h4 style="margin: 0 0 12px 0; color: #1e293b; font-size: 1.02em; font-weight: 800; display: flex; align-items: center; justify-content: space-between;">
              <span>📜 Solicitudes de Adicionales del Cliente (<%= @gig.gig_upsell_requests.count %>)</span>
            </h4>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <% @gig.gig_upsell_requests.ordered.each do |req| %>
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.6em;"><%= req.emoji.presence || '🚀' %></span>
                    <div>
                      <strong style="color: #0f172a; font-size: 0.95em;"><%= req.title %></strong>
                      <div style="font-size: 0.8em; color: #64748b;">
                        Solicitado: <%= req.requested_at&.strftime("%d/%m/%Y %I:%M %p") || req.created_at.strftime("%d/%m/%Y %I:%M %p") %>
                        <% if req.notes.present? %> • "<%= req.notes %>"<% end %>
                      </div>
                    </div>
                  </div>

                  <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                    <strong style="color: #059669; font-size: 1em;">+ $<%= number_with_precision(req.price, precision: 2) %> <%= req.currency %></strong>
                    
                    <% case req.status %>
                    <% when 'approved' %>
                      <span style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 4px 10px; border-radius: 99px; font-weight: 800; font-size: 0.78em;">
                        ✓ Añadido al Show
                      </span>
                    <% when 'rejected' %>
                      <span style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 4px 10px; border-radius: 99px; font-weight: 800; font-size: 0.78em;">
                        ✕ Rechazado
                      </span>
                    <% else %>
                      <span style="background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 4px 10px; border-radius: 99px; font-weight: 800; font-size: 0.78em;">
                        ⏳ Pendiente
                      </span>
                      <div style="display: flex; gap: 6px;">
                        <%= button_to "Añadir", approve_gig_upsell_request_path(req), method: :post, style: "background: #10b981; color: white; border: none; padding: 5px 10px; border-radius: 6px; font-weight: 700; font-size: 0.78em; cursor: pointer;", onclick: "return confirm('¿Aprobar y sumar al show?');" %>
                        <%= button_to "No añadir", reject_gig_upsell_request_path(req), method: :post, style: "background: #f1f5f9; color: #dc2626; border: 1px solid #cbd5e1; padding: 5px 10px; border-radius: 6px; font-weight: 700; font-size: 0.78em; cursor: pointer;", onclick: "return confirm('¿Rechazar adicional?');" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if current_user.leader? %>
          <%# --- BARRA DE ACCIÓN RÁPIDA PARA LÍDERES: AÑADIR ADICIONAL AL EVENTO --- %>
          <div style="background: #ffffff; border: 1px solid #c7d2fe; border-radius: 16px; padding: 20px; margin-bottom: 25px; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
              <div>
                <h4 style="margin: 0; color: #1e293b; font-size: 1.02em; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                  ⚡ Añadir Adicional / Hora Extra al Evento
                </h4>
                <p style="margin: 3px 0 0 0; color: #64748b; font-size: 0.84em;">
                  Haz clic en un botón para sumar el adicional cobrado. El presupuesto final aumentará automáticamente y si es una hora extra, se extenderá el horario.
                </p>
              </div>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 15px;">
              <% standard_catalog_list = StandardUpsell.all_with_defaults %>
              <% custom_upsells_map = @gig.custom_upsells || {} %>
              <% standard_catalog_list.each do |std| %>
                <% 
                  key_name = std.key.to_s
                  c_data = custom_upsells_map[key_name] || custom_upsells_map[std.id.to_s] || {}
                  card_active = std.active? && c_data['disabled'] != '1' && c_data['disabled'] != true
                  next unless card_active
                  item_title = c_data['title'].presence || std.title
                  item_emoji = c_data['emoji'].presence || std.emoji || '🚀'
                  item_price = c_data['price'].present? ? c_data['price'].to_f : std.price.to_f
                  item_currency = c_data['currency'].presence || std.currency || @gig.currency || 'USD'
                  is_time = key_name == 'extra_time' || key_name.include?('hora')
                %>
                <%= form_with url: add_upsell_gig_path(@gig), method: :post, local: true, style: "display: inline-block;" do |f| %>
                  <%= hidden_field_tag :upsell_key, key_name %>
                  <%= hidden_field_tag :price, item_price %>
                  <%= hidden_field_tag :title, item_title %>
                  <button type="submit" onclick="return confirm('¿Añadir \'<%= item_title %>\' (+ $ <%= number_with_precision(item_price, precision: 2) %> <%= item_currency %>) a este evento?<%= ' Se agregará 1 hora al horario final.' if is_time %>');" style="background: <%= is_time ? '#4f46e5' : '#059669' %>; color: white; border: none; padding: 9px 16px; border-radius: 12px; font-weight: 700; font-size: 0.86em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); transition: transform 0.15s, opacity 0.15s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                    <span><%= item_emoji %></span>
                    <span>+ <%= item_title %> (+ $ <%= number_with_precision(item_price, precision: 0) %> <%= item_currency %>)</span>
                  </button>
                <% end %>
              <% end %>
            </div>

            <%# Formulario para monto u hora extra personalizada a medida %>
            <details style="margin-top: 10px; background: #f8fafc; padding: 12px; border-radius: 12px; border: 1px solid #e2e8f0;">
              <summary style="font-weight: 700; font-size: 0.85em; color: #475569; cursor: pointer; user-select: none;">
                ⚙️ Añadir adicional con monto u horas personalizadas...
              </summary>
              <%= form_with url: add_upsell_gig_path(@gig), method: :post, local: true, style: "margin-top: 12px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;" do |f| %>
                <div style="flex: 2; min-width: 180px;">
                  <label style="display: block; font-size: 0.78em; font-weight: bold; color: #64748b; margin-bottom: 4px;">Concepto / Título del Adicional</label>
                  <%= text_field_tag :title, nil, placeholder: "Ej: Hora Extra Especial, Tarima Extra...", required: true, style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em;" %>
                </div>
                <div style="flex: 1; min-width: 120px;">
                  <label style="display: block; font-size: 0.78em; font-weight: bold; color: #64748b; margin-bottom: 4px;">Monto Adicional ($)</label>
                  <%= number_field_tag :price, nil, step: :any, placeholder: "0.00", required: true, style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em;" %>
                </div>
                <div style="flex: 1; min-width: 120px;">
                  <label style="display: block; font-size: 0.78em; font-weight: bold; color: #64748b; margin-bottom: 4px;">¿Sumar tiempo al horario?</label>
                  <%= select_tag :hours, options_for_select([["No sumar tiempo", 0], ["+ 1 Hora de evento", 1], ["+ 2 Horas de evento", 2], ["+ 3 Horas de evento", 3]]), style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; background: white;" %>
                </div>
                <div>
                  <%= f.submit "➕ Registrar Adicional", style: "background: #1e293b; color: white; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 0.85em; cursor: pointer;" %>
                </div>
              <% end %>
            </details>
          </div>
        <% end %>

        <%= form_with model: @gig, local: true do |f| %>
          <div id="upsells-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 20px;">
            <% 
              standard_catalog = StandardUpsell.all_with_defaults
              custom_map = @gig.custom_upsells || {}
            %>
            <% standard_catalog.each do |std| %>
              <% 
                key = std.key.to_s
                custom_data = custom_map[key] || custom_map[std.id.to_s] || {}
                is_active = std.active? && custom_data['disabled'] != '1' && custom_data['disabled'] != true
                custom_emoji = custom_data['emoji'].presence || std.emoji || '🚀'
              %>
              <div class="upsell-card-container" style="background: <%= is_active ? '#ffffff' : '#f1f5f9' %>; border: 1px solid <%= is_active ? '#cbd5e1' : '#e2e8f0' %>; border-radius: 14px; padding: 15px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                  <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #1e293b; font-size: 0.9em;">
                    <span style="font-size: 1.2em;"><%= custom_emoji %></span>
                    <span><%= std.title %></span>
                  </div>
                  <div>
                    <%= hidden_field_tag "gig[custom_upsells][#{key}][disabled]", "1" %>
                    <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.82em; font-weight: bold; color: <%= is_active ? '#15803d' : '#64748b' %>; cursor: pointer;">
                      <%= check_box_tag "gig[custom_upsells][#{key}][disabled]", "0", is_active %>
                      Activo en este toque
                    </label>
                  </div>
                </div>
                
                <div>
                  <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Nombre (Personalizado para este show)</label>
                  <%= text_field_tag "gig[custom_upsells][#{key}][title]", custom_data['title'], placeholder: "Estándar: #{std.title}", style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; outline: none; background: white;" %>
                </div>

                <div style="display: flex; gap: 10px;">
                  <div style="flex: 1;">
                    <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Precio Adicional</label>
                    <%= number_field_tag "gig[custom_upsells][#{key}][price]", custom_data['price'], step: :any, placeholder: "Estándar: $#{std.price.to_f}", style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; outline: none; background: white;" %>
                  </div>
                  <div style="width: 80px;">
                    <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Moneda</label>
                    <%= text_field_tag "gig[custom_upsells][#{key}][currency]", custom_data['currency'] || std.currency || 'USD', style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88em; outline: none; background: white; text-transform: uppercase;" %>
                  </div>
                </div>

                <div>
                  <label style="display: block; font-size: 0.78em; color: #64748b; font-weight: bold; margin-bottom: 3px;">Descripción (Personalizada para este show)</label>
                  <%= text_area_tag "gig[custom_upsells][#{key}][description]", custom_data['description'], rows: 2, placeholder: "Dejar vacío para usar la descripción estándar...", style: "width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85em; outline: none; background: white; resize: vertical;" %>
                </div>

                <% if key.include?('smoke') || std.title.to_s.downcase.include?('humo') %>
                  <div style="padding: 8px 12px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; font-size: 0.78em; color: #92400e; line-height: 1.4; display: flex; align-items: center; gap: 6px;">
                    <span>💨</span>
                    <span><strong>Recordatorio de Uso:</strong> La máquina de humo no se debe usar en lugares muy al aire libre porque el viento dispersa el humo y no se aprecia el efecto de luces.</span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div style="text-align: right;">
            <%= f.submit "Guardar Cambios de Adicionales", style: "background: #4f46e5; color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; cursor: pointer; font-size: 0.9em; box-shadow: 0 4px 6px rgba(79, 70, 229, 0.15); transition: 0.2s;" %>
          </div>
        <% end %>
      </div>
    </div>

    <script>
      function toggleUpsellsPanel() {
        const content = document.getElementById('upsells-collapsible-content');
        const text = document.getElementById('upsells-toggle-text');
        const icon = document.getElementById('upsells-toggle-icon');

        if (content.style.display === 'none' || !content.style.display) {
          content.style.display = 'block';
          text.textContent = 'Plegar';
          icon.style.transform = 'rotate(180deg)';
        } else {
          content.style.display = 'none';
          text.textContent = 'Desplegar';
          icon.style.transform = 'rotate(0deg)';
        }
      }
    </script>

    <%# --- BALANCE FINANCIERO DEL SHOW --- %>
    <div style="background: white; padding: 24px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 10px;">
        <h3 style="margin: 0; font-size: 1.15em; font-weight: 800; color: #1e293b; display: flex; align-items: center; gap: 8px;">
          <span>💰</span> Balance Financiero del Show
        </h3>
        <% if current_user.leader? %>
          <%= form_with url: add_upsell_gig_path(@gig), method: :post, local: true, style: "margin: 0;" do |f| %>
            <%= hidden_field_tag :upsell_key, 'extra_time' %>
            <button type="submit" onclick="return confirm('¿Añadir 1 Hora Extra a este evento? Se sumará la tarifa correspondiente al monto del toque y 1 hora al horario final.');" style="background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; padding: 6px 14px; border-radius: 10px; font-weight: 700; font-size: 0.82em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: 0.2s;" onmouseover="this.style.background='#e0e7ff'" onmouseout="this.style.background='#eef2ff'">
              🎵 + Añadir Hora Extra
            </button>
          <% end %>
        <% end %>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; align-items: start;">
        <%# Columna Izquierda: Métricas, Progreso y Formulario de Asignación %>
        <div>
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px; margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px;">
              <span style="font-size: 0.85em; color: #64748b; font-weight: 700; text-transform: uppercase;">Monto Acordado</span>
              <span style="font-size: 1.3em; font-weight: 800; color: #10b981;">
                <%= number_with_precision(@gig.amount, precision: 2) %> 
                <span style="font-size: 0.65em; color: #94a3b8; font-weight: 600;"><%= @gig.currency %></span>
              </span>
            </div>

            <div style="margin-bottom: 12px;">
              <%= render 'gigs/payment_progress', gig: @gig, size: :compact, show_details: true, show_footer: false %>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px;">
              <div style="background: white; padding: 10px 12px; border-radius: 10px; border: 1px solid #e2e8f0;">
                <div style="font-size: 0.78em; color: #64748b; font-weight: 700;">Pagos a Agrupación</div>
                <div style="font-size: 1.05em; font-weight: 800; color: #ef4444; margin-top: 2px;">
                  <%= number_with_precision(@gig.total_employee_payouts || 0, precision: 2) %> <%= @gig.currency %>
                </div>
              </div>
              <div style="background: white; padding: 10px 12px; border-radius: 10px; border: 1px solid #e2e8f0;">
                <div style="font-size: 0.78em; color: #64748b; font-weight: 700;">Asignado a Fondos</div>
                <div style="font-size: 1.05em; font-weight: 800; color: #0ea5e9; margin-top: 2px;">
                  <%= number_with_precision(@gig.total_allocated || 0, precision: 2) %> <%= @gig.currency %>
                </div>
              </div>
            </div>

            <div style="margin-top: 14px; border-top: 1px dashed #cbd5e1; padding-top: 12px; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-weight: 800; color: #1e293b; font-size: 0.95em;">💵 Saldo Disponible:</span>
              <span style="font-weight: 900; color: #065f46; font-size: 1.2em;">
                <%= number_with_precision(@gig.remaining_balance || 0, precision: 2) %> <%= @gig.currency %>
              </span>
            </div>
          </div>

          <%# Formulario de asignación de sobrante %>
          <div style="background: white; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px;">
            <div style="font-weight: 800; color: #334155; font-size: 0.9em; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
              <span>📥 Asignar Dinero a Fondos</span>
            </div>
            <%= form_with model: [@gig, FundAllocation.new], local: true do |f| %>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                <div>
                  <%= f.label :amount, 'Monto ($)', style: 'display:block; font-weight:700; color:#475569; font-size:0.8em; margin-bottom:4px;' %>
                  <%= f.text_field :amount,
                    inputmode: 'numeric',
                    data: { controller: 'currency', action: 'input->currency#format blur->currency#format' },
                    placeholder: '0.00',
                    style: 'width: 100%; box-sizing: border-box; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.9em;' %>
                </div>
                <div>
                  <%= f.label :fund_type, 'Fondo Destino', style: 'display:block; font-weight:700; color:#475569; font-size:0.8em; margin-bottom:4px;' %>
                  <%= f.select :fund_type, FundAllocation::FUND_TYPES.map { |t| [FundAllocation.fund_label_for(t), t] }, {}, style: 'width: 100%; box-sizing: border-box; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.9em; background: white;' %>
                </div>
              </div>
              <div style="margin-bottom: 12px;">
                <%= f.label :notes, 'Notas / Concepto (opcional)', style: 'display:block; font-weight:700; color:#475569; font-size:0.8em; margin-bottom:4px;' %>
                <%= f.text_field :notes, placeholder: 'Ej. Para nómina del staff, reparaciones...', style: 'width: 100%; box-sizing: border-box; padding: 8px 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.9em;' %>
              </div>
              <%= f.submit '💾 Asignar a Fondo', style: 'width: 100%; background: #10b981; color: white; padding: 10px; border-radius: 8px; font-weight: 800; border: none; cursor: pointer; font-size: 0.9em; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.2);' %>
            <% end %>
          </div>
        </div>

        <%# Columna Derecha: Historial de Asignaciones y Gastos Desglosados %>
        <div>
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px;">
            <div style="font-weight: 800; color: #1e293b; font-size: 0.95em; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between;">
              <span>📜 Historial de Asignaciones</span>
              <span style="font-size: 0.8em; font-weight: 700; color: #64748b; background: #e2e8f0; padding: 2px 8px; border-radius: 99px;">
                <%= @gig.fund_allocations.size %> registro(s)
              </span>
            </div>

            <% if @gig.fund_allocations.empty? %>
              <p style="color: #94a3b8; font-size: 0.88em; margin: 0; font-style: italic; text-align: center; padding: 20px 0;">
                No hay fondos asignados para este evento todavía.
              </p>
            <% else %>
              <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px;">
                <% @gig.fund_allocations.order(created_at: :desc).each do |fa| %>
                  <div style="background: white; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                    <div style="min-width: 0; flex: 1;">
                      <div style="font-weight: 800; color: #1e293b; font-size: 0.92em;"><%= fa.fund_label %></div>
                      <div style="font-size: 0.82em; color: #64748b; margin-top: 2px; word-break: break-word;"><%= fa.notes.presence || '-' %></div>
                    </div>
                    <div style="text-align: right; white-space: nowrap; flex-shrink: 0;">
                      <div style="font-weight: 800; color: #0284c7; font-size: 0.95em;">
                        <%= number_with_precision(fa.amount, precision: 2) %> <%= fa.currency %>
                      </div>
                      <div style="font-size: 0.78em; color: #94a3b8; margin-top: 2px;">
                        <%= fa.created_at.strftime('%d/%m/%Y') %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <%# Desglose de Gastos por Fondo %>
            <% active_allocations = @gig.fund_allocations.select { |fa| fa.fund_expenses.any? } %>
            <% if active_allocations.any? %>
              <div style="border-top: 1px dashed #cbd5e1; padding-top: 14px; margin-top: 10px;">
                <div style="font-weight: 800; color: #475569; font-size: 0.88em; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;">
                  💸 Gastos Aplicados a Fondos
                </div>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <% active_allocations.each do |fa| %>
                    <div style="background: white; border-radius: 10px; border: 1px solid #e2e8f0; padding: 12px; box-shadow: 0 1px 4px rgba(0,0,0,0.02);">
                      <div style="font-weight: 800; color: #1e293b; font-size: 0.88em; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px;">
                        <span>Gastos para: <%= fa.fund_label %></span>
                        <span style="font-size: 0.8em; font-weight: 700; color: <%= fa.remaining.to_f > 0 ? '#059669' : '#64748b' %>; background: <%= fa.remaining.to_f > 0 ? '#ecfdf5' : '#f1f5f9' %>; padding: 2px 8px; border-radius: 99px;">
                          Saldo: $<%= number_with_precision(fa.remaining, precision: 2) %>
                        </span>
                      </div>

                      <div style="display: flex; flex-direction: column; gap: 6px;">
                        <% fa.fund_expenses.order(created_at: :desc).each do |exp| %>
                          <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 6px 8px; background: #f8fafc; border-radius: 6px; font-size: 0.85em;">
                            <div style="color: #334155; min-width: 0; word-break: break-word; flex: 1; line-height: 1.3;">
                              <%= exp.notes.presence || 'Sin nota de concepto' %>
                            </div>
                            <div style="text-align: right; white-space: nowrap; flex-shrink: 0;">
                              <span style="color: #ef4444; font-weight: 800; font-size: 0.92em;">-$<%= number_with_precision(exp.amount, precision: 2) %></span>
                              <div style="font-size: 0.76em; color: #94a3b8;"><%= exp.spent_at&.strftime('%d/%m/%Y') || exp.created_at&.strftime('%d/%m/%Y') %></div>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

          </div>
        </div>
      </div>
    </div>
    <%# --- ASIGNACIÓN DE TRABAJADORES --- %>
    <div style="background: white; padding: 25px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 30px;">
      <h3 style="margin: 0 0 15px 0; color: #1e293b; font-size: 1.1em; display: flex; align-items: center; justify-content: space-between;">
        <span>👷 Trabajadores asignados</span>
        <span style="font-size: 0.85em; color: #64748b; font-weight: 600;">Total acordado: $<%= number_with_precision(@gig.staff_assignments.sum(:agreed_amount), precision: 2) %></span>
      </h3>

      <%= form_with url: assign_staff_gig_path(@gig), method: :post, local: true, style: "display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; margin-bottom: 20px; background: #f8fafc; padding: 16px; border-radius: 12px; border: 1px solid #e2e8f0;" do |f| %>
        <div style="flex: 1; min-width: 200px;">
          <label style="display: block; font-size: 0.85em; font-weight: 700; color: #475569; margin-bottom: 4px;">Seleccionar trabajador</label>
          <%= f.select :staff_id, current_company.users.workers.order(:email).map { |w| [w.display_name, w.id] }, { prompt: "Seleccionar trabajador..." }, style: "width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none; background: white;" %>
        </div>
        <div style="flex: 1; min-width: 220px;">
          <label style="display: block; font-size: 0.85em; font-weight: 700; color: #475569; margin-bottom: 4px;">¿Cuánto le vas a pagar a este trabajador? ($ USD)</label>
          <%= f.text_field :agreed_amount, inputmode: 'decimal', placeholder: '0.00', style: "width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none; background: white;" %>
        </div>
        <div>
          <%= f.submit "➕ Asignar trabajador", style: "background: #2563eb; color: white; border: none; padding: 9px 16px; border-radius: 8px; font-weight: bold; cursor: pointer;" %>
        </div>
      <% end %>

      <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px;">
