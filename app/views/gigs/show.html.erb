      </button>
      <button onclick="switchLogisticsMode('carga')" id="btn-tab-carga" class="logistics-tab" style="flex: 1; padding: 12px; border: none; border-radius: 10px; font-weight: 700; font-size: 0.9em; cursor: pointer; transition: all 0.2s; background: transparent; color: #64748b;">
        🚚 Modo Carga (Depósito)
      </button>
      <button onclick="switchLogisticsMode('retorno')" id="btn-tab-retorno" class="logistics-tab" style="flex: 1; padding: 12px; border: none; border-radius: 10px; font-weight: 700; font-size: 0.9em; cursor: pointer; transition: all 0.2s; background: transparent; color: #64748b;">
        ↩️ Modo Retorno (Devolución)
      </button>
    </div>

    <% if current_user.leader? %>
