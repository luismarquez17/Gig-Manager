          <span style="font-size: 0.85em; font-weight: 800; color: #1d4ed8; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;">🛠️ Aplicar Plantilla:</span>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <% @available_kits.each do |kit| %>
              <%= button_to add_kit_gig_path(@gig), 
                  params: { kit_id: kit.id },
                  method: :post,
                  style: "background: #2563eb; color: white; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 0.85em; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 6px;",
                  onmouseover: "this.style.backgroundColor='#1d4ed8'",
                  onmouseout: "this.style.backgroundColor='#2563eb'",
                  title: "Aplicar #{kit.name} al checklist" do %>
                📦 <%= kit.name %>
              <% end %>
            <% end %>
          </div>
          <span style="font-size: 0.75em; color: #3b82f6; margin-left: auto;">Las cantidades se acumulan si el equipo ya está en la lista.</span>
        </div>
      <% end %>

      <%# FORMULARIO PARA AÑADIR ITEM INDIVIDUAL %>
      <div style="padding: 20px 25px; border-bottom: 2px solid #f1f5f9; background: #ffffff;">
