          <% paid = sa.total_paid %>
          <% agreed = sa.agreed_amount.to_f %>
          <% balance = sa.balance %>
          <div style="background: #f8fafc; padding: 12px 16px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
