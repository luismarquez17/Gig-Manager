            <%= f.text_field :description, placeholder: "e.g. Usar chispa fría y canción especial", style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-family: inherit; font-size: 0.9em; box-sizing: border-box;" %>
