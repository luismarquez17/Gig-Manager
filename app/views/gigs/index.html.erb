<div style="max-width: 1200px; margin: 0 auto; font-family: 'Segoe UI', sans-serif;">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <h1 style="color: #2c3e50; margin: 0;"><%= company_term(:gigs_history, (venue_mode? ? '🏛️ Historial de Eventos' : '🎸 Historial de Toques')) %></h1>
    <%= link_to company_term(:new_gig_btn, (venue_mode? ? '➕ Registrar Nuevo Evento' : '➕ Registrar Nuevo Toque')), new_gig_path, style: "background: #28a745; color: white; padding: 12px 20px; text-decoration: none; border-radius: 8px; font-weight: bold; box-shadow: 0 4px 6px rgba(40, 167, 69, 0.2);" %>
  </div>

  <%# --- AVISO / BANNER DEL SIGUIENTE SHOW --- %>
  <% if @next_gig.present? %>
    <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%); border-radius: 14px; padding: 18px 22px; margin-bottom: 22px; color: white; box-shadow: 0 8px 20px rgba(67, 56, 202, 0.2); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; border: 1px solid rgba(255, 255, 255, 0.12);">
      <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div style="width: 46px; height: 46px; border-radius: 12px; background: rgba(255, 255, 255, 0.16); display: flex; align-items: center; justify-content: center; font-size: 1.45em; flex-shrink: 0; border: 1px solid rgba(255, 255, 255, 0.2);">
          🎯
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
            <span style="font-size: 0.75em; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; background: rgba(255, 255, 255, 0.2); padding: 2px 9px; border-radius: 99px;">
              <%= venue_mode? ? 'Próximo Evento' : 'Próximo Show' %>
            </span>
            <span style="font-size: 0.82em; font-weight: 700; color: #a5b4fc;">
              <%= time_until_gig_in_words(@next_gig) %>
            </span>
            <% if params[:date_filter] == 'next' %>
              <span style="font-size: 0.72em; font-weight: 700; background: #22c55e; color: white; padding: 2px 8px; border-radius: 99px;">
                Filtro activo en tabla
              </span>
            <% end %>
          </div>
          <div style="font-size: 1.18em; font-weight: 800; line-height: 1.3;">
            El siguiente <%= venue_mode? ? 'evento' : 'show' %> es 
            <span style="color: #fde047; text-decoration: underline; text-underline-offset: 3px;"><%= @next_gig.client_display_name %></span>
          </div>
          <div style="font-size: 0.88em; color: #c7d2fe; margin-top: 4px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
            <span>📅 <%= spanish_long_date(@next_gig.date) %></span>
            <% if @next_gig.start_time.present? %>
              <span>🕒 <%= @next_gig.start_time.strftime("%I:%M %p") rescue nil %></span>
            <% end %>
            <% if @next_gig.location.present? %>
              <span>📍 <%= @next_gig.location %></span>
            <% end %>
          </div>
        </div>
      </div>
      
      <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0; margin-left: auto;">
        <% if params[:date_filter] == 'next' %>
          <%= link_to gigs_path(request.query_parameters.except("date_filter")), 
              style: "background: rgba(255, 255, 255, 0.15); color: white; padding: 9px 15px; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 0.88em; border: 1px solid rgba(255, 255, 255, 0.25); display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;",
              title: "Ver todos los eventos" do %>
            <span>Ver todos</span> ✕
          <% end %>
        <% else %>
          <%= link_to gigs_path(request.query_parameters.merge("date_filter" => "next")), 
              style: "background: rgba(255, 255, 255, 0.15); color: white; padding: 9px 15px; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 0.88em; border: 1px solid rgba(255, 255, 255, 0.25); display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;",
              title: "Filtrar la tabla para mostrar únicamente este show" do %>
            <span>Filtrar</span> 🎯
          <% end %>
        <% end %>
        <%= link_to gig_path(@next_gig), 
            style: "background: #ffffff; color: #3730a3; padding: 9px 20px; text-decoration: none; border-radius: 8px; font-weight: 800; font-size: 0.9em; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15); display: inline-flex; align-items: center; gap: 6px; transition: transform 0.15s;",
            title: "Ver detalles completos del show" do %>
          <span>Ver</span> ➔
        <% end %>
      </div>
    </div>
  <% elsif params[:date_filter] != 'past' %>
    <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 14px 20px; margin-bottom: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: #64748b; font-size: 0.9em;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span>🗓️</span>
        <span>No hay <%= venue_mode? ? 'eventos próximos' : 'shows próximos' %> programados actualmente.</span>
      </div>
      <%= link_to company_term(:new_gig_btn, (venue_mode? ? '➕ Registrar Evento' : '➕ Registrar Show')), new_gig_path, style: "color: #2563eb; font-weight: 700; text-decoration: none; font-size: 0.88em;" %>
    </div>
  <% end %>

  <%# --- ACCESOS RÁPIDOS DE FILTRADO (PILLS) --- %>
  <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 20px;">
    <span style="font-size: 0.82em; font-weight: 700; color: #64748b; margin-right: 4px;">Filtro rápido:</span>
    <%= link_to gigs_path(request.query_parameters.except("date_filter")), 
        style: "text-decoration: none; padding: 6px 14px; border-radius: 99px; font-size: 0.82em; font-weight: 700; transition: all 0.15s; #{params[:date_filter].blank? ? 'background: #0f172a; color: white;' : 'background: #f8fafc; color: #475569; border: 1px solid #e2e8f0;'}" do %>
      Todos
    <% end %>
    <%= link_to gigs_path(request.query_parameters.merge("date_filter" => "next")), 
        style: "text-decoration: none; padding: 6px 14px; border-radius: 99px; font-size: 0.82em; font-weight: 700; transition: all 0.15s; #{params[:date_filter] == 'next' ? 'background: #4f46e5; color: white;' : 'background: #f8fafc; color: #475569; border: 1px solid #e2e8f0;'}" do %>
      🎯 El Siguiente
    <% end %>
    <%= link_to gigs_path(request.query_parameters.merge("date_filter" => "upcoming")), 
        style: "text-decoration: none; padding: 6px 14px; border-radius: 99px; font-size: 0.82em; font-weight: 700; transition: all 0.15s; #{params[:date_filter] == 'upcoming' ? 'background: #2563eb; color: white;' : 'background: #f8fafc; color: #475569; border: 1px solid #e2e8f0;'}" do %>
      🔮 Próximos
    <% end %>
    <%= link_to gigs_path(request.query_parameters.merge("date_filter" => "past")), 
        style: "text-decoration: none; padding: 6px 14px; border-radius: 99px; font-size: 0.82em; font-weight: 700; transition: all 0.15s; #{params[:date_filter] == 'past' ? 'background: #64748b; color: white;' : 'background: #f8fafc; color: #475569; border: 1px solid #e2e8f0;'}" do %>
      ⏳ Pasados
    <% end %>
  </div>

  <%# --- SECCIÓN DE BÚSQUEDA, FILTROS Y ORDEN (DESPLEGABLE) --- %>
  <% 
    has_active_gigs_filters = params[:query].present? || params[:priority].present? || params[:date_filter].present? || (params[:sort].present? && params[:sort] != 'fecha_desc')
    active_filters_count = [params[:query], params[:priority], params[:date_filter]].select(&:present?).count
  %>
  
  <details style="background: white; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); margin-bottom: 25px; border: 1px solid #e2e8f0; overflow: hidden;" <%= 'open' if has_active_gigs_filters %>>
    <summary style="cursor: pointer; padding: 14px 20px; font-weight: 700; font-size: 0.95em; color: #1e293b; display: flex; justify-content: space-between; align-items: center; user-select: none; background: #f8fafc;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 1.1em;">🔍</span>
        <span><%= company_term(:gigs_filter, (venue_mode? ? 'Buscador & Filtros de Eventos' : 'Buscador & Filtros de Toques')) %></span>
        <% if active_filters_count > 0 %>
          <span style="background: #2563eb; color: white; padding: 2px 10px; border-radius: 99px; font-size: 0.78em; font-weight: 800;">
            <%= active_filters_count %> filtro(s) activo(s)
          </span>
        <% else %>
          <span style="color: #94a3b8; font-size: 0.82em; font-weight: normal;">(Haz clic para desplegar u ocultar)</span>
        <% end %>
      </div>
      <span style="font-size: 0.8em; color: #64748b; font-weight: bold;">🔽 Desplegar / Contraer</span>
    </summary>

    <div style="padding: 20px; border-top: 1px solid #f1f5f9;">
      <%= form_with url: gigs_path, method: :get, local: true, style: "display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap;" do |f| %>
        
        <%# Buscador %>
        <div style="flex-grow: 2; min-width: 200px; margin-bottom: 15px;">
          <%= f.label :query, "🔍 Buscar Cliente o Teléfono", style: "display: block; font-size: 0.85em; font-weight: bold; margin-bottom: 8px; color: #555;" %>
          <%= f.text_field :query, value: params[:query], placeholder: "Ej: Juan Perez o 0414...", style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box;" %>
        </div>

        <%# Filtro de Prioridad %>
        <div style="flex-grow: 1; min-width: 130px; margin-bottom: 15px;">
          <%= f.label :priority, "Prioridad", style: "display: block; font-size: 0.85em; font-weight: bold; margin-bottom: 8px; color: #555;" %>
          <%= f.select :priority, [["Todas", ""], ["Alta 🟢", "alta"], ["Media 🟡", "media"], ["Baja 🔴", "baja"]], { selected: params[:priority] }, { style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; background: white;" } %>
        </div>

        <%# Filtro de Fecha %>
        <div style="flex-grow: 1; min-width: 140px; margin-bottom: 15px;">
          <%= f.label :date_filter, "Fecha", style: "display: block; font-size: 0.85em; font-weight: bold; margin-bottom: 8px; color: #555;" %>
          <%= f.select :date_filter, [["Todos", ""], ["El Siguiente 🎯", "next"], ["Próximos 🔮", "upcoming"], ["Pasados ⏳", "past"]], { selected: params[:date_filter] }, { style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; background: white;" } %>
        </div>

        <%# Selector de Ordenamiento %>
        <div style="flex-grow: 1; min-width: 160px; margin-bottom: 15px;">
          <%= f.label :sort, "📊 Ordenar por", style: "display: block; font-size: 0.85em; font-weight: bold; margin-bottom: 8px; color: #555;" %>
          <%= f.select :sort, 
              [["📅 Fecha (Más Cercano primero)", "fecha_asc"],
               ["📅 Fecha (Más Reciente primero)", "fecha_desc"], 
               ["💰 Monto (Mayor a Menor)", "monto_desc"], 
               ["💸 Monto (Menor a Mayor)", "monto_asc"]], 
              { selected: params[:sort] }, 
              { style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; background: white;" } %>
        </div>

        <%# Botones de Acción %>
        <div style="display: flex; gap: 10px; margin-bottom: 15px; align-items: flex-end;">
          <%= f.submit "Aplicar", style: "background: #007bff; color: white; border: none; padding: 0 25px; border-radius: 6px; cursor: pointer; font-weight: bold; height: 40px;" %>
          <%= link_to "Limpiar", gigs_path, style: "background: #4a5568; color: white; border: none; padding: 0 15px; border-radius: 6px; text-decoration: none; font-size: 0.9em; display: flex; align-items: center; height: 40px; font-weight: bold;" %>
        </div>
      <% end %>
    </div>
  </details>

  <%# --- TABLA DE RESULTADOS --- %>
  <div class="d-md-none" style="display: flex; align-items: center; justify-content: space-between; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 8px 14px; margin-bottom: 12px; color: #1e40af; font-size: 0.82em; font-weight: 700;">
    <div style="display: flex; align-items: center; gap: 6px;">
      <span>👈 Desliza hacia los lados 👉</span>
    </div>
    <span style="font-size: 0.85em; opacity: 0.85;">Ver tabla completa</span>
  </div>

  <div class="table-custom-wrapper" style="background: white; border-radius: 14px; overflow-x: auto; -webkit-overflow-scrolling: touch; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: 1px solid #eee; margin-bottom: 25px; width: 100%; max-width: 100%;">
    <% if @gigs.any? %>
      <table class="table-custom" style="width: 100%; border-collapse: collapse; text-align: left; min-width: 860px;">
        <thead>
          <tr style="background-color: #f8f9fa; color: #333;">
            <th style="padding: 15px; border-bottom: 2px solid #eee; min-width: 110px;">Fecha</th>
            <th style="padding: 15px; border-bottom: 2px solid #eee; min-width: 180px;">Cliente (Prioridad)</th>
            <th style="padding: 15px; border-bottom: 2px solid #eee; min-width: 210px;">Ubicación & Detalles</th>
            <th style="padding: 15px; border-bottom: 2px solid #eee; min-width: 230px;">Monto & Cobro</th>
            <th style="padding: 15px; border-bottom: 2px solid #eee; text-align: center; min-width: 200px;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @gigs.each do |gig| %>
            <tr style="border-bottom: 1px solid #f1f1f1;" onmouseover="this.style.backgroundColor='#fdfdfd'" onmouseout="this.style.backgroundColor='transparent'">
              <td style="padding: 15px; color: #666; white-space: nowrap;"><%= gig.date.strftime("%d/%m/%Y") if gig.date %></td>
              <td style="padding: 15px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <% if gig.client %>
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: <%= color_prioridad(gig.client.priority) %>; flex-shrink: 0;"></div>
                    <div>
                      <%= link_to gig.client.name, client_path(gig.client), style: "color: #007bff; text-decoration: none; font-weight: bold; display: block;" %>
                      <small style="color: #999;"><%= gig.client.phone %></small>
                    </div>
                  <% else %>
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: #94a3b8; flex-shrink: 0;"></div>
                    <div>
                      <span style="color: #64748b; font-weight: bold; display: block;">Sin Cliente</span>
                      <small style="color: #cbd5e1;"><%= gig.client_email %></small>
                    </div>
                  <% end %>
                </div>
              </td>
              <td style="padding: 15px; color: #555;">
                <div style="font-weight: bold; color: #334155; margin-bottom: 4px;">
                  <%= gig.location.presence || "---" %>
                </div>
                <% if gig.details.present? %>
                  <div style="font-size: 0.85em; color: #64748b; line-height: 1.4;" title="<%= gig.details %>">
                    <%= truncate(gig.details, length: 80) %>
                  </div>
                <% end %>
              </td>
              <td style="padding: 15px; vertical-align: middle;">
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                  <span style="font-weight: 800; color: #0f172a; font-size: 1.05em;">
                    <%= number_with_precision(gig.amount, precision: 2) %>
                  </span>
                  <span style="background: #f1f5f9; padding: 2px 7px; border-radius: 6px; font-size: 0.75em; font-weight: 800; color: #475569; border: 1px solid #e2e8f0;">
                    <%= gig.currency %>
                  </span>
                </div>
                <%= render 'gigs/payment_progress', gig: gig, size: :compact, show_details: false, show_footer: true %>
                
                <% if current_user.leader? && gig.staff_assignments.any? %>
                  <%
                    margin_val = gig.projected_profit_margin
                    is_pos = gig.projected_net_profit >= 0
                    m_bg = margin_val >= 30 ? '#f0fdf4' : (margin_val >= 10 ? '#fefce8' : '#fef2f2')
                    m_border = margin_val >= 30 ? '#bbf7d0' : (margin_val >= 10 ? '#fef08a' : '#fecaca')
                    m_color = is_pos ? (margin_val >= 30 ? '#15803d' : '#854d0e') : '#dc2626'
                  %>
                  <div style="margin-top: 6px; font-size: 0.78em; display: flex; align-items: center; justify-content: space-between; gap: 4px; padding: 4px 8px; background: <%= m_bg %>; border-radius: 6px; border: 1px solid <%= m_border %>;" title="Ganancia Neta estimada tras pagar nómina">
                    <span style="color: #64748b; font-weight: 700;"><%= venue_mode? ? 'Ganancia Neta:' : 'Ganancia Banda:' %></span>
                    <strong style="color: <%= m_color %>;">
                      <%= is_pos ? '+' : '' %>$<%= number_with_precision(gig.projected_net_profit, precision: 0) %> (<%= margin_val %>%)
                    </strong>
                  </div>
                <% end %>
              </td>
              <td style="padding: 15px; text-align: center;">
                  <%# Botón Ficha para WhatsApp %>
                  <button type="button" 
                          onclick="openFlashcardModal('flashcard-modal-<%= gig.id %>')" 
                          style="background: #eef2ff; border: 1px solid #c7d2fe; padding: 10px 14px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: 0.2s; box-shadow: 0 2px 4px rgba(79, 70, 229, 0.05);" 
                          onmouseover="this.style.backgroundColor='#e0e7ff'" 
                          onmouseout="this.style.backgroundColor='#eef2ff'" 
                          title="Descargar Ficha para WhatsApp">
                    <span style="color: #4338ca; font-size: 0.9em; font-weight: bold;">Ficha</span>
                    <span style="font-size: 1.1em;">📸</span>
                  </button>

                  <%# Botón de Ver Evento (Panel) %>
                  <%= link_to gig_path(gig), 
                      style: "background: #f0fdf4; border: 1px solid #86efac; padding: 10px 16px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 8px; text-decoration: none; transition: 0.2s; box-shadow: 0 2px 4px rgba(22, 101, 52, 0.05);", 
                      onmouseover: "this.style.backgroundColor='#dcfce7'",
                      onmouseout: "this.style.backgroundColor='#f0fdf4'",
                      title: "Ver Panel del #{venue_mode? ? 'Evento' : 'Show'}" do %>
                    <span style="color: #166534; font-size: 0.9em; font-weight: bold;">Panel</span>
                    <span style="font-size: 1.1em;">📋</span>
                  <% end %>

                  <%# NUEVO Botón de Eliminar estilizado %>
                  <%= button_to gig_path(gig), 
                      method: :delete, 
                      data: { turbo_confirm: "¿Estás seguro de que quieres eliminar este #{venue_mode? ? 'evento' : 'show'}? Esto recalculará la prioridad del cliente." }, 
                      style: "background: #fff5f5; border: 1px solid #feb2b2; padding: 10px 16px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: 0.2s; box-shadow: 0 2px 4px rgba(197, 48, 48, 0.05);", 
                      onmouseover: "this.style.backgroundColor='#fed7d7'",
                      onmouseout: "this.style.backgroundColor='#fff5f5'",
                      title: "Eliminar Registro" do %>
                    <span style="color: #c53030; font-size: 0.9em; font-weight: bold;">Eliminar</span>
                    <span style="font-size: 1.1em;">🗑️</span>
                  <% end %>
                </div>

                <%= render 'gigs/flashcard_modal', gig: gig %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div style="padding: 60px 20px; text-align: center; color: #94a3b8;">
        <div style="font-size: 50px; margin-bottom: 10px;">🤷‍♂️</div>
        <h3 style="margin: 0; color: #64748b;">
          <%= params[:date_filter] == 'next' ? (venue_mode? ? 'No hay ningún evento próximo programado' : 'No hay ningún show próximo programado') : (venue_mode? ? 'No se encontraron eventos registrados' : 'No se encontraron shows registrados') %>
        </h3>
        <%= link_to (venue_mode? ? "Ver todos los eventos" : "Ver todos los shows"), gigs_path, style: "display: inline-block; margin-top: 20px; color: #007bff; text-decoration: none; font-weight: bold;" %>
      </div>
    <% end %>
  </div>

  <%# --- RESUMEN DINÁMICO --- %>
  <% if @gigs.any? %>
    <div style="margin-top: 30px; padding: 25px; background: #ffffff; border-radius: 12px; border: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h3 style="margin: 0; color: #64748b; font-size: 0.9em; text-transform: uppercase; letter-spacing: 1px;"><%= venue_mode? ? 'Cobrado en Eventos Filtrados' : 'Cobrado en Shows Filtrados' %></h3>
        <p style="margin: 5px 0 0 0; font-size: 1.5em; font-weight: bold;">
          <span style="color: #10b981;">$ <%= number_with_precision(@total_usd, precision: 2) %> USD</span>
        </p>
      </div>
      <div style="text-align: right; color: #94a3b8; font-size: 0.9em;">
        Resultados: <strong><%= @gigs.count %></strong> <%= venue_mode? ? 'eventos' : 'shows' %>
      </div>
    </div>
  <% end %>

</div>