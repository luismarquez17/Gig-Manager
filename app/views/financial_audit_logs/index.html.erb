<div style="max-width: 1200px; margin: 0 auto; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

  <%# --- HEADER --- %>
  <header style="margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
          <h1 style="color: var(--text-heading, #0f172a); font-size: 2em; font-weight: 800; margin: 0; letter-spacing: -0.5px;">
            📋 Libro de Auditoría Financiera
          </h1>
          <span style="background: rgba(59, 130, 246, 0.12); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); font-size: 0.75em; font-weight: 800; padding: 3px 10px; border-radius: 9999px; text-transform: uppercase;">
            Inmutable · Anti-Fraude
          </span>
        </div>
        <p style="color: var(--text-muted, #64748b); font-size: 1em; margin: 0;">
          Trazabilidad completa de creaciones, modificaciones de montos, eliminaciones y aprobaciones contables.
        </p>
      </div>

      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <%= link_to "← Volver a Finanzas", financials_dashboard_path, class: "btn-main btn-gray-custom", style: "padding: 8px 16px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9em; display: inline-flex; align-items: center; gap: 6px;" %>
        <%= link_to "🏦 Ver Caja General", cash_register_path, class: "btn-main btn-primary-custom", style: "padding: 8px 16px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9em; display: inline-flex; align-items: center; gap: 6px;" %>
      </div>
    </div>
  </header>

  <%# --- TARJETAS DE RESUMEN DE AUDITORÍA --- %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-bottom: 30px;">
    
    <div class="custom-card" style="padding: 20px; border-radius: 16px;">
      <span style="color: var(--text-muted, #64748b); font-size: 0.75em; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">Total Transacciones</span>
      <h2 style="font-size: 1.8em; margin: 6px 0 0 0; color: var(--text-heading, #0f172a); font-weight: 800;">
        <%= @total_logs_count %>
      </h2>
      <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 4px;">Eventos financieros registrados</div>
    </div>

    <div class="custom-card" style="padding: 20px; border-radius: 16px;">
      <span style="color: var(--text-muted, #64748b); font-size: 0.75em; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">✏️ Modificaciones</span>
      <h2 style="font-size: 1.8em; margin: 6px 0 0 0; color: #d97706; font-weight: 800;">
        <%= @updates_count %>
      </h2>
      <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 4px;">Cambios de montos o datos</div>
    </div>

    <div class="custom-card" style="padding: 20px; border-radius: 16px;">
      <span style="color: var(--text-muted, #64748b); font-size: 0.75em; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">🗑️ Eliminaciones</span>
      <h2 style="font-size: 1.8em; margin: 6px 0 0 0; color: <%= @deletions_count > 0 ? '#ef4444' : 'var(--text-muted, #64748b)' %>; font-weight: 800;">
        <%= @deletions_count %>
      </h2>
      <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 4px;">Registros borrados por usuarios</div>
    </div>

    <div class="custom-card" style="padding: 20px; border-radius: 16px;">
      <span style="color: var(--text-muted, #64748b); font-size: 0.75em; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">✨ Creaciones</span>
      <h2 style="font-size: 1.8em; margin: 6px 0 0 0; color: #10b981; font-weight: 800;">
        <%= @creations_count %>
      </h2>
      <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 4px;">Nuevos cobros, pagos y caja</div>
    </div>

  </div>

  <%# --- FORMULARIO DE FILTROS --- %>
  <div class="custom-card" style="padding: 20px; margin-bottom: 25px; border-radius: 16px;">
    <%= form_with url: financial_audit_logs_path, method: :get, local: true, style: "display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; align-items: end;" do |f| %>
      
      <div>
        <label style="display: block; font-size: 0.75em; font-weight: 700; color: var(--text-muted, #475569); text-transform: uppercase; margin-bottom: 4px;">Acción</label>
        <%= select_tag :action_type, options_for_select([
          ['Todas las acciones', ''],
          ['✨ Creaciones', 'created'],
          ['✏️ Modificaciones', 'updated'],
          ['🗑️ Eliminaciones', 'deleted'],
          ['✅ Aprobaciones', 'approved'],
          ['❌ Rechazos', 'rejected']
        ], params[:action_type]), class: "form-select form-input-custom", style: "width: 100%; border-radius: 8px; padding: 7px 10px; font-size: 0.9em;" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.75em; font-weight: 700; color: var(--text-muted, #475569); text-transform: uppercase; margin-bottom: 4px;">Tipo de Registro</label>
        <%= select_tag :model_type, options_for_select([
          ['Todos los registros', ''],
          ['🎸 Abonos de Shows (GigPayment)', 'GigPayment'],
          ['👥 Nóminas de Personal (EmployeePayment)', 'EmployeePayment'],
          ['💵 Caja General (CashAdjustment)', 'CashAdjustment']
        ], params[:model_type]), class: "form-select form-input-custom", style: "width: 100%; border-radius: 8px; padding: 7px 10px; font-size: 0.9em;" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.75em; font-weight: 700; color: var(--text-muted, #475569); text-transform: uppercase; margin-bottom: 4px;">Usuario Responsable</label>
        <%= select_tag :user_id, options_for_select(
          [['Todos los usuarios', '']] + @users_for_filter.map { |u| [u.display_name, u.id] },
          params[:user_id]
        ), class: "form-select form-input-custom", style: "width: 100%; border-radius: 8px; padding: 7px 10px; font-size: 0.9em;" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.75em; font-weight: 700; color: var(--text-muted, #475569); text-transform: uppercase; margin-bottom: 4px;">Buscar por texto / motivo</label>
        <%= text_field_tag :query, params[:query], placeholder: "Ej. error, corrección, nombre...", class: "form-input-custom", style: "width: 100%; border-radius: 8px; padding: 7px 10px; font-size: 0.9em;" %>
      </div>

      <div style="display: flex; gap: 8px;">
        <%= submit_tag "Filtrar", class: "btn-main btn-primary-custom", style: "flex: 1; border: none; border-radius: 8px; padding: 8px 14px; font-weight: 700; font-size: 0.9em; cursor: pointer;" %>
        <% if params[:action_type].present? || params[:model_type].present? || params[:user_id].present? || params[:query].present? %>
          <%= link_to "Limpiar", financial_audit_logs_path, class: "btn-main btn-gray-custom", style: "border-radius: 8px; padding: 8px 12px; font-weight: 700; text-decoration: none; font-size: 0.9em;" %>
        <% end %>
      </div>

    <% end %>
  </div>

  <%# --- TABLA DE REGISTROS DE AUDITORÍA --- %>
  <div class="table-custom-wrapper">
    
    <% if @logs.any? %>
      <div style="overflow-x: auto;">
        <table class="table-custom" style="min-width: 860px;">
          <thead>
            <tr>
              <th style="padding: 14px 16px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">Fecha y Hora</th>
              <th style="padding: 14px 16px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">Acción</th>
              <th style="padding: 14px 16px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">Registro / Tipo</th>
              <th style="padding: 14px 16px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">Monto / Impacto</th>
              <th style="padding: 14px 16px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">Responsable</th>
              <th style="padding: 14px 16px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">Motivo & Detalles</th>
            </tr>
          </thead>
          <tbody>
            <% @logs.each do |log| %>
              <tr>
                
                <%# 1. Fecha %>
                <td style="padding: 14px 16px; white-space: nowrap;">
                  <div style="font-weight: 700; color: var(--text-heading);"><%= log.created_at.strftime("%d/%m/%Y") %></div>
                  <div style="font-size: 0.8em; color: var(--text-muted);"><%= log.created_at.strftime("%I:%M:%S %p") %></div>
                </td>

                <%# 2. Acción %>
                <td style="padding: 14px 16px; white-space: nowrap;">
                  <span style="display: inline-flex; align-items: center; gap: 4px; background: <%= log.action_badge_bg %>; color: <%= log.action_badge_color %>; font-size: 0.8em; font-weight: 800; padding: 3px 10px; border-radius: 6px;">
                    <%= log.action_emoji %> <%= log.action_label %>
                  </span>
                </td>

                <%# 3. Tipo de Registro %>
                <td style="padding: 14px 16px;">
                  <div style="font-weight: 700; color: var(--text-heading);">
                    <%= log.auditable_human_type %>
                  </div>
                  <% if log.details.is_a?(Hash) && log.details['_gig_info'].present? %>
                    <div style="font-size: 0.8em; color: var(--text-muted); margin-top: 3px;">
                      Show: <%= log.details.dig('_gig_info', 'client_name') %> (<%= log.details.dig('_gig_info', 'date') %>)
                    </div>
                  <% elsif log.details.is_a?(Hash) && log.details['_worker_info'].present? %>
                    <div style="font-size: 0.8em; color: var(--text-muted); margin-top: 3px;">
                      Personal: <%= log.details.dig('_worker_info', 'name') %>
                    </div>
                  <% end %>
                </td>

                <%# 4. Monto / Impacto %>
                <td style="padding: 14px 16px; white-space: nowrap;">
                  <span style="font-weight: 800; font-size: 0.95em; color: <%= log.action == 'deleted' ? '#ef4444' : (log.action == 'created' ? '#10b981' : 'var(--text-heading)') %>;">
                    <%= log.formatted_amount_change %>
                  </span>
                </td>

                <%# 5. Responsable %>
                <td style="padding: 14px 16px;">
                  <div style="font-weight: 700; color: var(--text-heading);">
                    <%= log.user_display_name %>
                  </div>
                  <% if log.ip_address.present? %>
                    <div style="font-size: 0.75em; color: var(--text-muted); margin-top: 2px;">IP: <%= log.ip_address %></div>
                  <% end %>
                </td>

                <%# 6. Motivo & Detalles %>
                <td style="padding: 14px 16px; max-width: 340px;">
                  <div style="font-size: 0.9em; color: var(--text-main); font-weight: 500; line-height: 1.4;">
                    <%= log.reason.presence || "Sin motivo especificado" %>
                  </div>

                  <%# Si hubo cambios específicos de campos %>
                  <% changes_list = log.humanized_changes %>
                  <% if changes_list.any? %>
                    <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 5px;">
                      <% changes_list.each do |c| %>
                        <div style="font-size: 0.76em; background: var(--bg-card-subtle, #f8fafc); border: 1px solid var(--border-color, #e2e8f0); border-radius: 6px; padding: 4px 8px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                          <span style="font-weight: 700; color: var(--text-muted, #475569);"><%= c[:field] %>:</span>
                          <span style="color: var(--text-main, #64748b); background: var(--bg-card, #f1f5f9); border: 1px solid var(--border-subtle, #cbd5e1); padding: 1px 6px; border-radius: 4px; font-weight: 600;"><%= c[:before] %></span>
                          <span style="color: var(--text-muted, #94a3b8); font-size: 0.9em;">➔</span>
                          <span style="color: #10b981; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); padding: 1px 6px; border-radius: 4px; font-weight: 700;"><%= c[:after] %></span>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </td>

              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div style="text-align: center; padding: 60px 20px;">
        <div style="font-size: 3em; margin-bottom: 12px;">🛡️</div>
        <h3 style="color: var(--text-heading); font-weight: 800; margin-bottom: 6px;">No se encontraron registros de auditoría</h3>
        <p style="color: var(--text-muted); font-size: 0.95em; max-width: 450px; margin: 0 auto;">
          Los movimientos financieros que registres, modifiques o elimines aparecerán aquí con su registro inmutable de trazabilidad.
        </p>
      </div>
    <% end %>

  </div>

</div>
