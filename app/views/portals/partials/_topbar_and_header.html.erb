<%# --- BARRA SUPERIOR DE ACCESO / CONTROL DEL CLIENTE --- %>
<div style="display: flex; justify-content: space-between; align-items: center; background: rgba(15, 23, 42, 0.65); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 18px; padding: 12px 18px; margin-bottom: 25px; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); flex-wrap: wrap; gap: 10px;">
  <div style="display: flex; align-items: center; gap: 10px;">
    <span style="font-size: 1.2em;">💎</span>
    <span style="font-size: 0.9em; font-weight: 700; color: #f1f5f9;"><%= @gig.company&.name || "Portal de Evento" %></span>
  </div>

  <div>
    <% if user_signed_in? && current_user.client? %>
      <%= link_to client_gig_path(@gig), style: "background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 8px 16px; border-radius: 10px; font-weight: 800; font-size: 0.85em; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);" do %>
        <span>👤</span> <%= current_user.display_name %> • Ir a Mi Panel ➔
      <% end %>
    <% elsif user_signed_in? && (current_user.leader? || current_user.superadmin? || current_user.staff? || current_user.musician?) %>
      <%= link_to gig_path(@gig), style: "background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #cbd5e1; padding: 8px 14px; border-radius: 10px; font-weight: 700; font-size: 0.82em; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;" do %>
        <span>👑</span> Vista Previa (Admin) • Volver a la App ➔
      <% end %>
    <% else %>
      <button type="button" onclick="openClientAuthModal()" style="background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%); color: white; padding: 8px 18px; border-radius: 10px; font-weight: 800; font-size: 0.85em; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.25); transition: 0.2s;">
        <span>🔑</span> Iniciar Sesión / Controlar Evento
      </button>
    <% end %>
  </div>
</div>

<% if flash[:alert] %>
  <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 12px 16px; border-radius: 14px; font-size: 0.9em; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
    <span>⚠️</span> <span><%= flash[:alert] %></span>
  </div>
<% end %>

<% if flash[:notice] %>
  <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; padding: 12px 16px; border-radius: 14px; font-size: 0.9em; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
    <span>✅</span> <span><%= flash[:notice] %></span>
  </div>
<% end %>

<%# --- HEADER DEL PORTAL --- %>
<header class="portal-header">
  <span class="badge">Portal Oficial • <%= @gig.company&.name || "Gig Manager" %></span>
  <h1 class="title-accent">El <%= @gig.company&.term_for(:event_singular, 'Evento') %> de <%= @gig.client&.name || "Cliente" %></h1>

  <p>
    <span>📅 <%= @gig.date&.strftime("%d/%m/%Y") || "Fecha por definir" %></span>
    <span>•</span>
    <span>📍 <%= @gig.location.presence || "Ubicación por confirmar" %></span>
    <% if @gig.formatted_time_range.present? %>
      <span>•</span>
      <span>🕐 <%= @gig.formatted_time_range %></span>
    <% end %>
  </p>
</header>

<%# --- BANNER DE CONTROL TOTAL DE EVENTO PARA EL CLIENTE --- %>
<section class="glass-card" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(6, 182, 212, 0.12) 100%); border: 1px solid rgba(139, 92, 246, 0.35); margin-bottom: 30px;">
  <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start; justify-content: space-between;">
    <div style="flex-grow: 1;">
      <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(139, 92, 246, 0.25); color: #c084fc; padding: 4px 12px; border-radius: 99px; font-size: 0.78em; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">
        <span>✨</span> Acceso para Clientes
      </div>
      <h3 style="font-size: 1.35em; font-weight: 800; margin: 0 0 6px 0; color: #ffffff; font-family: var(--font-outfit);">
        🎮 Toma el Control Total de tu Evento
      </h3>
      <p style="color: #cbd5e1; font-size: 0.92em; margin: 0; line-height: 1.5; max-width: 650px;">
        Inicia sesión o activa tu cuenta de cliente para ver todas tus opciones, reportar y verificar tus abonos en tiempo real, solicitar servicios adicionales y mantenerte al día con el equipo de <%= @gig.company&.name || "la empresa" %>.
      </p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
      <% if user_signed_in? && current_user.client? %>
        <%= link_to client_gig_path(@gig), style: "background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 12px 22px; border-radius: 14px; font-weight: 800; font-size: 0.95em; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);" do %>
          <span>🚀</span> Ir a Mi Panel de Control ➔
        <% end %>
      <% else %>
        <button type="button" onclick="openClientAuthModal()" style="background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%); color: white; padding: 12px 22px; border-radius: 14px; font-weight: 800; font-size: 0.95em; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.35); transition: transform 0.2s;">
          <span>🔑</span> Iniciar Sesión / Activar Cuenta
        </button>
        <%= link_to access_public_portal_path(@gig.portal_token), style: "background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #f8fafc; padding: 11px 18px; border-radius: 14px; font-weight: 700; font-size: 0.9em; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;" do %>
          <span>⚙️</span> Opciones
        <% end %>
      <% end %>
    </div>
  </div>
</section>
