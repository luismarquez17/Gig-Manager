<%
  portal_rate_info ||= (@gig.company&.exchange_rate_details rescue nil) || ExchangeRateService.today_rate_info(@gig.company)
  portal_effective_rate ||= portal_rate_info[:effective_rate].to_f
  portal_formatted_rate ||= portal_rate_info[:formatted_effective_rate]
%>

<%# --- JAVASCRIPT --- %>
<script>
  // 1. Lógica de la cuenta regresiva
  (function() {
    const gigDateStr = '<%= @gig.date&.to_s %>';
    if (!gigDateStr) return;

    let timerInterval = null;
    const targetDate = new Date(`${gigDateStr}T20:00:00`).getTime();
    const lblElement = document.getElementById('countdown-label');

    const updateCountdown = () => {
      const now = new Date().getTime();
      const diff = targetDate - now;

      if (diff <= 0) {
        const eventDayStart = new Date(`${gigDateStr}T00:00:00`).getTime();
        const eventDayEnd = new Date(`${gigDateStr}T23:59:59`).getTime();
        const currentNow = new Date().getTime();

        const d = document.getElementById('cd-days');
        const h = document.getElementById('cd-hours');
        const m = document.getElementById('cd-minutes');
        const s = document.getElementById('cd-seconds');
        if (d) d.textContent = '00';
        if (h) h.textContent = '00';
        if (m) m.textContent = '00';
        if (s) s.textContent = '00';

        if (lblElement) {
          if (currentNow >= eventDayStart && currentNow <= eventDayEnd) {
            lblElement.textContent = "¡TU EVENTO ES HOY! ¡A DISFRUTAR!";
            lblElement.style.color = "#10b981";
          } else {
            lblElement.textContent = "¡Evento Finalizado! Gracias por tu preferencia.";
            lblElement.style.color = '#94a3b8';
          }
        }
        if (timerInterval) clearInterval(timerInterval);
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      const d = document.getElementById('cd-days');
      const h = document.getElementById('cd-hours');
      const m = document.getElementById('cd-minutes');
      const s = document.getElementById('cd-seconds');
      if (d) d.textContent = days.toString().padStart(2, '0');
      if (h) h.textContent = hours.toString().padStart(2, '0');
      if (m) m.textContent = minutes.toString().padStart(2, '0');
      if (s) s.textContent = seconds.toString().padStart(2, '0');
    };

    updateCountdown();
    timerInterval = setInterval(updateCountdown, 1000);
  })();

  // 2. Firma digital por AJAX
  window.submitContractSignature = function() {
    const sigInput = document.getElementById('signature-input');
    const signatureName = sigInput ? sigInput.value.trim() : '';
    
    if (!signatureName) {
      if (sigInput) sigInput.style.borderColor = 'var(--danger)';
      alert("Por favor, escribe tu nombre completo para poder firmar.");
      return;
    }

    const btn = document.getElementById('btn-sign-contract');
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Firmando Contrato...";
    }

    const token = '<%= @gig.portal_token %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    fetch(`/portal/${token}/sign`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ signature_name: signatureName })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const signatureSection = document.getElementById('signature-section');
        if (signatureSection) {
          signatureSection.innerHTML = `
            <div class="signed-badge" style="animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <div class="signed-details">
                <h4 style="margin: 0 0 5px 0; font-size: 1.05em; font-weight: 800;">Contrato Firmado Digitalmente</h4>
                <p><strong>Firmante:</strong> ${data.name}</p>
                <p><strong>Fecha/Hora:</strong> ${data.signed_at}</p>
                <p><strong>IP de Registro:</strong> ${data.ip}</p>
              </div>
            </div>
          `;
        }
      } else {
        alert("Error al firmar contrato: " + (data.error || "Ocurrió un error."));
        if (btn) {
          btn.disabled = false;
          btn.textContent = "✍️ Aceptar Términos y Firmar Contrato";
        }
      }
    })
    .catch(() => {
      alert("Error de red. Intenta de nuevo.");
      if (btn) {
        btn.disabled = false;
        btn.textContent = "✍️ Aceptar Términos y Firmar Contrato";
      }
    });
  };

  // 3. Modal y Solicitud de Adicional (Upsell)
  let activeUpsell = null;

  window.openUpsellModalFromButton = function(btn) {
    if (!btn) return;
    const key = btn.getAttribute('data-key') || '';
    const title = btn.getAttribute('data-title') || '';
    const emoji = btn.getAttribute('data-emoji') || '🚀';
    const price = parseFloat(btn.getAttribute('data-price')) || 0;
    const currency = btn.getAttribute('data-currency') || 'USD';
    const description = btn.getAttribute('data-description') || '';
    window.openUpsellModal(key, title, emoji, price, currency, description);
  };

  window.openUpsellModal = function(key, title, emoji, price, currency, description) {
    activeUpsell = {
      key: key,
      title: title,
      emoji: emoji || '🚀',
      price: parseFloat(price) || 0,
      currency: currency || 'USD',
      description: description || ''
    };

    const emojiEl = document.getElementById('modal-upsell-emoji');
    if (emojiEl) emojiEl.textContent = activeUpsell.emoji;

    const titleEl = document.getElementById('modal-upsell-title');
    if (titleEl) titleEl.textContent = activeUpsell.title;

    const formattedPrice = Number(activeUpsell.price).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    const symbol = activeUpsell.currency === 'USD' ? '$' : 'Bs. ';
    const priceEl = document.getElementById('modal-upsell-price');
    if (priceEl) priceEl.textContent = `+ ${symbol}${formattedPrice} ${activeUpsell.currency}`;

    const descEl = document.getElementById('modal-upsell-desc');
    if (descEl) {
      descEl.textContent = activeUpsell.description || "¿Deseas solicitar este servicio adicional para tu evento? El equipo organizador recibirá tu aviso y confirmará la disponibilidad.";
    }

    const btn = document.getElementById('btn-confirm-upsell');
    if (btn) {
      btn.disabled = false;
      btn.textContent = "✅ Sí, solicitar adicional";
    }

    const modal = document.getElementById('upsell-confirm-modal');
    if (modal) {
      modal.style.display = 'flex';
    }
  };

  window.closeUpsellModal = function() {
    const modal = document.getElementById('upsell-confirm-modal');
    if (modal) modal.style.display = 'none';
    activeUpsell = null;
  };

  window.confirmUpsellRequest = function() {
    if (!activeUpsell) return;

    const btn = document.getElementById('btn-confirm-upsell');
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Enviando solicitud...";
    }

    const token = '<%= @gig.portal_token %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    fetch(`/portal/${token}/request_upsell`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        upsell_key: activeUpsell.key,
        title: activeUpsell.title,
        emoji: activeUpsell.emoji,
        price: activeUpsell.price,
        currency: activeUpsell.currency
      })
    })
    .then(res => {
      if (!res.ok && res.status !== 422) {
        throw new Error("HTTP error " + res.status);
      }
      return res.json();
    })
    .then(data => {
      if (data.success) {
        const savedUpsell = Object.assign({}, activeUpsell);
        window.closeUpsellModal();

        const actionContainer = document.getElementById(`upsell-action-${data.request?.key || savedUpsell.key}`);
        if (actionContainer) {
          const priceFormatted = Number(savedUpsell.price).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
          const symbol = savedUpsell.currency === 'USD' ? '$' : 'Bs. ';
          actionContainer.innerHTML = `
            <span style="font-weight: 800; color: #34d399; font-size: 1.05em; font-family: var(--font-outfit);">
              +${symbol}${priceFormatted} <span style="font-size: 0.7em; color: var(--text-muted); font-weight: normal;">${savedUpsell.currency}</span>
            </span>
            <span style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #fbbf24; padding: 5px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78em; animation: scaleIn 0.35s ease;">
              ⏳ Solicitud Enviada
            </span>
          `;
        }

        alert(data.message || "¡Solicitud enviada con éxito! El equipo organizador fue notificado y confirmará la disponibilidad a la brevedad.");
      } else {
        alert("Error al solicitar adicional: " + (data.error || "Ocurrió un error."));
        if (btn) {
          btn.disabled = false;
          btn.textContent = "✅ Sí, solicitar adicional";
        }
      }
    })
    .catch((err) => {
      console.error("Error en upsell:", err);
      alert("Error de red al enviar la solicitud.");
      if (btn) {
        btn.disabled = false;
        btn.textContent = "✅ Sí, solicitar adicional";
      }
    });
  };

  // Delegación de eventos para clicks en botones de upsell
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('button[data-key]');
    if (btn) {
      e.preventDefault();
      window.openUpsellModalFromButton(btn);
    }
  });

  // Cerrar al hacer clic fuera del modal
  document.addEventListener('click', function(e) {
    const modal = document.getElementById('upsell-confirm-modal');
    if (modal && e.target === modal) {
      window.closeUpsellModal();
    }
  });

  const portalDailyRate = <%= portal_effective_rate.to_f %>;
  const portalFormattedDailyRate = "<%= portal_formatted_rate %>";

  window.calcPortalVesToUsd = function() {
    const vesInput = document.getElementById('portal_payment_amount_ves');
    const usdInput = document.getElementById('portal_payment_amount_usd');
    const refInput = document.getElementById('portal_payment_reference');
    const methodSelect = document.getElementById('portal_payment_method_select');
    const vesVal = parseFloat(vesInput?.value) || 0;

    if (portalDailyRate > 0) {
      const usdVal = (vesVal / portalDailyRate).toFixed(2);
      if (usdInput) usdInput.value = usdVal > 0 ? usdVal : '';
      if (methodSelect && (methodSelect.value === 'zelle' || methodSelect.value === 'cash')) {
        methodSelect.value = 'mobile_pay';
      }
    }
  };

  window.calcPortalUsdToVes = function() {
    const vesInput = document.getElementById('portal_payment_amount_ves');
    const usdInput = document.getElementById('portal_payment_amount_usd');
    const usdVal = parseFloat(usdInput?.value) || 0;

    if (portalDailyRate > 0) {
      const vesVal = (usdVal * portalDailyRate).toFixed(2);
      if (vesInput) vesInput.value = vesVal > 0 ? vesVal : '';
    }
  };

  // --- Modal de Autenticación de Cliente ---
  window.openClientAuthModal = function() {
    const modal = document.getElementById('client-auth-modal');
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeClientAuthModal = function() {
    const modal = document.getElementById('client-auth-modal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = 'auto';
    }
  };

  window.switchAuthTab = function(tab) {
    const loginPanel = document.getElementById('auth-panel-login');
    const signupPanel = document.getElementById('auth-panel-signup');
    const loginBtn = document.getElementById('tab-btn-login');
    const signupBtn = document.getElementById('tab-btn-signup');

    if (tab === 'login') {
      if (loginPanel) loginPanel.style.display = 'block';
      if (signupPanel) signupPanel.style.display = 'none';
      if (loginBtn) {
        loginBtn.style.background = 'linear-gradient(135deg, #8b5cf6, #6366f1)';
        loginBtn.style.color = '#ffffff';
      }
      if (signupBtn) {
        signupBtn.style.background = 'transparent';
        signupBtn.style.color = '#94a3b8';
      }
    } else {
      if (loginPanel) loginPanel.style.display = 'none';
      if (signupPanel) signupPanel.style.display = 'block';
      if (signupBtn) {
        signupBtn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
        signupBtn.style.color = '#ffffff';
      }
      if (loginBtn) {
        loginBtn.style.background = 'transparent';
        loginBtn.style.color = '#94a3b8';
      }
    }
  };

  document.addEventListener('click', function(e) {
    const authModal = document.getElementById('client-auth-modal');
    if (authModal && e.target === authModal) {
      window.closeClientAuthModal();
    }
  });
</script>
