<%# --- CRONOGRAMA / TIMELINE --- %>
<% if @gig.company&.module_enabled?(:gigs) %>
  <section class="glass-card">
    <h2 class="section-title">
      <span class="icon">📅</span>
      Cronograma y Agenda del Evento
    </h2>

    <% if @timeline_items.any? %>
      <div class="timeline-container">
        <% @timeline_items.each do |item| %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">⏰ <%= item.time %></div>
            <div class="timeline-title"><%= item.title %></div>
            <% if item.description.present? %>
              <div class="timeline-desc"><%= item.description %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="text-align: center; padding: 30px 10px; color: var(--text-muted);">
        <p style="font-size: 35px; margin: 0 0 10px 0;">⏳</p>
        <p style="font-weight: 700; margin: 0; font-size: 1.05em; color: var(--text-main);">Cronograma en preparación</p>
        <p style="margin: 5px 0 0 0; font-size: 0.9em; line-height: 1.5;">El equipo organizador está afinando los detalles de la agenda de tu evento. Una vez listos, verás las horas y actividades aquí en tiempo real.</p>
      </div>
    <% end %>
  </section>
<% end %>
