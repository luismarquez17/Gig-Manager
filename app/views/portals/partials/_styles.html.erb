<style>
  /* Glassmorphism card styles */
  .glass-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    border-radius: 24px;
    padding: 30px;
    margin-bottom: 30px;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .glass-card:hover {
    border-color: var(--card-border-hover);
    box-shadow: 0 12px 40px 0 rgba(139, 92, 246, 0.15);
    transform: translateY(-2px);
  }

  /* Typography helpers */
  .title-accent {
    background: linear-gradient(135deg, #a78bfa 0%, #22d3ee 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--font-outfit);
    font-weight: 800;
  }

  /* Header Styles */
  .portal-header {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
  }
  .portal-header .badge {
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #c084fc;
    padding: 6px 16px;
    border-radius: 99px;
    font-size: 0.85em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    display: inline-block;
    margin-bottom: 15px;
  }
  .portal-header h1 {
    font-size: 2.8em;
    margin: 0 0 10px 0;
    line-height: 1.2;
    letter-spacing: -1px;
  }
  .portal-header p {
    color: var(--text-muted);
    font-size: 1.1em;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Countdown grid */
  .countdown-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    text-align: center;
    margin-top: 10px;
  }
  .countdown-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 15px 10px;
  }
  .countdown-box .val {
    font-family: var(--font-outfit);
    font-size: 2.5em;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 5px;
    background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .countdown-box .lbl {
    color: var(--text-muted);
    font-size: 0.75em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .countdown-title {
    text-align: center;
    font-family: var(--font-outfit);
    font-size: 1.1em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #a78bfa;
    margin-bottom: 20px;
  }

  @media (max-width: 500px) {
    .countdown-container {
      grid-template-columns: repeat(2, 1fr);
    }
    .countdown-box .val {
      font-size: 2em;
    }
  }

  /* Section Headings */
  .section-title {
    font-family: var(--font-outfit);
    font-size: 1.4em;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 20px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-title span.icon {
    background: var(--primary-glow);
    border: 1px solid rgba(139, 92, 246, 0.2);
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9em;
    color: #c084fc;
  }

  /* Finance dashboard styles */
  .finance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 25px;
  }
  .finance-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 20px;
  }
  .finance-card .lbl {
    font-size: 0.8em;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .finance-card .val {
    font-family: var(--font-outfit);
    font-size: 1.6em;
    font-weight: 800;
  }
  .finance-card.val-total .val { color: var(--text-main); }
  .finance-card.val-paid .val { color: var(--success); }
  .finance-card.val-remaining .val { color: var(--warning); }

  @media (max-width: 600px) {
    .finance-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
  }

  /* Progress Bar */
  .progress-container {
    margin-bottom: 30px;
  }
  .progress-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9em;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .progress-track {
    background: rgba(255, 255, 255, 0.06);
    height: 12px;
    border-radius: 99px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.03);
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, #06b6d4 100%);
    border-radius: 99px;
    box-shadow: 0 0 12px var(--primary-glow);
    transition: width 1s ease-in-out;
  }

  /* Table styling */
  .table-wrapper {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0, 0, 0, 0.15);
  }
  .portal-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .portal-table th {
    background: rgba(255, 255, 255, 0.02);
    padding: 14px 18px;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.85em;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .portal-table td {
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 0.95em;
  }
  .portal-table tr:last-child td {
    border-bottom: none;
  }

  /* Timeline Styles */
  .timeline-container {
    position: relative;
    padding-left: 30px;
    margin-left: 10px;
  }
  .timeline-container::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    bottom: 5px;
    width: 2px;
    background: linear-gradient(180deg, var(--primary) 0%, rgba(6, 182, 212, 0.3) 100%);
  }
  .timeline-item {
    position: relative;
    margin-bottom: 25px;
  }
  .timeline-item:last-child {
    margin-bottom: 0;
  }
  .timeline-dot {
    position: absolute;
    left: -35px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-dark);
    border: 3px solid var(--primary);
    box-shadow: 0 0 8px var(--primary);
  }
  .timeline-time {
    font-family: var(--font-outfit);
    font-weight: 800;
    color: #c084fc;
    font-size: 0.9em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .timeline-title {
    font-weight: 700;
    font-size: 1.1em;
    color: var(--text-main);
    margin-bottom: 6px;
  }
  .timeline-desc {
    color: var(--text-muted);
    font-size: 0.9em;
    line-height: 1.4;
  }

  /* Contract Signature panel */
  .contract-content {
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    padding: 20px;
    max-height: 250px;
    overflow-y: auto;
    font-size: 0.95em;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 20px;
    white-space: pre-line;
  }
  
  .signature-box {
    background: rgba(139, 92, 246, 0.04);
    border: 1px dashed rgba(139, 92, 246, 0.2);
    border-radius: 16px;
    padding: 20px;
    margin-top: 15px;
  }
  
  .signed-badge {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .signed-badge svg {
    flex-shrink: 0;
    color: var(--success);
  }
  
  .signed-details p {
    margin: 2px 0;
    font-size: 0.9em;
  }
  
  /* Input & Button styling */
  .form-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    color: white;
    font-family: inherit;
    font-size: 1em;
    box-sizing: border-box;
    outline: none;
    margin-bottom: 12px;
    transition: border-color 0.3s;
  }
  .form-input:focus {
    border-color: var(--primary);
  }
  
  .btn-portal {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    font-size: 1em;
    width: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 12px var(--primary-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .btn-portal:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px var(--primary-glow);
  }
  .btn-portal:active {
    transform: translateY(0);
  }
  .btn-portal:disabled {
    background: #475569;
    color: #94a3b8;
    cursor: not-allowed;
    box-shadow: none;
  }

  .btn-whatsapp {
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.2);
  }
  .btn-whatsapp:hover {
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.3);
  }

  .alert-warning {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    color: #fbd38d;
    padding: 12px 16px;
    border-radius: 12px;
    margin-bottom: 15px;
    font-size: 0.9em;
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>
