<div style="max-width: 580px; margin: 40px auto; padding: 0 16px; font-family: var(--font-jakarta, sans-serif);">
  
  <div class="glass-card" style="padding: 34px 28px; border-radius: 24px; text-align: center; border-color: rgba(139, 92, 246, 0.35); box-shadow: 0 12px 40px rgba(0,0,0,0.5);">
    
    <%# Icono y Encabezado %>
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border-radius: 22px; background: linear-gradient(135deg, rgba(139, 92, 246, 0.25), rgba(6, 182, 212, 0.25)); border: 1px solid rgba(139, 92, 246, 0.4); font-size: 2.2rem; margin-bottom: 18px;">
      🎮
    </div>

    <h2 style="font-size: 1.7rem; font-weight: 800; color: #f8fafc; margin: 0 0 8px 0; font-family: var(--font-outfit, sans-serif); letter-spacing: -0.5px;">
      Control Total de tu Evento
    </h2>

    <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.5; margin: 0 0 12px 0;">
      Accede a tu panel privado de cliente para <strong><%= @gig.company&.name || "la agrupación" %></strong> y gestiona tus opciones, abonos y detalles en tiempo real.
    </p>

    <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 99px; padding: 6px 16px; font-size: 0.85rem; color: #94a3b8; margin-bottom: 24px;">
      <span>📅 <%= @gig.date ? @gig.date.strftime("%d/%m/%Y") : "Fecha por definir" %></span>
      <span>•</span>
      <span>📍 <%= @gig.location.presence || "Evento" %></span>
    </div>

    <% if flash[:alert] %>
      <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 12px 16px; border-radius: 12px; font-size: 0.88rem; margin-bottom: 20px; text-align: left; display: flex; align-items: center; gap: 8px;">
        <span>⚠️</span> <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; padding: 12px 16px; border-radius: 12px; font-size: 0.88rem; margin-bottom: 20px; text-align: left; display: flex; align-items: center; gap: 8px;">
        <span>✅</span> <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <%# Formulario para Iniciar Sesión (Si ya tiene contraseña) %>
    <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 22px; text-align: left; margin-bottom: 22px;">
      <h3 style="font-size: 1.05rem; font-weight: 800; color: #a78bfa; margin: 0 0 6px 0; font-family: var(--font-outfit); display: flex; align-items: center; gap: 8px;">
        <span>🔑</span> Iniciar Sesión con tu Contraseña
      </h3>
      <p style="color: #94a3b8; font-size: 0.83rem; margin: 0 0 16px 0;">
        Si ya creaste tu cuenta anteriormente, ingresa con tu correo y contraseña:
      </p>

      <%= form_with(url: login_public_portal_path(@gig.portal_token), method: :post, local: true, style: "display: flex; flex-direction: column; gap: 14px;") do |f| %>
        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px;">
            Correo Electrónico
          </label>
          <input type="email" name="email" value="<%= @gig.client_email.presence || @gig.client&.email %>" required placeholder="tu@email.com" style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
        </div>

        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px;">
            Contraseña
          </label>
          <input type="password" name="password" required placeholder="Tu contraseña" style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
        </div>

        <button type="submit" style="background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%); color: white; padding: 12px 18px; border-radius: 12px; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3); transition: transform 0.2s;">
          <span>🚀</span> Iniciar Sesión y Entrar al Panel
        </button>
      <% end %>
    </div>

    <%# Formulario para Crear / Activar Contraseña Personal %>
    <details style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 18px; padding: 18px 20px; text-align: left; margin-bottom: 24px;">
      <summary style="cursor: pointer; font-weight: 800; color: #22d3ee; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center;">
        <span style="display: flex; align-items: center; gap: 8px;">
          <span>✨</span> ¿Primera vez? Activa tu cuenta personal
        </span>
        <span style="font-size: 0.8em; color: #94a3b8;">▼ Desplegar</span>
      </summary>

      <div style="margin-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.06); padding-top: 16px;">
        <p style="color: #94a3b8; font-size: 0.83rem; margin: 0 0 16px 0; line-height: 1.4;">
          Elige una contraseña personal para proteger tu información y acceder a todos tus eventos desde cualquier dispositivo:
        </p>

        <%= form_with(url: setup_password_public_portal_path(@gig.portal_token), method: :post, local: true, style: "display: flex; flex-direction: column; gap: 14px;") do |f| %>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px;">
              Correo Electrónico
            </label>
            <input type="email" name="email" value="<%= @gig.client_email.presence || @gig.client&.email %>" required placeholder="tu@email.com" style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
          </div>

          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px;">
              Nueva Contraseña Personal
            </label>
            <input type="password" name="password" required minlength="6" placeholder="Mínimo 6 caracteres" style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
          </div>

          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px;">
              Confirmar Contraseña
            </label>
            <input type="password" name="password_confirmation" required minlength="6" placeholder="Repite tu contraseña" style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
          </div>

          <button type="submit" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 12px 18px; border-radius: 12px; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);">
            <span>🔒</span> Activar Cuenta y Entrar al Panel
          </button>
        <% end %>
      </div>
    </details>

    <%# Enlace para regresar al portal público %>
    <div style="margin-top: 20px;">
      <%= link_to "← Volver al Portal del Evento", public_portal_path(@gig.portal_token), style: "color: #94a3b8; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 600;" %>
    </div>

  </div>

</div>
