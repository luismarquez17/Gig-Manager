          <h4 style="font-family: var(--font-outfit); font-size: 1.05em; font-weight: 700; margin: 0 0 12px 0; color: #38bdf8; display: flex; align-items: center; gap: 8px;">
            <span>💳</span> Métodos de Pago Oficiales
          </h4>
          <%= render 'shared/payment_methods_cards', company: @gig.company, dark_theme: true %>
        </div>
      <% end %>

      <%# Recordatorio de Suministro Eléctrico / Planta %>
      <div style="margin-top: 20px; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 16px; padding: 16px 20px; color: #fef08a; display: flex; align-items: flex-start; gap: 14px;">
        <span style="font-size: 1.5em; flex-shrink: 0; line-height: 1;">⚡</span>
        <div>
          <h4 style="margin: 0 0 4px 0; font-size: 0.95em; font-weight: 800; color: #fbbf24; text-transform: uppercase; letter-spacing: 0.5px;">Recordatorio Importante: Suministro Eléctrico</h4>
