            <div>
              <label style="display: block; font-size: 0.8em; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">
                Monto del Abono ($ USD) *
              </label>
              <%= text_field_tag :amount, (@gig.remaining_amount.positive? ? sprintf('%.2f', @gig.remaining_amount) : ''), placeholder: "0.00", required: true, style: "width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 10px 14px; font-size: 1.1em; font-weight: 800; color: white; box-sizing: border-box;" %>
            </div>

            <div>
              <label style="display: block; font-size: 0.8em; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">
