              <%= select_tag :payment_method, options_for_select(GigPayment::PAYMENT_METHODS.map { |k, v| ["#{v[:emoji]} #{v[:label]}", k] }, 'zelle'), style: "width: 100%; background: #0f172a; border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 10px 14px; font-size: 0.95em; font-weight: 700; color: white; box-sizing: border-box;" %>
            </div>

            <div>
              <label style="display: block; font-size: 0.8em; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">
