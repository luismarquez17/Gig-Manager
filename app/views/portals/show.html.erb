<style>
  /* Glassmorphism card styles */
  .glass-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    border-radius: 24px;
    padding: 30px;
    margin-bottom: 30px;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .glass-card:hover {
    border-color: var(--card-border-hover);
    box-shadow: 0 12px 40px 0 rgba(139, 92, 246, 0.15);
    transform: translateY(-2px);
  }

  /* Typography helpers */
  .title-accent {
    background: linear-gradient(135deg, #a78bfa 0%, #22d3ee 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--font-outfit);
    font-weight: 800;
  }

  /* Header Styles */
  .portal-header {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
  }
  .portal-header .badge {
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #c084fc;
    padding: 6px 16px;
    border-radius: 99px;
    font-size: 0.85em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    display: inline-block;
    margin-bottom: 15px;
  }
  .portal-header h1 {
    font-size: 2.8em;
    margin: 0 0 10px 0;
    line-height: 1.2;
    letter-spacing: -1px;
  }
  .portal-header p {
    color: var(--text-muted);
    font-size: 1.1em;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Countdown grid */
  .countdown-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    text-align: center;
    margin-top: 10px;
  }
  .countdown-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 15px 10px;
  }
  .countdown-box .val {
    font-family: var(--font-outfit);
    font-size: 2.5em;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 5px;
    background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .countdown-box .lbl {
    color: var(--text-muted);
    font-size: 0.75em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .countdown-title {
    text-align: center;
    font-family: var(--font-outfit);
    font-size: 1.1em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #a78bfa;
    margin-bottom: 20px;
  }

  @media (max-width: 500px) {
    .countdown-container {
      grid-template-columns: repeat(2, 1fr);
    }
    .countdown-box .val {
      font-size: 2em;
    }
  }

  /* Section Headings */
  .section-title {
    font-family: var(--font-outfit);
    font-size: 1.4em;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 20px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-title span.icon {
    background: var(--primary-glow);
    border: 1px solid rgba(139, 92, 246, 0.2);
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9em;
    color: #c084fc;
  }

  /* Finance dashboard styles */
  .finance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 25px;
  }
  .finance-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 20px;
  }
  .finance-card .lbl {
    font-size: 0.8em;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .finance-card .val {
    font-family: var(--font-outfit);
    font-size: 1.6em;
    font-weight: 800;
  }
  .finance-card.val-total .val { color: var(--text-main); }
  .finance-card.val-paid .val { color: var(--success); }
  .finance-card.val-remaining .val { color: var(--warning); }

  @media (max-width: 600px) {
    .finance-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
  }

  /* Progress Bar */
  .progress-container {
    margin-bottom: 30px;
  }
  .progress-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9em;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .progress-track {
    background: rgba(255, 255, 255, 0.06);
    height: 12px;
    border-radius: 99px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.03);
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, #06b6d4 100%);
    border-radius: 99px;
    box-shadow: 0 0 12px var(--primary-glow);
    transition: width 1s ease-in-out;
  }

  /* Table styling */
  .table-wrapper {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0, 0, 0, 0.15);
  }
  .portal-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .portal-table th {
    background: rgba(255, 255, 255, 0.02);
    padding: 14px 18px;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.85em;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .portal-table td {
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 0.95em;
  }
  .portal-table tr:last-child td {
    border-bottom: none;
  }

  /* Timeline Styles */
  .timeline-container {
    position: relative;
    padding-left: 30px;
    margin-left: 10px;
  }
  .timeline-container::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    bottom: 5px;
    width: 2px;
    background: linear-gradient(180deg, var(--primary) 0%, rgba(6, 182, 212, 0.3) 100%);
  }
  .timeline-item {
    position: relative;
    margin-bottom: 25px;
  }
  .timeline-item:last-child {
    margin-bottom: 0;
  }
  .timeline-dot {
    position: absolute;
    left: -35px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-dark);
    border: 3px solid var(--primary);
    box-shadow: 0 0 8px var(--primary);
  }
  .timeline-time {
    font-family: var(--font-outfit);
    font-weight: 800;
    color: #c084fc;
    font-size: 0.9em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .timeline-title {
    font-weight: 700;
    font-size: 1.1em;
    color: var(--text-main);
    margin-bottom: 6px;
  }
  .timeline-desc {
    color: var(--text-muted);
    font-size: 0.9em;
    line-height: 1.4;
  }

  /* Contract Signature panel */
  .contract-content {
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    padding: 20px;
    max-height: 250px;
    overflow-y: auto;
    font-size: 0.95em;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 20px;
    white-space: pre-line;
  }
  
  .signature-box {
    background: rgba(139, 92, 246, 0.04);
    border: 1px dashed rgba(139, 92, 246, 0.2);
    border-radius: 16px;
    padding: 20px;
    margin-top: 15px;
  }
  
  .signed-badge {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .signed-badge svg {
    flex-shrink: 0;
    color: var(--success);
  }
  
  .signed-details p {
    margin: 2px 0;
    font-size: 0.9em;
  }
  
  /* Input & Button styling */
  .form-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    color: white;
    font-family: inherit;
    font-size: 1em;
    box-sizing: border-box;
    outline: none;
    margin-bottom: 12px;
    transition: border-color 0.3s;
  }
  .form-input:focus {
    border-color: var(--primary);
  }
  
  .btn-portal {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    font-size: 1em;
    width: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 12px var(--primary-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .btn-portal:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px var(--primary-glow);
  }
  .btn-portal:active {
    transform: translateY(0);
  }
  .btn-portal:disabled {
    background: #475569;
    color: #94a3b8;
    cursor: not-allowed;
    box-shadow: none;
  }

  .btn-whatsapp {
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.2);
  }
  .btn-whatsapp:hover {
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.3);
  }

  .alert-warning {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    color: #fbd38d;
    padding: 12px 16px;
    border-radius: 12px;
    margin-bottom: 15px;
    font-size: 0.9em;
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>

<div class="portal-container">
  
  <%# --- HEADER DEL PORTAL --- %>
  <header class="portal-header">
    <span class="badge">Portal Oficial • <%= @gig.company&.name || "Gig Manager" %></span>
    <h1 class="title-accent">El Evento de <%= @gig.client&.name || "Cliente" %></h1>

    <p>
      <span>📅 <%= @gig.date&.strftime("%d/%m/%Y") || "Fecha por definir" %></span>
      <span>•</span>
      <span>📍 <%= @gig.location.presence || "Ubicación por confirmar" %></span>
      <% if @gig.formatted_time_range.present? %>
        <span>•</span>
        <span>🕐 <%= @gig.formatted_time_range %></span>
      <% end %>
    </p>
  </header>

  <%# --- CUENTA REGRESIVA --- %>
  <section class="glass-card">
    <h2 class="countdown-title" id="countdown-label">Tiempo Restante para el Evento</h2>
    <div class="countdown-container">
      <div class="countdown-box">
        <div class="val" id="cd-days">--</div>
        <div class="lbl">Días</div>
      </div>
      <div class="countdown-box">
        <div class="val" id="cd-hours">--</div>
        <div class="lbl">Horas</div>
      </div>
      <div class="countdown-box">
        <div class="val" id="cd-minutes">--</div>
        <div class="lbl">Minutos</div>
      </div>
      <div class="countdown-box">
        <div class="val" id="cd-seconds">--</div>
        <div class="lbl">Segundos</div>
      </div>
    </div>
  </section>

  <%# --- NORMATIVAS GENERALES DEL SERVICIO --- %>
  <section class="glass-card">
    <h2 class="section-title">
      <span class="icon">📜</span>
      Normativas y Políticas del Servicio
    </h2>

    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 16px; padding: 18px 20px; margin-bottom: 20px; color: #fef08a;">
      <h4 style="margin: 0 0 6px 0; font-size: 1em; font-weight: 800; color: #fbbf24;">💳 REGLA CLAVE DE PAGO</h4>
      <p style="margin: 0; font-size: 0.9em; line-height: 1.5; color: #fef3c7;">
        El evento debe estar <strong>pagado en su totalidad (100%) el mismo día del show</strong>, previo al inicio del montaje del equipamiento técnico.
      </p>
    </div>

    <details style="background: rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 15px; color: #e2e8f0; font-size: 0.9em;">
      <summary style="cursor: pointer; font-weight: 800; color: #a78bfa; font-size: 1em; list-style: none; display: flex; justify-content: space-between; align-items: center;">
        <span>🔍 Ver detalle de Normativas y Requerimientos</span>
        <span style="font-size: 0.8em; opacity: 0.7;">▼ Desplegar</span>
      </summary>
      <div style="margin-top: 15px; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 15px; display: grid; gap: 14px; line-height: 1.5;">
        <div>
          <strong style="color: #67e8f9;">1. Horarios y Horas Extra:</strong> El tiempo contratado inicia puntualmente a la hora acordada. Las extensiones de horario tienen un costo adicional.
        </div>
        <div>
          <strong style="color: #67e8f9;">2. Toma Eléctrica y Techo / Servicio Eléctrico:</strong> Se requiere toma eléctrica estable (110V/220V) a menos de 10m y espacio techado si el evento es al aire libre. <strong>Importante:</strong> No nos hacemos responsables en caso de que donde estemos se vaya la luz, no tenemos planta contratada en nuestro paquete.
        </div>
        <div>
          <strong style="color: #67e8f9;">3. Cuidado del Equipamiento:</strong> Cualquier daño a los equipos o instrumentos ocasionado por invitados será facturado al cliente contratante.
        </div>
        <div>
          <strong style="color: #67e8f9;">4. Políticas de Abono:</strong> Las señas de reserva no son reembolsables en caso de cancelación del evento por causas ajenas a la empresa.
        </div>
      </div>
    </details>
  </section>

  <%# --- RESUMEN DE CONTRATO / CONDICIONES --- %>
  <section class="glass-card">
    <h2 class="section-title">
      <span class="icon">📜</span>
      Resumen de Contrato y Condiciones
    </h2>
    
    <% if @gig.details.present? %>
      <div class="contract-content">
        <%= @gig.details %>
      </div>
    <% else %>
      <div class="alert-warning" style="margin-bottom: 20px;">
        ℹ️ Los detalles del paquete contratado se están terminando de redactar. Pronto aparecerán aquí.
      </div>
    <% end %>

    <%# Panel de Firma Digital %>
    <div id="signature-section">
      <% if @gig.contract_signed? %>
        <div class="signed-badge">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <div class="signed-details">
            <h4 style="margin: 0 0 5px 0; font-size: 1.05em; font-weight: 800;">Contrato Firmado Digitalmente</h4>
            <p><strong>Firmante:</strong> <%= @gig.contract_signed_name %></p>
            <p><strong>Fecha/Hora:</strong> <%= @gig.contract_signed_at&.strftime("%d/%m/%Y %I:%M %p") %></p>
            <p><strong>IP de Registro:</strong> <%= @gig.contract_signed_ip %></p>
          </div>
        </div>
      <% else %>
        <div class="alert-warning">
          ⚠️ El contrato se encuentra pendiente de aprobación. Por favor, lee los términos detallados arriba y fírmalo digitalmente escribiendo tu nombre completo.
        </div>
        <div class="signature-box">
          <label style="display: block; font-weight: 700; font-size: 0.85em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Firma Digital del Cliente</label>
          <input type="text" id="signature-input" placeholder="Escribe tu nombre completo para firmar..." class="form-input">
          <button id="btn-sign-contract" onclick="submitContractSignature()" class="btn-portal">
            ✍️ Aceptar Términos y Firmar Contrato
          </button>
        </div>
      <% end %>
    </div>
  </section>

  <%# --- EQUIPO DE TRABAJO --- %>
  <% if @staff_members.present? %>
  <section class="glass-card">
    <h2 class="section-title">
      <span class="icon">👥</span>
      Tu Equipo de Trabajo
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px;">
      <% @staff_members.each do |staff| %>
        <%= link_to public_portal_worker_path(token: @gig.portal_token, worker_id: staff.id), style: "text-decoration: none; color: inherit; display: block;" do %>
          <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; padding: 20px; text-align: center; height: 100%; box-sizing: border-box; transition: border-color 0.3s, transform 0.3s; cursor: pointer;" onmouseover="this.style.borderColor='rgba(139,92,246,0.3)'; this.style.transform='translateY(-3px)';" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'; this.style.transform='translateY(0)';">
            <% if staff.avatar_attached? %>
              <div style="width: 80px; height: 80px; border-radius: 50%; margin: 0 auto 12px; overflow: hidden; border: 3px solid rgba(139, 92, 246, 0.3); box-shadow: 0 0 15px rgba(139, 92, 246, 0.15); display: flex; align-items: center; justify-content: center;">
                <%= image_tag staff.avatar_url_or_data, style: "width: 100%; height: 100%; object-fit: cover;" %>
              </div>
            <% else %>
              <div style="width: 80px; height: 80px; border-radius: 50%; margin: 0 auto 12px; background: linear-gradient(135deg, #8b5cf6 0%, #06b6d4 100%); display: flex; align-items: center; justify-content: center; font-family: var(--font-outfit); font-size: 1.6em; font-weight: 800; color: white; border: 3px solid rgba(139, 92, 246, 0.3); box-shadow: 0 0 15px rgba(139, 92, 246, 0.15);">
                <%= staff.display_name[0].upcase %>
              </div>
            <% end %>
            <h4 style="margin: 0 0 4px 0; font-family: var(--font-outfit); font-weight: 700; font-size: 1.05em; color: var(--text-main);">
              <%= staff.display_name %>
            </h4>
            <% if staff.specialty.present? %>
              <span style="display: inline-block; background: rgba(139, 92, 246, 0.12); border: 1px solid rgba(139, 92, 246, 0.25); color: #c084fc; padding: 3px 10px; border-radius: 99px; font-size: 0.78em; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
                <%= staff.specialty %>
              </span>
            <% end %>
            <% if staff.bio.present? %>
              <p style="margin: 8px 0 0 0; color: var(--text-muted); font-size: 0.85em; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
                <%= staff.bio %>
              </p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
  <% end %>

  <%# --- ESTADO DE CUENTA / PAGOS --- %>
  <section class="glass-card">
    <h2 class="section-title">
      <span class="icon">💳</span>
      Estado de Cuenta y Pagos
    </h2>

    <div class="finance-grid">
      <div class="finance-card val-total">
        <div class="lbl">Total Acordado</div>
        <div class="val"><%= number_with_precision(@gig.amount, precision: 2) %> <span style="font-size:0.6em; color:var(--text-muted);"><%= @gig.currency %></span></div>
      </div>
      <div class="finance-card val-paid">
        <div class="lbl">Total Abonado</div>
        <div class="val"><%= number_with_precision(@gig.total_received || 0, precision: 2) %> <span style="font-size:0.6em; color:var(--text-muted);"><%= @gig.currency %></span></div>
      </div>
      <div class="finance-card val-remaining">
        <div class="lbl">Saldo Pendiente</div>
        <div class="val"><%= number_with_precision(@gig.remaining_amount || 0, precision: 2) %> <span style="font-size:0.6em; color:var(--text-muted);"><%= @gig.currency %></span></div>
      </div>
    </div>

    <%# Progress bar %>
    <% pct = (@gig.total_received.to_f / (@gig.amount.to_f.nonzero? || 1) * 100).to_f %>
    <div class="progress-container">
      <div class="progress-header">
        <span style="color: var(--text-muted);">Progreso de Pago</span>
        <span style="color: #22d3ee;"><%= pct.round(1) %>% Cobrado</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style="width: <%= [pct, 100].min %>%;"></div>
      </div>
    </div>

    <%# Historial de transacciones %>
    <h3 style="font-family: var(--font-outfit); font-size: 1.05em; font-weight: 700; margin: 0 0 15px 0; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Historial de Transacciones</h3>
    <% if @gig_payments.any? %>
      <div class="table-wrapper">
        <table class="portal-table">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Payer / Cliente</th>
              <th>Concepto / Referencia</th>
              <th style="text-align: right;">Monto</th>
            </tr>
          </thead>
          <tbody>
            <% @gig_payments.each do |p| %>
              <tr>
                <td style="color: var(--text-muted); font-weight: 600;"><%= p.date_paid&.strftime("%d/%m/%Y") || "---" %></td>
                <td style="font-weight: 600; color: var(--text-main);"><%= p.payer_name.presence || "Cliente" %></td>
                <td style="color: var(--text-muted); font-size: 0.9em;">
                  <span style="background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 0.8em; color: var(--text-main); margin-right: 5px;">
                    <%= p.category.presence || "Abono" %>
                  </span>
                  <%= p.notes %>
                </td>
                <td style="text-align: right; font-weight: 800; color: var(--success);">
                  +<%= number_with_precision(p.amount, precision: 2) %> <%= p.currency %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p style="text-align: center; color: var(--text-muted); font-style: italic; margin: 20px 0;">No se han registrado pagos para este show todavía.</p>
    <% end %>

    <%# Reportar nuevo pago %>
    <% if @gig.remaining_amount.positive? %>
      <div style="margin-top: 30px; border-top: 1px dashed rgba(255, 255, 255, 0.08); padding-top: 25px;">
        <p style="font-size: 0.9em; color: var(--text-muted); text-align: center; margin-bottom: 15px;">
          ¿Realizaste un nuevo abono? Envíanos tu comprobante o capture por WhatsApp para que nuestro equipo lo registre.
        </p>
        <%
          whatsapp_number = "584140000000" # Por defecto o configurado si existe
          if @gig.client&.formatted_phone_for_whatsapp.present?
            # En realidad queremos el WhatsApp de la EMPRESA/LÍDER, no del cliente.
            # Supongamos que hay un teléfono corporativo, si no usaremos wa.me/58414... o similar
          end
          # Usamos un texto predefinido
          wa_message = "Hola! Acabo de hacer un pago para el evento de #{@gig.client&.name} del día #{@gig.date&.strftime('%d/%m/%Y')}. Adjunto el comprobante."
          wa_url = "https://wa.me/584140000000?text=#{ERB::Util.url_encode(wa_message)}" # Teléfono placeholder, modificable
        %>
        <a href="<%= wa_url %>" target="_blank" class="btn-portal btn-whatsapp" style="text-decoration: none;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Notificar Pago por WhatsApp
        </a>
      </div>
    <% end %>

    <%# Recordatorio de Suministro Eléctrico / Planta %>
    <div style="margin-top: 25px; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 16px; padding: 16px 20px; color: #fef08a; display: flex; align-items: flex-start; gap: 14px;">
      <span style="font-size: 1.5em; flex-shrink: 0; line-height: 1;">⚡</span>
      <div>
        <h4 style="margin: 0 0 4px 0; font-size: 0.95em; font-weight: 800; color: #fbbf24; text-transform: uppercase; letter-spacing: 0.5px;">Recordatorio Importante: Suministro Eléctrico</h4>
        <p style="margin: 0; font-size: 0.88em; line-height: 1.5; color: #fef3c7;">
          No nos hacemos responsables en caso de donde estemos se vaya la luz, no tenemos planta contratada en nuestro paquete.
        </p>
      </div>
    </div>
  </section>

  <%# --- CRONOGRAMA / TIMELINE --- %>
  <section class="glass-card">
    <h2 class="section-title">
      <span class="icon">📅</span>
      Cronograma y Agenda del Evento
    </h2>

    <% if @timeline_items.any? %>
      <div class="timeline-container">
        <% @timeline_items.each do |item| %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-time">⏰ <%= item.time %></div>
            <div class="timeline-title"><%= item.title %></div>
            <% if item.description.present? %>
              <div class="timeline-desc"><%= item.description %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="text-align: center; padding: 30px 10px; color: var(--text-muted);">
        <p style="font-size: 35px; margin: 0 0 10px 0;">⏳</p>
        <p style="font-weight: 700; margin: 0; font-size: 1.05em; color: var(--text-main);">Cronograma en preparación</p>
        <p style="margin: 5px 0 0 0; font-size: 0.9em; line-height: 1.5;">El equipo organizador está afinando los detalles de la agenda de tu evento. Una vez listos, verás las horas y actividades aquí en tiempo real.</p>
      </div>
    <% end %>
  </section>

  <%# --- SECCIÓN DE ADICIONALES RECOMENDADOS (UPSELL HORIZONTAL) --- %>
  <% available_upsells = @gig.available_upsells %>
  <% if available_upsells.any? %>
    <section class="glass-card" style="border-color: rgba(139, 92, 246, 0.25); box-shadow: 0 8px 32px 0 rgba(139, 92, 246, 0.10); margin-bottom: 30px;">
      <h2 class="section-title" style="color: #a78bfa; margin-bottom: 5px;">
        <span class="icon" style="background: rgba(139, 92, 246, 0.2); color: #c084fc;">🚀</span>
        ¿Quieres potenciar tu evento?
      </h2>
      <p style="color: var(--text-muted); font-size: 0.9em; margin: 0 0 15px 0; line-height: 1.4;">
        Lleva tu fiesta al siguiente nivel agregando uno de nuestros servicios recomendados con un solo clic.
      </p>

      <div style="display: flex; gap: 15px; overflow-x: auto; padding: 5px 5px 15px; scrollbar-width: thin; -webkit-overflow-scrolling: touch;">
        <% available_upsells.each do |upsell| %>
          <div style="flex: 0 0 280px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 16px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.3s ease;" 
               class="upsell-card"
               onmouseover="this.style.transform='translateY(-2px)'; this.style.borderColor='rgba(139, 92, 246, 0.4)'; this.style.background='rgba(139, 92, 246, 0.02)';" 
               onmouseout="this.style.transform='none'; this.style.borderColor='rgba(255, 255, 255, 0.05)'; this.style.background='rgba(255, 255, 255, 0.02)';">
            <div>
              <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                <span style="font-size: 1.8em;"><%= upsell[:emoji] %></span>
                <h4 style="margin: 0; font-size: 1.05em; font-weight: 700; color: var(--text-main); font-family: var(--font-outfit);"><%= upsell[:title] %></h4>
              </div>
              <p style="margin: 0; font-size: 0.85em; color: var(--text-muted); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; min-height: 3.6em;">
                <%= upsell[:description] %>
              </p>
              <% if upsell[:key].to_s.include?('smoke') || upsell[:title].to_s.downcase.include?('humo') %>
                <div style="margin-top: 8px; padding: 6px 10px; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 8px; font-size: 0.76em; color: #fbbf24; line-height: 1.35;">
                  ⚠️ <strong>Nota:</strong> No se recomienda para lugares muy al aire libre porque el viento dispersa el humo y no se aprecia.
                </div>
              <% end %>
            </div>
            <div id="upsell-action-<%= upsell[:key] %>" style="margin-top: 15px; border-top: 1px dashed rgba(255, 255, 255, 0.08); padding-top: 12px; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-weight: 800; color: #34d399; font-size: 1.05em; font-family: var(--font-outfit);">
                +<%= number_to_currency(upsell[:price], unit: upsell[:currency] == "USD" ? "$" : "Bs. ", precision: 0) %> <span style="font-size: 0.7em; color: var(--text-muted); font-weight: normal;"><%= upsell[:currency] %></span>
              </span>
              
              <% case upsell[:request_status] %>
              <% when 'pending' %>
                <span style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #fbbf24; padding: 5px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78em;">
                  ⏳ Solicitud Enviada
                </span>
              <% when 'approved' %>
                <span style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34d399; padding: 5px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78em;">
                  ✅ Añadido al Show
                </span>
              <% when 'rejected' %>
                <span style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; padding: 5px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78em;">
                  ❌ No Disponible
                </span>
              <% else %>
                <button type="button"
                        onclick="openUpsellModalFromButton(this)"
                        data-key="<%= upsell[:key] %>"
                        data-title="<%= upsell[:title] %>"
                        data-emoji="<%= upsell[:emoji] %>"
                        data-price="<%= upsell[:price] %>"
                        data-currency="<%= upsell[:currency] %>"
                        data-description="<%= upsell[:description] %>"
                        class="btn-portal"
                        style="padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.82em; width: auto; box-shadow: none;">
                  Añadir ＋
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# --- FOOTER --- %>
  <footer style="text-align: center; color: var(--text-muted); font-size: 0.85em; margin-top: 50px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 20px;">
    <p style="margin: 0;">Generado por <strong>Gig Manager</strong>. Todos los derechos reservados.</p>
  </footer>

</div>

<%# --- MODAL DE CONFIRMACIÓN DE UPSELL --- %>
<div id="upsell-confirm-modal" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.78); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
  <div style="background: #0f172a; border: 1px solid rgba(139, 92, 246, 0.35); border-radius: 24px; padding: 30px; max-width: 440px; width: 100%; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6); animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); text-align: center; color: white; box-sizing: border-box;">
    <div id="modal-upsell-emoji" style="font-size: 3.5em; margin-bottom: 8px; line-height: 1;">🚀</div>
    <h3 id="modal-upsell-title" style="font-family: var(--font-outfit); font-size: 1.4em; font-weight: 800; margin: 0 0 10px 0; color: #f8fafc;">Añadir Adicional</h3>
    <div id="modal-upsell-price" style="font-family: var(--font-outfit); font-size: 1.6em; font-weight: 800; color: #34d399; margin-bottom: 12px;">+ $0 USD</div>
    <p id="modal-upsell-desc" style="color: #94a3b8; font-size: 0.9em; line-height: 1.5; margin: 0 0 24px 0;">
      ¿Deseas solicitar este servicio adicional para tu evento? El equipo organizador recibirá tu aviso y confirmará la disponibilidad.
    </p>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
      <button type="button" onclick="closeUpsellModal()" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #cbd5e1; padding: 12px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 0.95em; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.12)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'">
        Cancelar
      </button>
      <button type="button" id="btn-confirm-upsell" onclick="confirmUpsellRequest()" class="btn-portal" style="padding: 12px; margin: 0; width: 100%;">
        ✅ Sí, solicitar
      </button>
    </div>
  </div>
</div>

<style>
  @keyframes scaleIn {
    0% { transform: scale(0.9); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<%# --- JAVASCRIPT --- %>
<script>
  // 1. Lógica de la cuenta regresiva
  (function() {
    const gigDateStr = '<%= @gig.date&.to_s %>';
    if (!gigDateStr) return;

    let timerInterval = null;
    const targetDate = new Date(`${gigDateStr}T20:00:00`).getTime();
    const lblElement = document.getElementById('countdown-label');

    const updateCountdown = () => {
      const now = new Date().getTime();
      const diff = targetDate - now;

      if (diff <= 0) {
        const eventDayStart = new Date(`${gigDateStr}T00:00:00`).getTime();
        const eventDayEnd = new Date(`${gigDateStr}T23:59:59`).getTime();
        const currentNow = new Date().getTime();

        const d = document.getElementById('cd-days');
        const h = document.getElementById('cd-hours');
        const m = document.getElementById('cd-minutes');
        const s = document.getElementById('cd-seconds');
        if (d) d.textContent = '00';
        if (h) h.textContent = '00';
        if (m) m.textContent = '00';
        if (s) s.textContent = '00';

        if (lblElement) {
          if (currentNow >= eventDayStart && currentNow <= eventDayEnd) {
            lblElement.textContent = "¡TU EVENTO ES HOY! ¡A DISFRUTAR!";
            lblElement.style.color = "#10b981";
          } else {
            lblElement.textContent = "¡Evento Finalizado! Gracias por tu preferencia.";
            lblElement.style.color = '#94a3b8';
          }
        }
        if (timerInterval) clearInterval(timerInterval);
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      const d = document.getElementById('cd-days');
      const h = document.getElementById('cd-hours');
      const m = document.getElementById('cd-minutes');
      const s = document.getElementById('cd-seconds');
      if (d) d.textContent = days.toString().padStart(2, '0');
      if (h) h.textContent = hours.toString().padStart(2, '0');
      if (m) m.textContent = minutes.toString().padStart(2, '0');
      if (s) s.textContent = seconds.toString().padStart(2, '0');
    };

    updateCountdown();
    timerInterval = setInterval(updateCountdown, 1000);
  })();

  // 2. Firma digital por AJAX
  window.submitContractSignature = function() {
    const sigInput = document.getElementById('signature-input');
    const signatureName = sigInput ? sigInput.value.trim() : '';
    
    if (!signatureName) {
      if (sigInput) sigInput.style.borderColor = 'var(--danger)';
      alert("Por favor, escribe tu nombre completo para poder firmar.");
      return;
    }

    const btn = document.getElementById('btn-sign-contract');
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Firmando Contrato...";
    }

    const token = '<%= @gig.portal_token %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    fetch(`/portal/${token}/sign`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ signature_name: signatureName })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const signatureSection = document.getElementById('signature-section');
        if (signatureSection) {
          signatureSection.innerHTML = `
            <div class="signed-badge" style="animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <div class="signed-details">
                <h4 style="margin: 0 0 5px 0; font-size: 1.05em; font-weight: 800;">Contrato Firmado Digitalmente</h4>
                <p><strong>Firmante:</strong> ${data.name}</p>
                <p><strong>Fecha/Hora:</strong> ${data.signed_at}</p>
                <p><strong>IP de Registro:</strong> ${data.ip}</p>
              </div>
            </div>
          `;
        }
      } else {
        alert("Error al firmar contrato: " + (data.error || "Ocurrió un error."));
        if (btn) {
          btn.disabled = false;
          btn.textContent = "✍️ Aceptar Términos y Firmar Contrato";
        }
      }
    })
    .catch(() => {
      alert("Error de red. Intenta de nuevo.");
      if (btn) {
        btn.disabled = false;
        btn.textContent = "✍️ Aceptar Términos y Firmar Contrato";
      }
    });
  };

  // 3. Modal y Solicitud de Adicional (Upsell)
  let activeUpsell = null;

  window.openUpsellModalFromButton = function(btn) {
    if (!btn) return;
    const key = btn.getAttribute('data-key') || '';
    const title = btn.getAttribute('data-title') || '';
    const emoji = btn.getAttribute('data-emoji') || '🚀';
    const price = parseFloat(btn.getAttribute('data-price')) || 0;
    const currency = btn.getAttribute('data-currency') || 'USD';
    const description = btn.getAttribute('data-description') || '';
    window.openUpsellModal(key, title, emoji, price, currency, description);
  };

  window.openUpsellModal = function(key, title, emoji, price, currency, description) {
    activeUpsell = {
      key: key,
      title: title,
      emoji: emoji || '🚀',
      price: parseFloat(price) || 0,
      currency: currency || 'USD',
      description: description || ''
    };

    const emojiEl = document.getElementById('modal-upsell-emoji');
    if (emojiEl) emojiEl.textContent = activeUpsell.emoji;

    const titleEl = document.getElementById('modal-upsell-title');
    if (titleEl) titleEl.textContent = activeUpsell.title;

    const formattedPrice = Number(activeUpsell.price).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    const symbol = activeUpsell.currency === 'USD' ? '$' : 'Bs. ';
    const priceEl = document.getElementById('modal-upsell-price');
    if (priceEl) priceEl.textContent = `+ ${symbol}${formattedPrice} ${activeUpsell.currency}`;

    const descEl = document.getElementById('modal-upsell-desc');
    if (descEl) {
      descEl.textContent = activeUpsell.description || "¿Deseas solicitar este servicio adicional para tu evento? El equipo organizador recibirá tu aviso y confirmará la disponibilidad.";
    }

    const btn = document.getElementById('btn-confirm-upsell');
    if (btn) {
      btn.disabled = false;
      btn.textContent = "✅ Sí, solicitar adicional";
    }

    const modal = document.getElementById('upsell-confirm-modal');
    if (modal) {
      modal.style.display = 'flex';
    }
  };

  window.closeUpsellModal = function() {
    const modal = document.getElementById('upsell-confirm-modal');
    if (modal) modal.style.display = 'none';
    activeUpsell = null;
  };

  window.confirmUpsellRequest = function() {
    if (!activeUpsell) return;

    const btn = document.getElementById('btn-confirm-upsell');
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Enviando solicitud...";
    }

    const token = '<%= @gig.portal_token %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    fetch(`/portal/${token}/request_upsell`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        upsell_key: activeUpsell.key,
        title: activeUpsell.title,
        emoji: activeUpsell.emoji,
        price: activeUpsell.price,
        currency: activeUpsell.currency
      })
    })
    .then(res => {
      if (!res.ok && res.status !== 422) {
        throw new Error("HTTP error " + res.status);
      }
      return res.json();
    })
    .then(data => {
      if (data.success) {
        const savedUpsell = Object.assign({}, activeUpsell);
        window.closeUpsellModal();

        const actionContainer = document.getElementById(`upsell-action-${data.request?.key || savedUpsell.key}`);
        if (actionContainer) {
          const priceFormatted = Number(savedUpsell.price).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
          const symbol = savedUpsell.currency === 'USD' ? '$' : 'Bs. ';
          actionContainer.innerHTML = `
            <span style="font-weight: 800; color: #34d399; font-size: 1.05em; font-family: var(--font-outfit);">
              +${symbol}${priceFormatted} <span style="font-size: 0.7em; color: var(--text-muted); font-weight: normal;">${savedUpsell.currency}</span>
            </span>
            <span style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #fbbf24; padding: 5px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78em; animation: scaleIn 0.35s ease;">
              ⏳ Solicitud Enviada
            </span>
          `;
        }

        alert(data.message || "¡Solicitud enviada con éxito! El equipo organizador fue notificado y confirmará la disponibilidad a la brevedad.");
      } else {
        alert("Error al solicitar adicional: " + (data.error || "Ocurrió un error."));
        if (btn) {
          btn.disabled = false;
          btn.textContent = "✅ Sí, solicitar adicional";
        }
      }
    })
    .catch((err) => {
      console.error("Error en upsell:", err);
      alert("Error de red al enviar la solicitud.");
      if (btn) {
        btn.disabled = false;
        btn.textContent = "✅ Sí, solicitar adicional";
      }
    });
  };

  // Delegación de eventos para clicks en botones de upsell
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('button[data-key]');
    if (btn) {
      e.preventDefault();
      window.openUpsellModalFromButton(btn);
    }
  });

  // Cerrar al hacer clic fuera del modal
  document.addEventListener('click', function(e) {
    const modal = document.getElementById('upsell-confirm-modal');
    if (modal && e.target === modal) {
      window.closeUpsellModal();
    }
  });
</script>
