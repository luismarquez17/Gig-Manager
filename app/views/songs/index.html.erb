<div style="max-width: 1100px; margin: 0 auto; font-family: 'Inter', sans-serif;">

  <%# Header %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
    <div>
      <h1 style="color: #0f172a; font-size: 2em; font-weight: 800; margin: 0;">🎵 Catálogo de Repertorio Musical</h1>
      <p style="color: #64748b; font-size: 0.95em; margin: 5px 0 0 0;">
        Gestiona las canciones que tus clientes podrán explorar y seleccionar en su portal.
      </p>
    </div>
    <div style="display: flex; gap: 10px;">
      <% if @songs.empty? %>
        <%= button_to seed_defaults_songs_path, method: :post, class: "btn-main btn-success-custom", style: "padding: 10px 18px; font-weight: 800; font-size: 0.9em; text-decoration: none;" do %>
          ✨ Cargar Repertorio Sugerido (25 Temas)
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Formulario para agregar nueva canción %>
  <div style="background: white; border-radius: 20px; border: 1px solid #e2e8f0; padding: 22px 26px; margin-bottom: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
    <h3 style="margin: 0 0 16px 0; font-size: 1.1em; color: #1e293b; font-weight: 800; display: flex; align-items: center; gap: 8px;">
      <span>➕</span> Añadir Canción al Repertorio
    </h3>

    <%= form_with(model: @new_song, url: songs_path, local: true, style: "display: grid; grid-template-columns: 2fr 2fr 2fr auto; gap: 12px; align-items: end;") do |f| %>
      <div>
        <%= f.label :title, "Título de la Canción *", style: "display: block; font-size: 0.78em; font-weight: 700; text-transform: uppercase; color: #64748b; margin-bottom: 6px;" %>
        <%= f.text_field :title, placeholder: "Ej: De Música Ligera", required: true, style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 0.95em; box-sizing: border-box;" %>
      </div>

      <div>
        <%= f.label :artist, "Artista / Agrupación", style: "display: block; font-size: 0.78em; font-weight: 700; text-transform: uppercase; color: #64748b; margin-bottom: 6px;" %>
        <%= f.text_field :artist, placeholder: "Ej: Soda Stereo", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 0.95em; box-sizing: border-box;" %>
      </div>

      <div>
        <%= f.label :genre, "Género / Categoría *", style: "display: block; font-size: 0.78em; font-weight: 700; text-transform: uppercase; color: #64748b; margin-bottom: 6px;" %>
        <%= f.select :genre, Song::DEFAULT_GENRES, {}, style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 0.95em; box-sizing: border-box; background: white;" %>
      </div>

      <div>
        <%= f.submit "＋ Guardar Canción", class: "btn-main btn-primary-custom", style: "padding: 10px 18px; font-weight: 800; font-size: 0.9em; height: 42px; width: 100%; cursor: pointer;" %>
      </div>
    <% end %>
  </div>

  <%# Filtros por Género %>
  <div style="display: flex; gap: 8px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px;">
    <%= link_to songs_path, style: "padding: 8px 16px; border-radius: 99px; font-size: 0.85em; font-weight: 700; text-decoration: none; #{params[:genre].blank? ? 'background: #2563eb; color: white;' : 'background: #f1f5f9; color: #475569;'}" do %>
      Todos (<%= current_company.songs.count %>)
    <% end %>

    <% @genres.each do |g| %>
      <% count = current_company.songs.where(genre: g).count %>
      <%= link_to songs_path(genre: g), style: "padding: 8px 16px; border-radius: 99px; font-size: 0.85em; font-weight: 700; text-decoration: none; #{params[:genre] == g ? 'background: #2563eb; color: white;' : 'background: #f1f5f9; color: #475569;'}" do %>
        <%= g %> (<%= count %>)
      <% end %>
    <% end %>
  </div>

  <%# Tabla / Listado de Canciones %>
  <div style="background: white; border-radius: 20px; border: 1px solid #e2e8f0; padding: 24px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
    <% if @songs.any? %>
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="text-align: left; border-bottom: 2px solid #f8fafc;">
            <th style="padding: 12px 0; color: #64748b; font-size: 0.8em; text-transform: uppercase;">Canción</th>
            <th style="padding: 12px 0; color: #64748b; font-size: 0.8em; text-transform: uppercase;">Artista</th>
            <th style="padding: 12px 0; color: #64748b; font-size: 0.8em; text-transform: uppercase;">Género</th>
            <th style="padding: 12px 0; color: #64748b; font-size: 0.8em; text-transform: uppercase; text-align: right;">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% @songs.each do |song| %>
            <tr style="border-bottom: 1px solid #f8fafc;">
              <td style="padding: 14px 0; font-weight: 700; color: #0f172a; font-size: 0.95em;">
                🎵 <%= song.title %>
              </td>
              <td style="padding: 14px 0; color: #475569; font-size: 0.9em;">
                <%= song.artist.presence || "—" %>
              </td>
              <td style="padding: 14px 0;">
                <span style="background: #eff6ff; color: #2563eb; padding: 4px 10px; border-radius: 8px; font-size: 0.78em; font-weight: 700;">
                  <%= song.genre %>
                </span>
              </td>
              <td style="padding: 14px 0; text-align: right;">
                <%= button_to song_path(song, genre: params[:genre]), method: :delete, data: { turbo_confirm: "¿Eliminar #{song.title} del repertorio?" }, class: "btn-main btn-danger-custom", style: "padding: 6px 12px; font-size: 0.8em; font-weight: 700;" do %>
                  🗑️ Eliminar
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div style="text-align: center; padding: 40px; color: #94a3b8;">
        <span style="font-size: 2.5em; display: block; margin-bottom: 12px;">🎶</span>
        <h4 style="margin: 0 0 6px 0; color: #334155; font-size: 1.1em;">No hay canciones en esta categoría</h4>
        <p style="margin: 0 0 15px 0; font-size: 0.9em;">Agrega temas usando el formulario superior o carga el repertorio base sugerido.</p>
        <%= button_to seed_defaults_songs_path, method: :post, class: "btn-main btn-success-custom", style: "padding: 10px 20px; font-weight: 800; font-size: 0.9em;" do %>
          ✨ Cargar Repertorio Sugerido
        <% end %>
      </div>
    <% end %>
  </div>

</div>
