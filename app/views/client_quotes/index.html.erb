<div style="max-width: 1150px; margin: 0 auto; padding-bottom: 60px; font-family: var(--font-main, 'Inter', 'Segoe UI', sans-serif);">
  
  <%# --- HEADER --- %>
  <div class="custom-card" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <div>
      <h1 style="font-size: 1.7rem; font-weight: 800; color: var(--text-heading); margin: 0 0 6px 0; display: flex; align-items: center; gap: 10px;">
        <span>📋</span> Presupuestos de Clientes
      </h1>
      <p style="margin: 0; color: var(--text-muted); font-size: 0.95rem;">
        Genera enlaces privados e intuitivos para que tus clientes elijan un presupuesto base o coticen su evento, y jálalos con 1 clic al crear el evento (Gig).
      </p>
    </div>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <%= form_with(url: client_quotes_path, method: :post, local: true) do |f| %>
        <input type="hidden" name="client_quote[currency]" value="<%= current_company.currency.presence || 'USD' %>">
        <input type="hidden" name="client_quote[amount]" value="0.0">
        <button type="submit" class="btn-main btn-success-custom" style="padding: 12px 18px; border-radius: 12px; font-size: 0.88rem; cursor: pointer; border: none;">
          <span>⚡</span> Generar Enlace Rápido
        </button>
      <% end %>

      <%= link_to new_client_quote_path, class: "btn-main btn-primary-custom", style: "padding: 12px 18px; border-radius: 12px; font-size: 0.88rem; text-decoration: none;" do %>
        <span>⚙️</span> Personalizar Enlace
      <% end %>
    </div>
  </div>

  <%# --- ACCESO RÁPIDO CON PRESUPUESTOS BASE --- %>
  <% if @preset_budgets.present? && @preset_budgets.any? %>
    <div style="margin-bottom: 24px; background: var(--bg-card-subtle); border: 1px solid var(--border-color); border-radius: 16px; padding: 16px 20px;">
      <div style="font-size: 0.82rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
        <span>🎯</span> Enlace rápido con Presupuesto Base preseleccionado:
      </div>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <% @preset_budgets.each do |preset| %>
          <%= link_to new_client_quote_path(preset_budget_id: preset.id), style: "background: var(--bg-card); border: 1px solid var(--border-color); padding: 8px 14px; border-radius: 10px; font-size: 0.84rem; font-weight: 700; color: var(--text-heading); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: var(--shadow-card); transition: all 0.2s;" do %>
            <span>📦 <%= preset.title %></span>
            <span style="color: #22c55e; font-weight: 800;">$<%= preset.price %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# --- LISTA DE PRESUPUESTOS --- %>
  <% if @client_quotes.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px;">
      <% @client_quotes.each do |quote| %>
        <div class="custom-card" style="display: flex; flex-direction: column; justify-content: space-between; position: relative; margin-bottom: 0;">
          
          <div>
            <%# Header de la tarjeta %>
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 14px;">
              <%
                badge_bg = case quote.status
                           when 'pending' then 'rgba(245, 158, 11, 0.15)'
                           when 'accepted' then 'rgba(34, 197, 94, 0.15)'
                           when 'converted' then 'rgba(99, 102, 241, 0.15)'
                           else 'var(--bg-card-subtle)'
                           end
                badge_color = case quote.status
                             when 'pending' then '#f59e0b'
                             when 'accepted' then '#22c55e'
                             when 'converted' then '#818cf8'
                             else 'var(--text-muted)'
                             end
                badge_border = case quote.status
                              when 'pending' then 'rgba(245, 158, 11, 0.35)'
                              when 'accepted' then 'rgba(34, 197, 94, 0.35)'
                              when 'converted' then 'rgba(99, 102, 241, 0.35)'
                              else 'var(--border-color)'
                              end
              %>
              <span style="font-size: 0.74rem; font-weight: 800; padding: 4px 10px; border-radius: 99px; background: <%= badge_bg %>; color: <%= badge_color %>; border: 1px solid <%= badge_border %>;">
                <%= quote.status_label %>
              </span>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 0.88rem; font-weight: 800; color: #22c55e; background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); padding: 3px 9px; border-radius: 8px;">
                  $<%= quote.amount %> <%= quote.currency %>
                </span>
                <%= button_to client_quote_path(quote), method: :delete, data: { turbo_confirm: "¿Estás seguro de eliminar este presupuesto?" }, style: "background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1rem; padding: 2px;", title: "Eliminar Presupuesto" do %>
                  🗑️
                <% end %>
              </div>
            </div>

            <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--text-heading); margin: 0 0 6px 0;">
              <%= quote.display_client_name %>
            </h3>

            <% if quote.preset_budget.present? || quote.package_name.present? %>
              <div style="display: inline-flex; align-items: center; gap: 4px; background: rgba(37, 99, 235, 0.12); color: var(--color-primary); border: 1px solid rgba(37, 99, 235, 0.25); font-size: 0.76rem; font-weight: 800; padding: 3px 8px; border-radius: 6px; margin-bottom: 10px;">
                <span>📦</span> <%= quote.package_display_title %>
              </div>
            <% end %>

            <div style="font-size: 0.86rem; color: var(--text-muted); margin-top: 6px; margin-bottom: 14px; display: flex; flex-direction: column; gap: 5px;">
              <div>📞 <%= quote.client_phone.presence || '<span style="color: var(--text-subtle); font-style: italic;">Por definir por el cliente</span>'.html_safe %></div>
              <% if quote.client_email.present? %>
                <div>📧 <%= quote.client_email %></div>
              <% end %>
              <div>📅 Fecha: <strong style="color: var(--text-heading);"><%= quote.event_date ? quote.event_date.strftime("%d/%m/%Y") : '<span style="color: var(--text-subtle); font-weight: normal; font-style: italic;">Por definir</span>'.html_safe %></strong></div>
              <div>📍 Lugar: <strong style="color: var(--text-heading);"><%= quote.event_location.presence || '<span style="color: var(--text-subtle); font-weight: normal; font-style: italic;">Por confirmar</span>'.html_safe %></strong></div>
              <% if quote.advance_amount.to_f > 0 %>
                <div style="color: #22c55e; font-weight: 800; background: rgba(34, 197, 94, 0.12); padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(34, 197, 94, 0.25); display: inline-block;">
                  💵 Adelanto reportado: $<%= quote.advance_amount %> <%= quote.currency %>
                </div>
              <% end %>
            </div>
          </div>

          <%# Acciones del Presupuesto %>
          <div style="border-top: 1px solid var(--border-color); padding-top: 14px; margin-top: 12px; display: flex; flex-direction: column; gap: 8px;">
            <% public_url = public_client_quote_url(quote.public_token) %>
            <% 
              wa_text = "¡Hola! Te comparto el formulario de presupuesto para tu evento con #{current_company.name}. Puedes completarlo aquí en un minuto:\n#{public_url}"
              wa_url = "https://wa.me/#{quote.client_phone.present? ? quote.client_phone.gsub(/\D/, '') : ''}?text=#{ERB::Util.url_encode(wa_text)}"
            %>
            
            <div style="display: flex; gap: 6px;">
              <input type="text" readonly value="<%= public_url %>" style="flex: 1; padding: 7px 10px; font-size: 0.78rem; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-input); color: var(--text-main);" id="token-input-<%= quote.id %>">
              
              <button onclick="navigator.clipboard.writeText('<%= public_url %>'); showToast('¡Enlace de presupuesto copiado al portapapeles!', 'success');" style="background: var(--bg-card-subtle); border: 1px solid var(--border-color); color: var(--text-heading); padding: 7px 10px; border-radius: 8px; font-size: 0.78rem; font-weight: 700; cursor: pointer; white-space: nowrap;" title="Copiar Enlace">
                📋 Copiar
              </button>

              <a href="<%= wa_url %>" target="_blank" style="background: #25d366; color: white; padding: 7px 10px; border-radius: 8px; font-size: 0.78rem; font-weight: 800; text-decoration: none; display: flex; align-items: center; justify-content: center;" title="Compartir por WhatsApp">
                💬 WhatsApp
              </a>
            </div>

            <% if quote.status != 'converted' %>
              <%= link_to new_gig_path(quote_id: quote.id), class: "btn-main btn-success-custom", style: "padding: 10px; border-radius: 10px; font-size: 0.88rem; font-weight: 800; text-decoration: none; text-align: center; display: block;" do %>
                ✨ Crear Gig desde este Presupuesto ➔
              <% end %>
            <% else %>
              <% if quote.gig %>
                <%= link_to gig_path(quote.gig), style: "background: var(--bg-card-subtle); color: var(--text-heading); padding: 9px; border-radius: 10px; font-size: 0.84rem; font-weight: 700; text-decoration: none; text-align: center; display: block; border: 1px solid var(--border-color);" do %>
                  Ver Evento Activo (Gig) ➔
                <% end %>
              <% end %>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div class="custom-card" style="text-align: center; padding: 60px 20px;">
      <div style="font-size: 3.5rem; margin-bottom: 12px;">📋</div>
      <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-heading); margin: 0 0 6px 0;">Aún no has generado presupuestos de clientes</h3>
      <p style="margin: 0 0 20px 0; font-size: 0.92rem; max-width: 500px; margin-left: auto; margin-right: auto; color: var(--text-muted);">
        Crea enlaces en segundos y compártelos por WhatsApp. Tu cliente podrá seleccionar un presupuesto base o indicarte lo que necesita.
      </p>
      
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <%= form_with(url: client_quotes_path, method: :post, local: true) do |f| %>
          <input type="hidden" name="client_quote[currency]" value="<%= current_company.currency.presence || 'USD' %>">
          <input type="hidden" name="client_quote[amount]" value="0.0">
          <button type="submit" class="btn-main btn-success-custom" style="padding: 12px 24px; border-radius: 10px; font-weight: 800; font-size: 0.92rem; border: none; cursor: pointer;">
            ⚡ Generar Primer Enlace Rápido
          </button>
        <% end %>
        <%= link_to "⚙️ Personalizar Presupuesto", new_client_quote_path, class: "btn-main btn-primary-custom", style: "padding: 12px 24px; border-radius: 10px; font-weight: 700; font-size: 0.92rem; text-decoration: none;" %>
      </div>
    </div>
  <% end %>

</div>

