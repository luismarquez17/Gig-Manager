<div style="max-width: 800px; margin: 0 auto; padding-bottom: 60px;">
  
  <div style="background: white; padding: 32px 28px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px rgba(0,0,0,0.05); font-family: 'Inter', sans-serif;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
      <div>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">
          📋 Generar Enlace de Presupuesto para Cliente
        </h1>
        <p style="color: #64748b; font-size: 0.92rem; margin: 0;">
          Puedes pre-configurar los datos que desees o generar el enlace en blanco para que el cliente seleccione su presupuesto base y complete sus datos.
        </p>
      </div>

      <%= link_to "← Volver a Lista", client_quotes_path, style: "font-size: 0.85rem; font-weight: 700; color: #64748b; text-decoration: none; padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 8px;" %>
    </div>

    <%= form_with(model: @client_quote, local: true, style: "display: grid; grid-template-columns: 1fr; gap: 20px;") do |f| %>
      
      <%# --- SECCIÓN: PRESUPUESTO BASE PRESELECCIONADO (OPCIONAL) --- %>
      <% if @preset_budgets.present? && @preset_budgets.any? %>
        <div style="background: #f0f9ff; padding: 18px 20px; border-radius: 14px; border: 1px solid #bae6fd;">
          <label style="display: block; font-size: 0.85rem; font-weight: 800; color: #0369a1; margin-bottom: 6px;">
            📦 Seleccionar Presupuesto Base Inicial (Opcional)
          </label>
          <p style="margin: 0 0 12px 0; font-size: 0.82rem; color: #0284c7;">
            Si eliges un paquete, sus datos y precio se sugerirán en el formulario. Si lo dejas vacío, el cliente podrá ver y elegir cualquier paquete en su enlace.
          </p>
          
          <%= f.select :preset_budget_id, 
              options_for_select([["-- Dejar que el cliente elija (Formulario General) --", ""]] + @preset_budgets.map { |p| ["#{p.title} - $#{p.price} #{p.currency}", p.id, { 'data-price' => p.price, 'data-currency' => p.currency, 'data-desc' => p.description, 'data-title' => p.title }] }, @client_quote.preset_budget_id), 
              {}, 
              { id: "preset-budget-select", onchange: "onPresetChange(this)", style: "width: 100%; padding: 11px 14px; border: 2px solid #38bdf8; border-radius: 10px; font-size: 0.95rem; font-weight: 700; color: #0f172a; background: white;" } 
          %>
          <%= f.hidden_field :package_name, id: "package-name-input" %>
        </div>
      <% end %>

      <%# --- SECCIÓN: DATOS BÁSICOS DEL CLIENTE (OPCIONALES) --- %>
      <div style="background: #f8fafc; padding: 18px 20px; border-radius: 14px; border: 1px solid #e2e8f0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h3 style="font-size: 0.95rem; font-weight: 800; color: #0f172a; margin: 0;">
            👤 Datos del Cliente <span style="font-weight: normal; color: #64748b; font-size: 0.82rem;">(Opcional - El cliente puede completarlos)</span>
          </h3>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
          <div>
            <%= f.label :client_name, "Nombre del Cliente", style: "display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;" %>
            <%= f.text_field :client_name, placeholder: "Ej. María Fernández (O dejar vacío)", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;" %>
          </div>

          <div>
            <%= f.label :client_phone, "Teléfono / WhatsApp", style: "display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;" %>
            <%= f.text_field :client_phone, placeholder: "Ej. 04141234567", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;" %>
          </div>
        </div>
      </div>

      <%# --- SECCIÓN: ESTIMACIÓN Y MONTOS --- %>
      <div style="background: #f8fafc; padding: 18px 20px; border-radius: 14px; border: 1px solid #e2e8f0;">
        <h3 style="font-size: 0.95rem; font-weight: 800; color: #0f172a; margin: 0 0 12px 0;">
          💰 Estimación de Presupuesto Inicial & Adelanto
        </h3>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 14px; margin-bottom: 12px;">
          <div>
            <%= f.label :amount, "Monto Acordado o Estimado", style: "display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;" %>
            <%= f.number_field :amount, step: "0.01", id: "quote-amount-input", placeholder: "0.00", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; font-weight: 700; box-sizing: border-box;" %>
          </div>

          <div>
            <%= f.label :currency, "Moneda", style: "display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;" %>
            <%= f.select :currency, [["USD ($)", "USD"], ["BS (Bs)", "BS"]], {}, { id: "quote-currency-select", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-weight: 700; background: white;" } %>
          </div>
        </div>

        <div style="margin-bottom: 12px;">
          <%= f.label :advance_amount, "Adelanto / Anticipo Inicial Abonado (Opcional)", style: "display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;" %>
          <%= f.number_field :advance_amount, step: "0.01", placeholder: "0.00", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; font-weight: 700; color: #166534; box-sizing: border-box;" %>
        </div>

        <div>
          <%= f.label :details, "Detalles / Paquete o Requerimientos Iniciales", style: "display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;" %>
          <%= f.text_area :details, rows: 3, id: "quote-details-input", placeholder: "Ej. Incluye show de 2 horas con agrupación completa y sonido...", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88rem; box-sizing: border-box; resize: vertical;" %>
        </div>
      </div>

      <div style="display: flex; gap: 12px; margin-top: 6px;">
        <%= f.submit "✨ Generar Enlace de Presupuesto", style: "flex: 1; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; padding: 14px; border: none; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);" %>
        <%= link_to "Cancelar", client_quotes_path, style: "padding: 14px 20px; border: 1px solid #cbd5e1; border-radius: 12px; color: #475569; font-weight: 700; text-decoration: none; font-size: 0.9rem;" %>
      </div>

    <% end %>
  </div>

</div>

<script>
  function onPresetChange(select) {
    var selectedOption = select.options[select.selectedIndex];
    var price = selectedOption.getAttribute('data-price');
    var currency = selectedOption.getAttribute('data-currency');
    var desc = selectedOption.getAttribute('data-desc');
    var title = selectedOption.getAttribute('data-title');

    var amountInput = document.getElementById('quote-amount-input');
    var currencySelect = document.getElementById('quote-currency-select');
    var detailsInput = document.getElementById('quote-details-input');
    var packageInput = document.getElementById('package-name-input');

    if (price && amountInput) {
      amountInput.value = price;
    }
    if (currency && currencySelect) {
      currencySelect.value = currency;
    }
    if (desc && detailsInput && !detailsInput.value) {
      detailsInput.value = desc;
    }
    if (packageInput) {
      packageInput.value = title || "";
    }
  }
</script>

