<div style="max-width: 600px; margin: 40px auto; padding: 0 16px; font-family: var(--font-jakarta, sans-serif);">
  
  <div class="glass-card" style="padding: 32px 26px; border-radius: 24px; text-align: center; border-color: rgba(139, 92, 246, 0.35); box-shadow: 0 10px 35px rgba(0,0,0,0.4);">
    
    <%# Icono y Título %>
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 20px; background: linear-gradient(135deg, rgba(139, 92, 246, 0.25), rgba(6, 182, 212, 0.25)); border: 1px solid rgba(139, 92, 246, 0.4); font-size: 2rem; margin-bottom: 16px;">
      🔒
    </div>

    <h2 style="font-size: 1.6rem; font-weight: 800; color: #f8fafc; margin: 0 0 8px 0; font-family: var(--font-outfit, sans-serif);">
      Acceso Seguro al Perfil de Cliente
    </h2>

    <p style="color: #cbd5e1; font-size: 0.92rem; line-height: 1.5; margin: 0 0 24px 0;">
      Para proteger la privacidad de tus contratos, pagos y eventos con <strong><%= @company.name %></strong>, solo tú puedes acceder a tu cuenta.
    </p>

    <% if flash[:alert] %>
      <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 12px 16px; border-radius: 12px; font-size: 0.88rem; margin-bottom: 20px; text-align: left;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%# Formulario para Crear / Establecer Contraseña Segura %>
    <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 18px; padding: 22px; text-align: left; margin-bottom: 24px;">
      <h3 style="font-size: 1rem; font-weight: 800; color: #a78bfa; margin: 0 0 6px 0; font-family: var(--font-outfit);">
        ✨ Activa o Protege tu Cuenta
      </h3>
      <p style="color: #94a3b8; font-size: 0.82rem; margin: 0 0 16px 0;">
        Confirma tus datos y elige una contraseña personal para entrar y proteger tu cuenta:
      </p>

      <%= form_with(url: setup_password_public_client_quote_path(@quote.public_token), method: :post, local: true, style: "display: flex; flex-direction: column; gap: 14px;") do |f| %>
        
        <% if @quote.client_email.present? %>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 4px;">
              Correo Electrónico
            </label>
            <input type="email" name="email" value="<%= @quote.client_email %>" required style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
          </div>
        <% else %>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 4px;">
              Teléfono Registrado
            </label>
            <input type="text" name="phone" value="<%= @quote.client_phone %>" required placeholder="Ej. 04141234567" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
          </div>
        <% end %>

        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 4px;">
            Nueva Contraseña Personal
          </label>
          <input type="password" name="password" required minlength="6" placeholder="Mínimo 6 caracteres" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
        </div>

        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #cbd5e1; margin-bottom: 4px;">
            Confirmar Contraseña
          </label>
          <input type="password" name="password_confirmation" required minlength="6" placeholder="Repite la contraseña" style="width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(15, 23, 42, 0.8); color: white; font-size: 0.9rem; box-sizing: border-box;">
        </div>

        <button type="submit" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; padding: 13px 20px; border-radius: 12px; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 6px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);">
          <span>🚀</span> Establecer Contraseña y Entrar
        </button>

      <% end %>
    </div>

    <%# Opción para quienes ya tienen contraseña %>
    <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px; display: flex; flex-direction: column; gap: 12px;">
      <p style="color: #94a3b8; font-size: 0.85rem; margin: 0;">
        ¿Ya configuraste tu contraseña anteriormente?
      </p>
      
      <%= link_to new_user_session_path(user: { email: @quote.client_email }), style: "background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); color: #f8fafc; padding: 11px 18px; border-radius: 12px; font-weight: 700; font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s;" do %>
        <span>🔑</span> Iniciar Sesión con Mi Contraseña Existente
      <% end %>

      <div style="margin-top: 8px;">
        <%= link_to "← Volver al Presupuesto", public_client_quote_path(@quote.public_token), style: "color: #94a3b8; font-size: 0.82rem; text-decoration: none;" %>
      </div>
    </div>

  </div>

</div>
