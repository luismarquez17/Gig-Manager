<div class="landing-container" style="max-width: 900px;">
  <div style="margin-bottom: 25px;">
    <%= link_to "⬅ Volver a #{@company.name}", band_landing_path(slug: @company.slug), style: "color: #a78bfa; text-decoration: none; font-weight: 700; font-size: 0.9em;" %>
  </div>

  <div class="glass-box" style="border: 2px solid rgba(139, 92, 246, 0.35); box-shadow: 0 12px 50px rgba(139, 92, 246, 0.15);">
    <div style="text-align: center; margin-bottom: 30px;">
      <span class="section-badge">⚡ Cotizador Interactivo</span>
      <h1 class="gradient-title" style="font-size: 2.3em; margin: 0;">Calcula el Presupuesto de tu Evento</h1>
      <p style="color: var(--text-muted); font-size: 1.05em; margin-top: 8px;">Configura la música y producción en vivo para <%= @company.name %>.</p>
    </div>

    <%# 1. Formato de Banda %>
    <div style="margin-bottom: 25px;">
      <label style="display: block; font-family: var(--font-outfit); font-weight: 800; font-size: 0.95em; text-transform: uppercase; color: #a78bfa; margin-bottom: 12px;">
        1. Formato de la Agrupación
      </label>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px;">
        <div class="sim-pill active" onclick="selectBandFormat('acoustic', 400, 'Acústico (2 Músicos)', this)">
          <div style="font-size: 1.6em;">🎻</div>
          <strong>Acústico</strong>
          <span style="font-size: 0.78em; color: var(--text-muted); display: block;">Dúo / Trío</span>
        </div>
        <div class="sim-pill" onclick="selectBandFormat('full_band', 750, 'Banda Completa (5 Músicos)', this)">
          <div style="font-size: 1.6em;">🎸</div>
          <strong>Banda Completa</strong>
          <span style="font-size: 0.78em; color: var(--text-muted); display: block;">5 Músicos</span>
        </div>
        <div class="sim-pill" onclick="selectBandFormat('big_band', 1200, 'Big Band con Metales (8+ Músicos)', this)">
          <div style="font-size: 1.6em;">🎺</div>
          <strong>Big Band</strong>
          <span style="font-size: 0.78em; color: var(--text-muted); display: block;">Metales &amp; Show</span>
        </div>
      </div>
    </div>

    <%# 2. Horas de Show %>
    <div style="margin-bottom: 25px;">
      <label style="display: block; font-family: var(--font-outfit); font-weight: 800; font-size: 0.95em; text-transform: uppercase; color: #a78bfa; margin-bottom: 12px;">
        2. Horas de Música en Vivo: <span id="hours-display" style="color: white; font-size: 1.1em;">2 Horas</span>
      </label>
      <input type="range" id="hours-slider" min="1" max="5" value="2" step="1" style="width: 100%; accent-color: var(--primary); cursor: pointer;" oninput="updateHours(this.value)">
      <div style="display: flex; justify-content: space-between; font-size: 0.8em; color: var(--text-muted); font-weight: 700; margin-top: 6px;">
        <span>1h</span>
        <span>2h (Estándar)</span>
        <span>3h</span>
        <span>4h</span>
        <span>5h</span>
      </div>
    </div>

    <%# 3. Efectos y Adicionales %>
    <div style="margin-bottom: 25px;">
      <label style="display: block; font-family: var(--font-outfit); font-weight: 800; font-size: 0.95em; text-transform: uppercase; color: #a78bfa; margin-bottom: 12px;">
        3. Adicionales de Escenario &amp; Efectos
      </label>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px;">
        <div class="sim-addon-card" onclick="toggleAddon(this, 'Chispas Frías (Pirotecnia Fría)', 120)">
          <input type="checkbox" style="accent-color: var(--primary);">
          <div>
            <strong style="display: block; font-size: 0.9em;">✨ Chispas Frías</strong>
            <span style="font-size: 0.8em; color: #34d399;">+$120 USD</span>
          </div>
        </div>
        <div class="sim-addon-card" onclick="toggleAddon(this, 'Máquina de Humo / Geiser', 60)">
          <input type="checkbox" style="accent-color: var(--primary);">
          <div>
            <strong style="display: block; font-size: 0.9em;">💨 Máquina de Humo</strong>
            <span style="font-size: 0.8em; color: #34d399;">+$60 USD</span>
          </div>
        </div>
        <div class="sim-addon-card" onclick="toggleAddon(this, 'Subwoofers / Refuerzo Sonoro', 100)">
          <input type="checkbox" style="accent-color: var(--primary);">
          <div>
            <strong style="display: block; font-size: 0.9em;">🔊 Subwoofers Extra</strong>
            <span style="font-size: 0.8em; color: #34d399;">+$100 USD</span>
          </div>
        </div>
        <div class="sim-addon-card" onclick="toggleAddon(this, 'Luces Robóticas / Cabezas Móviles', 150)">
          <input type="checkbox" style="accent-color: var(--primary);">
          <div>
            <strong style="display: block; font-size: 0.9em;">💡 Iluminación Robótica</strong>
            <span style="font-size: 0.8em; color: #34d399;">+$150 USD</span>
          </div>
        </div>
      </div>
    </div>

    <%# Fecha y Ubicación %>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 25px;">
      <div>
        <label style="display: block; font-size: 0.78em; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Fecha Tentativa</label>
        <input type="date" id="sim-date" class="form-input" style="background: rgba(0,0,0,0.3); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 10px 14px; width: 100%; box-sizing: border-box;" onchange="updateSummary()">
      </div>
      <div>
        <label style="display: block; font-size: 0.78em; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Ciudad / Ubicación</label>
        <input type="text" id="sim-location" placeholder="Ciudad o salón..." class="form-input" style="background: rgba(0,0,0,0.3); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 10px 14px; width: 100%; box-sizing: border-box;" oninput="updateSummary()">
      </div>
    </div>

    <%# Desglose Total %>
    <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 20px; margin-bottom: 20px;">
      <div style="display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 12px; margin-bottom: 12px; font-size: 0.92em;">
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--text-muted);" id="sum-format-name">Acústico (2 Músicos)</span>
          <strong id="sum-format-price">$400 USD</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--text-muted);" id="sum-hours-name">2 Horas de Música</span>
          <strong id="sum-hours-price">Incluidas</strong>
        </div>
        <div id="sum-addons-list" style="display: flex; flex-direction: column; gap: 6px;"></div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span style="font-size: 1.05em; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Total Estimado:</span>
        <div>
          <span style="font-family: var(--font-outfit); font-size: 2.6em; font-weight: 900; color: #34d399;" id="sim-total-price">$400</span>
          <span style="font-size: 0.9em; color: var(--text-muted);">USD</span>
        </div>
      </div>
    </div>

    <a id="btn-whatsapp-quote" href="#" target="_blank" class="btn-cta-primary" style="width: 100%; justify-content: center; text-decoration: none; padding: 16px; font-size: 1.15em; background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);">
      <span>💬</span> Enviar Presupuesto por WhatsApp
    </a>
  </div>
</div>

<style>
  .sim-pill {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 16px 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .sim-pill:hover {
    border-color: rgba(139, 92, 246, 0.3);
  }
  .sim-pill.active {
    background: rgba(139, 92, 246, 0.15);
    border-color: var(--primary);
    box-shadow: 0 0 15px var(--primary-glow);
  }

  .sim-addon-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .sim-addon-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
  }
  .sim-addon-card.active {
    background: rgba(139, 92, 246, 0.12);
    border-color: var(--primary);
  }
</style>

<script>
  let baseFormatPrice = 400;
  let baseFormatName = "Acústico (2 Músicos)";
  let selectedHours = 2;
  let activeAddons = [];

  function selectBandFormat(key, price, name, element) {
    document.querySelectorAll('.sim-pill').forEach(el => el.classList.remove('active'));
    element.classList.add('active');
    baseFormatPrice = price;
    baseFormatName = name;
    updateSummary();
  }

  function updateHours(hours) {
    selectedHours = parseInt(hours);
    document.getElementById('hours-display').textContent = `${hours} ${hours === '1' ? 'Hora' : 'Horas'}`;
    updateSummary();
  }

  function toggleAddon(element, addonName, addonPrice) {
    const checkbox = element.querySelector('input[type="checkbox"]');
    checkbox.checked = !checkbox.checked;
    
    if (checkbox.checked) {
      element.classList.add('active');
      activeAddons.push({ name: addonName, price: addonPrice });
    } else {
      element.classList.remove('active');
      activeAddons = activeAddons.filter(a => a.name !== addonName);
    }
    updateSummary();
  }

  function updateSummary() {
    document.getElementById('sum-format-name').textContent = baseFormatName;
    document.getElementById('sum-format-price').textContent = `$${baseFormatPrice} USD`;

    let extraHoursCost = 0;
    if (selectedHours > 2) {
      extraHoursCost = (selectedHours - 2) * 120;
      document.getElementById('sum-hours-name').textContent = `${selectedHours} Horas (+${selectedHours - 2}h extra)`;
      document.getElementById('sum-hours-price').textContent = `+$${extraHoursCost} USD`;
    } else {
      document.getElementById('sum-hours-name').textContent = `${selectedHours} ${selectedHours === 1 ? 'Hora' : 'Horas'}`;
      document.getElementById('sum-hours-price').textContent = selectedHours === 1 ? "-$50 USD" : "Incluidas";
      if (selectedHours === 1) extraHoursCost = -50;
    }

    const addonsContainer = document.getElementById('sum-addons-list');
    addonsContainer.innerHTML = '';
    let addonsTotal = 0;

    activeAddons.forEach(addon => {
      addonsTotal += addon.price;
      const row = document.createElement('div');
      row.style.display = 'flex';
      row.style.justifyContent = 'space-between';
      row.innerHTML = `<span style="color: var(--text-muted);">${addon.name}</span><strong>+$${addon.price} USD</strong>`;
      addonsContainer.appendChild(row);
    });

    const total = baseFormatPrice + extraHoursCost + addonsTotal;
    document.getElementById('sim-total-price').textContent = `$${total}`;

    const dateVal = document.getElementById('sim-date').value || "Por definir";
    const locVal = document.getElementById('sim-location').value || "Por confirmar";
    
    let addonsText = activeAddons.length > 0 ? activeAddons.map(a => a.name).join(", ") : "Ninguno";
    
    let waMsg = `¡Hola <%= @company.name %>! Estuve calculando en su cotizador web y me gustaría reservar:\n` +
      `• Formato: ${baseFormatName}\n` +
      `• Duración: ${selectedHours} horas\n` +
      `• Efectos/Adicionales: ${addonsText}\n` +
      `• Fecha tentativa: ${dateVal}\n` +
      `• Ciudad/Lugar: ${locVal}\n` +
      `• Presupuesto estimado: $${total} USD\n\n` +
      `¿Tienen disponibilidad para esta fecha?`;

    const waBtn = document.getElementById('btn-whatsapp-quote');
    waBtn.href = `https://wa.me/584140000000?text=${encodeURIComponent(waMsg)}`;
  }

  updateSummary();
</script>
