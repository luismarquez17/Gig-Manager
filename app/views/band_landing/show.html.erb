<%# --- JAVASCRIPT DEL SIMULADOR EN VIVO (LÓGICA SEPARADA: SHOWS VS SONIDO) & GALERÍA --- %>
<script>
  const baseShowsCount = <%= @company.landing_calculator_base_shows || 1 %>;
  const extraShowPrice = <%= @company.landing_calculator_extra_show_price || 250.0 %>;
  const baseSoundHours = <%= @company.landing_calculator_base_sound_hours || 4 %>;
  const extraSoundHourRate = <%= @company.landing_calculator_extra_sound_hour_price || 60.0 %>;
  const defaultCurrency = '<%= @company.landing_calculator_currency.presence || "USD" %>';

  <% first_fmt = @calculator_formats.first || { 'price' => 400, 'name' => 'Acústico', 'musicians' => 'Dúo' } %>
  let baseFormatPrice = <%= first_fmt['price'].to_f %>;
  let baseFormatName = "<%= first_fmt['name'] %> (<%= first_fmt['musicians'] %>)";
  let selectedShows = 1;
  let selectedSoundHours = baseSoundHours;
  let activeAddons = [];

  function selectBandFormat(key, price, name, element) {
    document.querySelectorAll('.sim-pill').forEach(el => el.classList.remove('active'));
    element.classList.add('active');
    baseFormatPrice = price;
    baseFormatName = name;
    updateSummary();
  }

  function selectShows(showsCount, element) {
    document.querySelectorAll('.sim-show-pill').forEach(el => {
      el.classList.remove('active');
      el.style.borderColor = 'var(--card-border)';
      el.style.background = 'rgba(255,255,255,0.04)';
    });
    element.classList.add('active');
    element.style.borderColor = 'var(--primary)';
    element.style.background = 'var(--primary-glow)';
    selectedShows = parseInt(showsCount);
    updateSummary();
  }

  function updateSoundHours(hours) {
    selectedSoundHours = parseInt(hours);
    document.getElementById('sound-hours-display').textContent = `${hours} Horas`;
    updateSummary();
  }

  function selectAndScrollToFormat(key, price, name) {
    const pill = document.querySelector(`.sim-pill[data-format="${key}"]`);
    if (pill) {
      selectBandFormat(key, price, name, pill);
    }
    const cotizadorSection = document.getElementById('cotizador');
    if (cotizadorSection) {
      cotizadorSection.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function toggleAddon(element, addonName, addonPrice) {
    const checkbox = element.querySelector('input[type="checkbox"]');
    checkbox.checked = !checkbox.checked;
    
    if (checkbox.checked) {
      element.classList.add('active');
      activeAddons.push({ name: addonName, price: addonPrice });
    } else {
      element.classList.remove('active');
      activeAddons = activeAddons.filter(a => a.name !== addonName);
    }
    updateSummary();
  }

  function updateSummary() {
    document.getElementById('sum-format-name').textContent = baseFormatName;
    document.getElementById('sum-format-price').textContent = `$${baseFormatPrice} ${defaultCurrency}`;

    // 1. Shows en Vivo (1 Hora por Pase)
    let extraShowsCost = 0;
    if (selectedShows > 1) {
      extraShowsCost = (selectedShows - 1) * extraShowPrice;
      document.getElementById('sum-shows-name').textContent = `${selectedShows} Shows en Vivo (${selectedShows} Pases de 60m)`;
      document.getElementById('sum-shows-price').textContent = `+$${Math.round(extraShowsCost)} ${defaultCurrency}`;
      document.getElementById('sum-shows-price').style.color = '#34d399';
    } else {
      document.getElementById('sum-shows-name').textContent = "1 Show en Vivo (Pase de 60m)";
      document.getElementById('sum-shows-price').textContent = "Incluido";
      document.getElementById('sum-shows-price').style.color = '#34d399';
    }

    // 2. Cobertura de Sonido & DJ
    let extraSoundCost = 0;
    if (selectedSoundHours > baseSoundHours) {
      extraSoundCost = (selectedSoundHours - baseSoundHours) * extraSoundHourRate;
      document.getElementById('sum-sound-name').textContent = `${selectedSoundHours} Horas Sonido (+${selectedSoundHours - baseSoundHours}h extra)`;
      document.getElementById('sum-sound-price').textContent = `+$${Math.round(extraSoundCost)} ${defaultCurrency}`;
      document.getElementById('sum-sound-price').style.color = '#34d399';
    } else if (selectedSoundHours < baseSoundHours) {
      extraSoundCost = (selectedSoundHours - baseSoundHours) * (extraSoundHourRate * 0.5);
      document.getElementById('sum-sound-name').textContent = `${selectedSoundHours} Horas Sonido & DJ`;
      document.getElementById('sum-sound-price').textContent = `-$${Math.abs(Math.round(extraSoundCost))} ${defaultCurrency}`;
      document.getElementById('sum-sound-price').style.color = '#cbd5e1';
    } else {
      document.getElementById('sum-sound-name').textContent = `${selectedSoundHours} Horas Sonido & DJ`;
      document.getElementById('sum-sound-price').textContent = "Incluidas";
      document.getElementById('sum-sound-price').style.color = '#34d399';
    }

    // 3. Adicionales
    const addonsContainer = document.getElementById('sum-addons-list');
    addonsContainer.innerHTML = '';
    let addonsTotal = 0;

    activeAddons.forEach(addon => {
      addonsTotal += addon.price;
      const row = document.createElement('div');
      row.style.display = 'flex';
      row.style.justifyContent = 'space-between';
      row.innerHTML = `<span style="color: var(--text-muted);">${addon.name}</span><strong>+$${addon.price} ${defaultCurrency}</strong>`;
      addonsContainer.appendChild(row);
    });

    const total = baseFormatPrice + extraShowsCost + extraSoundCost + addonsTotal;
    document.getElementById('sim-total-price').textContent = `$${Math.round(total)}`;

    // 4. Construir mensaje de WhatsApp
    const dateVal = document.getElementById('sim-date').value || "Por definir";
    const locVal = document.getElementById('sim-location').value || "Por confirmar";
    
    let addonsText = activeAddons.length > 0 ? activeAddons.map(a => a.name).join(", ") : "Ninguno";
    
    let waMsg = `¡Hola <%= @company.name %>! Estuve calculando en su cotizador web y me gustaría reservar:\n` +
      `• Formato: ${baseFormatName}\n` +
      `• Shows en Vivo: ${selectedShows} ${selectedShows === 1 ? 'Show (1 Pase de 60m)' : 'Shows (' + selectedShows + ' Pases de 60m con receso)'}\n` +
      `• Cobertura de Sonido & DJ: ${selectedSoundHours} Horas\n` +
      `• Efectos/Adicionales: ${addonsText}\n` +
      `• Fecha tentativa: ${dateVal}\n` +
      `• Ciudad/Lugar: ${locVal}\n` +
      `• Presupuesto estimado: $${Math.round(total)} ${defaultCurrency}\n\n` +
      `¿Tienen disponibilidad para esta fecha?`;

    const waNumber = '<%= @whatsapp_number.gsub(/[^0-9]/, "") %>';
    const waBtn = document.getElementById('btn-whatsapp-quote');
    waBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMsg)}`;
  }

  // Filtrado de Galería Audiovisual
  function filterMediaCategory(category) {
    document.querySelectorAll('.media-filter-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelector(`.media-filter-btn[data-cat="${category}"]`)?.classList.add('active');

    const cards = document.querySelectorAll('.media-card');
    cards.forEach(card => {
      if (category === 'all' || card.getAttribute('data-category') === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // Acordeón de FAQs
  function toggleFaqAccordion(idx) {
    const ans = document.getElementById(`faq-ans-${idx}`);
    const arrow = document.getElementById(`faq-arrow-${idx}`);
    if (!ans) return;
    if (ans.style.display === 'block') {
      ans.style.display = 'none';
      if (arrow) arrow.textContent = '▼';
    } else {
      ans.style.display = 'block';
      if (arrow) arrow.textContent = '▲';
    }
  }

  // Inicializar cálculo
  updateSummary();
</script>
