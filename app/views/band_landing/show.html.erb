<div class="landing-container">

  <%# --- 1. HERO SECTION --- %>
  <section id="hero" style="text-align: center; padding: 60px 0 80px; position: relative;">
    <div class="section-badge">✨ Experiencia Musical de Alto Nivel</div>
    <h1 class="gradient-title" style="font-size: clamp(2.4em, 6vw, 4.2em); line-height: 1.1; margin: 0 0 20px 0; max-width: 900px; margin-left: auto; margin-right: auto;">
      <%= @company.tagline.presence || "La Mejor Música en Vivo para tu Boda o Evento" %>
    </h1>
    <p style="font-size: clamp(1.05em, 2.5vw, 1.25em); color: var(--text-muted); max-width: 680px; margin: 0 auto 35px; line-height: 1.6;">
      <%= @company.bio.presence || "Transformamos tu celebración con sonido profesional, puesta en escena impecable y un repertorio diseñado a tu medida en #{@company.name}." %>
    </p>

    <div style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; margin-bottom: 40px;">
      <a href="#cotizador" class="btn-cta-primary">
        <span>⚡</span> Simular Mi Presupuesto en Vivo
      </a>
      <a href="#paquetes" class="btn-cta-secondary">
        <span>📦</span> Ver Paquetes Base
      </a>
    </div>

    <%# Métricas / Social Proof %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; max-width: 800px; margin: 0 auto;">
      <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; padding: 16px;">
        <div style="font-family: var(--font-outfit); font-size: 2em; font-weight: 900; color: #fbbf24;">★ <%= @rating %></div>
        <div style="font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Calificación de Clientes</div>
      </div>
      <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; padding: 16px;">
        <div style="font-family: var(--font-outfit); font-size: 2em; font-weight: 900; color: #34d399;">100%</div>
        <div style="font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Puntualidad &amp; Show</div>
      </div>
      <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; padding: 16px;">
        <div style="font-family: var(--font-outfit); font-size: 2em; font-weight: 900; color: #c084fc;">Top Live</div>
        <div style="font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Show Enérgico &amp; Pro</div>
      </div>
    </div>
  </section>

  <%# --- 2. PAQUETES DESTACADOS (PRESET BUDGETS) --- %>
  <section id="paquetes" style="padding: 40px 0 70px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <span class="section-badge">Nuestros Paquetes</span>
      <h2 class="gradient-title" style="font-size: 2.3em; margin: 0;">Opciones Listas para Celebrar</h2>
      <p style="color: var(--text-muted); font-size: 1.05em; margin-top: 8px;">Elige una configuración prediseñada o personaliza cada detalle en nuestro cotizador.</p>
    </div>

    <% if @preset_budgets.any? %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px;">
        <% @preset_budgets.each do |preset| %>
          <div class="glass-box" style="display: flex; flex-direction: column; justify-content: space-between; border-color: rgba(139, 92, 246, 0.2); transition: transform 0.3s ease, border-color 0.3s ease;" onmouseover="this.style.transform='translateY(-4px)'; this.style.borderColor='rgba(139,92,246,0.5)';" onmouseout="this.style.transform='none'; this.style.borderColor='rgba(139,92,246,0.2)';">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <h3 style="margin: 0; font-family: var(--font-outfit); font-size: 1.4em; font-weight: 800; color: var(--text-main);">
                  <%= preset.title %>
                </h3>
              </div>

              <div style="margin: 15px 0 20px 0;">
                <span style="font-family: var(--font-outfit); font-size: 2.2em; font-weight: 900; color: #34d399;">
                  <%= number_to_currency(preset.price, unit: preset.currency == "USD" ? "$" : "Bs. ", precision: 0) %>
                </span>
                <span style="color: var(--text-muted); font-size: 0.9em;"><%= preset.currency %></span>
              </div>

              <p style="color: #cbd5e1; font-size: 0.95em; line-height: 1.6; margin: 0 0 20px 0; white-space: pre-line;">
                <%= preset.description %>
              </p>
            </div>

            <% 
              wa_text = "Hola! Me interesa el paquete \"#{preset.title}\" por #{preset.price.to_i} #{preset.currency} para mi evento. ¿Tienen disponibilidad?"
              wa_link = "https://wa.me/584140000000?text=#{ERB::Util.url_encode(wa_text)}"
            %>
            <a href="<%= wa_link %>" target="_blank" class="btn-cta-primary" style="width: 100%; justify-content: center; text-decoration: none; margin-top: 15px;">
              <span>💬</span> Consultar Disponibilidad
            </a>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Paquetes de demostración por defecto %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px;">
        <div class="glass-box" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <h3 style="margin: 0; font-family: var(--font-outfit); font-size: 1.4em; font-weight: 800;">Formato Acústico / Íntimo</h3>
            <div style="margin: 15px 0 20px 0;">
              <span style="font-family: var(--font-outfit); font-size: 2.2em; font-weight: 900; color: #34d399;">$400</span>
              <span style="color: var(--text-muted); font-size: 0.9em;">USD</span>
            </div>
            <p style="color: #cbd5e1; font-size: 0.95em; line-height: 1.6;">
              • Dúo / Trío Acústico (Voz, Guitarra/Piano, Percusión)<br>
              • 2 Horas de Música en Vivo<br>
              • Sonido para hasta 80 personas<br>
              • Ideal para recepciones, cócteles o cenas.
            </p>
          </div>
          <button onclick="selectAndScrollToFormat('acoustic', 400, 'Acústico (2 Músicos)')" class="btn-cta-primary" style="justify-content: center; width: 100%;">⚡ Cotizar Este Formato</button>
        </div>

        <div class="glass-box" style="border-color: rgba(139, 92, 246, 0.4); box-shadow: 0 0 30px rgba(139, 92, 246, 0.2); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span style="background: rgba(139, 92, 246, 0.2); color: #c084fc; font-size: 0.75em; font-weight: 800; padding: 4px 10px; border-radius: 99px; text-transform: uppercase;">Más Popular</span>
            <h3 style="margin: 8px 0 0 0; font-family: var(--font-outfit); font-size: 1.4em; font-weight: 800;">Banda Completa Fiesta</h3>
            <div style="margin: 15px 0 20px 0;">
              <span style="font-family: var(--font-outfit); font-size: 2.2em; font-weight: 900; color: #34d399;">$750</span>
              <span style="color: var(--text-muted); font-size: 0.9em;">USD</span>
            </div>
            <p style="color: #cbd5e1; font-size: 0.95em; line-height: 1.6;">
              • Banda Completa 5 integrantes (Vocalistas, Bajo, Batería, Teclados, Guitarra)<br>
              • 2 Horas de Show Bailable &amp; Pop/Rock<br>
              • Sonido e Iluminación LED Automatizada<br>
              • Montaje profesional completo.
            </p>
          </div>
          <button onclick="selectAndScrollToFormat('full_band', 750, 'Banda Completa (5 Músicos)')" class="btn-cta-primary" style="justify-content: center; width: 100%;">⚡ Cotizar Este Formato</button>
        </div>

        <div class="glass-box" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <h3 style="margin: 0; font-family: var(--font-outfit); font-size: 1.4em; font-weight: 800;">Show Premium Big Band</h3>
            <div style="margin: 15px 0 20px 0;">
              <span style="font-family: var(--font-outfit); font-size: 2.2em; font-weight: 900; color: #34d399;">$1,200</span>
              <span style="color: var(--text-muted); font-size: 0.9em;">USD</span>
            </div>
            <p style="color: #cbd5e1; font-size: 0.95em; line-height: 1.6;">
              • Banda 8+ músicos (Incluye sección de Metales: Trompeta &amp; Saxo)<br>
              • 2 Horas de Show Continuo de Alto Impacto<br>
              • Sonido para grandes aforos<br>
              • Experiencia VIP para bodas y galas.
            </p>
          </div>
          <button onclick="selectAndScrollToFormat('big_band', 1200, 'Big Band con Metales (8+ Músicos)')" class="btn-cta-primary" style="justify-content: center; width: 100%;">⚡ Cotizar Este Formato</button>
        </div>
      </div>
    <% end %>
  </section>

  <%# --- 3. SIMULADOR / COTIZADOR VISUAL EN VIVO --- %>
  <section id="cotizador" style="padding: 40px 0 80px;">
    <div class="glass-box" style="border: 2px solid rgba(139, 92, 246, 0.35); box-shadow: 0 12px 50px rgba(139, 92, 246, 0.15);">
      <div style="text-align: center; margin-bottom: 35px;">
        <span class="section-badge">Calculadora en Vivo</span>
        <h2 class="gradient-title" style="font-size: 2.4em; margin: 0;">Simula tu Presupuesto al Instante</h2>
        <p style="color: var(--text-muted); font-size: 1.05em; margin-top: 8px;">Juega con las opciones y calcula el valor estimado de tu evento en tiempo real.</p>
      </div>

      <div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 35px; align-items: start;">
        
        <%# Controles del Simulador %>
        <div>
          <%# 1. Formato de Banda %>
          <div style="margin-bottom: 25px;">
            <label style="display: block; font-family: var(--font-outfit); font-weight: 800; font-size: 0.95em; text-transform: uppercase; color: #a78bfa; margin-bottom: 12px;">
              1. Selecciona el Formato de la Agrupación
            </label>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px;">
              <div class="sim-pill active" data-format="acoustic" onclick="selectBandFormat('acoustic', 400, 'Acústico (2 Músicos)', this)">
                <div style="font-size: 1.4em;">🎻</div>
                <strong>Acústico</strong>
                <span style="font-size: 0.75em; color: var(--text-muted); display: block;">Dúo / Trío</span>
              </div>
              <div class="sim-pill" data-format="full_band" onclick="selectBandFormat('full_band', 750, 'Banda Completa (5 Músicos)', this)">
                <div style="font-size: 1.4em;">🎸</div>
                <strong>Banda Completa</strong>
                <span style="font-size: 0.75em; color: var(--text-muted); display: block;">5 Músicos</span>
              </div>
              <div class="sim-pill" data-format="big_band" onclick="selectBandFormat('big_band', 1200, 'Big Band con Metales (8+ Músicos)', this)">
                <div style="font-size: 1.4em;">🎺</div>
                <strong>Big Band</strong>
                <span style="font-size: 0.75em; color: var(--text-muted); display: block;">Metales &amp; Show</span>
              </div>
            </div>
          </div>

          <%# 2. Horas de Show %>
          <div style="margin-bottom: 25px;">
            <label style="display: block; font-family: var(--font-outfit); font-weight: 800; font-size: 0.95em; text-transform: uppercase; color: #a78bfa; margin-bottom: 12px;">
              2. Duración del Show: <span id="hours-display" style="color: white; font-size: 1.1em;">2 Horas</span>
            </label>
            <input type="range" id="hours-slider" min="1" max="5" value="2" step="1" style="width: 100%; accent-color: var(--primary); cursor: pointer;" oninput="updateHours(this.value)">
            <div style="display: flex; justify-content: space-between; font-size: 0.78em; color: var(--text-muted); font-weight: 700; margin-top: 6px;">
              <span>1 Hora</span>
              <span>2 Horas</span>
              <span>3 Horas</span>
              <span>4 Horas</span>
              <span>5 Horas</span>
            </div>
          </div>

          <%# 3. Efectos y Adicionales %>
          <div style="margin-bottom: 25px;">
            <label style="display: block; font-family: var(--font-outfit); font-weight: 800; font-size: 0.95em; text-transform: uppercase; color: #a78bfa; margin-bottom: 12px;">
              3. Añade Efectos Especiales &amp; Producción
            </label>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px;">
              <div class="sim-addon-card" onclick="toggleAddon(this, 'Chispas Frías (Pirotecnia Fría)', 120)">
                <input type="checkbox" style="accent-color: var(--primary);">
                <div>
                  <strong style="display: block; font-size: 0.9em;">✨ Chispas Frías</strong>
                  <span style="font-size: 0.8em; color: #34d399;">+$120 USD</span>
                </div>
              </div>
              <div class="sim-addon-card" onclick="toggleAddon(this, 'Máquina de Humo / Geiser', 60)">
                <input type="checkbox" style="accent-color: var(--primary);">
                <div>
                  <strong style="display: block; font-size: 0.9em;">💨 Máquina de Humo</strong>
                  <span style="font-size: 0.8em; color: #34d399;">+$60 USD</span>
                </div>
              </div>
              <div class="sim-addon-card" onclick="toggleAddon(this, 'Subwoofers / Refuerzo Sonoro', 100)">
                <input type="checkbox" style="accent-color: var(--primary);">
                <div>
                  <strong style="display: block; font-size: 0.9em;">🔊 Subwoofers Extra</strong>
                  <span style="font-size: 0.8em; color: #34d399;">+$100 USD</span>
                </div>
              </div>
              <div class="sim-addon-card" onclick="toggleAddon(this, 'Luces Robóticas / Cabezas Móviles', 150)">
                <input type="checkbox" style="accent-color: var(--primary);">
                <div>
                  <strong style="display: block; font-size: 0.9em;">💡 Iluminación Robótica</strong>
                  <span style="font-size: 0.8em; color: #34d399;">+$150 USD</span>
                </div>
              </div>
            </div>
          </div>

          <%# Fecha y Ubicación Opcionales %>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label style="display: block; font-size: 0.78em; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Fecha Tentativa</label>
              <input type="date" id="sim-date" class="form-input" style="background: rgba(0,0,0,0.3); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 10px 14px; width: 100%; box-sizing: border-box;" onchange="updateSummary()">
            </div>
            <div>
              <label style="display: block; font-size: 0.78em; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Ciudad o Lugar</label>
              <input type="text" id="sim-location" placeholder="Ej: Caracas / San Cristóbal" class="form-input" style="background: rgba(0,0,0,0.3); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 10px 14px; width: 100%; box-sizing: border-box;" oninput="updateSummary()">
            </div>
          </div>
        </div>

        <%# Resumen de Cotización en Vivo %>
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 25px; position: sticky; top: 90px;">
          <h3 style="margin: 0 0 15px 0; font-family: var(--font-outfit); font-size: 1.2em; font-weight: 800; color: white;">
            📋 Resumen de tu Presupuesto
          </h3>

          <div style="display: flex; flex-direction: column; gap: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 15px; margin-bottom: 15px; font-size: 0.92em;">
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);" id="sum-format-name">Acústico (2 Músicos)</span>
              <strong id="sum-format-price">$400 USD</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);" id="sum-hours-name">2 Horas de Música</span>
              <strong id="sum-hours-price">Incluidas</strong>
            </div>
            <div id="sum-addons-list" style="display: flex; flex-direction: column; gap: 6px;"></div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px;">
            <span style="font-size: 1em; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Total Estimado:</span>
            <div style="text-align: right;">
              <span style="font-family: var(--font-outfit); font-size: 2.4em; font-weight: 900; color: #34d399;" id="sim-total-price">$400</span>
              <span style="font-size: 0.9em; color: var(--text-muted);">USD</span>
            </div>
          </div>

          <a id="btn-whatsapp-quote" href="#" target="_blank" class="btn-cta-primary" style="width: 100%; justify-content: center; text-decoration: none; padding: 14px; background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);">
            <span>💬</span> Reservar por WhatsApp
          </a>
          <p style="text-align: center; font-size: 0.75em; color: var(--text-muted); margin: 10px 0 0 0;">
            Te atenderemos de inmediato para confirmar disponibilidad.
          </p>
        </div>

      </div>
    </div>
  </section>

  <%# --- 4. GALERÍA AUDIOVISUAL & VIDEOS EN TARIMA --- %>
  <section id="galeria" style="padding: 40px 0 80px;">
    <div style="text-align: center; margin-bottom: 35px;">
      <span class="section-badge">Showcase Audiovisual</span>
      <h2 class="gradient-title" style="font-size: 2.4em; margin: 0;">Instrumentos, Producción &amp; Show en Vivo</h2>
      <p style="color: var(--text-muted); font-size: 1.05em; margin-top: 8px;">Conoce de cerca la calidad de nuestros instrumentos, backline profesional y la energía en tarima.</p>
      
      <%# Filtros de Categoría %>
      <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 20px;" id="media-filter-buttons">
        <button onclick="filterMediaCategory('all')" class="media-filter-btn active" data-cat="all">Todos</button>
        <button onclick="filterMediaCategory('live_show')" class="media-filter-btn" data-cat="live_show">🔥 En Vivo &amp; Tarima</button>
        <button onclick="filterMediaCategory('instruments')" class="media-filter-btn" data-cat="instruments">🎸 Instrumentos &amp; Backline</button>
        <button onclick="filterMediaCategory('effects')" class="media-filter-btn" data-cat="effects">✨ Efectos &amp; Iluminación</button>
        <button onclick="filterMediaCategory('backstage')" class="media-filter-btn" data-cat="backstage">🎬 Montaje &amp; Backstage</button>
      </div>
    </div>

    <% if @media_items.any? %>
      <div id="media-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        <% @media_items.each do |item| %>
          <div class="glass-box media-card" data-category="<%= item.category %>" style="padding: 16px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <%# Reproductor o Imagen %>
              <div style="border-radius: 12px; overflow: hidden; background: #000; margin-bottom: 14px; position: relative; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center;">
                <% if item.video? && item.media_file.attached? %>
                  <video controls playsinline preload="metadata" style="width: 100%; height: 100%; object-fit: cover;">
                    <source src="<%= url_for(item.media_file) %>" type="<%= item.media_file.content_type %>">
                    Tu navegador no soporta reproducción de video.
                  </video>
                <% elsif item.youtube? && item.video_url.present? %>
                  <iframe src="<%= item.youtube_embed_url %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width: 100%; height: 100%; border: none;"></iframe>
                <% elsif item.photo? && item.media_file.attached? %>
                  <%= image_tag item.media_file, style: "width: 100%; height: 100%; object-fit: cover;" %>
                <% else %>
                  <div style="text-align: center; color: var(--text-muted); padding: 20px;">
                    <span style="font-size: 2.5em; display: block; margin-bottom: 4px;">🎬</span>
                    <span style="font-size: 0.85em;"><%= item.title %></span>
                  </div>
                <% end %>
              </div>

              <%# Encabezado del contenido %>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 8px;">
                <h4 style="margin: 0; font-family: var(--font-outfit); font-size: 1.15em; font-weight: 800; color: white;">
                  <%= item.title %>
                </h4>
                <span style="background: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.3); color: #c084fc; font-size: 0.72em; padding: 2px 8px; border-radius: 99px; font-weight: 700; white-space: nowrap;">
                  <%= item.category_label %>
                </span>
              </div>

              <% if item.description.present? %>
                <p style="margin: 0; color: #cbd5e1; font-size: 0.88em; line-height: 1.4;">
                  <%= item.description %>
                </p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Showcase Placeholder demostrativo %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <div class="glass-box" style="padding: 20px;">
          <div style="border-radius: 12px; background: linear-gradient(135deg, rgba(139,92,246,0.2) 0%, rgba(6,182,212,0.2) 100%); aspect-ratio: 16/9; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 14px; border: 1px solid rgba(255,255,255,0.08);">
            <span style="font-size: 3em; margin-bottom: 6px;">🥁</span>
            <span style="font-size: 0.85em; font-weight: 700; color: #cbd5e1;">Backline de Batería &amp; Microfonía</span>
          </div>
          <h4 style="margin: 0 0 6px 0; font-family: var(--font-outfit); font-size: 1.1em; font-weight: 800; color: white;">Set Acústico &amp; Cajas Profesionales</h4>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.85em;">Microfonía Shure y consolas digitales para un sonido nítido y balanceado.</p>
        </div>

        <div class="glass-box" style="padding: 20px;">
          <div style="border-radius: 12px; background: linear-gradient(135deg, rgba(245,158,11,0.2) 0%, rgba(239,68,68,0.2) 100%); aspect-ratio: 16/9; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 14px; border: 1px solid rgba(255,255,255,0.08);">
            <span style="font-size: 3em; margin-bottom: 6px;">✨</span>
            <span style="font-size: 0.85em; font-weight: 700; color: #cbd5e1;">Chispas Frías &amp; Iluminación Robótica</span>
          </div>
          <h4 style="margin: 0 0 6px 0; font-family: var(--font-outfit); font-size: 1.1em; font-weight: 800; color: white;">Efectos Especiales de Tarima</h4>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.85em;">Chispas seguras para interiores y exteriores para momentos cumbre y primer baile.</p>
        </div>

        <div class="glass-box" style="padding: 20px;">
          <div style="border-radius: 12px; background: linear-gradient(135deg, rgba(16,185,129,0.2) 0%, rgba(59,130,246,0.2) 100%); aspect-ratio: 16/9; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 14px; border: 1px solid rgba(255,255,255,0.08);">
            <span style="font-size: 3em; margin-bottom: 6px;">🎸</span>
            <span style="font-size: 0.85em; font-weight: 700; color: #cbd5e1;">Guitarras, Bajo &amp; Teclados en Vivo</span>
          </div>
          <h4 style="margin: 0 0 6px 0; font-family: var(--font-outfit); font-size: 1.1em; font-weight: 800; color: white;">Instrumentación de Alta Gama</h4>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.85em;">Amplificadores y pedaleras de última generación para fidelidad de estudio en vivo.</p>
        </div>
      </div>
    <% end %>
  </section>

  <%# --- 5. EQUIPO DE MÚSICOS & TALENTO --- %>
