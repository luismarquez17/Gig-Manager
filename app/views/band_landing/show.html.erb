            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# --- 6. TESTIMONIOS & RESEÑAS 5 ESTRELLAS --- %>
  <section id="resenas" style="padding: 40px 0 80px;">
    <div style="text-align: center; margin-bottom: 35px;">
      <span class="section-badge">Opiniones Reales</span>
      <h2 class="gradient-title" style="font-size: 2.3em; margin: 0;">Lo que Dicen Quienes ya Celebraron con Nosotros</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
