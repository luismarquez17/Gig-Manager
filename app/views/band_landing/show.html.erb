    <section id="equipo" style="padding: 40px 0 70px;">
      <div style="text-align: center; margin-bottom: 35px;">
        <span class="section-badge">Músicos &amp; Producción</span>
        <h2 class="gradient-title" style="font-size: 2.3em; margin: 0;">Conoce a los Artistas en Tarima</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
        <% @staff_members.each do |staff| %>
          <div class="glass-box" style="text-align: center; padding: 24px;">
            <% if staff.avatar_attached? %>
              <div style="width: 85px; height: 85px; border-radius: 50%; margin: 0 auto 14px; overflow: hidden; border: 3px solid rgba(139, 92, 246, 0.4); box-shadow: 0 0 18px rgba(139, 92, 246, 0.2);">
                <%= image_tag staff.avatar_url_or_data, style: "width: 100%; height: 100%; object-fit: cover;" %>
              </div>
            <% else %>
              <div style="width: 85px; height: 85px; border-radius: 50%; margin: 0 auto 14px; background: linear-gradient(135deg, #8b5cf6 0%, #06b6d4 100%); display: flex; align-items: center; justify-content: center; font-family: var(--font-outfit); font-size: 1.8em; font-weight: 800; color: white; border: 3px solid rgba(139, 92, 246, 0.4);">
