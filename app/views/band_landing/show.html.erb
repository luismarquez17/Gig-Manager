      <% end %>
    </div>
  </section>

</div>

<%# --- ESTILOS DEL SIMULADOR --- %>
<style>
  .sim-pill {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .sim-pill:hover {
    border-color: rgba(139, 92, 246, 0.3);
  }
  .sim-pill.active {
    background: rgba(139, 92, 246, 0.15);
    border-color: var(--primary);
    box-shadow: 0 0 15px var(--primary-glow);
  }

  .sim-addon-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .sim-addon-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
  }
  .sim-addon-card.active {
    background: rgba(139, 92, 246, 0.12);
    border-color: var(--primary);
  }

  /* Media Filter Buttons */
  .media-filter-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    padding: 8px 16px;
    border-radius: 99px;
    font-size: 0.85em;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .media-filter-btn:hover {
    border-color: rgba(139, 92, 246, 0.4);
    color: white;
  }
  .media-filter-btn.active {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
    border-color: var(--primary);
    color: white;
    box-shadow: 0 2px 10px var(--primary-glow);
  }
</style>

<%# --- JAVASCRIPT DEL SIMULADOR EN VIVO & GALERÍA --- %>
<script>
  let baseFormatPrice = 400;
  let baseFormatName = "Acústico (2 Músicos)";
  let selectedHours = 2;
  let activeAddons = [];

  function selectBandFormat(key, price, name, element) {
    document.querySelectorAll('.sim-pill').forEach(el => el.classList.remove('active'));
    element.classList.add('active');
    baseFormatPrice = price;
    baseFormatName = name;
    updateSummary();
  }

  function selectAndScrollToFormat(key, price, name) {
    const pill = document.querySelector(`.sim-pill[data-format="${key}"]`);
    if (pill) {
      selectBandFormat(key, price, name, pill);
    }
    const cotizadorSection = document.getElementById('cotizador');
    if (cotizadorSection) {
      cotizadorSection.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function updateHours(hours) {
    selectedHours = parseInt(hours);
    document.getElementById('hours-display').textContent = `${hours} ${hours === '1' ? 'Hora' : 'Horas'}`;
    updateSummary();
  }

  function toggleAddon(element, addonName, addonPrice) {
    const checkbox = element.querySelector('input[type="checkbox"]');
    checkbox.checked = !checkbox.checked;
    
    if (checkbox.checked) {
      element.classList.add('active');
      activeAddons.push({ name: addonName, price: addonPrice });
    } else {
      element.classList.remove('active');
      activeAddons = activeAddons.filter(a => a.name !== addonName);
    }
    updateSummary();
  }

  function updateSummary() {
    document.getElementById('sum-format-name').textContent = baseFormatName;
    document.getElementById('sum-format-price').textContent = `$${baseFormatPrice} USD`;

    // Cálculo por horas extra
    let extraHoursCost = 0;
    if (selectedHours > 2) {
      extraHoursCost = (selectedHours - 2) * 120;
      document.getElementById('sum-hours-name').textContent = `${selectedHours} Horas (+${selectedHours - 2}h extra)`;
      document.getElementById('sum-hours-price').textContent = `+$${extraHoursCost} USD`;
    } else {
      document.getElementById('sum-hours-name').textContent = `${selectedHours} ${selectedHours === 1 ? 'Hora' : 'Horas'}`;
      document.getElementById('sum-hours-price').textContent = selectedHours === 1 ? "-$50 USD" : "Incluidas";
      if (selectedHours === 1) extraHoursCost = -50;
    }

    // Adicionales
    const addonsContainer = document.getElementById('sum-addons-list');
    addonsContainer.innerHTML = '';
    let addonsTotal = 0;

    activeAddons.forEach(addon => {
      addonsTotal += addon.price;
      const row = document.createElement('div');
      row.style.display = 'flex';
      row.style.justifyContent = 'space-between';
      row.innerHTML = `<span style="color: var(--text-muted);">${addon.name}</span><strong>+$${addon.price} USD</strong>`;
      addonsContainer.appendChild(row);
    });

    const total = baseFormatPrice + extraHoursCost + addonsTotal;
    document.getElementById('sim-total-price').textContent = `$${total}`;

    // Construir mensaje de WhatsApp
    const dateVal = document.getElementById('sim-date').value || "Por definir";
    const locVal = document.getElementById('sim-location').value || "Por confirmar";
    
    let addonsText = activeAddons.length > 0 ? activeAddons.map(a => a.name).join(", ") : "Ninguno";
    
    let waMsg = `¡Hola <%= @company.name %>! Estuve calculando en su cotizador web y me gustaría reservar:\n` +
      `• Formato: ${baseFormatName}\n` +
      `• Duración: ${selectedHours} horas\n` +
      `• Efectos/Adicionales: ${addonsText}\n` +
      `• Fecha tentativa: ${dateVal}\n` +
      `• Ciudad/Lugar: ${locVal}\n` +
      `• Presupuesto estimado: $${total} USD\n\n` +
      `¿Tienen disponibilidad para esta fecha?`;

    const waNumber = '<%= @whatsapp_number.gsub(/[^0-9]/, "") %>';
    const waBtn = document.getElementById('btn-whatsapp-quote');
    waBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMsg)}`;
  }

  // Filtrado de Galería Audiovisual
  function filterMediaCategory(category) {
    document.querySelectorAll('.media-filter-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelector(`.media-filter-btn[data-cat="${category}"]`)?.classList.add('active');

    const cards = document.querySelectorAll('.media-card');
    cards.forEach(card => {
      if (category === 'all' || card.getAttribute('data-category') === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // Inicializar cálculo
  updateSummary();
</script>
