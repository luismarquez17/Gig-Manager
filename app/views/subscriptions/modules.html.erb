<style>
  /* Toggle Switch Styles */
  .switch {
    position: relative;
    display: inline-block;
    width: 52px;
    height: 28px;
    flex-shrink: 0;
  }
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #cbd5e1;
    transition: .3s;
    border-radius: 34px;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .slider:before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    left: 4px;
    bottom: 3px;
    background-color: white;
    transition: .3s;
    border-radius: 50%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.25);
  }
  input:checked + .slider {
    background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%);
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.4);
  }
  input:checked + .slider:before {
    transform: translateX(24px);
  }
  .module-card {
    transition: all 0.25s ease;
  }
  .module-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.12) !important;
  }
</style>

<div style="max-width: 960px; margin: 0 auto; font-family: 'Inter', sans-serif;">
  
  <%# Breadcrumb / Navegación rápida %>
  <div style="margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
    <%= link_to "← Volver a Suscripción & Planes", subscriptions_path, style: "color: #6366f1; text-decoration: none; font-weight: 700; font-size: 0.9rem;" %>
    <span style="font-size: 0.85rem; color: #64748b;">
      🏢 Empresa: <strong style="color: #0f172a;"><%= @company.name %></strong>
    </span>
  </div>

  <%# Header Principal con Estilo Dark / Neón %>
  <div style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border-radius: 24px; border: 1px solid rgba(139, 92, 246, 0.3); padding: 32px; color: white; margin-bottom: 30px; box-shadow: 0 15px 35px rgba(15, 23, 42, 0.25); position: relative; overflow: hidden;">
    <div style="position: absolute; right: -20px; bottom: -20px; font-size: 8rem; opacity: 0.05; pointer-events: none;">🧩</div>
    
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 14px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 14px; border-radius: 50px; background: rgba(139, 92, 246, 0.2); border: 1px solid rgba(139, 92, 246, 0.4); color: #c084fc; font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">
        <span>⚡</span> Catálogo de Opciones de GigManager
      </div>
      <span style="padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; background: rgba(6, 182, 212, 0.2); border: 1px solid rgba(6, 182, 212, 0.4); color: #38bdf8;">
        <%= @company.enabled_module_keys.count %> de <%= AppModule.all.count %> Módulos Activos
      </span>
    </div>

    <h1 style="font-size: 2rem; font-weight: 800; margin: 0 0 10px 0; color: white; letter-spacing: -0.5px;">
      Añadir y Configurar Opciones de tu Agrupación
    </h1>
    <p style="color: #cbd5e1; font-size: 1rem; margin: 0; max-width: 680px; line-height: 1.6;">
      Personaliza las herramientas que aparecen en tu menú lateral izquierdo. Puedes encender módulos adicionales en cualquier momento para potenciar la gestión de tus shows.
    </p>
  </div>

  <%= form_with url: update_company_modules_path, method: :patch, local: true do |f| %>

    <% 
      active_modules = AppModule.all.select { |m| @company.module_enabled?(m[:key]) }
      inactive_modules = AppModule.all.reject { |m| @company.module_enabled?(m[:key]) }
    %>

    <%# SECCIÓN 1: MÓDULOS ACTIVOS %>
    <% if active_modules.any? %>
      <div style="margin-bottom: 35px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
          <span style="font-size: 1.2rem;">✅</span>
          <h2 style="font-size: 1.2rem; font-weight: 800; color: #0f172a; margin: 0;">
            Funciones Activas en tu Menú (<%= active_modules.count %>)
          </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <% active_modules.each do |mod| %>
            <div class="module-card" style="background: white; border-radius: 18px; border: 1.5px solid #a7f3d0; padding: 20px 24px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.05); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
              
              <div style="display: flex; align-items: flex-start; gap: 16px; flex: 1; min-width: 260px;">
                <div style="width: 48px; height: 48px; border-radius: 14px; background: #ecfdf5; border: 1px solid #a7f3d0; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; flex-shrink: 0;">
                  <%= mod[:icon] %>
                </div>

                <div>
                  <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
                    <h3 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #0f172a;">
                      <%= mod[:name] %>
                    </h3>
                    <span style="font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: #f1f5f9; color: #64748b; text-transform: uppercase;">
                      <%= mod[:category] %>
                    </span>
                    <span style="font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 6px; background: #dcfce7; color: #15803d;">
                      ✓ En tu Menú Lateral
                    </span>
                  </div>
                  
                  <p style="margin: 0 0 8px 0; font-size: 0.88rem; color: #475569; line-height: 1.45;">
                    <%= mod[:description] %>
                  </p>

                  <% if mod[:features].present? %>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                      <% mod[:features].each do |feat| %>
                        <span style="font-size: 0.72rem; padding: 2px 8px; border-radius: 6px; background: #f1f5f9; color: #334155; font-weight: 600;">
                          ✓ <%= feat %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 14px;">
                <span style="font-size: 0.82rem; font-weight: 800; color: #059669;">
                  Activo
                </span>
                
                <label class="switch" title="Desactivar <%= mod[:name] %>">
                  <%= hidden_field_tag "modules[#{mod[:key]}]", "0" %>
                  <%= check_box_tag "modules[#{mod[:key]}]", "1", true, id: "module_toggle_#{mod[:key]}" %>
                  <span class="slider"></span>
                </label>
              </div>

            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# SECCIÓN 2: OPCIONES DISPONIBLES PARA AÑADIR %>
    <div style="margin-bottom: 35px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
        <span style="font-size: 1.2rem;">✨</span>
        <h2 style="font-size: 1.2rem; font-weight: 800; color: #0f172a; margin: 0;">
          <% if inactive_modules.any? %>
            Opciones y Módulos Adicionales Disponibles para Añadir (<%= inactive_modules.count %>)
          <% else %>
            ¡Tu agrupación tiene todas las opciones y herramientas activadas! 🎉
          <% end %>
        </h2>
      </div>

      <% if inactive_modules.any? %>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <% inactive_modules.each do |mod| %>
            <div class="module-card" style="background: #fafafa; border-radius: 18px; border: 1.5px dashed #cbd5e1; padding: 20px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
              
              <div style="display: flex; align-items: flex-start; gap: 16px; flex: 1; min-width: 260px;">
                <div style="width: 48px; height: 48px; border-radius: 14px; background: #f1f5f9; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; flex-shrink: 0; opacity: 0.8;">
                  <%= mod[:icon] %>
                </div>

                <div>
                  <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
                    <h3 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #1e293b;">
                      <%= mod[:name] %>
                    </h3>
                    <span style="font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: #f1f5f9; color: #64748b; text-transform: uppercase;">
                      <%= mod[:category] %>
                    </span>
                    <span style="font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 6px; background: #ede9fe; color: #6d28d9;">
                      ➕ Disponible para Añadir
                    </span>
                  </div>
                  
                  <p style="margin: 0 0 8px 0; font-size: 0.88rem; color: #64748b; line-height: 1.45;">
                    <%= mod[:description] %>
                  </p>

                  <% if mod[:features].present? %>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                      <% mod[:features].each do |feat| %>
                        <span style="font-size: 0.72rem; padding: 2px 8px; border-radius: 6px; background: #e2e8f0; color: #475569; font-weight: 600;">
                          + <%= feat %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 14px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: #94a3b8;">
                  Apagado
                </span>
                
                <label class="switch" title="Activar <%= mod[:name] %>">
                  <%= hidden_field_tag "modules[#{mod[:key]}]", "0" %>
                  <%= check_box_tag "modules[#{mod[:key]}]", "1", false, id: "module_toggle_#{mod[:key]}" %>
                  <span class="slider"></span>
                </label>
              </div>

            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Botón Flotante / Inferior de Guardado %>
    <div style="background: white; border-radius: 20px; border: 1px solid #e2e8f0; padding: 20px 28px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; box-shadow: 0 10px 25px rgba(0,0,0,0.06); position: sticky; bottom: 20px; z-index: 10;">
      <div>
        <div style="font-weight: 800; color: #0f172a; font-size: 0.95rem;">¿Listo para actualizar las herramientas de tu banda?</div>
        <div style="font-size: 0.82rem; color: #64748b;">Los módulos encendidos aparecerán inmediatamente en tu menú lateral izquierdo.</div>
      </div>

      <div style="display: flex; gap: 10px;">
        <%= link_to "Cancelar", subscriptions_path, style: "padding: 12px 20px; border-radius: 12px; background: #f1f5f9; color: #475569; text-decoration: none; font-weight: 700; font-size: 0.9rem;" %>
        <%= f.submit "💾 Guardar y Aplicar Módulos", style: "padding: 12px 28px; border-radius: 12px; background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); color: white; border: none; font-weight: 800; font-size: 0.92rem; cursor: pointer; box-shadow: 0 4px 15px rgba(6, 182, 212, 0.35); transition: transform 0.15s;" %>
      </div>
    </div>

  <% end %>

</div>
