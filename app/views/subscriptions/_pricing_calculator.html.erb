<%# 
  Partial: _pricing_calculator.html.erb
  Calculador y Simulador Unificado de Planes Base y Módulos Adicionales (+ $3 USD)
%>

<style>
  .calc-container {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .pkg-pill-btn {
    transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: 2px solid #cbd5e1;
    position: relative;
    user-select: none;
  }
  .pkg-pill-btn:hover {
    transform: translateY(-3px);
    border-color: #94a3b8;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);
  }
  .pkg-pill-btn.is-active {
    border-color: #6366f1 !important;
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%) !important;
    color: white !important;
    box-shadow: 0 14px 30px -5px rgba(99, 102, 241, 0.4) !important;
    transform: translateY(-2px);
  }
  .pkg-pill-btn.is-active .pkg-name {
    color: white !important;
  }
  .pkg-pill-btn.is-active .pkg-subtext {
    color: #cbd5e1 !important;
  }
  .pkg-pill-btn.is-active .pkg-price-text {
    color: #38bdf8 !important;
  }
  .calc-module-row {
    transition: all 0.18s ease;
  }
  .calc-module-row:hover {
    border-color: #94a3b8 !important;
  }
  .calc-module-row.is-included {
    background: #f0fdf4 !important;
    border-color: #86efac !important;
  }
  .calc-module-row.is-extra-active {
    background: #fefce8 !important;
    border-color: #fde047 !important;
    box-shadow: 0 4px 12px rgba(234, 179, 8, 0.1) !important;
  }
  .calc-glow-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    border: 1.5px solid #6366f1;
    color: white;
    box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.3);
  }

  @media (max-width: 900px) {
    .pkg-grid-5 {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    .pkg-grid-5 .pkg-pill-btn:last-child {
      grid-column: span 2 !important;
    }
  }
  @media (max-width: 600px) {
    .pkg-grid-5 {
      grid-template-columns: 1fr !important;
    }
    .pkg-grid-5 .pkg-pill-btn:last-child {
      grid-column: span 1 !important;
    }
  }
</style>

<div class="calc-container" id="gigmanager-pricing-calculator" style="margin-bottom: 35px;">
  
  <%# Tarjeta Principal del Calculador %>
  <div style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 24px;">
    
    <%# Encabezado %>
    <div style="text-align: center; max-width: 760px; margin: 0 auto 28px auto;">
      <div style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 14px; border-radius: 50px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); color: #4f46e5; font-size: 0.82rem; font-weight: 800; text-transform: uppercase; margin-bottom: 10px;">
        <span>💎</span> Planes Base & Calculadora de Módulos Extra
      </div>
      <h2 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin: 0 0 8px 0; letter-spacing: -0.5px;">
        Elige tu Plan Base y Personaliza tus Módulos
      </h2>
      <p style="color: #64748b; font-size: 0.95rem; margin: 0; line-height: 1.5;">
        Selecciona un paquete pre-diseñado para tu sector. Los módulos de tu paquete están <strong>incluidos ($0)</strong>. Si agregas un módulo fuera del paquete, se cotiza a <strong>+$3.00 USD/mes</strong>.
      </p>
    </div>

    <%# 1. PLANES BASE ARRIBA (5 Cards Responsivas en Grid) %>
    <div style="margin-bottom: 30px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
        <label style="font-size: 0.84rem; font-weight: 800; text-transform: uppercase; color: #334155; letter-spacing: 0.5px;">
          1. Selecciona tu Paquete Base:
        </label>
        <span style="font-size: 0.78rem; color: #64748b; font-weight: 600;">
          💡 Haz clic en cualquier plan para cambiar la configuración
        </span>
      </div>

      <div class="pkg-grid-5" style="display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px;" id="calc-package-tabs">
        <% AppModule.packages.each do |pkg| %>
          <% is_selected = (@simulated_plan.presence || @company.plan_tier) == pkg[:key] %>
          <div class="pkg-pill-btn <%= 'is-active' if is_selected %>" data-pkg-key="<%= pkg[:key] %>" style="background: <%= is_selected ? '#0f172a' : '#f8fafc' %>; color: <%= is_selected ? 'white' : '#1e293b' %>; border-radius: 18px; padding: 14px 12px; display: flex; flex-direction: column; justify-content: space-between;">
            
            <div>
              <%# Badge en fila superior dedicada %>
              <div style="min-height: 22px; margin-bottom: 8px; display: flex; align-items: center; justify-content: flex-start;">
                <% if pkg[:badge].present? %>
                  <span class="pkg-badge-pill" style="font-size: 0.62rem; font-weight: 900; padding: 2px 7px; border-radius: 6px; background: <%= is_selected ? 'rgba(99, 102, 241, 0.3)' : '#e0e7ff' %>; color: <%= is_selected ? '#c7d2fe' : '#4338ca' %>; border: 1px solid <%= is_selected ? 'rgba(165, 180, 252, 0.4)' : '#c7d2fe' %>; text-transform: uppercase; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; display: inline-block;">
                    <%= pkg[:badge] %>
                  </span>
                <% else %>
                  <span style="visibility: hidden; font-size: 0.62rem; padding: 2px 0;">&nbsp;</span>
                <% end %>
              </div>

              <%# Icono %>
              <div style="font-size: 2rem; line-height: 1; margin-bottom: 8px;">
                <%= pkg[:icon] %>
              </div>

              <%# Nombre del Plan %>
              <div class="pkg-name" style="font-weight: 800; font-size: 0.92rem; margin-bottom: 4px; color: #0f172a; line-height: 1.25; min-height: 38px; display: flex; align-items: center;">
                <%= pkg[:name] %>
              </div>

              <%# Precio %>
              <div class="pkg-price-text" style="font-size: 1.45rem; font-weight: 900; color: #059669; line-height: 1.1; margin-bottom: 3px;">
                $<%= '%.0f' % pkg[:price] %> <span style="font-size: 0.72rem; font-weight: 700; color: #64748b;">USD/mes</span>
              </div>

              <%# Módulos Base %>
              <div class="pkg-subtext" style="font-size: 0.75rem; color: #64748b; font-weight: 600;">
                <%= pkg[:modules].count %> módulos base
              </div>
            </div>

            <%# Status Indicator %>
            <div class="pkg-selection-status" style="margin-top: 10px; padding-top: 8px; border-top: 1px solid <%= is_selected ? 'rgba(255,255,255,0.15)' : '#e2e8f0' %>; font-size: 0.72rem; font-weight: 800; text-align: center; color: <%= is_selected ? '#38bdf8' : '#64748b' %>;">
              <%= is_selected ? '✓ Seleccionado' : 'Elegir Plan' %>
            </div>

          </div>
        <% end %>
      </div>
    </div>

    <%# 2. SECCIÓN INFERIOR: CHECKLIST DE MÓDULOS (+3 +3) Y FACTURA EN VIVO %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; align-items: start;">
      
      <%# Columna Izquierda: Checklist de Módulos %>
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; padding: 22px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
          <label style="font-size: 0.85rem; font-weight: 800; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px;">
            2. Módulos & Herramientas Activas:
          </label>
          <span id="calc-module-count-badge" style="font-size: 0.75rem; font-weight: 800; padding: 3px 10px; border-radius: 20px; background: #e0e7ff; color: #4338ca;">
            -- módulos
          </span>
        </div>

        <p style="font-size: 0.82rem; color: #64748b; margin: 0 0 16px 0; line-height: 1.45;">
          Los módulos de tu plan base tienen costo <strong>$0</strong>. Al marcar un módulo adicional fuera de tu plan, se suma automáticamente <strong>+$3.00 USD/mes</strong> a tu cuota.
        </p>

        <form id="calc-modules-form" action="<%= update_company_modules_path %>" method="POST">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="_method" value="patch">

          <div style="display: flex; flex-direction: column; gap: 10px;" id="calc-modules-list">
            <% AppModule.all.each do |mod| %>
              <% is_checked = (@simulated_modules.presence || @company.enabled_module_keys).include?(mod[:key]) %>
              <div class="calc-module-row" id="calc-row-<%= mod[:key] %>" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                <label style="display: flex; align-items: center; gap: 12px; cursor: pointer; flex: 1; user-select: none;">
                  <input type="hidden" name="modules[<%= mod[:key] %>]" value="0">
                  <input type="checkbox" name="modules[<%= mod[:key] %>]" value="1" class="calc-module-checkbox" data-mod-key="<%= mod[:key] %>" <%= 'checked' if is_checked %> style="width: 18px; height: 18px; accent-color: #6366f1; cursor: pointer; flex-shrink: 0;">
                  <span style="font-size: 1.4rem; line-height: 1;"><%= mod[:icon] %></span>
                  <div>
                    <div style="font-size: 0.88rem; font-weight: 800; color: #0f172a; line-height: 1.2;">
                      <%= mod[:name] %>
                    </div>
                    <div style="font-size: 0.74rem; color: #64748b; margin-top: 2px;">
                      <%= mod[:category] %> • <%= mod[:description].truncate(50) %>
                    </div>
                  </div>
                </label>

                <%# Badge Dinámico de Estado / Precio Extra %>
                <div class="calc-module-status-badge" data-mod-key="<%= mod[:key] %>" style="flex-shrink: 0; text-align: right;">
                  <!-- Insertado dinámicamente por JS -->
                </div>
              </div>
            <% end %>
          </div>

          <div style="margin-top: 18px; display: flex; justify-content: flex-end;">
            <button type="submit" style="padding: 10px 18px; border-radius: 10px; background: #0f172a; color: white; border: none; font-size: 0.82rem; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(15,23,42,0.15);">
              <span>💾</span> Guardar Módulos en mi Empresa
            </button>
          </div>
        </form>
      </div>

      <%# Columna Derecha: Factura Proforma / Desglose en Dólares %>
      <div class="calc-glow-card" style="border-radius: 24px; padding: 26px; display: flex; flex-direction: column; justify-content: space-between; position: sticky; top: 20px;">
        
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 12px;">
            <span style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #a5b4fc;">
              🧾 Desglose de Mensualidad
            </span>
            <span id="calc-summary-plan-badge" style="font-size: 0.74rem; font-weight: 800; padding: 3px 10px; border-radius: 20px; background: rgba(99, 102, 241, 0.3); color: #c7d2fe; border: 1px solid rgba(165, 180, 252, 0.4);">
              Plan Activo
            </span>
          </div>

          <%# Línea 1: Plan Base %>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font-size: 0.92rem;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span id="calc-summary-pkg-icon" style="font-size: 1.2rem;">🎸</span>
              <span id="calc-summary-pkg-name" style="font-weight: 700; color: white;">Paquete Bandas</span>
            </div>
            <span id="calc-summary-base-price" style="font-weight: 800; color: #38bdf8; font-size: 1.05rem;">$15.00 USD</span>
          </div>

          <%# Lista de Módulos Incluidos %>
          <div style="margin-bottom: 16px; padding: 10px 14px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
            <div style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: #94a3b8; margin-bottom: 6px;">
              ✓ Módulos Incluidos en este Plan ($0 extra):
            </div>
            <div id="calc-summary-included-list" style="display: flex; flex-wrap: wrap; gap: 5px;">
              <!-- Insertado por JS -->
            </div>
          </div>

          <%# Línea 2: Módulos Adicionales (+3 c/u) %>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 0.92rem;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 1.1rem;">➕</span>
              <span style="font-weight: 700; color: #fde047;">Módulos Extra (<span id="calc-summary-extra-count">0</span>):</span>
            </div>
            <span id="calc-summary-extra-cost" style="font-weight: 800; color: #fde047; font-size: 1.05rem;">+$0.00 USD</span>
          </div>

          <%# Lista de Módulos Extra %>
          <div id="calc-summary-extra-container" style="margin-bottom: 16px; padding: 10px 14px; border-radius: 12px; background: rgba(253, 224, 71, 0.08); border: 1px solid rgba(253, 224, 71, 0.25);">
            <div style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: #fef08a; margin-bottom: 6px;">
              Módulos fuera de tu paquete (+$3.00 USD/mes c/u):
            </div>
            <div id="calc-summary-extra-list" style="display: flex; flex-wrap: wrap; gap: 5px;">
              <!-- Insertado por JS -->
            </div>
          </div>

          <%# Recomendación Inteligente Full Suite (si aplica) %>
          <div id="calc-full-suite-tip" style="display: none; margin-bottom: 18px; padding: 12px 14px; border-radius: 14px; background: linear-gradient(135deg, rgba(234, 179, 8, 0.2) 0%, rgba(245, 158, 11, 0.2) 100%); border: 1px solid rgba(251, 191, 36, 0.4); color: #fef08a;">
            <div style="font-weight: 800; font-size: 0.84rem; display: flex; align-items: center; gap: 6px; margin-bottom: 3px;">
              <span>👑</span> ¡Ahorro Inteligente GigManager!
            </div>
            <div style="font-size: 0.76rem; line-height: 1.35; color: #fef9c3;">
              Al sumar tantos módulos, te recomendamos activar el <strong>Paquete Full Suite Total por solo $22.00 USD/mes</strong> para tener los 7 módulos completos sin límite.
            </div>
          </div>

          <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.15); margin: 16px 0;" />

          <%# TOTAL A PAGAR EN DÓLARES %>
          <div style="margin-bottom: 20px;">
            <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #cbd5e1; margin-bottom: 4px;">
              Total Mensual a Pagar:
            </div>
            <div style="display: flex; align-items: baseline; gap: 8px;">
              <span id="calc-total-amount" style="font-size: 2.6rem; font-weight: 900; color: white; letter-spacing: -1px;">
                $15.00
              </span>
              <span style="font-size: 1rem; font-weight: 800; color: #38bdf8;">
                USD / mes
              </span>
            </div>
            <div style="font-size: 0.76rem; color: #94a3b8; margin-top: 4px;">
              Paga en USD vía Zelle, Binance Pay USDT o en Bolívares (Tasa Oficial BCV) por Pago Móvil.
            </div>
          </div>
        </div>

        <%# Botón de Acción Principal %>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <button type="button" id="calc-report-btn" onclick="applyCalculationToPaymentReport()" style="width: 100%; padding: 14px; border-radius: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; font-weight: 800; font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);">
            <span>⚡ Reportar Pago por <span id="calc-btn-amount">$15.00</span> USD</span>
          </button>

          <a href="<%= company_modules_path %>" style="text-align: center; font-size: 0.78rem; color: #a5b4fc; text-decoration: none; font-weight: 700;">
            ⚙️ Personalizar menú lateral en detalle →
          </a>
        </div>

      </div>

    </div>

  </div>

</div>

<%# JavaScript Reactivo del Simulador de Precios %>
<script>
  (function() {
    const PACKAGES_DATA = <%= raw AppModule::PACKAGES.to_json %>;
    const MODULES_DATA = <%= raw AppModule::MODULES.to_json %>;
    const EXTRA_PRICE = <%= AppModule::EXTRA_MODULE_PRICE %>;

    let selectedPackageKey = "<%= @simulated_plan.presence || @company.plan_tier.presence || 'banda' %>";

    function getSelectedModuleKeys() {
      const checkboxes = document.querySelectorAll('.calc-module-checkbox:checked');
      return Array.from(checkboxes).map(cb => cb.dataset.modKey);
    }

    function calculate() {
      const pkg = PACKAGES_DATA[selectedPackageKey] || PACKAGES_DATA['banda'];
      const pkgModules = pkg.modules || [];
      const basePrice = parseFloat(pkg.price) || 15.00;
      const selectedKeys = getSelectedModuleKeys();

      const includedKeys = selectedKeys.filter(k => pkgModules.includes(k));
      const extraKeys = selectedKeys.filter(k => !pkgModules.includes(k));
      const extraCost = extraKeys.length * EXTRA_PRICE;
      const subtotal = basePrice + extraCost;

      const fullSuitePrice = 22.00;
      const suggestsFullSuite = (subtotal >= fullSuitePrice) && (selectedPackageKey !== 'full');
      const finalTotal = suggestsFullSuite ? fullSuitePrice : subtotal;

      // Actualizar Filas y Badges de Módulos
      document.querySelectorAll('.calc-module-checkbox').forEach(cb => {
        const modKey = cb.dataset.modKey;
        const rowEl = document.getElementById(`calc-row-${modKey}`);
        const badgeContainer = document.querySelector(`.calc-module-status-badge[data-mod-key="${modKey}"]`);
        if (!badgeContainer) return;

        const isPartOfPackage = pkgModules.includes(modKey);
        const isChecked = cb.checked;

        if (rowEl) {
          rowEl.classList.remove('is-included', 'is-extra-active');
        }

        if (isPartOfPackage) {
          if (rowEl && isChecked) rowEl.classList.add('is-included');
          badgeContainer.innerHTML = `<span style="font-size: 0.72rem; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; display: inline-block;">
            ✓ Incluido ($0)
          </span>`;
        } else {
          if (isChecked) {
            if (rowEl) rowEl.classList.add('is-extra-active');
            badgeContainer.innerHTML = `<span style="font-size: 0.72rem; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; display: inline-block;">
              + $${EXTRA_PRICE.toFixed(2)} USD/mes
            </span>`;
          } else {
            badgeContainer.innerHTML = `<span style="font-size: 0.72rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; display: inline-block;">
              + $${EXTRA_PRICE.toFixed(2)} USD (Añadir)
            </span>`;
          }
        }
      });

      // Actualizar Resumen en Factura Proforma
      const summaryPkgIcon = document.getElementById('calc-summary-pkg-icon');
      const summaryPkgName = document.getElementById('calc-summary-pkg-name');
      const summaryBasePrice = document.getElementById('calc-summary-base-price');
      const summaryPlanBadge = document.getElementById('calc-summary-plan-badge');

      if (summaryPkgIcon) summaryPkgIcon.textContent = pkg.icon || '🎸';
      if (summaryPkgName) summaryPkgName.textContent = pkg.name || 'Paquete';
      if (summaryBasePrice) summaryBasePrice.textContent = `$${basePrice.toFixed(2)} USD`;
      if (summaryPlanBadge) summaryPlanBadge.textContent = pkg.name;

      // Lista de Módulos Incluidos
      const includedListEl = document.getElementById('calc-summary-included-list');
      if (includedListEl) {
        includedListEl.innerHTML = includedKeys.map(k => {
          const m = MODULES_DATA[k];
          return m ? `<span style="font-size: 0.74rem; background: rgba(255,255,255,0.08); padding: 2px 7px; border-radius: 6px; color: #e2e8f0; font-weight: 600;">${m.icon} ${m.name.split('(')[0].trim()}</span>` : '';
        }).join('') || '<span style="font-size: 0.72rem; color: #94a3b8;">Ninguno seleccionado</span>';
      }

      // Módulos Extra
      const extraCountEl = document.getElementById('calc-summary-extra-count');
      const extraCostEl = document.getElementById('calc-summary-extra-cost');
      const extraContainer = document.getElementById('calc-summary-extra-container');
      const extraListEl = document.getElementById('calc-summary-extra-list');

      if (extraCountEl) extraCountEl.textContent = extraKeys.length;
      if (extraCostEl) extraCostEl.textContent = `+$${extraCost.toFixed(2)} USD`;

      if (extraContainer) {
        extraContainer.style.display = extraKeys.length > 0 ? 'block' : 'none';
      }

      if (extraListEl) {
        extraListEl.innerHTML = extraKeys.map(k => {
          const m = MODULES_DATA[k];
          return m ? `<span style="font-size: 0.74rem; background: rgba(253, 224, 71, 0.2); border: 1px solid rgba(253, 224, 71, 0.4); padding: 2px 7px; border-radius: 6px; color: #fef08a; font-weight: 700;">+ ${m.icon} ${m.name.split('(')[0].trim()} (+$3)</span>` : '';
        }).join('');
      }

      // Tip Full Suite
      const tipEl = document.getElementById('calc-full-suite-tip');
      if (tipEl) {
        tipEl.style.display = suggestsFullSuite ? 'block' : 'none';
      }

      // Total Final
      const totalAmountEl = document.getElementById('calc-total-amount');
      const btnAmountEl = document.getElementById('calc-btn-amount');
      if (totalAmountEl) totalAmountEl.textContent = `$${finalTotal.toFixed(2)}`;
      if (btnAmountEl) btnAmountEl.textContent = `$${finalTotal.toFixed(2)}`;

      const moduleCountBadge = document.getElementById('calc-module-count-badge');
      if (moduleCountBadge) {
        moduleCountBadge.textContent = `${selectedKeys.length} de ${Object.keys(MODULES_DATA).length} Módulos Activos`;
      }

      // Sincronizar input de monto del formulario de reporte de pago si existe
      const paymentAmountInput = document.getElementById('subscription_amount_input');
      if (paymentAmountInput) {
        paymentAmountInput.value = finalTotal.toFixed(2);
      }
    }

    function selectPackage(pkgKey) {
      selectedPackageKey = pkgKey;
      const pkg = PACKAGES_DATA[pkgKey];
      if (!pkg) return;

      // Actualizar estado de las 5 cards superiores
      document.querySelectorAll('.pkg-pill-btn').forEach(btn => {
        const isThis = (btn.dataset.pkgKey === pkgKey);
        const statusEl = btn.querySelector('.pkg-selection-status');
        const badgeEl = btn.querySelector('.pkg-badge-pill');
        if (isThis) {
          btn.classList.add('is-active');
          if (statusEl) statusEl.textContent = '✓ Seleccionado';
          if (badgeEl) {
            badgeEl.style.background = 'rgba(99, 102, 241, 0.3)';
            badgeEl.style.color = '#c7d2fe';
            badgeEl.style.borderColor = 'rgba(165, 180, 252, 0.4)';
          }
        } else {
          btn.classList.remove('is-active');
          if (statusEl) statusEl.textContent = 'Elegir Plan';
          if (badgeEl) {
            badgeEl.style.background = '#e0e7ff';
            badgeEl.style.color = '#4338ca';
            badgeEl.style.borderColor = '#c7d2fe';
          }
        }
      });

      // Al cambiar de paquete, preseleccionar automáticamente los módulos del paquete
      const pkgModules = pkg.modules || [];
      document.querySelectorAll('.calc-module-checkbox').forEach(cb => {
        cb.checked = pkgModules.includes(cb.dataset.modKey);
      });

      calculate();
    }

    // Exponer función global para aplicar al formulario de reporte de pago
    window.applyCalculationToPaymentReport = function() {
      const select = document.getElementById('subscription_plan_tier_select');
      if (select) {
        select.value = selectedPackageKey;
      }

      const paymentAmountInput = document.getElementById('subscription_amount_input');
      const totalAmountEl = document.getElementById('calc-total-amount');
      if (paymentAmountInput && totalAmountEl) {
        const rawAmount = totalAmountEl.textContent.replace('$', '').trim();
        paymentAmountInput.value = parseFloat(rawAmount).toFixed(2);
      }
      
      const target = document.getElementById('reportar-pago');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    };

    document.addEventListener('DOMContentLoaded', function() {
      // Event listeners para pestañas de paquetes
      document.querySelectorAll('.pkg-pill-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          selectPackage(this.dataset.pkgKey);
        });
      });

      // Event listeners para checkboxes de módulos
      document.querySelectorAll('.calc-module-checkbox').forEach(cb => {
        cb.addEventListener('change', calculate);
      });

      // Inicializar cálculo con el plan de la empresa
      selectPackage(selectedPackageKey);
    });
  })();
</script>
