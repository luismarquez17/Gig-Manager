<%# 
  Partial: _pricing_calculator.html.erb
  Calculador y Simulador Unificado de Planes Base, Planes Personalizados y Pago de Diferencia (+ $3 USD)
%>

<style>
  .calc-container {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .pkg-pill-btn {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: 2px solid #cbd5e1;
    position: relative;
    user-select: none;
    background: #f8fafc;
    color: #1e293b;
    border-radius: 14px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .pkg-pill-btn:hover {
    transform: translateY(-2px);
    border-color: #94a3b8;
    box-shadow: 0 8px 20px -4px rgba(0,0,0,0.08);
  }
  .pkg-pill-btn.is-active {
    border: 2.5px solid #38bdf8 !important;
    background: linear-gradient(135deg, #090d16 0%, #1e1b4b 100%) !important;
    color: white !important;
    box-shadow: 0 0 0 1px #38bdf8, 0 12px 25px -4px rgba(56, 189, 248, 0.4) !important;
    transform: translateY(-2px);
  }
  .pkg-pill-btn.is-active .pkg-name {
    color: white !important;
  }
  .pkg-pill-btn.is-active .pkg-subtext {
    color: #cbd5e1 !important;
  }
  .pkg-pill-btn.is-active .pkg-price-text {
    color: #38bdf8 !important;
  }
  .pkg-pill-btn.is-active .pkg-selection-status {
    color: #38bdf8 !important;
    border-top-color: rgba(255,255,255,0.2) !important;
  }
  .pkg-pill-btn.is-active .pkg-badge-pill {
    background: rgba(99, 102, 241, 0.3) !important;
    color: #c7d2fe !important;
    border-color: rgba(165, 180, 252, 0.5) !important;
  }
  .pkg-pill-btn:not(.is-active) {
    background: #f8fafc !important;
    color: #1e293b !important;
    border-color: #cbd5e1 !important;
    box-shadow: none !important;
  }
  .pkg-pill-btn:not(.is-active) .pkg-name {
    color: #0f172a !important;
  }
  .pkg-pill-btn:not(.is-active) .pkg-subtext {
    color: #64748b !important;
  }
  .pkg-pill-btn:not(.is-active) .pkg-price-text {
    color: #059669 !important;
  }
  .pkg-pill-btn:not(.is-active) .pkg-selection-status {
    color: #64748b !important;
    border-top-color: #e2e8f0 !important;
  }
  .pkg-pill-btn:not(.is-active) .pkg-badge-pill {
    background: #e0e7ff !important;
    color: #4338ca !important;
    border-color: #c7d2fe !important;
  }
  .calc-module-row {
    transition: all 0.15s ease;
  }
  .calc-module-row:hover {
    border-color: #94a3b8 !important;
  }
  .calc-module-row.is-included {
    background: #f0fdf4 !important;
    border-color: #86efac !important;
  }
  .calc-module-row.is-extra-active {
    background: #fefce8 !important;
    border-color: #fde047 !important;
    box-shadow: 0 3px 10px rgba(234, 179, 8, 0.08) !important;
  }
  .calc-glow-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    border: 1.5px solid #6366f1;
    color: white;
    box-shadow: 0 15px 35px -8px rgba(15, 23, 42, 0.25);
  }
  .calc-toggle-btn {
    transition: all 0.2s ease;
  }
  .calc-toggle-btn:hover {
    background: #e2e8f0 !important;
    border-color: #94a3b8 !important;
    color: #0f172a !important;
  }

  @media (max-width: 1080px) {
    .calc-main-grid {
      grid-template-columns: 1fr !important;
    }
    .pkg-grid-packages {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
  @media (max-width: 640px) {
    .pkg-grid-packages {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }
</style>

<div class="calc-container" id="gigmanager-pricing-calculator" style="margin-bottom: 30px;">
  
  <%# Tarjeta Principal del Calculador %>
  <div style="background: white; border-radius: 20px; border: 1px solid #e2e8f0; padding: 22px; box-shadow: 0 8px 25px rgba(0,0,0,0.03); margin-bottom: 20px;">
    
    <%# Encabezado Compacto %>
    <div style="text-align: center; max-width: 760px; margin: 0 auto 20px auto;">
      <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 50px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); color: #4f46e5; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px;">
        <span>💎</span> Planes Base, Plan Personalizado & Descuentos
      </div>
      <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin: 0 0 6px 0; letter-spacing: -0.5px;">
        Elige un Paquete Preestablecido o Crea tu Plan Personalizado
      </h2>
      <p style="color: #64748b; font-size: 0.9rem; margin: 0; line-height: 1.45;">
        Elige un combo preconfigurado o selecciona el <strong>Plan Personalizado</strong> para escoger tus herramientas a medida con <strong>descuentos progresivos por volumen</strong>.
      </p>
    </div>

    <%# 1. PLANES ARRIBA (6 Cards Responsivas en Grid) %>
    <div style="margin-bottom: 22px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 6px;">
        <label style="font-size: 0.82rem; font-weight: 800; text-transform: uppercase; color: #334155; letter-spacing: 0.5px;">
          1. Selecciona tu Paquete o Plan:
        </label>
        <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">
          💡 Haz clic en cualquier plan para preconfigurar sus módulos
        </span>
      </div>

      <div class="pkg-grid-packages" style="display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px;" id="calc-package-tabs">
        <% AppModule.packages.each do |pkg| %>
          <% is_selected = (@simulated_plan.presence || @company.effective_plan_tier) == pkg[:key] %>
          <div class="pkg-pill-btn <%= 'is-active' if is_selected %>" data-pkg-key="<%= pkg[:key] %>" onclick="window.selectGigPackage('<%= pkg[:key] %>', true)">
            
            <div>
              <%# Badge en fila superior %>
              <div style="min-height: 18px; margin-bottom: 6px; display: flex; align-items: center; justify-content: flex-start;">
                <% if pkg[:badge].present? %>
                  <span class="pkg-badge-pill" style="font-size: 0.58rem; font-weight: 900; padding: 1px 6px; border-radius: 5px; border: 1px solid transparent; text-transform: uppercase; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; display: inline-block;">
                    <%= pkg[:badge] %>
                  </span>
                <% else %>
                  <span style="visibility: hidden; font-size: 0.58rem;">&nbsp;</span>
                <% end %>
              </div>

              <%# Icono + Nombre en bloque compacto %>
              <div style="font-size: 1.6rem; line-height: 1; margin-bottom: 4px;">
                <%= pkg[:icon] %>
              </div>

              <div class="pkg-name" style="font-weight: 800; font-size: 0.85rem; margin-bottom: 3px; line-height: 1.2; min-height: 32px; display: flex; align-items: center;">
                <%= pkg[:name] %>
              </div>

              <%# Precio %>
              <div class="pkg-price-text" style="font-size: 1.3rem; font-weight: 900; line-height: 1.1; margin-bottom: 2px;">
                <% if pkg[:key] == 'personalizado' %>
                  <span id="calc-pill-custom-price-display">$13</span> <span style="font-size: 0.68rem; font-weight: 700; color: #64748b;">USD/mes</span>
                <% else %>
                  $<%= '%.0f' % pkg[:price] %> <span style="font-size: 0.68rem; font-weight: 700; color: #64748b;">USD/mes</span>
                <% end %>
              </div>

              <div class="pkg-subtext" style="font-size: 0.72rem; font-weight: 600;">
                <% if pkg[:key] == 'personalizado' %>
                  Descuentos % volumen
                <% else %>
                  <%= pkg[:modules].count %> módulos base
                <% end %>
              </div>
            </div>

            <%# Status Indicator %>
            <div class="pkg-selection-status" style="margin-top: 8px; padding-top: 6px; border-top-width: 1px; border-top-style: solid; font-size: 0.68rem; font-weight: 800; text-align: center;">
              <%= is_selected ? '✓ Seleccionado' : 'Elegir Plan' %>
            </div>

          </div>
        <% end %>
      </div>
    </div>

    <%# 2. SECCIÓN INFERIOR: CHECKLIST COMPACTA Y FACTURA EN VIVO (SIN ESTIRAMIENTO VERTICAL) %>
    <div class="calc-main-grid" style="display: grid; grid-template-columns: 1.15fr 0.95fr; gap: 18px; align-items: start;">
      
      <%# Columna Izquierda: Checklist Compacta de 7 Módulos %>
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
          <label style="font-size: 0.82rem; font-weight: 800; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px;">
            2. Herramientas & Módulos:
          </label>
          <span id="calc-module-count-badge" style="font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 16px; background: #e0e7ff; color: #4338ca;">
            -- módulos
          </span>
        </div>

        <p id="calc-modules-instruction-text" style="font-size: 0.76rem; color: #64748b; margin: 0 0 10px 0; line-height: 1.35;">
          Marca o desmarca para personalizar tu menú. En <strong>Plan Personalizado</strong> obtienes descuentos por volumen.
        </p>

        <%# Banner de Alerta Dinámica al Destildar Módulos Pagados %>
        <div id="calc-unticked-warning-bar" style="display: none; margin-bottom: 12px; padding: 10px 13px; border-radius: 11px; background: #fffbebfb; border: 1.5px solid #f59e0b; color: #92400e; font-size: 0.78rem; line-height: 1.4; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.08);">
          <div style="font-weight: 800; font-size: 0.82rem; display: flex; align-items: center; gap: 6px; margin-bottom: 2px;">
            <span>⚠️</span> <span>Aviso: Módulo(s) pagado(s) desmarcado(s)</span>
          </div>
          <div id="calc-unticked-warning-text">
            <!-- Rellenado dinámicamente por JS -->
          </div>
        </div>

        <%# Banner Comparativo de Cambio de Plan (Downgrade, Upgrade o Mismo Valor) %>
        <div id="calc-plan-comparison-banner" style="display: none; margin-bottom: 12px; padding: 11px 13px; border-radius: 12px; font-size: 0.8rem; line-height: 1.4; transition: all 0.2s ease;">
          <div id="calc-plan-comparison-content">
            <!-- Rellenado dinámicamente por JS -->
          </div>
        </div>

        <form id="calc-modules-form" action="<%= update_company_modules_path %>" method="POST">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="_method" value="patch">
          <input type="hidden" name="plan_tier" id="calc-hidden-form-plan-tier" value="<%= @simulated_plan.presence || @company.effective_plan_tier %>">

          <div style="display: flex; flex-direction: column; gap: 7px;" id="calc-modules-list">
            <% AppModule.all.each do |mod| %>
              <% is_checked = (@simulated_modules.presence || @company.enabled_module_keys).include?(mod[:key]) %>
              <div class="calc-module-row" id="calc-row-<%= mod[:key] %>" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 11px; overflow: hidden; transition: all 0.2s ease;">
                
                <%# Fila Superior Compacta %>
                <div style="padding: 8px 11px; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                  
                  <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1; min-width: 0; user-select: none;">
                    <input type="hidden" name="modules[<%= mod[:key] %>]" value="0">
                    <input type="checkbox" name="modules[<%= mod[:key] %>]" value="1" class="calc-module-checkbox" data-mod-key="<%= mod[:key] %>" onchange="window.recalculateGigPricing()" <%= 'checked' if is_checked %> style="width: 17px; height: 17px; accent-color: #6366f1; cursor: pointer; flex-shrink: 0;">
                    <span style="font-size: 1.3rem; line-height: 1; flex-shrink: 0;"><%= mod[:icon] %></span>
                    
                    <div style="min-width: 0; flex: 1;">
                      <div style="font-size: 0.85rem; font-weight: 800; color: #0f172a; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <%= mod[:name] %>
                      </div>
                      <div style="font-size: 0.72rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.2;">
                        <span style="font-weight: 700; color: #475569;"><%= mod[:category] %>:</span> <%= mod[:description].truncate(45) %>
                      </div>
                    </div>
                  </label>

                  <div style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                    <%# Badge Dinámico de Estado / Precio Extra %>
                    <div class="calc-module-status-badge" data-mod-key="<%= mod[:key] %>">
                      <!-- Insertado dinámicamente por JS -->
                    </div>

                    <%# Botón Desplegable Chevron %>
                    <button type="button" class="calc-toggle-btn" onclick="window.toggleModuleDetails('<%= mod[:key] %>')" style="background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 7px; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; color: #64748b; font-size: 0.75rem; padding: 0; flex-shrink: 0;" title="Ver funciones incluidas">
                      <span id="calc-chevron-<%= mod[:key] %>" style="display: inline-block; transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);">▼</span>
                    </button>
                  </div>

                </div>

                <%# Panel Desplegable con Funciones & Descripción %>
                <div id="calc-details-<%= mod[:key] %>" style="display: none; padding: 10px 12px 12px 12px; background: #f8fafc; border-top: 1px solid #f1f5f9;">
                  <div style="font-size: 0.78rem; color: #334155; line-height: 1.45; margin-bottom: 8px;">
                    <%= mod[:description] %>
                  </div>

                  <% if mod[:features].present? %>
                    <div style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 5px;">
                      ✨ Herramientas incluidas en este módulo:
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 5px;">
                      <% mod[:features].each do |feat| %>
                        <div style="font-size: 0.72rem; padding: 4px 8px; border-radius: 6px; background: white; border: 1px solid #e2e8f0; color: #1e293b; font-weight: 600; display: flex; align-items: center; gap: 5px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                          <span style="color: #10b981; font-weight: 900; font-size: 0.75rem;">✓</span>
                          <span style="line-height: 1.25;"><%= feat %></span>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>

              </div>
            <% end %>
          </div>

          <div style="margin-top: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <span style="font-size: 0.72rem; color: #64748b;">Módulos sincronizados con tu menú lateral</span>
            <button type="button" id="calc-save-modules-btn" onclick="window.openPlanChangeModal()" style="padding: 9px 18px; border-radius: 10px; background: #0f172a; color: white; border: none; font-size: 0.82rem; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 3px 10px rgba(15,23,42,0.15);">
              <span>✨ Guardar Cambios de Plan</span>
            </button>
          </div>
        </form>
      </div>

      <%# Columna Derecha: Factura Proforma / Desglose en Dólares (Compacto & Elegante) %>
      <div class="calc-glow-card" style="border-radius: 18px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; position: sticky; top: 20px;">
        
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 9px;">
            <span style="font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #a5b4fc;">
              🧾 Desglose de Mensualidad
            </span>
            <span id="calc-summary-plan-badge" style="font-size: 0.7rem; font-weight: 800; padding: 2px 8px; border-radius: 16px; background: rgba(99, 102, 241, 0.3); color: #c7d2fe; border: 1px solid rgba(165, 180, 252, 0.4);">
              Plan Base
            </span>
          </div>

          <%# Título Dinámico del Plan %>
          <div style="margin-bottom: 10px;">
            <div id="calc-summary-plan-title" style="font-weight: 800; font-size: 1.05rem; color: #ffffff; line-height: 1.25;">
              Paquete Bandas & Orquestas
            </div>
            <div id="calc-summary-plan-subtitle" style="font-size: 0.74rem; color: #94a3b8; margin-top: 1px;">
              Configuración estándar del paquete
            </div>
          </div>

          <%# Línea 1: Plan Base / Subtotal %>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 0.86rem; background: rgba(255,255,255,0.05); padding: 7px 10px; border-radius: 9px;">
            <div style="display: flex; align-items: center; gap: 6px;">
              <span id="calc-summary-pkg-icon" style="font-size: 1.1rem;">🎸</span>
              <span id="calc-summary-pkg-name" style="font-weight: 700; color: white;">Paquete Bandas</span>
            </div>
            <span id="calc-summary-base-price" style="font-weight: 800; color: #38bdf8; font-size: 0.98rem;">$15.00 USD</span>
          </div>

          <%# Lista de Módulos Incluidos %>
          <div style="margin-bottom: 10px; padding: 7px 9px; border-radius: 9px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);">
            <div id="calc-summary-included-label" style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; color: #94a3b8; margin-bottom: 4px;">
              ✓ Incluidos en este Plan ($0 extra):
            </div>
            <div id="calc-summary-included-list" style="display: flex; flex-wrap: wrap; gap: 4px;">
              <!-- Insertado por JS -->
            </div>
          </div>

          <%# Línea 2A: Descuento por Volumen (Modo Personalizado) %>
          <div id="calc-summary-discount-line" style="display: none; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 0.86rem; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); padding: 7px 10px; border-radius: 9px;">
            <div style="display: flex; align-items: center; gap: 6px;">
              <span style="font-size: 1rem;">🎉</span>
              <span style="font-weight: 700; color: #6ee7b7;">Descuento por Volumen (<span id="calc-summary-discount-badge">0%</span>):</span>
            </div>
            <span id="calc-summary-discount-amount" style="font-weight: 800; color: #34d399; font-size: 0.98rem;">-$0.00 USD</span>
          </div>

          <%# Línea 2B: Módulos Adicionales (+3 c/u - Modo Combos Base) %>
          <div id="calc-summary-extra-line" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 0.86rem; background: rgba(253, 224, 71, 0.08); border: 1px solid rgba(253, 224, 71, 0.2); padding: 6px 10px; border-radius: 9px;">
            <div style="display: flex; align-items: center; gap: 6px;">
              <span style="font-size: 0.95rem;">➕</span>
              <span style="font-weight: 700; color: #fde047;">Módulos Extra (<span id="calc-summary-extra-count">0</span>):</span>
            </div>
            <span id="calc-summary-extra-cost" style="font-weight: 800; color: #fde047; font-size: 0.98rem;">+$0.00 USD</span>
          </div>

          <%# Lista de Módulos Extra %>
          <div id="calc-summary-extra-container" style="display: none; margin-bottom: 10px; padding: 7px 9px; border-radius: 9px; background: rgba(253, 224, 71, 0.06); border: 1px solid rgba(253, 224, 71, 0.25);">
            <div style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; color: #fef08a; margin-bottom: 4px;">
              Módulos fuera del paquete (+$3.00 USD/mes):
            </div>
            <div id="calc-summary-extra-list" style="display: flex; flex-wrap: wrap; gap: 4px;">
              <!-- Insertado por JS -->
            </div>
          </div>

          <%# Recomendación Inteligente Full Suite %>
          <div id="calc-full-suite-tip" style="display: none; margin-bottom: 12px; padding: 9px 11px; border-radius: 11px; background: linear-gradient(135deg, rgba(234, 179, 8, 0.2) 0%, rgba(245, 158, 11, 0.2) 100%); border: 1px solid rgba(251, 191, 36, 0.4); color: #fef08a;">
            <div style="font-weight: 800; font-size: 0.78rem; display: flex; align-items: center; gap: 5px; margin-bottom: 2px;">
              <span>👑</span> ¡Ahorro Inteligente GigManager!
            </div>
            <div style="font-size: 0.72rem; line-height: 1.3; color: #fef9c3;">
              Al sumar varios módulos, te conviene el <strong>Paquete Full Suite Total por $22.00 USD/mes</strong>.
            </div>
          </div>

          <hr style="border: none; border-top: 1px solid rgba(255,255,255,0.12); margin: 12px 0;" />

          <%# TOTAL A PAGAR EN DÓLARES %>
          <div style="margin-bottom: 14px;">
            <div id="calc-summary-regular-price-container" style="display: none; font-size: 0.74rem; color: #94a3b8; margin-bottom: 2px;">
              Precio regular de lista: <span id="calc-summary-regular-price" style="text-decoration: line-through; color: #f87171; font-weight: 700;">$0.00 USD</span>
            </div>
            <div style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #cbd5e1; margin-bottom: 2px;">
              Total Cuota Mensual:
            </div>
            <div style="display: flex; align-items: baseline; gap: 6px;">
              <span id="calc-total-amount" style="font-size: 2.2rem; font-weight: 900; color: white; letter-spacing: -0.5px;">
                $15.00
              </span>
              <span style="font-size: 0.92rem; font-weight: 800; color: #38bdf8;">
                USD / mes
              </span>
            </div>
          </div>

          <%# Banner Explicativo Inteligente de Pago y Fechas %>
          <div id="calc-difference-banner" style="margin-bottom: 12px; padding: 10px 12px; border-radius: 11px; font-size: 0.74rem; line-height: 1.35;">
            <div id="calc-diff-banner-content">
              <!-- Insertado por JS -->
            </div>
          </div>

        </div>

        <%# Botones de Acción %>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          
          <%# Botón Destacado: Confirmar Cambio de Plan (Visible cuando hay cambios respecto al plan actual) %>
          <button type="button" id="calc-confirm-change-btn" onclick="window.openPlanChangeModal()" style="display: none; width: 100%; padding: 12px; border-radius: 12px; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: white; border: 1.5px solid #a78bfa; font-weight: 800; font-size: 0.92rem; cursor: pointer; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 16px rgba(124, 58, 237, 0.4); margin-bottom: 2px;">
            <span>✨ Confirmar Cambio de Plan</span>
          </button>

          <%# Botón 1: Pagar Mensualidad Completa / Renovar %>
          <button type="button" id="calc-report-full-btn" onclick="window.applyCalculationToPaymentReport('full')" style="width: 100%; padding: 11px; border-radius: 11px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; font-weight: 800; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; box-shadow: 0 3px 12px rgba(16, 185, 129, 0.3);">
            <span>⚡ Reportar Mensualidad (<span id="calc-btn-full-amount">$15.00 USD</span>)</span>
          </button>

          <%# Botón 2: Pagar Solo la Diferencia (Solo visible si la empresa ya pagó su plan base) %>
          <button type="button" id="calc-report-diff-btn" onclick="window.applyCalculationToPaymentReport('diff')" style="display: none; width: 100%; padding: 10px; border-radius: 11px; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white; border: 1px solid rgba(165, 180, 252, 0.4); font-weight: 800; font-size: 0.84rem; cursor: pointer; align-items: center; justify-content: center; gap: 6px; box-shadow: 0 3px 10px rgba(99, 102, 241, 0.25);">
            <span>➕ Pagar Módulo(s) Extra (<span id="calc-btn-diff-amount">+$3.00 USD</span>)</span>
          </button>

          <div style="text-align: center; font-size: 0.72rem; color: #a5b4fc; font-weight: 600; margin-top: 2px;">
            💡 Sube automáticamente al formulario de reporte
          </div>
        </div>

      </div>

    </div>

  </div>

  <%# ========================================== %>
  <%# MODAL INTERACTIVO DE CONFIRMACIÓN DE PLAN   %>
  <%# ========================================== %>
  <div id="calc-confirm-change-modal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(6px); align-items: center; justify-content: center; padding: 16px; overflow-y: auto;">
    <div style="background: white; border-radius: 22px; max-width: 620px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); border: 1px solid #e2e8f0; overflow: hidden; margin: auto;">
      
      <%# Encabezado del Modal %>
      <div style="padding: 20px 24px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; background: #f8fafc;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 1.6rem;">✨</span>
          <div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: #0f172a; margin: 0;">Confirmar Cambio de Plan</h3>
            <p style="color: #64748b; font-size: 0.78rem; margin: 2px 0 0 0;">Revisa los detalles antes de aplicar la modificación en <strong><%= @company.name %></strong></p>
          </div>
        </div>
        <button type="button" onclick="window.closePlanChangeModal()" style="background: #e2e8f0; border: none; width: 30px; height: 30px; border-radius: 50%; font-weight: 800; color: #475569; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.9rem;">
          ✕
        </button>
      </div>

      <%# Cuerpo del Modal %>
      <div style="padding: 22px 24px;">
        
        <%# Tarjetas Comparativas (Plan Actual vs Nuevo Plan) %>
        <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; margin-bottom: 18px;">
          
          <%# Plan Actual %>
          <div style="padding: 14px; border-radius: 14px; background: #f1f5f9; border: 1.5px solid #cbd5e1; text-align: center;">
            <div style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 4px;">Plan Actual</div>
            <div style="font-size: 1.5rem; line-height: 1; margin-bottom: 4px;"><%= @company.effective_plan_tier == 'personalizado' ? '⚙️' : (AppModule.package_info(@company.effective_plan_tier)&.dig(:icon) || '🎸') %></div>
            <div style="font-size: 0.88rem; font-weight: 800; color: #0f172a; line-height: 1.2; margin-bottom: 2px;"><%= @company.plan_tier_name %></div>
            <div style="font-size: 1.05rem; font-weight: 900; color: #334155;">$<%= '%.2f' % @company.calculated_monthly_fee %> <span style="font-size: 0.68rem; font-weight: 600; color: #64748b;">USD/mes</span></div>
          </div>

          <%# Flecha %>
          <div style="font-size: 1.4rem; color: #6366f1; font-weight: 900;">➡️</div>

          <%# Nuevo Plan %>
          <div style="padding: 14px; border-radius: 14px; background: #eff6ff; border: 1.5px solid #93c5fd; text-align: center;">
            <div style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; color: #2563eb; margin-bottom: 4px;">Nuevo Plan</div>
            <div id="modal-new-plan-icon" style="font-size: 1.5rem; line-height: 1; margin-bottom: 4px;">👑</div>
            <div id="modal-new-plan-name" style="font-size: 0.88rem; font-weight: 800; color: #1e3a8a; line-height: 1.2; margin-bottom: 2px;">Paquete Full Suite</div>
            <div style="font-size: 1.05rem; font-weight: 900; color: #1d4ed8;"><span id="modal-new-plan-price">$22.00</span> <span style="font-size: 0.68rem; font-weight: 600; color: #60a5fa;">USD/mes</span></div>
          </div>

        </div>

        <%# Badge de Diferencia %>
        <div id="modal-difference-badge-container" style="margin-bottom: 16px; padding: 10px 14px; border-radius: 12px; text-align: center; font-size: 0.84rem; font-weight: 700;">
          <!-- Insertado dinámicamente por JS -->
        </div>

        <%# Detalle de Módulos (Conservados, Dejados de pagar, Nuevos) %>
        <div style="margin-bottom: 18px; display: flex; flex-direction: column; gap: 10px;">
          
          <%# Módulos Conservados %>
          <div id="modal-kept-modules-box" style="padding: 10px 12px; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: #059669; margin-bottom: 5px;">
              ✓ Módulos que mantendrás activos:
            </div>
            <div id="modal-kept-modules-list" style="display: flex; flex-wrap: wrap; gap: 5px;">
              <!-- Insertado por JS -->
            </div>
          </div>

          <%# Módulos que dejas de pagar (Aviso especial si destildó pagados) %>
          <div id="modal-removed-modules-box" style="display: none; padding: 12px 14px; border-radius: 12px; background: #fffbebfb; border: 1.5px solid #fcd34d;">
            <div style="font-size: 0.74rem; font-weight: 800; text-transform: uppercase; color: #b45309; margin-bottom: 4px; display: flex; align-items: center; gap: 5px;">
              <span>⚠️</span> <span>Módulo(s) que dejarás de pagar a partir del próximo mes:</span>
            </div>
            <div id="modal-removed-modules-list" style="display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 6px;">
              <!-- Insertado por JS -->
            </div>
            <div style="font-size: 0.74rem; color: #92400e; line-height: 1.35;">
              <% if @company.subscription_paid_and_active? %>
                Mantendrás tu acceso total a estos módulos hasta el fin de tu ciclo actual (<strong><%= l(@company.trial_ends_at.to_date, format: :long) rescue @company.trial_ends_at.strftime('%d/%m/%Y') %></strong>). A partir del próximo mes, tu cuota bajará y estos módulos se desactivarán automáticamente.
              <% else %>
                Estos módulos dejarán de estar habilitados en tu menú.
              <% end %>
            </div>
          </div>

          <%# Nuevos Módulos Agregados %>
          <div id="modal-added-modules-box" style="display: none; padding: 10px 12px; border-radius: 10px; background: #eff6ff; border: 1px solid #bfdbfe;">
            <div style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: #1d4ed8; margin-bottom: 5px;">
              ➕ Nuevos módulos que se agregarán a tu menú:
            </div>
            <div id="modal-added-modules-list" style="display: flex; flex-wrap: wrap; gap: 5px;">
              <!-- Insertado por JS -->
            </div>
          </div>

        </div>

        <%# Formulario con Opciones de Tiempo & Confirmación %>
        <%= form_with url: change_plan_subscriptions_path, method: :post, local: true, id: "modal-change-plan-form" do %>
          <%= hidden_field_tag :plan_tier, "", id: "modal-submit-plan-tier" %>
          <%= hidden_field_tag :difference_amount, "0.0", id: "modal-submit-difference-amount" %>
          <div id="modal-hidden-modules-inputs">
            <!-- Inputs dinámicos insertados por JS -->
          </div>

          <%# Opciones de Vigencia (Solo para empresas con suscripción pagada) %>
          <% if @company.subscription_paid_and_active? %>
            <div style="margin-bottom: 18px; padding: 14px; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0;">
              <div style="font-size: 0.74rem; font-weight: 800; text-transform: uppercase; color: #475569; margin-bottom: 8px;">
                📅 ¿Cuándo deseas aplicar este cambio?
              </div>

              <%# Opción 1: A partir del próximo mes (Predeterminada) %>
              <label style="display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; cursor: pointer; font-size: 0.82rem; color: #1e293b;">
                <input type="radio" name="timing" value="next_cycle" checked id="modal-timing-next" onchange="window.toggleModalTimingOption()" style="margin-top: 3px; accent-color: #6366f1;">
                <div>
                  <strong>A partir del próximo mes (<%= l(@company.trial_ends_at.to_date, format: :long) rescue @company.trial_ends_at.strftime('%d/%m/%Y') %>)</strong>
                  <div style="font-size: 0.75rem; color: #64748b; margin-top: 1px;">
                    ¡Sin ningún cobro hoy! Sigues disfrutando de tu plan actual y el cambio entrará en vigencia en tu próxima renovación.
                  </div>
                </div>
              </label>

              <%# Opción 2: Inmediato (Solo se muestra en upgrade de plan) %>
              <label id="modal-timing-immediate-option" style="display: none; align-items: flex-start; gap: 10px; cursor: pointer; font-size: 0.82rem; color: #1e293b;">
                <input type="radio" name="timing" value="immediate" id="modal-timing-immediate" onchange="window.toggleModalTimingOption()" style="margin-top: 3px; accent-color: #6366f1;">
                <div>
                  <input type="hidden" name="pay_difference" id="modal-hidden-pay-difference" value="0">
                  <strong>Activar de inmediato pagando diferencia (<span id="modal-immediate-diff-text">+$3.00 USD</span>)</strong>
                  <div style="font-size: 0.75rem; color: #64748b; margin-top: 1px;">
                    Te llevará a reportar solo el valor extra por los módulos adicionales para activarlos hoy mismo.
                  </div>
                </div>
              </label>
            </div>
          <% else %>
            <input type="hidden" name="timing" value="immediate">
            <div style="margin-bottom: 16px; padding: 12px 14px; border-radius: 11px; background: #f0fdf4; border: 1px solid #bbf7d0; font-size: 0.8rem; color: #166534; line-height: 1.4;">
              ✓ Al confirmar, tu plan y menú lateral se actualizarán al instante y tu próxima cuota mensual a reportar se ajustará a este monto.
            </div>
          <% end %>

          <%# Botones de Acción en el Modal %>
          <div style="display: flex; gap: 10px; justify-content: flex-end; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 16px;">
            <button type="button" onclick="window.closePlanChangeModal()" style="padding: 10px 18px; border-radius: 10px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-weight: 700; font-size: 0.84rem; cursor: pointer;">
              Volver y Seguir Editando
            </button>
            <button type="submit" id="modal-submit-confirm-btn" style="padding: 11px 22px; border-radius: 10px; background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%); color: white; border: none; font-weight: 800; font-size: 0.88rem; cursor: pointer; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35); display: inline-flex; align-items: center; gap: 6px;">
              <span>✅ Confirmar Cambio de Plan</span>
            </button>
          </div>

        <% end %>

      </div>

    </div>
  </div>

</div>

<script>
  (function() {
    const PACKAGES_DATA = <%= raw AppModule::PACKAGES.to_json %>;
    const MODULES_DATA = <%= raw AppModule::MODULES.to_json %>;
    const CUSTOM_TIERS_DATA = <%= raw AppModule::CUSTOM_TIERS.to_json %>;
    const EXTRA_PRICE = <%= AppModule::EXTRA_MODULE_PRICE %>;
    
    const IS_SUBSCRIPTION_PAID = <%= @company.subscription_paid_and_active? ? 'true' : 'false' %>;
    const EXPIRATION_DATE_STR = "<%= @company.trial_ends_at.present? ? (I18n.l(@company.trial_ends_at.to_date, format: :long) rescue @company.trial_ends_at.strftime('%d/%m/%Y')) : '' %>";
    const DAYS_LEFT = <%= @company.subscription_paid_and_active? ? @company.days_left_in_subscription : @company.days_left_in_trial %>;

    const CURRENT_ACTIVE_PLAN_KEY = "<%= @company.effective_plan_tier %>";
    const CURRENT_ACTIVE_MODULES = <%= raw @company.enabled_module_keys.to_json %>;
    const CURRENT_PAID_FEE = <%= @company.calculated_monthly_fee.to_f %>;
    const CURRENT_PLAN_NAME = "<%= @company.plan_tier_name %>";
    const HAS_SCHEDULED_CHANGE = <%= @company.has_scheduled_plan_change? ? 'true' : 'false' %>;
    const SCHEDULED_PLAN_KEY = "<%= @company.scheduled_plan_tier.to_s %>";
    const SCHEDULED_PLAN_NAME = "<%= @company.scheduled_plan_name.to_s %>";
    const SCHEDULED_MONTHLY_FEE = <%= @company.scheduled_monthly_fee.to_f %>;
    const SCHEDULED_DATE_STR = "<%= @company.scheduled_change_at.present? ? (I18n.l(@company.scheduled_change_at.to_date, format: :long) rescue @company.scheduled_change_at.strftime('%d/%m/%Y')) : '' %>";

    let selectedPackageKey = "<%= @simulated_plan.presence || (@company.has_scheduled_plan_change? ? @company.scheduled_plan_tier : @company.effective_plan_tier.presence) || 'banda' %>";

    function getSelectedModuleKeys() {
      const checkboxes = document.querySelectorAll('.calc-module-checkbox:checked');
      return Array.from(checkboxes).map(cb => cb.dataset.modKey);
    }

    window.recalculateGigPricing = function() {
      const isCustomMode = (selectedPackageKey === 'personalizado');
      const pkg = PACKAGES_DATA[selectedPackageKey] || PACKAGES_DATA['banda'];
      const selectedKeys = getSelectedModuleKeys();
      const count = selectedKeys.length;

      let basePrice = 0.0;
      let regularPrice = 0.0;
      let savings = 0.0;
      let discountLabel = '';
      let finalTotal = 0.0;
      let includedKeys = [];
      let extraKeys = [];
      let extraCost = 0.0;
      let suggestsFullSuite = false;

      if (isCustomMode) {
        const tier = CUSTOM_TIERS_DATA[count] || CUSTOM_TIERS_DATA[7];
        finalTotal = tier.price;
        regularPrice = tier.regular;
        savings = tier.savings;
        discountLabel = tier.discount_label;
        basePrice = finalTotal;
        includedKeys = selectedKeys;
        extraKeys = [];
        extraCost = 0.0;
        suggestsFullSuite = (count === 7);

        const pillCustomPrice = document.getElementById('calc-pill-custom-price-display');
        if (pillCustomPrice) {
          pillCustomPrice.textContent = `$${finalTotal.toFixed(0)}`;
        }
      } else {
        const pkgModules = pkg.modules || [];
        basePrice = parseFloat(pkg.price) || 15.00;
        includedKeys = selectedKeys.filter(k => pkgModules.includes(k));
        extraKeys = selectedKeys.filter(k => !pkgModules.includes(k));
        extraCost = extraKeys.length * EXTRA_PRICE;
        const subtotal = basePrice + extraCost;
        const fullSuitePrice = 22.00;
        suggestsFullSuite = (subtotal >= fullSuitePrice) && (selectedPackageKey !== 'full');
        finalTotal = suggestsFullSuite ? fullSuitePrice : subtotal;
        regularPrice = subtotal;
        savings = suggestsFullSuite ? (subtotal - fullSuitePrice) : 0.0;
        discountLabel = suggestsFullSuite ? "Full Suite Ahorro" : "";
      }

      // 1. Alerta en tiempo real al destildar una opción que están pagando
      const untickedPaidKeys = CURRENT_ACTIVE_MODULES.filter(k => !selectedKeys.includes(k));
      const hasUntickedPaid = IS_SUBSCRIPTION_PAID && (untickedPaidKeys.length > 0);

      const untickedBar = document.getElementById('calc-unticked-warning-bar');
      const untickedText = document.getElementById('calc-unticked-warning-text');
      if (untickedBar && untickedText) {
        if (hasUntickedPaid) {
          const names = untickedPaidKeys.map(k => MODULES_DATA[k] ? MODULES_DATA[k].name : k);
          untickedText.innerHTML = `Has desmarcado <strong>${names.join(', ')}</strong>, incluido(s) en tu plan pagado actual. Mantendrás tu acceso total garantizado hasta el <strong>${EXPIRATION_DATE_STR}</strong>. Al confirmar el cambio, este módulo se cancelará a partir del próximo mes y tu cuota se reducirá.`;
          untickedBar.style.display = 'block';
        } else {
          untickedBar.style.display = 'none';
        }
      }

      // 2. Actualizar Filas y Badges de Módulos en la lista izquierda
      document.querySelectorAll('.calc-module-checkbox').forEach(cb => {
        const modKey = cb.dataset.modKey;
        const rowEl = document.getElementById(`calc-row-${modKey}`);
        const badgeContainer = document.querySelector(`.calc-module-status-badge[data-mod-key="${modKey}"]`);
        if (!badgeContainer) return;

        const isChecked = cb.checked;
        const isPaidInCurrentPlan = IS_SUBSCRIPTION_PAID && CURRENT_ACTIVE_MODULES.includes(modKey);

        if (rowEl) {
          rowEl.classList.remove('is-included', 'is-extra-active');
          rowEl.style.borderColor = '#e2e8f0';
          rowEl.style.backgroundColor = 'white';
        }

        if (isPaidInCurrentPlan && !isChecked) {
          // AVISO VISUAL AL DESTILDAR OPCIÓN QUE SE ESTÁ PAGANDO
          if (rowEl) {
            rowEl.style.borderColor = '#f59e0b';
            rowEl.style.backgroundColor = '#fffbeb';
          }
          badgeContainer.innerHTML = `<span style="font-size: 0.68rem; font-weight: 800; padding: 2px 7px; border-radius: 5px; background: #fef3c7; color: #b45309; border: 1px solid #fde68a; display: inline-flex; align-items: center; gap: 3px;">
            ⚠️ Se cancela próx. mes
          </span>`;
        } else if (isCustomMode) {
          if (isChecked) {
            if (rowEl) rowEl.classList.add('is-included');
            badgeContainer.innerHTML = `<span style="font-size: 0.68rem; font-weight: 800; padding: 2px 7px; border-radius: 5px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; display: inline-block;">
              ✓ En tu Plan
            </span>`;
          } else {
            badgeContainer.innerHTML = `<span style="font-size: 0.68rem; font-weight: 700; padding: 2px 7px; border-radius: 5px; background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; display: inline-block;">
              + Añadir
            </span>`;
          }
        } else {
          const isPartOfPackage = (pkg.modules || []).includes(modKey);
          if (isPartOfPackage) {
            if (rowEl && isChecked) rowEl.classList.add('is-included');
            badgeContainer.innerHTML = `<span style="font-size: 0.68rem; font-weight: 800; padding: 2px 7px; border-radius: 5px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; display: inline-block;">
              ✓ $0
            </span>`;
          } else {
            if (isChecked) {
              if (rowEl) rowEl.classList.add('is-extra-active');
              badgeContainer.innerHTML = `<span style="font-size: 0.68rem; font-weight: 800; padding: 2px 7px; border-radius: 5px; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; display: inline-block;">
                + $${EXTRA_PRICE.toFixed(2)} Extra
              </span>`;
            } else {
              badgeContainer.innerHTML = `<span style="font-size: 0.68rem; font-weight: 700; padding: 2px 7px; border-radius: 5px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; display: inline-block;">
                + $${EXTRA_PRICE.toFixed(2)}
              </span>`;
            }
          }
        }
      });

      // 3. Comparativa Inteligente de Planes (Downgrade / Upgrade / Igual)
      const isDifferentTier = (selectedPackageKey !== CURRENT_ACTIVE_PLAN_KEY);
      const isDifferentModules = (selectedKeys.slice().sort().join(',') !== CURRENT_ACTIVE_MODULES.slice().sort().join(','));
      const isPlanChanged = isDifferentTier || isDifferentModules;

      const diffFromCurrent = finalTotal - CURRENT_PAID_FEE;
      const compBanner = document.getElementById('calc-plan-comparison-banner');
      const compContent = document.getElementById('calc-plan-comparison-content');
      const confirmChangeBtn = document.getElementById('calc-confirm-change-btn');
      const saveModulesBtn = document.getElementById('calc-save-modules-btn');

      if (isPlanChanged) {
        if (confirmChangeBtn) confirmChangeBtn.style.display = 'flex';
        if (saveModulesBtn) {
          saveModulesBtn.style.background = 'linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)';
          saveModulesBtn.innerHTML = '<span>✨ Guardar Cambios de Plan</span>';
        }

        if (compBanner && compContent) {
          compBanner.style.display = 'block';
          if (diffFromCurrent < -0.01) {
            // Plan más barato (Downgrade)
            const ahorro = Math.abs(diffFromCurrent);
            compBanner.style.background = '#ecfdf5';
            compBanner.style.border = '1.5px solid #6ee7b7';
            compBanner.style.color = '#065f46';
            compContent.innerHTML = `
              <div style="font-weight: 800; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                <span>🔻 Plan Más Económico Seleccionado</span>
                <span style="background: #10b981; color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.72rem; font-weight: 800;">Ahorro: -$${ahorro.toFixed(2)} USD/mes</span>
              </div>
              <div style="margin-top: 3px; font-size: 0.76rem; color: #047857; line-height: 1.35;">
                Tu cuota pasará de <strong>$${CURRENT_PAID_FEE.toFixed(2)}</strong> a <strong>$${finalTotal.toFixed(2)} USD/mes</strong>. ${IS_SUBSCRIPTION_PAID ? 'Al confirmar, el cambio se aplicará a partir de tu próximo mes (el ' + EXPIRATION_DATE_STR + ') sin perder acceso a lo que ya pagaste.' : 'Al confirmar, se actualizará tu cuota a pagar.'}
              </div>
            `;
          } else if (diffFromCurrent > 0.01) {
            // Plan más costoso (Upgrade)
            compBanner.style.background = '#eff6ff';
            compBanner.style.border = '1.5px solid #93c5fd';
            compBanner.style.color = '#1e3a8a';
            compContent.innerHTML = `
              <div style="font-weight: 800; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                <span>🔺 Mejora de Plan Seleccionada</span>
                <span style="background: #2563eb; color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.72rem; font-weight: 800;">+ $${diffFromCurrent.toFixed(2)} USD/mes</span>
              </div>
              <div style="margin-top: 3px; font-size: 0.76rem; color: #1d4ed8; line-height: 1.35;">
                Tu cuota pasará de <strong>$${CURRENT_PAID_FEE.toFixed(2)}</strong> a <strong>$${finalTotal.toFixed(2)} USD/mes</strong>. ${IS_SUBSCRIPTION_PAID ? 'Puedes programarlo para el próximo mes o pagar la diferencia ahora para activarlo hoy.' : 'Al confirmar, se actualizará tu cuota a pagar.'}
              </div>
            `;
          } else {
            // Mismo precio / Lateral
            compBanner.style.background = '#f5f3ff';
            compBanner.style.border = '1.5px solid #c4b5fd';
            compBanner.style.color = '#5b21b6';
            compContent.innerHTML = `
              <div style="font-weight: 800; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                <span>🔄 Cambio de Plan de Mismo Valor</span>
                <span style="background: #7c3aed; color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.72rem; font-weight: 800;">Misma Tarifa: $${finalTotal.toFixed(2)} USD/mes</span>
              </div>
              <div style="margin-top: 3px; font-size: 0.76rem; color: #6d28d9; line-height: 1.35;">
                ${IS_SUBSCRIPTION_PAID ? 'Al confirmar, tus nuevos módulos se activarán a partir de tu próximo mes (el ' + EXPIRATION_DATE_STR + ').' : 'Al confirmar, se actualizarán tus herramientas.'}
              </div>
            `;
          }
        }
      } else {
        if (confirmChangeBtn) confirmChangeBtn.style.display = 'none';
        if (compBanner) compBanner.style.display = 'none';
        if (saveModulesBtn) {
          saveModulesBtn.style.background = '#0f172a';
          saveModulesBtn.innerHTML = '<span>✨ Guardar Cambios de Plan</span>';
        }
      }

      // Sincronizar input oculto de plan en el formulario
      const hiddenPlanTierInput = document.getElementById('calc-hidden-form-plan-tier');
      if (hiddenPlanTierInput) hiddenPlanTierInput.value = selectedPackageKey;

      // 4. Actualizar Encabezado y Títulos del Plan en la Factura Derecha
      const summaryPlanBadge = document.getElementById('calc-summary-plan-badge');
      const summaryPlanTitle = document.getElementById('calc-summary-plan-title');
      const summaryPlanSubtitle = document.getElementById('calc-summary-plan-subtitle');
      const summaryPkgIcon = document.getElementById('calc-summary-pkg-icon');
      const summaryPkgName = document.getElementById('calc-summary-pkg-name');
      const summaryBasePrice = document.getElementById('calc-summary-base-price');
      const summaryIncludedLabel = document.getElementById('calc-summary-included-label');

      const hasExtras = !isCustomMode && (extraKeys.length > 0);

      if (summaryPlanBadge) {
        if (isCustomMode) {
          summaryPlanBadge.textContent = '⚙️ Plan Personalizado';
          summaryPlanBadge.style.background = 'rgba(56, 189, 248, 0.25)';
          summaryPlanBadge.style.color = '#38bdf8';
          summaryPlanBadge.style.borderColor = 'rgba(56, 189, 248, 0.4)';
        } else if (hasExtras) {
          summaryPlanBadge.textContent = '✨ Combo + Extras';
          summaryPlanBadge.style.background = 'rgba(234, 179, 8, 0.25)';
          summaryPlanBadge.style.color = '#fef08a';
          summaryPlanBadge.style.borderColor = 'rgba(251, 191, 36, 0.4)';
        } else {
          summaryPlanBadge.textContent = 'Plan Base';
          summaryPlanBadge.style.background = 'rgba(99, 102, 241, 0.3)';
          summaryPlanBadge.style.color = '#c7d2fe';
          summaryPlanBadge.style.borderColor = 'rgba(165, 180, 252, 0.4)';
        }
      }

      if (summaryPlanTitle) {
        if (isCustomMode) {
          summaryPlanTitle.textContent = count > 0 ? `Plan Personalizado (${count} ${count === 1 ? 'Módulo' : 'Módulos'})` : 'Plan Personalizado';
        } else if (selectedPackageKey === 'full') {
          summaryPlanTitle.textContent = pkg.name;
        } else if (hasExtras) {
          summaryPlanTitle.textContent = `${pkg.name} + ${extraKeys.length} Extra`;
        } else {
          summaryPlanTitle.textContent = pkg.name;
        }
      }

      if (summaryPlanSubtitle) {
        if (isCustomMode) {
          summaryPlanSubtitle.textContent = 'Herramientas a tu medida con descuento por volumen';
        } else if (hasExtras) {
          summaryPlanSubtitle.textContent = `Base (${pkg.name}) + ${extraKeys.length} módulo(s) extra`;
        } else {
          summaryPlanSubtitle.textContent = 'Configuración estándar del paquete';
        }
      }

      if (summaryPkgIcon) summaryPkgIcon.textContent = isCustomMode ? '⚙️' : (pkg.icon || '🎸');
      if (summaryPkgName) summaryPkgName.textContent = isCustomMode ? 'Plan Personalizado' : (pkg.name || 'Paquete');
      if (summaryBasePrice) summaryBasePrice.textContent = `$${(isCustomMode ? regularPrice : basePrice).toFixed(2)} USD`;

      if (summaryIncludedLabel) {
        summaryIncludedLabel.textContent = isCustomMode ? '✓ Módulos en tu Plan Personalizado:' : '✓ Incluidos en este Plan ($0 extra):';
      }

      // Lista de Módulos Incluidos
      const includedListEl = document.getElementById('calc-summary-included-list');
      if (includedListEl) {
        includedListEl.innerHTML = includedKeys.map(k => {
          const m = MODULES_DATA[k];
          return m ? `<span style="font-size: 0.7rem; background: rgba(255,255,255,0.08); padding: 1px 6px; border-radius: 5px; color: #e2e8f0; font-weight: 600;">${m.icon} ${m.name.split('(')[0].trim()}</span>` : '';
        }).join('') || '<span style="font-size: 0.7rem; color: #94a3b8;">Ninguno seleccionado</span>';
      }

      // Línea de Descuento por Volumen (en Modo Personalizado o Full Suite)
      const discountLine = document.getElementById('calc-summary-discount-line');
      const discountBadge = document.getElementById('calc-summary-discount-badge');
      const discountAmountEl = document.getElementById('calc-summary-discount-amount');
      const regularPriceContainer = document.getElementById('calc-summary-regular-price-container');
      const regularPriceEl = document.getElementById('calc-summary-regular-price');

      if (isCustomMode && savings > 0) {
        if (discountLine) discountLine.style.display = 'flex';
        if (discountBadge) discountBadge.textContent = discountLabel;
        if (discountAmountEl) discountAmountEl.textContent = `-$${savings.toFixed(2)} USD`;
        if (regularPriceContainer) regularPriceContainer.style.display = 'block';
        if (regularPriceEl) regularPriceEl.textContent = `$${regularPrice.toFixed(2)} USD`;
      } else {
        if (discountLine) discountLine.style.display = 'none';
        if (regularPriceContainer) regularPriceContainer.style.display = 'none';
      }

      // Módulos Extra (en modo Paquetes predefinidos)
      const extraLine = document.getElementById('calc-summary-extra-line');
      const extraCountEl = document.getElementById('calc-summary-extra-count');
      const extraCostEl = document.getElementById('calc-summary-extra-cost');
      const extraContainer = document.getElementById('calc-summary-extra-container');
      const extraListEl = document.getElementById('calc-summary-extra-list');

      if (extraLine) {
        extraLine.style.display = isCustomMode ? 'none' : 'flex';
      }

      if (extraCountEl) extraCountEl.textContent = extraKeys.length;
      if (extraCostEl) extraCostEl.textContent = `+$${extraCost.toFixed(2)} USD`;

      if (extraContainer) {
        extraContainer.style.display = (!isCustomMode && hasExtras) ? 'block' : 'none';
      }

      if (extraListEl) {
        extraListEl.innerHTML = extraKeys.map(k => {
          const m = MODULES_DATA[k];
          return m ? `<span style="font-size: 0.7rem; background: rgba(253, 224, 71, 0.2); border: 1px solid rgba(253, 224, 71, 0.4); padding: 1px 6px; border-radius: 5px; color: #fef08a; font-weight: 700;">+ ${m.icon} ${m.name.split('(')[0].trim()}</span>` : '';
        }).join('');
      }

      // Tip Full Suite
      const tipEl = document.getElementById('calc-full-suite-tip');
      if (tipEl) {
        tipEl.style.display = (!isCustomMode && suggestsFullSuite) ? 'block' : 'none';
      }

      // Banner Informativo Inteligente & Botones de Acción Condicionales
      const diffBanner = document.getElementById('calc-difference-banner');
      const diffBannerContent = document.getElementById('calc-diff-banner-content');
      const reportFullBtn = document.getElementById('calc-report-full-btn');
      const reportDiffBtn = document.getElementById('calc-report-diff-btn');

      if (IS_SUBSCRIPTION_PAID) {
        // CLIENTE CON SUSCRIPCIÓN ACTIVA Y PAGADA
        if (hasExtras) {
          if (diffBanner) {
            diffBanner.style.display = 'block';
            diffBanner.style.background = 'rgba(56, 189, 248, 0.12)';
            diffBanner.style.border = '1px solid rgba(56, 189, 248, 0.35)';
            diffBannerContent.innerHTML = `
              <div style="font-weight: 800; color: #38bdf8; margin-bottom: 2px; display: flex; align-items: center; gap: 4px;">
                <span>✅</span> Plan base pagado hasta el ${EXPIRATION_DATE_STR} (${DAYS_LEFT} días restantes)
              </div>
              <div style="color: #bae6fd;">
                Para activar estos <strong>${extraKeys.length} módulo(s) extra</strong> de inmediato, puedes pagar la diferencia de <strong>+$${extraCost.toFixed(2)} USD</strong> o programarlo para el próximo mes.
              </div>
            `;
          }
          if (reportDiffBtn) {
            reportDiffBtn.style.display = 'flex';
            reportDiffBtn.innerHTML = `<span>➕ Pagar Módulo(s) Extra (+ $${extraCost.toFixed(2)} USD)</span>`;
          }
          if (reportFullBtn) {
            reportFullBtn.style.display = 'flex';
            reportFullBtn.innerHTML = `<span>🔄 Renovar Mes Completo ($${finalTotal.toFixed(2)} USD)</span>`;
          }
        } else {
          if (diffBanner) {
            diffBanner.style.display = 'block';
            diffBanner.style.background = 'rgba(16, 185, 129, 0.12)';
            diffBanner.style.border = '1px solid rgba(16, 185, 129, 0.35)';
            diffBannerContent.innerHTML = `
              <div style="font-weight: 800; color: #34d399; margin-bottom: 2px; display: flex; align-items: center; gap: 4px;">
                <span>✓</span> Plan al día hasta el ${EXPIRATION_DATE_STR}
              </div>
              <div style="color: #a7f3d0;">
                No tienes pagos pendientes. Tu servicio actual está cubierto por <strong>${DAYS_LEFT} días más</strong>.
              </div>
            `;
          }
          if (reportDiffBtn) reportDiffBtn.style.display = 'none';
          if (reportFullBtn) {
            reportFullBtn.style.display = 'flex';
            reportFullBtn.innerHTML = `<span>🔄 Adelantar / Renovar Mes ($${finalTotal.toFixed(2)} USD)</span>`;
          }
        }
      } else {
        // CLIENTE EN PRUEBA GRATUITA, VENCIDO O PENDIENTE DE PAGO
        if (diffBanner) {
          diffBanner.style.display = 'block';
          diffBanner.style.background = 'rgba(234, 179, 8, 0.12)';
          diffBanner.style.border = '1px solid rgba(234, 179, 8, 0.35)';
          diffBannerContent.innerHTML = `
            <div style="font-weight: 800; color: #fde047; margin-bottom: 2px; display: flex; align-items: center; gap: 4px;">
              <span>📅</span> ${EXPIRATION_DATE_STR ? ('Vencimiento: ' + EXPIRATION_DATE_STR + ' (' + DAYS_LEFT + ' días)') : 'Pago de Mensualidad'}
            </div>
            <div style="color: #fef08a;">
              Tu cuota mensual seleccionada es de <strong>$${finalTotal.toFixed(2)} USD/mes</strong>. ${savings > 0 ? ('¡Estás ahorrando <strong>$' + savings.toFixed(2) + ' USD</strong> por volumen!') : 'Reporta tu pago para activar tu servicio.'}
            </div>
          `;
        }
        if (reportDiffBtn) reportDiffBtn.style.display = 'none';
        if (reportFullBtn) {
          reportFullBtn.style.display = 'flex';
          reportFullBtn.innerHTML = `<span>⚡ Reportar Pago Mensual ($${finalTotal.toFixed(2)} USD)</span>`;
        }
      }

      // Total Final
      const totalAmountEl = document.getElementById('calc-total-amount');
      if (totalAmountEl) totalAmountEl.textContent = `$${finalTotal.toFixed(2)}`;

      const moduleCountBadge = document.getElementById('calc-module-count-badge');
      if (moduleCountBadge) {
        moduleCountBadge.textContent = `${selectedKeys.length} de ${Object.keys(MODULES_DATA).length} Módulos`;
      }

      // Sincronizar campo de monto en el formulario de reporte de pago inferior
      const paymentAmountInput = document.getElementById('subscription_amount_input');
      if (paymentAmountInput && !paymentAmountInput.dataset.manualOverride) {
        paymentAmountInput.value = finalTotal.toFixed(2);
      }
    };

    window.selectGigPackage = function(pkgKey, switchPackageDefaults = false) {
      if (!PACKAGES_DATA[pkgKey]) pkgKey = 'banda';
      selectedPackageKey = pkgKey;
      const pkg = PACKAGES_DATA[pkgKey];

      // Actualizar estado de las 6 cards superiores
      document.querySelectorAll('.pkg-pill-btn').forEach(btn => {
        const isThis = (btn.dataset.pkgKey === pkgKey);
        const statusEl = btn.querySelector('.pkg-selection-status');
        if (isThis) {
          btn.classList.add('is-active');
          if (statusEl) statusEl.textContent = '✓ Seleccionado';
        } else {
          btn.classList.remove('is-active');
          if (statusEl) statusEl.textContent = 'Elegir Plan';
        }
      });

      // Solo si el usuario explícitamente hizo clic en otra pestaña de paquete,
      // preseleccionamos los módulos de ese nuevo paquete (si no es 'personalizado')
      if (switchPackageDefaults && pkgKey !== 'personalizado') {
        const pkgModules = pkg.modules || [];
        document.querySelectorAll('.calc-module-checkbox').forEach(cb => {
          cb.checked = pkgModules.includes(cb.dataset.modKey);
        });
      }

      // Sincronizar el select del formulario
      const select = document.getElementById('subscription_plan_tier_select');
      if (select) {
        select.value = selectedPackageKey;
      }

      window.recalculateGigPricing();
    };

    // Función para reportar pago completo o solo diferencia
    window.applyCalculationToPaymentReport = function(mode) {
      const isCustomMode = (selectedPackageKey === 'personalizado');
      const pkg = PACKAGES_DATA[selectedPackageKey] || PACKAGES_DATA['banda'];
      const selectedKeys = getSelectedModuleKeys();
      const count = selectedKeys.length;

      let finalTotal = 0.0;
      let extraKeys = [];
      let extraCost = 0.0;

      if (isCustomMode) {
        const tier = CUSTOM_TIERS_DATA[count] || CUSTOM_TIERS_DATA[7];
        finalTotal = tier.price;
      } else {
        const pkgModules = pkg.modules || [];
        extraKeys = selectedKeys.filter(k => !pkgModules.includes(k));
        extraCost = extraKeys.length * EXTRA_PRICE;
        const basePrice = parseFloat(pkg.price) || 15.00;
        const subtotal = basePrice + extraCost;
        const fullSuitePrice = 22.00;
        const suggestsFullSuite = (subtotal >= fullSuitePrice) && (selectedPackageKey !== 'full');
        finalTotal = suggestsFullSuite ? fullSuitePrice : subtotal;
      }

      const select = document.getElementById('subscription_plan_tier_select');
      if (select) {
        select.value = selectedPackageKey;
      }

      const paymentAmountInput = document.getElementById('subscription_amount_input');
      const notesInput = document.querySelector('input[name="notes"]');

      if (mode === 'diff' && extraKeys.length > 0 && IS_SUBSCRIPTION_PAID && !isCustomMode) {
        if (paymentAmountInput) {
          paymentAmountInput.value = extraCost.toFixed(2);
        }
        if (notesInput) {
          const extraNames = extraKeys.map(k => MODULES_DATA[k] ? MODULES_DATA[k].name : k).join(', ');
          notesInput.value = `Pago de diferencia por ${extraKeys.length} módulo(s) extra (${extraNames}) - Plan ${pkg.name} vigente hasta ${EXPIRATION_DATE_STR}`;
        }
      } else {
        if (paymentAmountInput) {
          paymentAmountInput.value = finalTotal.toFixed(2);
        }
        if (notesInput) {
          const modNames = selectedKeys.map(k => MODULES_DATA[k] ? MODULES_DATA[k].name.split('(')[0].trim() : k).join(', ');
          if (isCustomMode) {
            notesInput.value = `Suscripción mensual: Plan Personalizado (${selectedKeys.length} módulos: ${modNames})`;
          } else if (extraKeys.length > 0) {
            notesInput.value = `Suscripción mensual: ${pkg.name} + ${extraKeys.length} módulo(s) adicional(es)`;
          } else {
            notesInput.value = `Suscripción mensual: ${pkg.name}`;
          }
        }
      }

      const target = document.getElementById('reportar-pago');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
        const refInput = document.querySelector('input[name="reference_number"]');
        if (refInput) {
          setTimeout(() => refInput.focus(), 400);
        }
      }
    };

    // Función para desplegar y contraer detalles y funciones de cada módulo
    window.toggleModuleDetails = function(modKey) {
      const panel = document.getElementById(`calc-details-${modKey}`);
      const chevron = document.getElementById(`calc-chevron-${modKey}`);
      if (!panel) return;

      const isHidden = (panel.style.display === 'none' || panel.style.display === '');
      if (isHidden) {
        panel.style.display = 'block';
        if (chevron) {
          chevron.style.transform = 'rotate(180deg)';
          chevron.style.color = '#4f46e5';
        }
      } else {
        panel.style.display = 'none';
        if (chevron) {
          chevron.style.transform = 'rotate(0deg)';
          chevron.style.color = '#64748b';
        }
      }
    };

    // ==========================================
    // MODAL DE CONFIRMACIÓN DE CAMBIO DE PLAN
    // ==========================================
    window.openPlanChangeModal = function() {
      const isCustomMode = (selectedPackageKey === 'personalizado');
      const pkg = PACKAGES_DATA[selectedPackageKey] || PACKAGES_DATA['banda'];
      const selectedKeys = getSelectedModuleKeys();
      const count = selectedKeys.length;

      let finalTotal = 0.0;
      let newPlanName = '';
      let newPlanIcon = '';

      if (isCustomMode) {
        const tier = CUSTOM_TIERS_DATA[count] || CUSTOM_TIERS_DATA[7];
        finalTotal = tier.price;
        newPlanName = count > 0 ? `Plan Personalizado (${count} Módulos)` : 'Plan Personalizado';
        newPlanIcon = '⚙️';
      } else {
        const pkgModules = pkg.modules || [];
        const extraKeys = selectedKeys.filter(k => !pkgModules.includes(k));
        const extraCost = extraKeys.length * EXTRA_PRICE;
        const basePrice = parseFloat(pkg.price) || 15.00;
        const subtotal = basePrice + extraCost;
        const fullSuitePrice = 22.00;
        const suggestsFullSuite = (subtotal >= fullSuitePrice) && (selectedPackageKey !== 'full');
        finalTotal = suggestsFullSuite ? fullSuitePrice : subtotal;
        newPlanName = (selectedPackageKey === 'full') ? pkg.name : (extraKeys.length > 0 ? `${pkg.name} + ${extraKeys.length} Extra` : pkg.name);
        newPlanIcon = pkg.icon || '🎸';
      }

      // Rellenar datos del nuevo plan en el modal
      const modalIcon = document.getElementById('modal-new-plan-icon');
      const modalName = document.getElementById('modal-new-plan-name');
      const modalPrice = document.getElementById('modal-new-plan-price');
      if (modalIcon) modalIcon.textContent = newPlanIcon;
      if (modalName) modalName.textContent = newPlanName;
      if (modalPrice) modalPrice.textContent = `$${finalTotal.toFixed(2)}`;

      // Diferencia respecto a lo pagado actualmente
      const diffAmount = finalTotal - CURRENT_PAID_FEE;
      const badgeContainer = document.getElementById('modal-difference-badge-container');
      const immediateOption = document.getElementById('modal-timing-immediate-option');
      const immediateDiffText = document.getElementById('modal-immediate-diff-text');

      if (badgeContainer) {
        if (diffAmount < -0.01) {
          const ahorro = Math.abs(diffAmount);
          badgeContainer.style.background = '#ecfdf5';
          badgeContainer.style.color = '#065f46';
          badgeContainer.style.border = '1.5px solid #a7f3d0';
          badgeContainer.innerHTML = `🎉 <strong>Ahorro Mensual:</strong> Te ahorrarás <strong>-$${ahorro.toFixed(2)} USD/mes</strong> a partir del próximo ciclo.`;
          if (immediateOption) immediateOption.style.display = 'none';
        } else if (diffAmount > 0.01) {
          badgeContainer.style.background = '#eff6ff';
          badgeContainer.style.color = '#1e3a8a';
          badgeContainer.style.border = '1.5px solid #bfdbfe';
          badgeContainer.innerHTML = `⚡ <strong>Mejora de Plan:</strong> Incremento de <strong>+$${diffAmount.toFixed(2)} USD/mes</strong>.`;
          if (immediateOption) {
            immediateOption.style.display = 'flex';
            if (immediateDiffText) immediateDiffText.textContent = `+$${diffAmount.toFixed(2)} USD`;
          }
        } else {
          badgeContainer.style.background = '#f5f3ff';
          badgeContainer.style.color = '#5b21b6';
          badgeContainer.style.border = '1.5px solid #ddd6fe';
          badgeContainer.innerHTML = `✓ <strong>Tarifa Idéntica:</strong> Mantienes tu inversión de <strong>$${finalTotal.toFixed(2)} USD/mes</strong>.`;
          if (immediateOption) immediateOption.style.display = 'none';
        }
      }

      // Detalle de módulos
      const keptKeys = selectedKeys.filter(k => CURRENT_ACTIVE_MODULES.includes(k));
      const removedKeys = CURRENT_ACTIVE_MODULES.filter(k => !selectedKeys.includes(k));
      const addedKeys = selectedKeys.filter(k => !CURRENT_ACTIVE_MODULES.includes(k));

      const keptList = document.getElementById('modal-kept-modules-list');
      if (keptList) {
        keptList.innerHTML = keptKeys.map(k => {
          const m = MODULES_DATA[k];
          return m ? `<span style="font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; background: white; border: 1px solid #cbd5e1; color: #1e293b; font-weight: 700;">✓ ${m.icon} ${m.name.split('(')[0].trim()}</span>` : '';
        }).join('') || '<span style="font-size: 0.74rem; color: #94a3b8;">Ninguno</span>';
      }

      const removedBox = document.getElementById('modal-removed-modules-box');
      const removedList = document.getElementById('modal-removed-modules-list');
      if (removedBox && removedList) {
        if (removedKeys.length > 0) {
          removedBox.style.display = 'block';
          removedList.innerHTML = removedKeys.map(k => {
            const m = MODULES_DATA[k];
            return m ? `<span style="font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; background: #fef3c7; border: 1px solid #fde68a; color: #92400e; font-weight: 800;">✕ ${m.icon} ${m.name.split('(')[0].trim()}</span>` : '';
          }).join('');
        } else {
          removedBox.style.display = 'none';
        }
      }

      const addedBox = document.getElementById('modal-added-modules-box');
      const addedList = document.getElementById('modal-added-modules-list');
      if (addedBox && addedList) {
        if (addedKeys.length > 0) {
          addedBox.style.display = 'block';
          addedList.innerHTML = addedKeys.map(k => {
            const m = MODULES_DATA[k];
            return m ? `<span style="font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; background: #dbeafe; border: 1px solid #bfdbfe; color: #1d4ed8; font-weight: 800;">+ ${m.icon} ${m.name.split('(')[0].trim()}</span>` : '';
          }).join('');
        } else {
          addedBox.style.display = 'none';
        }
      }

      // Rellenar formulario oculto del modal
      const submitPlanTier = document.getElementById('modal-submit-plan-tier');
      if (submitPlanTier) submitPlanTier.value = selectedPackageKey;

      const submitDiffAmount = document.getElementById('modal-submit-difference-amount');
      if (submitDiffAmount) submitDiffAmount.value = Math.max(0, diffAmount).toFixed(2);

      const hiddenModulesContainer = document.getElementById('modal-hidden-modules-inputs');
      if (hiddenModulesContainer) {
        hiddenModulesContainer.innerHTML = Object.keys(MODULES_DATA).map(k => {
          const val = selectedKeys.includes(k) ? '1' : '0';
          return `<input type="hidden" name="modules[${k}]" value="${val}">`;
        }).join('');
      }

      // Resetear opciones de timing
      const timingNext = document.getElementById('modal-timing-next');
      if (timingNext) timingNext.checked = true;
      const hiddenPayDiff = document.getElementById('modal-hidden-pay-difference');
      if (hiddenPayDiff) hiddenPayDiff.value = '0';
      const submitBtn = document.getElementById('modal-submit-confirm-btn');
      if (submitBtn) submitBtn.innerHTML = '<span>✅ Confirmar Cambio de Plan</span>';

      const modal = document.getElementById('calc-confirm-change-modal');
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    };

    window.closePlanChangeModal = function() {
      const modal = document.getElementById('calc-confirm-change-modal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    };

    window.toggleModalTimingOption = function() {
      const immediateRadio = document.getElementById('modal-timing-immediate');
      const hiddenPayDiff = document.getElementById('modal-hidden-pay-difference');
      const submitBtn = document.getElementById('modal-submit-confirm-btn');
      if (immediateRadio && immediateRadio.checked) {
        if (hiddenPayDiff) hiddenPayDiff.value = '1';
        if (submitBtn) submitBtn.innerHTML = '<span>⚡ Pagar Diferencia y Activar Hoy</span>';
      } else {
        if (hiddenPayDiff) hiddenPayDiff.value = '0';
        if (submitBtn) submitBtn.innerHTML = '<span>✅ Confirmar Cambio para el Próximo Mes</span>';
      }
    };

    function initCalculator() {
      // Inicializar cálculo preservando los módulos reales guardados de la empresa
      window.selectGigPackage(selectedPackageKey, false);
    }

    if (document.readyState !== 'loading') {
      initCalculator();
    } else {
      document.addEventListener('DOMContentLoaded', initCalculator);
    }

    document.addEventListener('turbo:load', initCalculator);
    document.addEventListener('turbo:render', initCalculator);
  })();
</script>
