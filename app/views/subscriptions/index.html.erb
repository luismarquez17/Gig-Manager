<div style="max-width: 1100px; margin: 0 auto; padding: 20px 10px; font-family: 'Inter', sans-serif;">

  <!-- Encabezado Principal -->
  <div style="text-align: center; max-width: 800px; margin: 0 auto 35px auto;">
    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 50px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); color: #6366f1; font-size: 0.85rem; font-weight: 700; margin-bottom: 15px;">
      <span>🚀</span> <span>Plataforma SaaS Global para Gestión de Eventos</span>
    </div>
    <h1 style="font-size: 2.3rem; font-weight: 800; color: #0f172a; margin: 0 0 12px 0; letter-spacing: -0.5px;">
      Evoluciona tu Agrupación con Gig Manager
    </h1>
    <p style="font-size: 1.05rem; color: #64748b; margin: 0; line-height: 1.6;">
      Gestión profesional de eventos, contratos digitales, portal de clientes, nómina de músicos y control financiero en una sola plataforma.
    </p>
  </div>

  <!-- Banner de Estado de la Prueba / Suscripción -->
  <div style="margin-bottom: 35px;">
    <% if @company.active_subscription? %>
      <div style="padding: 22px 28px; border-radius: 20px; background: #ecfdf5; border: 1px solid #a7f3d0; display: flex; flex-wrap: wrap; items-center; justify-content: space-between; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 50px; height: 50px; border-radius: 14px; background: #10b981; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 900;">
            ✓
          </div>
          <div>
            <h3 style="font-size: 1.2rem; font-weight: 800; color: #065f46; margin: 0;">Suscripción Activa (<%= @company.plan_tier.to_s.capitalize %>)</h3>
            <p style="color: #047857; font-size: 0.9rem; margin: 4px 0 0 0;">Tu empresa <strong style="color: #064e3b;"><%= @company.name %></strong> tiene acceso total e ilimitado a todas las herramientas.</p>
          </div>
        </div>
        <%= button_to portal_subscriptions_path, method: :post, data: { turbo: false }, style: "padding: 12px 24px; border-radius: 12px; background: #059669; color: white; border: none; font-weight: 800; font-size: 0.9rem; cursor: pointer; box-shadow: 0 4px 14px rgba(5,150,105,0.3);" do %>
          Administrar Suscripción en Stripe 💳
        <% end %>
      </div>

    <% elsif @trial_active %>
      <div style="padding: 24px 28px; border-radius: 20px; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border: 1px solid #4338ca; color: white; display: flex; flex-wrap: wrap; items-center; justify-content: space-between; gap: 20px; box-shadow: 0 10px 30px rgba(15,23,42,0.15);">
        <div style="display: flex; align-items: center; gap: 18px;">
          <div style="min-width: 54px; height: 54px; border-radius: 16px; background: rgba(99, 102, 241, 0.25); border: 1px solid rgba(165, 180, 252, 0.4); color: #a5b4fc; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 900;">
            <%= @trial_days_left %>
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <span style="padding: 3px 10px; border-radius: 6px; font-size: 0.72rem; font-weight: 800; background: rgba(99, 102, 241, 0.3); color: #c7d2fe; border: 1px solid rgba(165, 180, 252, 0.4);">PRUEBA GRATUITA ACTIVA</span>
              <span style="font-size: 0.78rem; color: #94a3b8;">30 Días de Prueba Sin Tarjeta</span>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 800; color: white; margin: 0;">Te quedan <span style="color: #818cf8;"><%= @trial_days_left %> días</span> de prueba gratuita</h3>
            <p style="color: #cbd5e1; font-size: 0.88rem; margin: 4px 0 0 0;">Disfruta de la app completa. Puedes activar tu plan en cualquier momento para mantener el acceso ininterrumpido.</p>
          </div>
        </div>
      </div>

    <% else %>
      <div style="padding: 22px 28px; border-radius: 20px; background: #fffbebfb; border: 1px solid #fcd34d; display: flex; flex-wrap: wrap; items-center; justify-content: space-between; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 50px; height: 50px; border-radius: 14px; background: #f59e0b; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
            ⚠️
          </div>
          <div>
            <h3 style="font-size: 1.2rem; font-weight: 800; color: #78350f; margin: 0;">Tu prueba gratuita de 30 días ha finalizado</h3>
            <p style="color: #92400e; font-size: 0.9rem; margin: 4px 0 0 0;">Selecciona un plan a continuación para desbloquear tu panel y continuar gestionando tus eventos.</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Grilla de Planes de Precios -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 25px; margin-bottom: 45px;">

    <!-- Plan Base: $10/mes -->
    <div style="background: white; border-radius: 24px; border: 1px solid #cbd5e1; padding: 32px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 10px 30px rgba(0,0,0,0.04); position: relative;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h3 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0;">Plan Base</h3>
          <span style="padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 800; background: #f1f5f9; color: #475569;">Más Popular</span>
        </div>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0 0 20px 0; line-height: 1.5;">Ideal para agrupaciones, bandas y músicos independientes que buscan control total de su operación.</p>

        <div style="margin-bottom: 25px;">
          <span style="font-size: 3rem; font-weight: 900; color: #0f172a;">$10</span>
          <span style="color: #64748b; font-weight: 600; font-size: 1rem;">USD / mes</span>
        </div>

        <ul style="list-style: none; padding: 0; margin: 0 0 30px 0; display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem; color: #334155;">
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #10b981; font-weight: 900;">✓</span>
            <span>Gestión Ilimitada de Eventos (Gigs) y Calendario</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #10b981; font-weight: 900;">✓</span>
            <span>Contratos Digitales con Firma en Vivo</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #10b981; font-weight: 900;">✓</span>
            <span>Portal de Clientes con Token de WhatsApp</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #10b981; font-weight: 900;">✓</span>
            <span>Nómina de Músicos, Staff y Reportes de Pagos</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #10b981; font-weight: 900;">✓</span>
            <span>Control de Inventarios, Kits y Mantenimiento</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #10b981; font-weight: 900;">✓</span>
            <span>Dashboard Financiero, Balance y Utilidades</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px; color: #94a3b8; text-decoration: line-through;">
            <span>✕</span>
            <span>Landing Page Pública y Cotizador Web en Vivo</span>
          </li>
        </ul>
      </div>

      <div>
        <%= button_to checkout_subscriptions_path(plan_tier: 'starter'), method: :post, data: { turbo: false }, style: "width: 100%; padding: 16px; border-radius: 14px; background: #0f172a; color: white; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 4px 15px rgba(15,23,42,0.2); transition: background 0.2s;" do %>
          Activar Plan Base ($10/mes) 🚀
        <% end %>
      </div>
    </div>

    <!-- Plan Pro: $19/mes -->
    <div style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border-radius: 24px; border: 2px solid #6366f1; padding: 32px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 15px 40px rgba(99,102,241,0.2); position: relative; color: white;">
      <div style="position: absolute; top: -14px; right: 24px; padding: 5px 14px; border-radius: 20px; background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); color: white; font-size: 0.72rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; box-shadow: 0 4px 10px rgba(99,102,241,0.3);">
        Completo + Landing Web
      </div>

      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h3 style="font-size: 1.5rem; font-weight: 800; color: white; margin: 0;">Plan Pro</h3>
          <span style="padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 800; background: rgba(99, 102, 241, 0.2); color: #c7d2fe; border: 1px solid rgba(165, 180, 252, 0.3);">Recomendado</span>
        </div>
        <p style="color: #cbd5e1; font-size: 0.88rem; margin: 0 0 20px 0; line-height: 1.5;">Ideal para orquestas y empresas de producción que requieren presencia web e interactividad comercial.</p>

        <div style="margin-bottom: 25px;">
          <span style="font-size: 3rem; font-weight: 900; color: white;">$19</span>
          <span style="color: #cbd5e1; font-weight: 600; font-size: 1rem;">USD / mes</span>
        </div>

        <ul style="list-style: none; padding: 0; margin: 0 0 30px 0; display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem; color: #e2e8f0;">
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #34d399; font-weight: 900;">✓</span>
            <strong style="color: white;">Todo lo incluido en el Plan Base</strong>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #38bdf8; font-weight: 900;">✓</span>
            <span><strong style="color: #38bdf8;">Landing Page Pública Personalizada</strong> (`/b/tu-agrupacion`)</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #38bdf8; font-weight: 900;">✓</span>
            <span>Cotizador de Presupuestos en Vivo para Clientes</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #38bdf8; font-weight: 900;">✓</span>
            <span>Catálogo de Paquetes y Opciones de Show</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #38bdf8; font-weight: 900;">✓</span>
            <span>Galería Multimedia, Videos y Reseñas de Clientes</span>
          </li>
          <li style="display: flex; align-items: center; gap: 10px;">
            <span style="color: #38bdf8; font-weight: 900;">✓</span>
            <span>Temas Neón Festival, Royal Gala y Minimal Studio</span>
          </li>
        </ul>
      </div>

      <div>
        <%= button_to checkout_subscriptions_path(plan_tier: 'pro'), method: :post, data: { turbo: false }, style: "width: 100%; padding: 16px; border-radius: 14px; background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); color: white; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 6px 20px rgba(99,102,241,0.4);" do %>
          Activar Plan Pro ($19/mes) ✨
        <% end %>
      </div>
    </div>

  </div>

  <!-- Sección Especial: Métodos de Pago Venezuela / Alternativos (Zelle, Binance, Pago Móvil) -->
  <div style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 32px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 45px;">
    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 25px;">
      <span style="font-size: 2.2rem;">🇻🇪</span>
      <div>
        <h2 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin: 0;">Métodos de Pago en Venezuela y Alternativos</h2>
        <p style="color: #64748b; font-size: 0.9rem; margin: 4px 0 0 0;">¿Sin tarjeta internacional? Paga fácilmente por Zelle, Binance Pay USDT o Pago Móvil (Tasa BCV).</p>
      </div>
    </div>

    <!-- Pestañas / Datos bancarios de ejemplo configurables -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px; margin-bottom: 25px;">
      <div style="padding: 16px; border-radius: 16px; background: #f8fafc; border: 1px solid #e2e8f0;">
        <div style="font-weight: 800; color: #059669; font-size: 0.9rem; margin-bottom: 6px;">🇺🇸 Zelle (USD)</div>
        <div style="font-size: 0.82rem; color: #334155;">Correo: <strong style="color: #0f172a; user-select: all;">pagos@gigmanager.app</strong></div>
        <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">Titular: Gig Manager Corp</div>
      </div>
      <div style="padding: 16px; border-radius: 16px; background: #f8fafc; border: 1px solid #e2e8f0;">
        <div style="font-weight: 800; color: #d97706; font-size: 0.9rem; margin-bottom: 6px;">🔶 Binance Pay (USDT)</div>
        <div style="font-size: 0.82rem; color: #334155;">Pay ID: <strong style="color: #0f172a; user-select: all;">889977665</strong></div>
        <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">Red: TRC20 / BEP20</div>
      </div>
      <div style="padding: 16px; border-radius: 16px; background: #f0f9ff; border: 1px solid #bae6fd;">
        <div style="font-weight: 800; color: #0284c7; font-size: 0.9rem; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;">
          <span>🇻🇪 Pago Móvil (Tasa BCV)</span>
          <span style="font-size: 0.7rem; background: #0284c7; color: white; padding: 2px 7px; border-radius: 4px;">Bancamiga</span>
        </div>
        <div style="font-size: 0.82rem; color: #334155;">Banco: <strong style="color: #0f172a;">Bancamiga (0172)</strong></div>
        <div style="font-size: 0.82rem; color: #334155;">C.I.: <strong style="color: #0f172a; user-select: all;">V-33115864</strong></div>
        <div style="font-size: 0.82rem; color: #334155;">Teléfono: <strong style="color: #0f172a; user-select: all;">0424-6208725</strong></div>
      </div>
    </div>

    <!-- Pagos Pendientes Reportados por el Usuario -->
    <% if @pending_payments.present? %>
      <div style="margin-bottom: 25px; padding: 18px; border-radius: 16px; background: #fffbebfb; border: 1px solid #fcd34d;">
        <h4 style="font-weight: 800; color: #92400e; font-size: 0.9rem; margin: 0 0 10px 0;">⏳ Pagos en Proceso de Verificación (<%= @pending_payments.count %>)</h4>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <% @pending_payments.each do |p| %>
            <div style="font-size: 0.82rem; color: #1e293b; display: flex; justify-content: space-between; align-items: center; background: white; padding: 10px 14px; border-radius: 10px; border: 1px solid #fef3c7;">
              <span>Plan <strong><%= p.plan_tier.capitalize %></strong> ($<%= '%.2f' % p.amount %>) via <%= p.payment_method_label %></span>
              <span style="font-family: monospace; color: #0284c7; font-weight: 700;">Ref: #<%= p.reference_number %></span>
              <span style="padding: 3px 8px; border-radius: 6px; background: #fef3c7; color: #92400e; font-size: 0.72rem; font-weight: 800;">REVISANDO</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Formulario para Reportar Pago -->
    <div style="padding: 24px; border-radius: 18px; background: #f8fafc; border: 1px solid #e2e8f0;">
      <h3 style="font-size: 1.1rem; font-weight: 800; color: #0f172a; margin: 0 0 16px 0;">Reportar Pago Realizado</h3>
      <%= form_with url: report_payment_subscriptions_path, method: :post, local: true, style: "display: flex; flex-direction: column; gap: 15px;" do |f| %>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Plan a Activar</label>
            <%= select_tag :plan_tier, options_for_select([["Plan Base ($10 USD / mes)", "starter"], ["Plan Pro + Landing ($19 USD / mes)", "pro"]]), style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Método de Pago</label>
            <%= select_tag :payment_method, options_for_select([["Pago Móvil (Tasa BCV)", "pago_movil"], ["Zelle (USD)", "zelle"], ["Binance Pay (USDT)", "binance"], ["Transferencia Bancaria", "transferencia"]]), style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Número de Referencia</label>
            <%= text_field_tag :reference_number, nil, required: true, placeholder: "Ej. 09841235", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
        </div>
        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Notas adicionales (opcional)</label>
          <%= text_field_tag :notes, nil, placeholder: "Titular de la cuenta, banco emisor, etc.", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
        </div>
        <div style="padding-top: 5px;">
          <%= f.submit "Reportar Pago para Verificación 🚀", style: "width: 100%; padding: 14px; border-radius: 12px; background: #2563eb; color: white; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(37,99,235,0.3);" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- FAQ de Cobros -->
  <div style="max-width: 800px; margin: 0 auto; padding-top: 30px; border-top: 1px solid #e2e8f0;">
    <h3 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; text-align: center; margin: 0 0 25px 0;">Preguntas Frecuentes de Suscripción</h3>
    <div style="display: flex; flex-direction: column; gap: 15px;">
      <div style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Cómo funciona la prueba gratuita de 30 días?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Disfrutas de acceso total a Gig Manager durante 30 días sin ingresar ninguna tarjeta de crédito. Al finalizar el mes, simplemente eliges tu plan para mantener tu cuenta activa.</p>
      </div>
      <div style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Puedo cancelar o cambiar de plan en cualquier momento?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Sí. Puedes cambiar entre el Plan Base ($10/mo) y el Plan Pro ($19/mo) o cancelar tu suscripción con un solo clic en cualquier momento.</p>
      </div>
      <div style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Aceptan tarjetas de cualquier país y Pago Móvil en Venezuela?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Sí, procesamos tarjetas internacionales Visa/Mastercard vía Stripe y también aceptamos Pago Móvil Bancamiga (a Tasa BCV), Zelle y Binance Pay USDT.</p>
      </div>
    </div>
  </div>

</div>
