<style>
  @media (max-width: 768px) {
    .sub-mobile-container {
      padding: 12px 6px !important;
    }
    .sub-mobile-header h1 {
      font-size: 1.6rem !important;
    }
    .sub-mobile-header p {
      font-size: 0.9rem !important;
    }
    .sub-mobile-grid {
      grid-template-columns: 1fr !important;
    }
    .sub-mobile-card {
      padding: 20px 16px !important;
      border-radius: 18px !important;
    }
    .sub-mobile-btn {
      width: 100% !important;
      font-size: 0.9rem !important;
      padding: 14px !important;
    }
    .sub-mobile-flex {
      flex-direction: column !important;
      align-items: stretch !important;
    }
  }
</style>

<div class="sub-mobile-container" style="max-width: 1100px; margin: 0 auto; padding: 20px 10px; font-family: 'Inter', sans-serif;">

  <%# --- BANNER SUPERADMIN: UNIFICACIÓN CON PAGOS MANUALES --- %>
  <% if current_user.superadmin? %>
    <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: white; border-radius: 18px; padding: 18px 24px; margin-bottom: 25px; border: 1px solid #6366f1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px; box-shadow: 0 8px 25px rgba(49,46,129,0.25);">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 1.6rem;">👑</span>
        <div>
          <h3 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #fef08a;">Acceso Superadmin: Verificación de Pagos Manuales</h3>
          <p style="margin: 3px 0 0 0; color: #cbd5e1; font-size: 0.85rem;">Revisa y aprueba reportes de Pago Móvil Bancamiga, Zelle o Binance en 1 clic.</p>
        </div>
      </div>
      <%= link_to superadmin_subscription_payments_path, class: "sub-mobile-btn", style: "background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 800; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(16,185,129,0.3);" do %>
        <span>⚡ Ir al Panel de Pagos Manuales</span>
      <% end %>
    </div>
  <% end %>

  <!-- Encabezado Principal -->
  <div class="sub-mobile-header" style="text-align: center; max-width: 800px; margin: 0 auto 30px auto;">
    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 50px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); color: #6366f1; font-size: 0.85rem; font-weight: 700; margin-bottom: 12px;">
      <span>🚀</span> <span>Plataforma SaaS Global para Gestión de Eventos & Agrupaciones</span>
    </div>
    <h1 style="font-size: 2.2rem; font-weight: 800; color: #0f172a; margin: 0 0 10px 0; letter-spacing: -0.5px;">
      Suscripción SaaS & Planes de GigManager
    </h1>
    <p style="font-size: 1rem; color: #64748b; margin: 0; line-height: 1.55;">
      Gestiona tu suscripción mensual, consulta las cuentas de pago oficial y personaliza las herramientas activas de <strong><%= @company.name %></strong>.
    </p>
  </div>

  <!-- 1. Banner de Estado de la Prueba / Suscripción -->
  <div style="margin-bottom: 25px;">
    <% if @company.subscription_paid_and_active? %>
      <div class="sub-mobile-card sub-mobile-flex" style="padding: 20px 24px; border-radius: 18px; background: #ecfdf5; border: 1.5px solid #6ee7b7; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 48px; height: 48px; border-radius: 14px; background: #10b981; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; flex-shrink: 0;">
            ✓
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 3px; flex-wrap: wrap;">
              <span style="padding: 2px 8px; border-radius: 6px; font-size: 0.72rem; font-weight: 800; background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0;">
                ✓ SUSCRIPCIÓN PAGADA & ACTIVA
              </span>
              <span style="font-size: 0.78rem; color: #047857; font-weight: 700;">
                Válida hasta: <%= l(@company.trial_ends_at.to_date, format: :long) rescue @company.trial_ends_at.strftime('%d/%m/%Y') %> (<%= @company.days_left_in_subscription %> días restantes)
              </span>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: #065f46; margin: 0;">
              <%= @company.plan_tier_name %> • <%= @company.enabled_module_keys.count %> Módulos Habilitados
            </h3>
            <p style="color: #047857; font-size: 0.84rem; margin: 3px 0 0 0;">
              Tu empresa está al día con sus mensualidades. Si añades un nuevo módulo a tu plan, solo abonas la cuota del módulo adicional.
            </p>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
          <a href="#gigmanager-modules-section" class="sub-mobile-btn" style="text-decoration: none; padding: 10px 16px; border-radius: 11px; background: #059669; color: white; font-weight: 800; font-size: 0.84rem; display: inline-flex; align-items: center; gap: 5px; box-shadow: 0 3px 12px rgba(5,150,105,0.25);">
            <span>➕</span> Añadir Módulos Extra
          </a>
          <a href="#reportar-pago" class="sub-mobile-btn" style="text-decoration: none; padding: 10px 16px; border-radius: 11px; background: #ffffff; color: #065f46; border: 1px solid #a7f3d0; font-weight: 800; font-size: 0.84rem; display: inline-flex; align-items: center; gap: 5px;">
            <span>🔄</span> Renovar Ciclo
          </a>
        </div>
      </div>

    <% elsif @trial_active %>
      <div class="sub-mobile-card sub-mobile-flex" style="padding: 22px 26px; border-radius: 18px; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border: 1.5px solid #4338ca; color: white; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; box-shadow: 0 10px 30px rgba(15,23,42,0.15);">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="min-width: 50px; height: 50px; border-radius: 14px; background: rgba(99, 102, 241, 0.25); border: 1px solid rgba(165, 180, 252, 0.4); color: #a5b4fc; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; flex-shrink: 0;">
            <%= @trial_days_left %>
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 3px; flex-wrap: wrap;">
              <span style="padding: 2px 8px; border-radius: 6px; font-size: 0.72rem; font-weight: 800; background: rgba(99, 102, 241, 0.3); color: #c7d2fe; border: 1px solid rgba(165, 180, 252, 0.4);">PRUEBA GRATUITA ACTIVA</span>
              <span style="font-size: 0.78rem; color: #94a3b8;">Vence el <%= l(@company.trial_ends_at.to_date, format: :long) rescue @company.trial_ends_at.strftime('%d/%m/%Y') %></span>
            </div>
            <h3 style="font-size: 1.2rem; font-weight: 800; color: white; margin: 0;">Te quedan <span style="color: #818cf8;"><%= @trial_days_left %> días</span> de prueba sin tarjeta</h3>
            <p style="color: #cbd5e1; font-size: 0.86rem; margin: 3px 0 0 0;">
              Tu cuota calculada es de <strong style="color: #38bdf8;">$<%= '%.2f' % @pricing_breakdown[:total_price] %> USD/mes</strong>. Puedes reportar tu primer pago para activar tu plan.
            </p>
          </div>
        </div>
        <div>
          <a href="#reportar-pago" class="sub-mobile-btn" style="text-decoration: none; padding: 11px 20px; border-radius: 11px; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white; font-weight: 800; font-size: 0.86rem; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 14px rgba(99,102,241,0.35);">
            <span>💳</span> Reportar Primer Pago
          </a>
        </div>
      </div>

    <% else %>
      <div class="sub-mobile-card sub-mobile-flex" style="padding: 20px 24px; border-radius: 18px; background: #fffbebfb; border: 1.5px solid #fcd34d; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 48px; height: 48px; border-radius: 14px; background: #f59e0b; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0;">
            ⚠️
          </div>
          <div>
            <span style="padding: 2px 8px; border-radius: 6px; font-size: 0.72rem; font-weight: 800; background: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
              PAGO PENDIENTE / VENCIDO
            </span>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: #78350f; margin: 3px 0 0 0;">Tu ciclo venció el <%= l(@company.trial_ends_at.to_date, format: :long) rescue @company.trial_ends_at.strftime('%d/%m/%Y') %></h3>
            <p style="color: #92400e; font-size: 0.86rem; margin: 2px 0 0 0;">Reporta tu pago mensual completo para reactivar el acceso completo para todos los integrantes.</p>
          </div>
        </div>
        <div>
          <a href="#reportar-pago" class="sub-mobile-btn" style="text-decoration: none; padding: 11px 20px; border-radius: 11px; background: #d97706; color: white; font-weight: 800; font-size: 0.86rem; display: inline-flex; align-items: center; gap: 6px;">
            <span>⚡</span> Reportar Pago Mensual
          </a>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 2. SECCIÓN SUPERIOR: MÉTODOS DE PAGO DISPONIBLES & FORMULARIO DE REPORTE -->
  <div id="reportar-pago" class="sub-mobile-card" style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 35px;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; flex-wrap: wrap; gap: 12px;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 2rem;">💳</span>
        <div>
          <h2 style="font-size: 1.35rem; font-weight: 800; color: #0f172a; margin: 0;">Métodos de Pago & Reporte Rápido</h2>
          <p style="color: #64748b; font-size: 0.88rem; margin: 3px 0 0 0;">Realiza tu transferencia o pago móvil y adjunta tu número de referencia para activación inmediata.</p>
        </div>
      </div>
      <span style="font-size: 0.82rem; font-weight: 800; color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 6px 14px; border-radius: 20px;">
        Cuota Calculada: $<%= '%.2f' % @pricing_breakdown[:total_price] %> USD/mes
      </span>
    </div>

    <!-- Cuentas bancarias de pago oficial -->
    <div class="sub-mobile-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px; margin-bottom: 25px;">
      <div style="padding: 16px; border-radius: 16px; background: #f8fafc; border: 1px solid #e2e8f0;">
        <div style="font-weight: 800; color: #059669; font-size: 0.9rem; margin-bottom: 6px;">🇺🇸 Zelle (USD)</div>
        <div style="font-size: 0.82rem; color: #334155;">Correo: <strong style="color: #0f172a; user-select: all;">pagos@gigmanager.app</strong></div>
        <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">Titular: Gig Manager Corp</div>
      </div>
      <div style="padding: 16px; border-radius: 16px; background: #f8fafc; border: 1px solid #e2e8f0;">
        <div style="font-weight: 800; color: #d97706; font-size: 0.9rem; margin-bottom: 6px;">🔶 Binance Pay (USDT)</div>
        <div style="font-size: 0.82rem; color: #334155;">Pay ID: <strong style="color: #0f172a; user-select: all;">889977665</strong></div>
        <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">Red: TRC20 / BEP20</div>
      </div>
      <div style="padding: 16px; border-radius: 16px; background: #f0f9ff; border: 1px solid #bae6fd;">
        <div style="font-weight: 800; color: #0284c7; font-size: 0.9rem; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;">
          <span>🇻🇪 Pago Móvil Bancamiga</span>
          <span style="font-size: 0.72rem; background: #0284c7; color: white; padding: 2px 6px; border-radius: 4px; font-weight: 800;">TASA BCV</span>
        </div>
        <div style="font-size: 0.82rem; color: #334155;">Banco: <strong style="color: #0f172a;">Bancamiga (0172)</strong></div>
        <div style="font-size: 0.82rem; color: #334155;">C.I.: <strong style="color: #0f172a; user-select: all;">V-33115864</strong></div>
        <div style="font-size: 0.82rem; color: #334155;">Teléfono: <strong style="color: #0f172a; user-select: all;">0424-6208725</strong></div>
      </div>
    </div>

    <!-- Pagos Pendientes Reportados por la Empresa -->
    <% if @pending_payments.present? %>
      <div style="margin-bottom: 25px; padding: 18px; border-radius: 16px; background: #fffbebfb; border: 1px solid #fcd34d;">
        <h4 style="font-weight: 800; color: #92400e; font-size: 0.9rem; margin: 0 0 10px 0;">⏳ Pagos en Proceso de Verificación (<%= @pending_payments.count %>)</h4>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <% @pending_payments.each do |p| %>
            <% pkg_info = AppModule.package_info(p.plan_tier) %>
            <div style="font-size: 0.82rem; color: #1e293b; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; background: white; padding: 10px 14px; border-radius: 10px; border: 1px solid #fef3c7;">
              <span><%= pkg_info ? pkg_info[:icon] : '💎' %> <strong><%= pkg_info ? pkg_info[:name] : p.plan_tier.to_s.titleize %></strong> ($<%= '%.2f' % p.amount %> USD) via <%= p.payment_method_label %></span>
              <span style="font-family: monospace; color: #0284c7; font-weight: 700;">Ref: #<%= p.reference_number %></span>
              <span style="padding: 3px 8px; border-radius: 6px; background: #fef3c7; color: #92400e; font-size: 0.72rem; font-weight: 800;">EN REVISIÓN</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Formulario para Reportar Pago -->
    <div style="padding: 22px; border-radius: 18px; background: #f8fafc; border: 1px solid #e2e8f0;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
        <h3 style="font-size: 1.05rem; font-weight: 800; color: #0f172a; margin: 0;">Formulario de Reporte de Pago</h3>
        <span style="font-size: 0.75rem; color: #64748b;">💡 Se pre-rellena automáticamente desde la calculadora</span>
      </div>
      <%= form_with url: report_payment_subscriptions_path, method: :post, local: true, style: "display: flex; flex-direction: column; gap: 15px;" do |f| %>
        <div class="sub-mobile-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Paquete Base</label>
            <%= select_tag :plan_tier, options_for_select(
              AppModule.packages.map { |pkg| ["#{pkg[:icon]} #{pkg[:name]} ($#{'%.0f' % pkg[:price]} USD)", pkg[:key]] },
              @company.effective_plan_tier
            ), id: "subscription_plan_tier_select", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Monto a Pagar ($ USD)</label>
            <%= number_field_tag :amount, @pricing_breakdown[:total_price], step: "0.01", id: "subscription_amount_input", placeholder: "15.00", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Método de Pago</label>
            <%= select_tag :payment_method, options_for_select([["Pago Móvil (Tasa BCV)", "pago_movil"], ["Zelle (USD)", "zelle"], ["Binance Pay (USDT)", "binance"], ["Transferencia Bancaria", "transferencia"]]), style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Número de Referencia</label>
            <%= text_field_tag :reference_number, nil, required: true, placeholder: "Ej. 09841235", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
        </div>
        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Notas adicionales (opcional)</label>
          <%= text_field_tag :notes, nil, placeholder: "Titular de la cuenta, banco emisor, detalle de módulos, etc.", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
        </div>
        <div style="padding-top: 5px;">
          <%= f.submit "Reportar Pago para Verificación 🚀", class: "sub-mobile-btn", style: "width: 100%; padding: 14px; border-radius: 12px; background: #2563eb; color: white; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(37,99,235,0.3);" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 3. SECCIÓN UNIFICADA: PLANES BASE & CONFIGURACIÓN DE MÓDULOS -->
  <div id="gigmanager-modules-section">
    <%= render 'subscriptions/pricing_calculator' %>
  </div>

  <!-- 4. FAQ de Cobros -->
  <div style="max-width: 800px; margin: 0 auto; padding-top: 30px; border-top: 1px solid #e2e8f0;">
    <h3 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; text-align: center; margin: 0 0 25px 0;">Preguntas Frecuentes de Suscripción</h3>
    <div style="display: flex; flex-direction: column; gap: 15px;">
      <div class="sub-mobile-card" style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Cómo funciona la prueba gratuita de 30 días?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Disfrutas de acceso total a Gig Manager durante 30 días sin ingresar ninguna tarjeta de crédito. Al finalizar el mes, simplemente eliges tu paquete para mantener tu cuenta activa.</p>
      </div>
      <div class="sub-mobile-card" style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Puedo cambiar de paquete o módulos en cualquier momento?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Sí. Puedes cambiar de paquete o ajustar los módulos activos de tu agrupación directamente desde esta pantalla pulsando <strong>"Guardar Módulos en mi Empresa"</strong>.</p>
      </div>
      <div class="sub-mobile-card" style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Cómo reporto el pago si solo agregué 1 módulo adicional (+ $3 USD)?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Al marcar el módulo adicional en la calculadora, haz clic en el botón <strong>"➕ Pagar Solo Diferencia (+$3.00 USD)"</strong>. El formulario se autocompletará con el monto de $3.00 USD para que no tengas que pagar la mensualidad base dos veces.</p>
      </div>
    </div>
  </div>

</div>
