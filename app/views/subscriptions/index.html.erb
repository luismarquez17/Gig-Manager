<style>
  @media (max-width: 768px) {
    .sub-mobile-container {
      padding: 12px 6px !important;
    }
    .sub-mobile-header h1 {
      font-size: 1.6rem !important;
    }
    .sub-mobile-header p {
      font-size: 0.9rem !important;
    }
    .sub-mobile-grid {
      grid-template-columns: 1fr !important;
    }
    .sub-mobile-card {
      padding: 20px 16px !important;
      border-radius: 18px !important;
    }
    .sub-mobile-btn {
      width: 100% !important;
      font-size: 0.9rem !important;
      padding: 14px !important;
    }
    .sub-mobile-flex {
      flex-direction: column !important;
      align-items: stretch !important;
    }
  }
</style>

<div class="sub-mobile-container" style="max-width: 1100px; margin: 0 auto; padding: 20px 10px; font-family: 'Inter', sans-serif;">

  <%# --- BANNER SUPERADMIN: UNIFICACIÓN CON PAGOS MANUALES --- %>
  <% if current_user.superadmin? %>
    <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: white; border-radius: 18px; padding: 18px 24px; margin-bottom: 25px; border: 1px solid #6366f1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px; box-shadow: 0 8px 25px rgba(49,46,129,0.25);">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 1.6rem;">👑</span>
        <div>
          <h3 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #fef08a;">Acceso Superadmin: Verificación de Pagos Manuales</h3>
          <p style="margin: 3px 0 0 0; color: #cbd5e1; font-size: 0.85rem;">Revisa y aprueba reportes de Pago Móvil Bancamiga, Zelle o Binance en 1 clic.</p>
        </div>
      </div>
      <%= link_to superadmin_subscription_payments_path, class: "sub-mobile-btn", style: "background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 800; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(16,185,129,0.3);" do %>
        <span>⚡ Ir al Panel de Pagos Manuales</span>
      <% end %>
    </div>
  <% end %>

  <!-- Encabezado Principal -->
  <div class="sub-mobile-header" style="text-align: center; max-width: 800px; margin: 0 auto 35px auto;">
    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 50px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); color: #6366f1; font-size: 0.85rem; font-weight: 700; margin-bottom: 15px;">
      <span>🚀</span> <span>Plataforma SaaS Global para Gestión de Eventos</span>
    </div>
    <h1 style="font-size: 2.3rem; font-weight: 800; color: #0f172a; margin: 0 0 12px 0; letter-spacing: -0.5px;">
      Evoluciona tu Agrupación con Gig Manager
    </h1>
    <p style="font-size: 1.05rem; color: #64748b; margin: 0; line-height: 1.6;">
      Gestión profesional de eventos, contratos digitales, portal de clientes, nómina de músicos y control financiero en una sola plataforma.
    </p>
  </div>

  <!-- Banner de Estado de la Prueba / Suscripción -->
  <div style="margin-bottom: 35px;">
    <% if @company.active_subscription? %>
      <div class="sub-mobile-card sub-mobile-flex" style="padding: 22px 28px; border-radius: 20px; background: #ecfdf5; border: 1px solid #a7f3d0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 50px; height: 50px; border-radius: 14px; background: #10b981; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 900; flex-shrink: 0;">
            ✓
          </div>
          <div>
            <h3 style="font-size: 1.2rem; font-weight: 800; color: #065f46; margin: 0;">Suscripción Activa (<%= @company.plan_tier_name %>)</h3>
            <p style="color: #047857; font-size: 0.9rem; margin: 4px 0 0 0;">Tu empresa <strong style="color: #064e3b;"><%= @company.name %></strong> tiene acceso total e ilimitado a todas las herramientas activas.</p>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <a href="#reportar-pago" class="sub-mobile-btn" style="text-decoration: none; padding: 12px 20px; border-radius: 12px; background: #059669; color: white; font-weight: 800; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 14px rgba(5,150,105,0.3);">
            <span>🔄</span> Renovar o Cambiar Plan
          </a>
        </div>
      </div>

    <% elsif @trial_active %>
      <div class="sub-mobile-card sub-mobile-flex" style="padding: 24px 28px; border-radius: 20px; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border: 1px solid #4338ca; color: white; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; box-shadow: 0 10px 30px rgba(15,23,42,0.15);">
        <div style="display: flex; align-items: center; gap: 18px;">
          <div style="min-width: 54px; height: 54px; border-radius: 16px; background: rgba(99, 102, 241, 0.25); border: 1px solid rgba(165, 180, 252, 0.4); color: #a5b4fc; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 900; flex-shrink: 0;">
            <%= @trial_days_left %>
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">
              <span style="padding: 3px 10px; border-radius: 6px; font-size: 0.72rem; font-weight: 800; background: rgba(99, 102, 241, 0.3); color: #c7d2fe; border: 1px solid rgba(165, 180, 252, 0.4);">PRUEBA GRATUITA ACTIVA</span>
              <span style="font-size: 0.78rem; color: #94a3b8;">30 Días de Prueba Sin Tarjeta</span>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 800; color: white; margin: 0;">Te quedan <span style="color: #818cf8;"><%= @trial_days_left %> días</span> de prueba gratuita</h3>
            <p style="color: #cbd5e1; font-size: 0.88rem; margin: 4px 0 0 0;">Disfruta de la app completa. Puedes activar tu paquete en cualquier momento para mantener el acceso ininterrumpido.</p>
          </div>
        </div>
      </div>

    <% else %>
      <div class="sub-mobile-card sub-mobile-flex" style="padding: 22px 28px; border-radius: 20px; background: #fffbebfb; border: 1px solid #fcd34d; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 50px; height: 50px; border-radius: 14px; background: #f59e0b; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
            ⚠️
          </div>
          <div>
            <h3 style="font-size: 1.2rem; font-weight: 800; color: #78350f; margin: 0;">Tu prueba gratuita de 30 días ha finalizado</h3>
            <p style="color: #92400e; font-size: 0.9rem; margin: 4px 0 0 0;">Selecciona un paquete a continuación para desbloquear tu panel y continuar gestionando tus eventos.</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Panel de Módulos Activos de la Empresa -->
  <div class="sub-mobile-card" style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 35px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>🧩</span> Módulos Habilitados en <%= @company.name %>
        </h2>
        <p style="color: #64748b; font-size: 0.88rem; margin: 4px 0 0 0;">
          Estos son los módulos activos para tu agrupación. Puedes personalizar las herramientas de tu menú en cualquier momento.
        </p>
      </div>
      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <%= link_to company_modules_path, style: "font-size: 0.82rem; font-weight: 800; color: #4338ca; text-decoration: none; padding: 6px 14px; border-radius: 20px; background: #e0e7ff; display: inline-flex; align-items: center; gap: 5px;" do %>
          <span>⚙️</span> Personalizar Menú
        <% end %>
        <span style="padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 800; background: #f1f5f9; color: #334155;">
          <%= @company.enabled_module_keys.count %> de <%= AppModule.all.count %> Módulos
        </span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
      <% AppModule.all.each do |mod| %>
        <% is_on = @company.module_enabled?(mod[:key]) %>
        <div style="background: <%= is_on ? '#f8fafc' : '#f1f5f9' %>; border: 1px solid <%= is_on ? '#cbd5e1' : '#e2e8f0' %>; border-radius: 14px; padding: 16px; display: flex; align-items: flex-start; gap: 12px; opacity: <%= is_on ? '1' : '0.6' %>;">
          <span style="font-size: 1.5rem; line-height: 1;"><%= mod[:icon] %></span>
          <div style="flex: 1;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <strong style="color: #0f172a; font-size: 0.92rem;"><%= mod[:name] %></strong>
              <% if is_on %>
                <span style="font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 20px; background: #dcfce7; color: #15803d;">
                  ✓ Activo
                </span>
              <% else %>
                <span style="font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 20px; background: #fee2e2; color: #b91c1c;">
                  ✕ Inactivo
                </span>
              <% end %>
            </div>
            <p style="margin: 0; font-size: 0.8rem; color: #64748b; line-height: 1.35;"><%= mod[:description] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Encabezado de la Grilla de Paquetes -->
  <div style="text-align: center; max-width: 700px; margin: 0 auto 30px auto;">
    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 14px; border-radius: 50px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); color: #6366f1; font-size: 0.82rem; font-weight: 800; text-transform: uppercase; margin-bottom: 10px;">
      <span>💎</span> Paquetes Pre-Diseñados con Descuento
    </div>
    <h2 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin: 0 0 8px 0; letter-spacing: -0.5px;">
      Elige el Paquete a tu Medida
    </h2>
    <p style="color: #64748b; font-size: 0.95rem; margin: 0; line-height: 1.5;">
      Ahorra contratando un paquete pre-diseñado para tu sector con todos los módulos y herramientas que necesitas.
    </p>
  </div>

  <!-- Grilla de Paquetes Oficiales -->
  <div class="sub-mobile-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 45px;">
    <% AppModule.packages.each do |pkg| %>
      <% is_featured = pkg[:featured] == true %>
      <% is_current_plan = @company.plan_tier == pkg[:key] && @company.active_subscription? %>

      <div class="sub-mobile-card" style="<%= is_featured ? 'background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border: 2px solid #6366f1; color: white; box-shadow: 0 15px 40px rgba(99,102,241,0.25);' : 'background: white; border: 1.5px solid #cbd5e1; color: #0f172a; box-shadow: 0 10px 30px rgba(0,0,0,0.04);' %> border-radius: 24px; padding: 30px; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
        
        <% if pkg[:badge].present? %>
          <div style="position: absolute; top: -13px; right: 20px; padding: 4px 12px; border-radius: 20px; <%= is_featured ? 'background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white; box-shadow: 0 4px 10px rgba(99,102,241,0.4);' : 'background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe;' %> font-size: 0.72rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em;">
            <%= pkg[:badge] %>
          </div>
        <% end %>

        <div>
          <!-- Icono y Nombre -->
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <div style="width: 48px; height: 48px; border-radius: 14px; <%= is_featured ? 'background: rgba(99,102,241,0.25); border: 1px solid rgba(165,180,252,0.4);' : 'background: #f1f5f9; border: 1px solid #e2e8f0;' %> display: flex; align-items: center; justify-content: center; font-size: 1.7rem; flex-shrink: 0;">
              <%= pkg[:icon] %>
            </div>
            <div>
              <h3 style="font-size: 1.28rem; font-weight: 800; margin: 0; <%= is_featured ? 'color: white;' : 'color: #0f172a;' %>">
                <%= pkg[:name] %>
              </h3>
              <% if pkg[:savings].present? %>
                <span style="font-size: 0.74rem; font-weight: 800; <%= is_featured ? 'color: #a5b4fc;' : 'color: #059669;' %>">
                  ⚡ Ahorras <%= pkg[:savings] %>
                </span>
              <% end %>
            </div>
          </div>

          <p style="font-size: 0.86rem; margin: 0 0 18px 0; line-height: 1.45; <%= is_featured ? 'color: #cbd5e1;' : 'color: #64748b;' %>">
            <%= pkg[:description] %>
          </p>

          <!-- Precio -->
          <div style="margin-bottom: 22px; display: flex; align-items: baseline; gap: 6px;">
            <span style="font-size: 2.5rem; font-weight: 900; <%= is_featured ? 'color: white;' : 'color: #0f172a;' %>">
              $<%= '%.0f' % pkg[:price] %>
            </span>
            <span style="font-weight: 700; font-size: 0.9rem; <%= is_featured ? 'color: #cbd5e1;' : 'color: #64748b;' %>">
              USD / mes
            </span>
          </div>

          <!-- Lista de Módulos -->
          <div style="margin-bottom: 25px;">
            <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; <%= is_featured ? 'color: #a5b4fc;' : 'color: #64748b;' %>">
              Módulos Incluidos (<%= pkg[:modules].count %>):
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.86rem;">
              <% pkg[:modules].each do |mod_key| %>
                <% mod_obj = AppModule.find(mod_key) %>
                <% next unless mod_obj %>
                <li style="display: flex; align-items: center; gap: 9px;">
                  <span style="font-size: 1rem;"><%= mod_obj[:icon] %></span>
                  <span style="<%= is_featured ? 'color: #f8fafc;' : 'color: #334155;' %> font-weight: 600;">
                    <%= mod_obj[:name] %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <!-- Botón de Acción -->
        <div>
          <% if is_current_plan %>
            <div style="width: 100%; text-align: center; box-sizing: border-box; padding: 14px; border-radius: 12px; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; font-weight: 800; font-size: 0.9rem;">
              ✓ Tu Paquete Actual
            </div>
          <% else %>
            <a href="#reportar-pago" onclick="selectPlanTier('<%= pkg[:key] %>')" class="sub-mobile-btn" style="display: block; width: 100%; text-align: center; box-sizing: border-box; text-decoration: none; padding: 15px; border-radius: 12px; <%= is_featured ? 'background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white; box-shadow: 0 6px 20px rgba(99,102,241,0.4);' : 'background: #0f172a; color: white; box-shadow: 0 4px 15px rgba(15,23,42,0.2);' %> font-weight: 800; font-size: 0.92rem; transition: transform 0.15s;">
              Elegir este Paquete ($<%= '%.0f' % pkg[:price] %>/mes) 🚀
            </a>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>

  <!-- Sección Especial: Métodos de Pago Disponibles (Zelle, Binance, Pago Móvil, Transferencia) -->
  <div id="reportar-pago" class="sub-mobile-card" style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 32px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 45px;">
    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 25px; flex-wrap: wrap;">
      <span style="font-size: 2.2rem;">💳</span>
      <div>
        <h2 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin: 0;">Métodos de Pago Disponibles</h2>
        <p style="color: #64748b; font-size: 0.9rem; margin: 4px 0 0 0;">Paga fácilmente por Pago Móvil Bancamiga (Tasa BCV), Zelle, Binance Pay USDT o Transferencia Bancaria.</p>
      </div>
    </div>

    <!-- Pestañas / Datos bancarios de ejemplo configurables -->
    <div class="sub-mobile-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px; margin-bottom: 25px;">
      <div style="padding: 16px; border-radius: 16px; background: #f8fafc; border: 1px solid #e2e8f0;">
        <div style="font-weight: 800; color: #059669; font-size: 0.9rem; margin-bottom: 6px;">🇺🇸 Zelle (USD)</div>
        <div style="font-size: 0.82rem; color: #334155;">Correo: <strong style="color: #0f172a; user-select: all;">pagos@gigmanager.app</strong></div>
        <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">Titular: Gig Manager Corp</div>
      </div>
      <div style="padding: 16px; border-radius: 16px; background: #f8fafc; border: 1px solid #e2e8f0;">
        <div style="font-weight: 800; color: #d97706; font-size: 0.9rem; margin-bottom: 6px;">🔶 Binance Pay (USDT)</div>
        <div style="font-size: 0.82rem; color: #334155;">Pay ID: <strong style="color: #0f172a; user-select: all;">889977665</strong></div>
        <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">Red: TRC20 / BEP20</div>
      </div>
      <div style="padding: 16px; border-radius: 16px; background: #f0f9ff; border: 1px solid #bae6fd;">
        <div style="font-weight: 800; color: #0284c7; font-size: 0.9rem; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;">
          <span>🇻🇪 Pago Móvil Bancamiga</span>
          <span style="font-size: 0.72rem; background: #0284c7; color: white; padding: 2px 6px; border-radius: 4px; font-weight: 800;">TASA BCV</span>
        </div>
        <div style="font-size: 0.82rem; color: #334155;">Banco: <strong style="color: #0f172a;">Bancamiga (0172)</strong></div>
        <div style="font-size: 0.82rem; color: #334155;">C.I.: <strong style="color: #0f172a; user-select: all;">V-33115864</strong></div>
        <div style="font-size: 0.82rem; color: #334155;">Teléfono: <strong style="color: #0f172a; user-select: all;">0424-6208725</strong></div>
      </div>
    </div>

    <!-- Pagos Pendientes Reportados por la Empresa -->
    <% if @pending_payments.present? %>
      <div style="margin-bottom: 25px; padding: 18px; border-radius: 16px; background: #fffbebfb; border: 1px solid #fcd34d;">
        <h4 style="font-weight: 800; color: #92400e; font-size: 0.9rem; margin: 0 0 10px 0;">⏳ Pagos en Proceso de Verificación (<%= @pending_payments.count %>)</h4>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <% @pending_payments.each do |p| %>
            <% pkg_info = AppModule.package_info(p.plan_tier) %>
            <div style="font-size: 0.82rem; color: #1e293b; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; background: white; padding: 10px 14px; border-radius: 10px; border: 1px solid #fef3c7;">
              <span><%= pkg_info ? pkg_info[:icon] : '💎' %> <strong><%= pkg_info ? pkg_info[:name] : p.plan_tier.to_s.titleize %></strong> ($<%= '%.2f' % p.amount %>) via <%= p.payment_method_label %></span>
              <span style="font-family: monospace; color: #0284c7; font-weight: 700;">Ref: #<%= p.reference_number %></span>
              <span style="padding: 3px 8px; border-radius: 6px; background: #fef3c7; color: #92400e; font-size: 0.72rem; font-weight: 800;">REVISANDO</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Formulario para Reportar Pago -->
    <div style="padding: 24px; border-radius: 18px; background: #f8fafc; border: 1px solid #e2e8f0;">
      <h3 style="font-size: 1.1rem; font-weight: 800; color: #0f172a; margin: 0 0 16px 0;">Reportar Pago Realizado</h3>
      <%= form_with url: report_payment_subscriptions_path, method: :post, local: true, style: "display: flex; flex-direction: column; gap: 15px;" do |f| %>
        <div class="sub-mobile-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Paquete o Plan a Activar</label>
            <%= select_tag :plan_tier, options_for_select(
              AppModule.packages.map { |pkg| ["#{pkg[:icon]} #{pkg[:name]} ($#{'%.0f' % pkg[:price]} USD / mes)", pkg[:key]] },
              @company.plan_tier.presence || "banda"
            ), id: "subscription_plan_tier_select", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Método de Pago</label>
            <%= select_tag :payment_method, options_for_select([["Pago Móvil (Tasa BCV)", "pago_movil"], ["Zelle (USD)", "zelle"], ["Binance Pay (USDT)", "binance"], ["Transferencia Bancaria", "transferencia"]]), style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Número de Referencia</label>
            <%= text_field_tag :reference_number, nil, required: true, placeholder: "Ej. 09841235", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
          </div>
        </div>
        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 5px;">Notas adicionales (opcional)</label>
          <%= text_field_tag :notes, nil, placeholder: "Titular de la cuenta, banco emisor, etc.", style: "width: 100%; border-radius: 10px; background: white; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 12px; font-size: 0.88rem; outline: none;" %>
        </div>
        <div style="padding-top: 5px;">
          <%= f.submit "Reportar Pago para Verificación 🚀", class: "sub-mobile-btn", style: "width: 100%; padding: 14px; border-radius: 12px; background: #2563eb; color: white; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(37,99,235,0.3);" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- FAQ de Cobros -->
  <div style="max-width: 800px; margin: 0 auto; padding-top: 30px; border-top: 1px solid #e2e8f0;">
    <h3 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; text-align: center; margin: 0 0 25px 0;">Preguntas Frecuentes de Suscripción</h3>
    <div style="display: flex; flex-direction: column; gap: 15px;">
      <div class="sub-mobile-card" style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Cómo funciona la prueba gratuita de 30 días?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Disfrutas de acceso total a Gig Manager durante 30 días sin ingresar ninguna tarjeta de crédito. Al finalizar el mes, simplemente eliges tu paquete para mantener tu cuenta activa.</p>
      </div>
      <div class="sub-mobile-card" style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Puedo cambiar de paquete o módulos en cualquier momento?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Sí. Puedes cambiar de paquete o ajustar los módulos activos de tu agrupación en cualquier momento según las necesidades operativas de tus eventos.</p>
      </div>
      <div class="sub-mobile-card" style="padding: 20px; border-radius: 16px; background: white; border: 1px solid #e2e8f0;">
        <h4 style="font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">¿Cuáles son los métodos de pago aceptados?</h4>
        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Aceptamos Pago Móvil Bancamiga (a Tasa Oficial BCV), Zelle (USD), Binance Pay (USDT) y Transferencias Bancarias. Una vez efectuado el pago, repórtalo en el formulario para activar tu plan de inmediato.</p>
      </div>
    </div>
  </div>

</div>

<script>
  function selectPlanTier(tierKey) {
    var select = document.getElementById('subscription_plan_tier_select');
    if (select) {
      select.value = tierKey;
    }
    var target = document.getElementById('reportar-pago');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth' });
    }
  }
</script>
