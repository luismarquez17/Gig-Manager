<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; background-color: #030712; color: #f8fafc; border-radius: 16px; overflow: hidden; border: 1px solid #1e293b;">
  <!-- Header -->
  <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); padding: 36px 30px; text-align: center; border-bottom: 1px solid #334155;">
    <h1 style="margin: 0; font-size: 26px; font-weight: 900; color: #ffffff; letter-spacing: -0.5px;">
      Gig<span style="color: #38bdf8;">Manager</span>
    </h1>
    <p style="margin: 8px 0 0 0; color: #fef08a; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
      Aviso de Período de Prueba
    </p>
  </div>

  <!-- Body -->
  <div style="padding: 32px 30px; background-color: #0b1120;">
    <h2 style="font-size: 20px; font-weight: 800; color: #ffffff; margin-top: 0; margin-bottom: 16px;">
      Tu prueba gratuita vence pronto ⏳
    </h2>

    <p style="font-size: 15px; line-height: 1.6; color: #cbd5e1; margin-bottom: 24px;">
      Hola, <%= @user.display_name %>. Te recordamos que a tu cuenta de <strong style="color: #38bdf8;"><%= @company&.name %></strong> le quedan <strong><%= @days_left %> días</strong> de prueba gratuita.
    </p>

    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 12px; padding: 18px 20px; margin-bottom: 28px;">
      <div style="font-size: 14px; font-weight: 800; color: #fbbf24; margin-bottom: 4px;">
        ⚠️ MANTÉN TUS EVENTOS Y CONTRATOS ACTIVOS
      </div>
      <div style="font-size: 13px; color: #cbd5e1;">
        Activa tu plan ahora para asegurar el acceso ininterrumpido de tu agrupación, tus músicos y tus clientes.
      </div>
    </div>

    <!-- Action Button -->
    <div style="text-align: center; margin-bottom: 32px;">
      <a href="<%= @subscriptions_url %>" style="display: inline-block; background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: #ffffff; font-weight: 800; font-size: 15px; padding: 14px 28px; border-radius: 10px; text-decoration: none; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);">
        Elegir Plan de Suscripción →
      </a>
    </div>

    <div style="background: #030712; border: 1px solid #1e293b; border-radius: 12px; padding: 16px; font-size: 13px; color: #94a3b8; margin-bottom: 24px;">
      <strong>Métodos de Pago Disponibles:</strong> Pago Móvil Bancamiga (0424-6208725, Tasa BCV), Zelle, Binance Pay USDT y Tarjetas Internacionales.
    </div>

    <!-- Support Box -->
    <div style="border-top: 1px solid #1e293b; padding-top: 20px; font-size: 13px; color: #94a3b8; line-height: 1.5;">
      💬 <strong>¿Dudas o requerimientos especiales?</strong> Escríbenos por WhatsApp al 
      <a href="https://wa.me/584246208725" style="color: #25D366; font-weight: 700; text-decoration: none;">+58 424 6208725</a>.
    </div>
  </div>

  <!-- Footer -->
  <div style="background-color: #030712; padding: 20px 30px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #1e293b;">
    © <%= Time.current.year %> GigManager SaaS. Todos los derechos reservados.
  </div>
</div>
