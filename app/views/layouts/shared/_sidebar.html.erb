<%# --- SIDEBAR --- %>
<% if user_signed_in? %>
  <%
    is_gero_company ||= current_company.present? && (current_company.name.to_s.downcase.include?('gero') || current_company.slug.to_s.downcase.include?('gero'))
  %>
  <aside class="app-sidebar" id="app-sidebar">
    
    <%# Logo + nombre de empresa + botón cerrar (sólo visible en móvil) %>
    <div class="sidebar-brand">
      <%# Vista de Marca Estándar %>
      <div class="brand-default-view">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
          <h2 style="display: flex; align-items: center; margin: 0; min-width: 0; flex: 1 1 auto;">
            <img src="/icons/logo.svg" alt="GigManager" style="width: 38px; height: 38px; border-radius: 11px; margin-right: 10px; box-shadow: 0 4px 12px rgba(37,99,235,0.35); flex-shrink: 0;" />
            <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Gig Manager</span>
          </h2>
          <button class="sidebar-close-btn" aria-label="Cerrar menú">&times;</button>
        </div>
        <% if current_company.present? %>
          <div style="font-size: 0.78rem; color: #818cf8; font-weight: 600; margin-top: 6px; display: flex; align-items: center; gap: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            <span>🏢</span> <span><%= current_company.name %></span>
          </div>
        <% end %>
      </div>

      <%# Vista de Marca Co-Branded GERO VIP %>
      <div class="brand-gerovip-view">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px;">
          <div style="display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1 1 auto;">
            <div style="display: flex; align-items: center; gap: 4px; flex-shrink: 0; background: rgba(0,0,0,0.25); padding: 4px 6px; border-radius: 10px; border: 1px solid rgba(212,175,55,0.3);">
              <img src="/icons/logo.svg" alt="GigManager" style="width: 32px; height: 32px; border-radius: 8px; box-shadow: 0 4px 10px rgba(37,99,235,0.35); flex-shrink: 0;" />
              <span style="margin: 0 2px; font-weight: 900; color: #d4af37; font-size: 1.1rem; line-height: 1; flex-shrink: 0;">+</span>
              <img src="/icons/gerovip_logo.png" alt="Gero Producciones" style="width: 34px; height: 34px; object-fit: contain; flex-shrink: 0; filter: drop-shadow(0 2px 8px rgba(212,175,55,0.55));" />
            </div>
            <div style="min-width: 0; flex: 1 1 auto;">
              <div style="font-weight: 800; font-size: 1.02rem; color: #ffffff; line-height: 1.15; letter-spacing: -0.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                Gig Manager
              </div>
              <div style="font-weight: 800; font-size: 0.8rem; color: #ffd700; line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                + Gero Producciones
              </div>
            </div>
          </div>
          <button class="sidebar-close-btn" aria-label="Cerrar menú">&times;</button>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 6px;">
          <div style="display: inline-flex; align-items: center; gap: 4px; background: rgba(212, 175, 55, 0.18); border: 1px solid rgba(212, 175, 55, 0.4); padding: 3px 8px; border-radius: 6px; font-size: 0.68rem; color: #ffd700; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; flex-shrink: 0;">
            <span>👑</span> <span>Colaborador VIP</span>
          </div>
          <% if current_company.present? %>
            <div style="font-size: 0.72rem; color: #cbd5e1; font-weight: 600; opacity: 0.9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 125px; text-align: right;" title="<%= current_company.name %>">
              🏢 <%= current_company.name %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Navegación %>
    <nav class="sidebar-nav">
      <% if current_user.superadmin? %>
        <div style="background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 12px; padding: 10px; margin-bottom: 12px;">
          <div style="font-size: 0.75rem; font-weight: 800; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">👑 Superadmin</div>
          <%= link_to superadmin_dashboard_path, class: "sidebar-link #{'active' if controller_name == 'dashboard' && controller_path.start_with?('superadmin')}" do %>
            <span class="icon">📊</span> <span>Panel Universo</span>
          <% end %>
          <%= link_to superadmin_companies_path, class: "sidebar-link #{'active' if controller_name == 'companies' && controller_path.start_with?('superadmin')}" do %>
            <span class="icon">🏢</span> <span>Empresas</span>
          <% end %>
          <%= link_to superadmin_clients_path, class: "sidebar-link #{'active' if controller_name == 'clients' && controller_path.start_with?('superadmin')}" do %>
            <span class="icon">👥</span> <span>Clientes</span>
          <% end %>
          <%= link_to superadmin_subscription_payments_path, class: "sidebar-link #{'active' if controller_name == 'subscription_payments' && controller_path.start_with?('superadmin')}" do %>
            <span class="icon">💳</span> <span>Pagos Manuales</span>
            <% 
              pending_sub_count = SubscriptionPayment.pending.count rescue 0
            %>
            <% if pending_sub_count > 0 %>
              <span style="background: #ec4899; color: white; border-radius: 99px; font-size: 0.72em; padding: 2px 7px; font-weight: 800; margin-left: auto;">
                <%= pending_sub_count %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%= link_to root_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'dashboard'}" do %>
        <span class="icon">🏠</span> <span>Inicio (Dashboard)</span>
      <% end %>

      <% if current_user.leader? || current_user.staff? || current_user.musician? || current_user.superadmin? %>
        <%= link_to notifications_path, class: "sidebar-link #{'active' if controller_name == 'notifications'}" do %>
          <span class="icon">🔔</span> <span>Notificaciones</span>
          <%= render "notifications/unread_badge" %>
        <% end %>
      <% end %>

      <% if current_user.leader? || current_user.superadmin? %>

        <%# --- EVENTOS & SHOWS --- %>
        <% if module_enabled?(:gigs) %>
          <%= link_to gigs_path, class: "sidebar-link #{'active' if controller_name == 'gigs' && action_name != 'my'}" do %>
            <span class="icon"><%= venue_mode? ? '🏛️' : '🎸' %></span> <span><%= company_term(:gig_plural, 'Gigs / Eventos') %></span>
            <% 
              pending_upsells_count = current_company&.gig_upsell_requests&.pending&.count rescue 0 
            %>
            <% if pending_upsells_count.to_i > 0 %>
              <span style="background: #3b82f6; color: white; border-radius: 99px; font-size: 0.72em; padding: 2px 7px; font-weight: 800; margin-left: auto;">
                <%= pending_upsells_count %>
              </span>
            <% end %>
          <% end %>

          <%= link_to gig_payments_path, class: "sidebar-link #{'active' if controller_name == 'gig_payments'}" do %>
            <span class="icon">💳</span> <span>Pagos <%= venue_mode? ? 'de Eventos' : 'Eventos / Shows' %></span>
          <% end %>
        <% end %>

        <%# --- INVENTARIO & TALLER --- %>
        <% if module_enabled?(:inventory) %>
          <%= link_to items_path, class: "sidebar-link #{'active' if controller_name == 'items'}" do %>
            <span class="icon">📦</span> <span>Inventario</span>
          <% end %>

          <%= link_to kits_path, class: "sidebar-link #{'active' if controller_name == 'kits'}" do %>
            <span class="icon">🛠️</span> <span>Plantillas (Kits)</span>
          <% end %>

          <%= link_to maintenance_records_path, class: "sidebar-link #{'active' if controller_name == 'maintenance_records'}" do %>
            <span class="icon">🔧</span> <span>Taller (Reparos)</span>
          <% end %>

          <%= link_to availability_dashboard_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'availability'}" do %>
            <span class="icon">⚡</span> <span>Conflictos</span>
          <% end %>
        <% end %>

        <%# --- METAS DE REINVERSIÓN & LISTA DE COMPRAS --- %>
        <% if module_enabled?(:shopping_list) || current_user.leader? || current_user.superadmin? %>
          <%= link_to reinvestment_goals_path, class: "sidebar-link #{'active' if controller_name == 'reinvestment_goals'}" do %>
            <span class="icon">🎯</span> <span>Metas de Reinversión</span>
          <% end %>

          <%= link_to shopping_items_path, class: "sidebar-link #{'active' if controller_name == 'shopping_items'}" do %>
            <span class="icon">🛒</span> <span>Lista de Compras</span>
          <% end %>
        <% end %>

        <%# --- COMERCIAL / CLIENTES --- %>
        <% if module_enabled?(:clients_crm) %>
          <%= link_to clients_path, class: "sidebar-link #{'active' if controller_name == 'clients' && action_name == 'index'}" do %>
            <span class="icon">👥</span> <span>Clientes</span>
          <% end %>

          <%= link_to debts_clients_path, class: "sidebar-link #{'active' if controller_name == 'clients' && action_name == 'debts'}" do %>
            <span class="icon">💳</span> <span>Cuentas por Cobrar</span>
          <% end %>

          <%= link_to preset_budgets_path, class: "sidebar-link #{'active' if controller_name == 'preset_budgets'}" do %>
            <span class="icon">📄</span> <span><%= venue_mode? ? 'Combos & Paquetes' : 'Presupuestos Base' %></span>
          <% end %>

          <%= link_to client_quotes_path, class: "sidebar-link #{'active' if controller_name == 'client_quotes'}" do %>
            <span class="icon">📋</span> <span>Presupuestos Clientes</span>
          <% end %>

          <%= link_to payment_methods_settings_path, class: "sidebar-link #{'active' if controller_name == 'payment_methods'}" do %>
            <span class="icon">💳</span> <span>Métodos de Pago</span>
          <% end %>

          <%= link_to standard_upsells_path, class: "sidebar-link #{'active' if controller_name == 'standard_upsells'}" do %>
            <span class="icon">🚀</span> <span>Adicionales (Upsells)</span>
          <% end %>
        <% end %>

        <%# --- FINANZAS & CAJA --- %>
        <% if module_enabled?(:finances) %>
          <%= link_to cash_adjustments_path, class: "sidebar-link #{'active' if controller_name == 'cash_adjustments'}" do %>
            <span class="icon">🏦</span> <span>Caja General (Fondo)</span>
          <% end %>

          <%= link_to financials_dashboard_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'financials'}" do %>
            <span class="icon">📊</span> <span>Métricas / Finanzas</span>
          <% end %>

          <%= link_to investments_path, class: "sidebar-link #{'active' if controller_name == 'investments'}" do %>
            <span class="icon">💸</span> <span>Inversiones</span>
          <% end %>

          <%= link_to financial_audit_logs_path, class: "sidebar-link #{'active' if controller_name == 'financial_audit_logs'}" do %>
            <span class="icon">🛡️</span> <span>Auditoría Contable</span>
          <% end %>
        <% end %>

        <%# --- NÓMINA DE PERSONAL --- %>
        <% if module_enabled?(:payroll) %>
          <%= link_to employee_payments_path, class: "sidebar-link #{'active' if controller_name == 'employee_payments'}" do %>
            <span class="icon">💰</span> <span><%= venue_mode? ? 'Nómina / Pagos a personal' : 'Nómina de trabajadores' %></span>
            <% 
              pending_count = current_company&.employee_payments&.pending_approval&.count rescue 0 
            %>
            <% if pending_count.to_i > 0 %>
              <span style="background: #f59e0b; color: white; border-radius: 99px; font-size: 0.72em; padding: 2px 7px; font-weight: 800; margin-left: auto;">
                <%= pending_count %>
              </span>
            <% end %>
          <% end %>

          <%= link_to my_payments_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'my_payments'}" do %>
            <span class="icon">💵</span> <span><%= venue_mode? ? 'Mis Pagos / Cuentas por Evento' : 'Mis Pagos / Cuentas por Show' %></span>
          <% end %>
        <% end %>

        <%# --- ADMINISTRACIÓN & SUSCRIPCIÓN --- %>
        <%= link_to users_path, class: "sidebar-link #{'active' if controller_name == 'users'}" do %>
          <span class="icon">⚙️</span> <span>Roles / Accesos</span>
        <% end %>

        <% if current_company.present? %>
          <%# Botón Destacado: Añadir Funciones & Opciones %>
          <div style="margin: 12px 10px 14px 10px; padding: 12px; background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(6, 182, 212, 0.12) 100%); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 14px;">
            <div style="font-size: 0.72rem; font-weight: 800; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between;">
              <span>⚡ Planes & Módulos</span>
              <span style="font-size: 0.68rem; padding: 2px 6px; border-radius: 6px; background: rgba(99, 102, 241, 0.3); color: #e0e7ff;">
                <%= current_company.enabled_module_keys.count %>/<%= AppModule.all.count %>
              </span>
            </div>
            <div style="font-size: 0.75rem; color: #cbd5e1; margin-bottom: 8px; line-height: 1.3;">
              <%= venue_mode? ? 'Personaliza tu plan y añade más herramientas a tu empresa.' : 'Personaliza tu plan y añade más herramientas a tu banda.' %>
            </div>
            <%= link_to subscriptions_path(anchor: 'gigmanager-modules-section'), style: "display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 7px 10px; font-size: 0.78rem; font-weight: 800; border-radius: 8px; background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); color: white; text-decoration: none; box-shadow: 0 3px 10px rgba(6, 182, 212, 0.25); box-sizing: border-box;" do %>
              <span>➕</span> <span>Personalizar Módulos</span>
            <% end %>
          </div>

          <%= link_to subscriptions_path, class: "sidebar-link #{'active' if controller_name == 'subscriptions'}" do %>
            <span class="icon">💳</span> <span>Suscripción SaaS</span>
            <% if current_company.trial_active? %>
              <span style="background: rgba(139, 92, 246, 0.3); color: #c084fc; border: 1px solid rgba(139, 92, 246, 0.4); border-radius: 99px; font-size: 0.72em; padding: 2px 7px; font-weight: 800; margin-left: auto;">
                Trial <%= current_company.days_left_in_trial %>d
              </span>
            <% end %>
          <% end %>
        <% end %>

        <%= link_to normativas_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'normativas'}" do %>
          <span class="icon">📜</span> <span>Normativas</span>
        <% end %>
      <% elsif current_user.staff? %>
        <div class="nav-header"><%= venue_mode? ? 'Personal / Staff' : 'Agrupación' %></div>
        <%= link_to my_gigs_path, class: "sidebar-link #{'active' if controller_name == 'gigs' && action_name == 'my'}" do %>
          <span class="icon">🎫</span> <span>Mis eventos</span>
        <% end %>

        <%= link_to my_payments_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'my_payments'}" do %>
          <span class="icon">💵</span> <span>Mis Pagos</span>
        <% end %>

        <%= link_to edit_user_path(current_user), class: "sidebar-link #{'active' if controller_path == 'users' && action_name == 'edit'}" do %>
          <span class="icon">👤</span> <span>Mi Perfil</span>
        <% end %>

        <%= link_to help_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'help'}" do %>
          <span class="icon">❓</span> <span>Ayuda</span>
        <% end %>
      <% elsif current_user.musician? %>
        <div class="nav-header">Músico</div>
        <%= link_to my_gigs_path, class: "sidebar-link #{'active' if controller_name == 'gigs' && action_name == 'my'}" do %>
          <span class="icon">🎸</span> <span>Mis Shows</span>
        <% end %>

        <%= link_to my_payments_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'my_payments'}" do %>
          <span class="icon">💵</span> <span>Mis Pagos</span>
        <% end %>

        <%= link_to edit_user_path(current_user), class: "sidebar-link #{'active' if controller_path == 'users' && action_name == 'edit'}" do %>
          <span class="icon">👤</span> <span>Mi Perfil</span>
        <% end %>

        <%= link_to help_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'help'}" do %>
          <span class="icon">❓</span> <span>Ayuda</span>
        <% end %>
      <% elsif current_user.client? %>
        <div class="nav-header">Cliente</div>
        <%= link_to client_gigs_path, class: "sidebar-link #{'active' if controller_path == 'client/gigs' && action_name == 'index'}" do %>
          <span class="icon">🎫</span> <span>Mis Eventos</span>
        <% end %>

        <%# Acceso rápido al próximo evento %>
        <%
          next_gig = current_user.client&.gigs&.where('date >= ?', Date.today)&.order(date: :asc)&.first
        %>
        <% if next_gig %>
          <%= link_to client_gig_path(next_gig), class: "sidebar-link #{'active' if controller_path == 'client/gigs' && action_name == 'show'}" do %>
            <span class="icon">⭐</span> <span><%= venue_mode? ? 'Mi Próximo Evento' : 'Mi Próximo Show' %></span>
          <% end %>
        <% end %>

        <%= link_to preset_budgets_path, class: "sidebar-link #{'active' if controller_name == 'preset_budgets'}" do %>
          <span class="icon">📋</span> <span><%= venue_mode? ? 'Combos & Paquetes' : 'Presupuestos Base' %></span>
        <% end %>

        <%= link_to normativas_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'normativas'}" do %>
          <span class="icon">📜</span> <span>Normativas</span>
        <% end %>

        <%= link_to edit_user_path(current_user), class: "sidebar-link #{'active' if controller_path == 'users' && action_name == 'edit'}" do %>
          <span class="icon">👤</span> <span>Mi Perfil</span>
        <% end %>

        <%= link_to help_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'help'}" do %>
          <span class="icon">❓</span> <span>Ayuda</span>
        <% end %>
      <% end %>

      <%# --- BOTÓN PERSONALIZACIÓN DE TEMA --- %>
      <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--sidebar-border, rgba(255,255,255,0.08));">
        <button type="button" onclick="openThemeCustomizer()" class="sidebar-link" style="width: 100%; border: none; background: transparent; text-align: left; cursor: pointer; color: #cbd5e1; display: flex; align-items: center; gap: 12px; padding: 12px 16px;">
          <span class="icon">🎨</span> <span>Personalizar Tema</span>
          <% if is_gero_company %>
            <span style="background: linear-gradient(135deg, #ffd700, #d4af37); color: #1a0309; border-radius: 99px; font-size: 0.68em; padding: 2px 7px; font-weight: 900; margin-left: auto;">VIP</span>
          <% end %>
        </button>
      </div>

      <div id="sidebar-scroll-indicator" aria-hidden="true"></div>
    </nav>

    <%# Pie del Sidebar: Usuario y Logout %>
    <div class="sidebar-footer">
      <div class="user-info">
        <div class="avatar" style="overflow: hidden; display: flex; align-items: center; justify-content: center;">
          <% if current_user.avatar_attached? %>
            <%= image_tag current_user.avatar_url_or_data, style: "width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" %>
          <% else %>
            <%= current_user.email[0].upcase %>
          <% end %>
        </div>
        <div class="user-details">
          <p class="email"><%= current_user.display_name %></p>
          <p class="status">En línea</p>
        </div>
      </div>
      <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete, class: "btn-logout" %>
    </div>
  </aside>
<% end %>
