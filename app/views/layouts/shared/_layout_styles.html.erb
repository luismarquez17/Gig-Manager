<style>
  /* Hide native scrollbar but keep scroll functionality */
  aside {
    /* allow flex children to shrink/overflow correctly */
    min-height: 0;
  }
  aside nav {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE 10+ */
    position: relative; /* container for custom indicator */
    /* ensure nav can scroll inside the flex layout */
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  aside nav::-webkit-scrollbar { display: none; }

  /* Custom scroll indicator (a subtle background bar acting as thumb) */
  #sidebar-scroll-indicator {
    position: absolute;
    right: 6px;
    top: 0;
    width: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 6px;
    transition: transform 0.12s linear, height 0.12s linear, opacity 0.12s linear;
    will-change: transform, height;
    opacity: 0.9;
  }

  /* Prevent long labels from wrapping awkwardly */
  aside nav a { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Top auto-dismiss banners */
  @keyframes topBannerProgress {
    from { width: 100%; }
    to { width: 0%; }
  }
  .top-auto-dismiss-banner {
    transition: opacity 0.4s ease, transform 0.4s ease, max-height 0.4s ease, margin 0.4s ease, padding 0.4s ease !important;
  }
  .top-banner-close-btn:hover {
    opacity: 1 !important;
    background: rgba(0, 0, 0, 0.08) !important;
  }

  /* ======================================================
     MOBILE TOPBAR — oculto en desktop, visible en móvil
     ====================================================== */
  #mobile-topbar {
    display: none;
  }

  /* ======================================================
     MOBILE BACKDROP — oculto siempre hasta activación JS
     ====================================================== */
  #mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 18, 35, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 998;
  }
  #mobile-backdrop.open { display: block; }

  /* ======================================================
     BOTÓN CERRAR dentro del sidebar — oculto en desktop
     ====================================================== */
  #sidebar-close-btn,
  .sidebar-close-btn {
    display: none !important;
  }

  /* ======================================================
     RESPONSIVE: todo el cambio ocurre SOLO aquí (≤ 991px)
     ====================================================== */
  @media (max-width: 991px) {

    /* Topbar visible */
    #mobile-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 58px;
      background: #0f172a;
      z-index: 1000;
      padding: 0 14px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.25);
      border-bottom: 1px solid rgba(255,255,255,0.07);
      gap: 8px;
    }

    #mobile-topbar .topbar-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      color: white;
      font-family: 'Inter', sans-serif;
      font-weight: 800;
      font-size: 1.05rem;
      min-width: 0;
      flex: 1 1 auto;
      overflow: hidden;
    }

    #mobile-topbar .topbar-logo {
      background: linear-gradient(135deg, #2563eb, #3b82f6);
      color: white;
      width: 30px; height: 30px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 800;
      flex-shrink: 0;
    }

    #mobile-topbar .topbar-hamburger {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 99px;
      width: 40px; height: 40px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 5px;
      cursor: pointer;
      flex-shrink: 0;
    }
    #mobile-topbar .topbar-hamburger span {
      display: block;
      width: 20px; height: 2px;
      background: white;
      border-radius: 2px;
    }

    /* Sidebar se convierte en drawer off-canvas con scroll fluido unificado */
    .app-sidebar {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      height: 100% !important;
      height: 100dvh !important;
      width: 295px !important;
      max-width: 88vw !important;
      transform: translateX(-100%) !important;
      transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
      z-index: 999 !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      -webkit-overflow-scrolling: touch !important;
      overscroll-behavior: contain !important;
      touch-action: pan-y !important;
      display: flex !important;
      flex-direction: column !important;
      padding: 16px 14px max(35px, env(safe-area-inset-bottom, 25px)) 14px !important;
      box-sizing: border-box !important;
      box-shadow: 6px 0 30px rgba(0,0,0,0.5) !important;
    }
    .app-sidebar.sidebar-open {
      transform: translateX(0) !important;
    }

    /* Unificar scroll: nav no bloquea el deslizamiento */
    .app-sidebar .sidebar-nav {
      overflow-y: visible !important;
      flex: 1 0 auto !important;
      min-height: auto !important;
      padding-right: 0 !important;
      margin-bottom: 20px !important;
    }

    .app-sidebar .sidebar-footer {
      flex-shrink: 0 !important;
      margin-top: auto !important;
    }

    #sidebar-scroll-indicator {
      display: none !important;
    }

    /* Botón cerrar sidebar visible y estilizado */
    #sidebar-close-btn,
    .sidebar-close-btn {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 9px;
      color: #94a3b8;
      font-size: 1.35rem;
      line-height: 1;
      cursor: pointer;
      flex-shrink: 0;
      transition: all 0.2s ease;
      text-decoration: none;
      margin-left: auto;
    }
    #sidebar-close-btn:hover,
    .sidebar-close-btn:hover {
      background: rgba(255,255,255,0.16);
      color: white;
    }

    /* Main: quitar margin-left que aplica inline en desktop y poner top padding para topbar */
    main {
      margin-left: 0 !important;
      padding-top: calc(58px + 20px) !important;
      padding-left: 14px !important;
      padding-right: 14px !important;
      min-width: 0;
      overflow-x: hidden;
    }

    /* Tablas: scroll horizontal en móvil sin romper layout */
    table {
      min-width: 500px;
    }
    .table-custom-wrapper,
    div:has(> table) {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    /* Inputs/selects: fuente ≥16px para evitar zoom automático en iOS */
    input, select, textarea {
      font-size: 16px !important;
    }

    /* Ajustes de responsividad para teléfonos móviles (estrechos) */
    .notifications-container {
      padding-left: 2px !important;
      padding-right: 2px !important;
    }

    .notifications-header {
      padding: 18px 16px !important;
      border-radius: 14px !important;
    }

    .mobile-full-width,
    .mobile-full-width form,
    .mobile-full-width button {
      width: 100% !important;
    }

    .notification-card {
      padding: 16px 14px !important;
      border-radius: 12px !important;
    }

    .notification-card > div {
      flex-direction: column !important;
      align-items: stretch !important;
    }

    .btn-action-container {
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: stretch !important;
      margin-top: 10px !important;
    }

    .btn-action-container a,
    .btn-action-container form,
    .btn-action-container button {
      width: 100% !important;
      text-align: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
    }

    .nav-tabs-scroll {
      padding: 4px !important;
      border-radius: 12px !important;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
    }
    .nav-tabs-scroll::-webkit-scrollbar {
      display: none !important;
    }
  }

  @keyframes toastProgress {
    from { transform: scaleX(1); }
    to   { transform: scaleX(0); }
  }
</style>
