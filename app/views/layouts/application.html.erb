<!DOCTYPE html>
<html>
  <head>
    <title>GigManager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- PWA & Mobile Web App Meta Tags -->
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="GigManager">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" type="image/png" href="/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/icons/logo.svg">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# ── FAST PRE-RENDERER: Cero FOUC / Cero retraso en renderizado ── %>
    <script>
      (function() {
        try {
          var isGeroCompany = <%= (user_signed_in? && current_company.present? && (current_company.name.to_s.downcase.include?('gero') || current_company.slug.to_s.downcase.include?('gero'))).to_json %>;
          var saved = localStorage.getItem('gig_theme_config');
          var cfg = saved ? JSON.parse(saved) : null;
          if (!cfg) {
            cfg = isGeroCompany ? { theme: 'gerovip', accent: 'gold', density: 'normal', radius: 'smooth' } : { theme: 'light', accent: 'sapphire', density: 'normal', radius: 'smooth' };
          }
          var doc = document.documentElement;
          var isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (cfg.theme === 'system') {
            doc.setAttribute('data-theme', isDark ? 'dark' : 'light');
          } else {
            doc.setAttribute('data-theme', cfg.theme || (isGeroCompany ? 'gerovip' : 'light'));
          }
          doc.setAttribute('data-accent', cfg.accent || (isGeroCompany ? 'gold' : 'sapphire'));
          doc.setAttribute('data-density', cfg.density || 'normal');
          doc.setAttribute('data-radius', cfg.radius || 'smooth');
        } catch (e) {}
      })();
    </script>

    <%= render 'layouts/shared/layout_styles' %>
  </head>
  <%
    is_gero_company = user_signed_in? && current_company.present? && (current_company.name.to_s.downcase.include?('gero') || current_company.slug.to_s.downcase.include?('gero'))
  %>
  <body class="<%= 'is-gero-company' if is_gero_company %>" style="margin: 0; padding: 0;">

    <%= render 'layouts/shared/mobile_topbar' %>

    <div style="display: flex; min-height: 100vh; font-family: 'Inter', sans-serif;">
      <%= render 'layouts/shared/sidebar' %>

      <%# --- CONTENIDO PRINCIPAL --- %>
      <main style="<%= user_signed_in? ? 'margin-left: 280px;' : 'margin-left: 0;' %> flex-grow: 1; min-height: 100vh; padding: 40px; box-sizing: border-box; overflow-x: auto;">
        <div style="max-width: 1200px; margin: 0 auto;">
          <%= render 'layouts/shared/trial_banner' %>
          <%= render 'layouts/shared/flash_notices' %>
          <%= yield %>
        </div>
      </main>
    </div>

    <%= render 'layouts/shared/core_scripts' %>
    <%= render 'layouts/shared/global_modals' %>
  </body>
</html>