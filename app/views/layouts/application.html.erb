<!DOCTYPE html>
<html>
  <head>
    <title>GigManager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      /* Hide native scrollbar but keep scroll functionality */
      aside {
        /* allow flex children to shrink/overflow correctly */
        min-height: 0;
      }
      aside nav {
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE 10+ */
        position: relative; /* container for custom indicator */
        /* ensure nav can scroll inside the flex layout */
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
      aside nav::-webkit-scrollbar { display: none; }

      /* Custom scroll indicator (a subtle background bar acting as thumb) */
      #sidebar-scroll-indicator {
        position: absolute;
        right: 6px;
        top: 0;
        width: 6px;
        background: rgba(255,255,255,0.08);
        border-radius: 6px;
        transition: transform 0.12s linear, height 0.12s linear, opacity 0.12s linear;
        will-change: transform, height;
        opacity: 0.9;
      }

      /* Prevent long labels from wrapping awkwardly */
      aside nav a { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      /* ======================================================
         MOBILE TOPBAR — oculto en desktop, visible en móvil
         ====================================================== */
      #mobile-topbar {
        display: none;
      }

      /* ======================================================
         MOBILE BACKDROP — oculto siempre hasta activación JS
         ====================================================== */
      #mobile-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10, 18, 35, 0.6);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        z-index: 998;
      }
      #mobile-backdrop.open { display: block; }

      /* ======================================================
         BOTÓN CERRAR dentro del sidebar — oculto en desktop
         ====================================================== */
      #sidebar-close-btn {
        display: none;
      }

      /* ======================================================
         RESPONSIVE: todo el cambio ocurre SOLO aquí (≤ 991px)
         ====================================================== */
      @media (max-width: 991px) {

        /* Topbar visible */
        #mobile-topbar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          position: fixed;
          top: 0; left: 0; right: 0;
          height: 58px;
          background: #0f172a;
          z-index: 1000;
          padding: 0 16px;
          box-shadow: 0 2px 12px rgba(0,0,0,0.25);
          border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        #mobile-topbar .topbar-brand {
          display: flex;
          align-items: center;
          gap: 10px;
          color: white;
          font-family: 'Inter', sans-serif;
          font-weight: 800;
          font-size: 1.05rem;
        }
        #mobile-topbar .topbar-logo {
          background: linear-gradient(135deg, #2563eb, #3b82f6);
          color: white;
          width: 30px; height: 30px;
          display: flex; align-items: center; justify-content: center;
          border-radius: 8px;
          font-size: 0.85rem;
          font-weight: 800;
          flex-shrink: 0;
        }

        #mobile-topbar .topbar-hamburger {
          background: rgba(255,255,255,0.08);
          border: 1px solid rgba(255,255,255,0.12);
          border-radius: 9px;
          width: 40px; height: 40px;
          display: flex; flex-direction: column;
          align-items: center; justify-content: center;
          gap: 5px;
          cursor: pointer;
          flex-shrink: 0;
        }
        #mobile-topbar .topbar-hamburger span {
          display: block;
          width: 20px; height: 2px;
          background: white;
          border-radius: 2px;
        }

        /* Sidebar se convierte en drawer off-canvas */
        .app-sidebar {
          position: fixed !important;
          top: 0; left: 0; bottom: 0;
          width: 280px !important;
          max-width: 82vw;
          transform: translateX(-100%);
          transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
          z-index: 999;
          overflow-y: auto;
        }
        .app-sidebar.sidebar-open {
          transform: translateX(0);
        }

        /* Botón cerrar sidebar visible */
        #sidebar-close-btn {
          display: flex;
          align-items: center; justify-content: center;
          position: absolute;
          top: 14px; right: 14px;
          width: 32px; height: 32px;
          background: rgba(255,255,255,0.08);
          border: 1px solid rgba(255,255,255,0.12);
          border-radius: 8px;
          color: #94a3b8;
          font-size: 1.3rem;
          line-height: 1;
          cursor: pointer;
          z-index: 10;
          text-decoration: none;
        }

        /* Main: quitar margin-left que aplica inline en desktop y poner top padding para topbar */
        main {
          margin-left: 0 !important;
          padding-top: calc(58px + 20px) !important;
          padding-left: 14px !important;
          padding-right: 14px !important;
          min-width: 0;
          overflow-x: hidden;
        }

        /* Tablas: scroll horizontal en móvil sin romper layout */
        table {
          min-width: 500px;
        }
        .table-custom-wrapper,
        div:has(> table) {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }

        /* Inputs/selects: fuente ≥16px para evitar zoom automático en iOS */
        input, select, textarea {
          font-size: 16px !important;
        }
      }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f8fafc;">

    <%# =============================================
        TOPBAR MÓVIL (oculto en desktop por CSS)
        ============================================= %>
    <% if user_signed_in? %>
      <header id="mobile-topbar" aria-label="Barra de navegación móvil">
        <button class="topbar-hamburger" id="hamburger-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="app-sidebar">
          <span></span><span></span><span></span>
        </button>
        <div class="topbar-brand">
          <span class="topbar-logo">G</span>
          Gig Manager
        </div>
        <div style="width:40px;"></div><%# espaciador para centrar el brand %>
      </header>

      <%# Backdrop para cerrar sidebar en móvil %>
      <div id="mobile-backdrop" aria-hidden="true"></div>
    <% end %>

    <div style="display: flex; min-height: 100vh; font-family: 'Inter', sans-serif;">
      
      <%# --- SIDEBAR --- %>
      <% if user_signed_in? %>
        <aside class="app-sidebar" id="app-sidebar">
          
          <%# Logo + nombre de empresa + botón cerrar (sólo visible en móvil) %>
          <div class="sidebar-brand" style="position: relative;">
            <h2>
              <span class="brand-logo">G</span>
              Gig Manager
            </h2>
            <% if current_company.present? %>
              <div style="font-size: 0.78rem; color: #818cf8; font-weight: 600; margin-top: 4px; display: flex; align-items: center; gap: 4px;">
                <span>🏢</span> <span><%= current_company.name %></span>
              </div>
            <% end %>
            <button id="sidebar-close-btn" aria-label="Cerrar menú">&times;</button>
          </div>

          <%# Navegación %>
          <nav class="sidebar-nav">
            <% if current_user.superadmin? %>
              <div style="background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 12px; padding: 10px; margin-bottom: 12px;">
                <div style="font-size: 0.75rem; font-weight: 800; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">👑 Superadmin</div>
                <%= link_to superadmin_dashboard_path, class: "sidebar-link #{'active' if controller_name == 'dashboard' && controller_path.start_with?('superadmin')}" do %>
                  <span class="icon">📊</span> <span>Panel Universo</span>
                <% end %>
                <%= link_to superadmin_companies_path, class: "sidebar-link #{'active' if controller_name == 'companies' && controller_path.start_with?('superadmin')}" do %>
                  <span class="icon">🏢</span> <span>Empresas</span>
                <% end %>
              </div>
            <% end %>


            <%= link_to root_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'dashboard'}" do %>
              <span class="icon">🏠</span> <span>Inicio (Dashboard)</span>
            <% end %>

            <% if current_user.leader? || current_user.superadmin? %>

              <%= link_to items_path, class: "sidebar-link #{'active' if controller_name == 'items'}" do %>
                <span class="icon">📦</span> <span>Inventario</span>
              <% end %>

              <%= link_to shopping_items_path, class: "sidebar-link #{'active' if controller_name == 'shopping_items'}" do %>
                <span class="icon">🛒</span> <span>Lista de Compras</span>
              <% end %>

              <%= link_to clients_path, class: "sidebar-link #{'active' if controller_name == 'clients' && action_name == 'index'}" do %>
                <span class="icon">👥</span> <span>Clientes</span>
              <% end %>

              <%= link_to debts_clients_path, class: "sidebar-link #{'active' if controller_name == 'clients' && action_name == 'debts'}" do %>
                <span class="icon">💳</span> <span>Cuentas por Cobrar</span>
              <% end %>

              <%= link_to preset_budgets_path, class: "sidebar-link #{'active' if controller_name == 'preset_budgets'}" do %>
                <span class="icon">📄</span> <span>Presupuestos Base</span>
              <% end %>

              <%= link_to standard_upsells_path, class: "sidebar-link #{'active' if controller_name == 'standard_upsells'}" do %>
                <span class="icon">🚀</span> <span>Adicionales (Upsells)</span>
              <% end %>

              <% if current_company.present? %>
                <%= link_to band_landing_path(slug: current_company.slug), target: "_blank", class: "sidebar-link" do %>
                  <span class="icon">🌐</span> <span>Mi Landing Pública ↗</span>
                <% end %>
              <% end %>

              <%= link_to gigs_path, class: "sidebar-link #{'active' if controller_name == 'gigs' && action_name != 'my'}" do %>
                <span class="icon">🎸</span> <span>Gigs / Eventos</span>
              <% end %>

              <%= link_to gig_payments_path, class: "sidebar-link #{'active' if controller_name == 'gig_payments'}" do %>
                <span class="icon">💳</span> <span>Pagos Eventos / Shows</span>
              <% end %>

              <%= link_to kits_path, class: "sidebar-link #{'active' if controller_name == 'kits'}" do %>
                <span class="icon">🛠️</span> <span>Plantillas (Kits)</span>
              <% end %>

              <%= link_to maintenance_records_path, class: "sidebar-link #{'active' if controller_name == 'maintenance_records'}" do %>
                <span class="icon">🔧</span> <span>Taller (Reparos)</span>
              <% end %>

              <%= link_to availability_dashboard_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'availability'}" do %>
                <span class="icon">⚡</span> <span>Conflictos</span>
              <% end %>

              <%= link_to financials_dashboard_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'financials'}" do %>
                <span class="icon">📊</span> <span>Métricas / Finanzas</span>
              <% end %>

              <%= link_to investments_path, class: "sidebar-link #{'active' if controller_name == 'investments'}" do %>
                <span class="icon">💸</span> <span>Inversiones</span>
              <% end %>

              <%= link_to employee_payments_path, class: "sidebar-link #{'active' if controller_name == 'employee_payments'}" do %>
                <span class="icon">💰</span> <span>Pagos a trabajadores</span>
                <% 
                  pending_count = current_company&.employee_payments&.pending_approval&.count rescue 0 
                %>
                <% if pending_count.to_i > 0 %>
                  <span style="background: #f59e0b; color: white; border-radius: 99px; font-size: 0.72em; padding: 2px 7px; font-weight: 800; margin-left: auto;">
                    <%= pending_count %>
                  </span>
                <% end %>
              <% end %>

              <%= link_to users_path, class: "sidebar-link #{'active' if controller_name == 'users'}" do %>
                <span class="icon">⚙️</span> <span>Roles / Accesos</span>
              <% end %>

              <%= link_to normativas_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'normativas'}" do %>
                <span class="icon">📜</span> <span>Normativas</span>
              <% end %>

            <% elsif current_user.staff? %>
              <div class="nav-header">Agrupación</div>
              <%= link_to my_gigs_path, class: "sidebar-link #{'active' if controller_name == 'gigs' && action_name == 'my'}" do %>
                <span class="icon">🎫</span> <span>Mis eventos</span>
              <% end %>

              <%= link_to my_payments_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'my_payments'}" do %>
                <span class="icon">💵</span> <span>Mis Pagos</span>
              <% end %>

              <%= link_to edit_user_path(current_user), class: "sidebar-link #{'active' if controller_path == 'users' && action_name == 'edit'}" do %>
                <span class="icon">👤</span> <span>Mi Perfil</span>
              <% end %>

              <%= link_to help_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'help'}" do %>
                <span class="icon">❓</span> <span>Ayuda</span>
              <% end %>
            <% elsif current_user.musician? %>
              <div class="nav-header">Músico</div>
              <%= link_to my_gigs_path, class: "sidebar-link #{'active' if controller_name == 'gigs' && action_name == 'my'}" do %>
                <span class="icon">🎸</span> <span>Mis Shows</span>
              <% end %>

              <%= link_to my_payments_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'my_payments'}" do %>
                <span class="icon">💵</span> <span>Mis Pagos</span>
              <% end %>

              <%= link_to edit_user_path(current_user), class: "sidebar-link #{'active' if controller_path == 'users' && action_name == 'edit'}" do %>
                <span class="icon">👤</span> <span>Mi Perfil</span>
              <% end %>

              <%= link_to help_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'help'}" do %>
                <span class="icon">❓</span> <span>Ayuda</span>
              <% end %>
            <% elsif current_user.client? %>
              <div class="nav-header">Cliente</div>
              <%= link_to client_gigs_path, class: "sidebar-link #{'active' if controller_path == 'client/gigs' && action_name == 'index'}" do %>
                <span class="icon">🎫</span> <span>Mis Eventos</span>
              <% end %>

              <%# Acceso rápido al próximo evento %>
              <%
                next_gig = current_user.client&.gigs&.where('date >= ?', Date.today)&.order(date: :asc)&.first
              %>
              <% if next_gig %>
                <%= link_to client_gig_path(next_gig), class: "sidebar-link #{'active' if controller_path == 'client/gigs' && action_name == 'show'}" do %>
                  <span class="icon">⭐</span> <span>Mi Próximo Show</span>
                <% end %>
              <% end %>

              <%= link_to preset_budgets_path, class: "sidebar-link #{'active' if controller_name == 'preset_budgets'}" do %>
                <span class="icon">📋</span> <span>Presupuestos Base</span>
              <% end %>

              <%= link_to normativas_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'normativas'}" do %>
                <span class="icon">📜</span> <span>Normativas</span>
              <% end %>

              <%= link_to edit_user_path(current_user), class: "sidebar-link #{'active' if controller_path == 'users' && action_name == 'edit'}" do %>
                <span class="icon">👤</span> <span>Mi Perfil</span>
              <% end %>

              <%= link_to help_path, class: "sidebar-link #{'active' if controller_name == 'pages' && action_name == 'help'}" do %>
                <span class="icon">❓</span> <span>Ayuda</span>
              <% end %>
            <% end %>
            <div id="sidebar-scroll-indicator" aria-hidden="true"></div>
          </nav>

          <%# Pie del Sidebar: Usuario y Logout %>
          <div class="sidebar-footer">
            <div class="user-info">
              <div class="avatar" style="overflow: hidden; display: flex; align-items: center; justify-content: center;">
                <% if current_user.avatar_attached? %>
                  <%= image_tag current_user.avatar_url_or_data, style: "width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" %>
                <% else %>
                  <%= current_user.email[0].upcase %>
                <% end %>
              </div>
              <div class="user-details">
                <p class="email"><%= current_user.display_name %></p>
                <p class="status">En línea</p>
              </div>
            </div>
            <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete, class: "btn-logout" %>
          </div>
        </aside>
      <% end %>

      <%# --- CONTENIDO PRINCIPAL --- %>
      <main style="<%= user_signed_in? ? 'margin-left: 280px;' : 'margin-left: 0;' %> flex-grow: 1; min-height: 100vh; padding: 40px; box-sizing: border-box; overflow-x: auto;">
        <div style="max-width: 1200px; margin: 0 auto;">
          
          <% if user_signed_in? && current_user.superadmin? && session[:superadmin_company_id].present? %>
            <div style="background: linear-gradient(135deg, #4338ca, #3730a3); color: white; padding: 12px 20px; border-radius: 12px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 4px 12px rgba(67, 56, 202, 0.3);">
              <div style="display: flex; align-items: center; gap: 10px; font-size: 0.92rem; font-weight: 600;">
                <span style="font-size: 1.2rem;">👁️</span>
                <span>Modo Inspección Activo: Estás viendo la plataforma como <strong><%= current_company&.name %></strong>.</span>
              </div>
              <%= button_to switch_tenant_superadmin_company_path("all"), method: :post, style: "background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: white; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.82rem; cursor: pointer;" do %>
                Volver a Modo Universo Superadmin
              <% end %>
            </div>
          <% end %>

          <% if user_signed_in? && (current_user.leader? || current_user.superadmin?) && controller_name != 'employee_payments' && !(controller_name == 'pages' && action_name == 'dashboard') %>
            <% pending_worker_reports = current_company&.employee_payments&.pending_approval&.count rescue 0 %>
            <% if pending_worker_reports.to_i > 0 %>
              <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 14px; padding: 14px 20px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.08);">
                <div style="display: flex; align-items: center; gap: 10px; color: #92400e; font-size: 0.92rem; font-weight: 600;">
                  <span style="font-size: 1.3rem;">🔔</span>
                  <span><strong>Notificación:</strong> Tienes <strong><%= pending_worker_reports %> pago(s) reportado(s)</strong> por trabajadores esperando tu confirmación.</span>
                </div>
                <%= link_to 'Revisar y Confirmar ➔', employee_payments_path, style: 'background: #f59e0b; color: white; padding: 7px 16px; border-radius: 8px; font-weight: 700; font-size: 0.84rem; text-decoration: none; box-shadow: 0 2px 4px rgba(245, 158, 11, 0.25); white-space: nowrap;' %>
              </div>
            <% end %>
          <% end %>

          <% if notice.present? %>
            <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600; font-size: 0.92rem; display: flex; align-items: center; gap: 8px;">
              <span>✅</span> <span><%= notice %></span>
            </div>
          <% end %>

          <% if alert.present? %>
            <div style="background: #fff1f2; border: 1px solid #fecdd3; color: #9f1239; padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600; font-size: 0.92rem; display: flex; align-items: center; gap: 8px;">
              <span>⚠️</span> <span><%= alert %></span>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </main>


    </div>

    <script>
      (function() {
        // ─── Scroll indicator (original) ───────────────────────────
        document.addEventListener('DOMContentLoaded', function(){
          var nav = document.querySelector('aside nav');
          var indicator = document.getElementById('sidebar-scroll-indicator');
          if(nav && indicator) {
            function refresh(){
              var scrollHeight = nav.scrollHeight;
              var client = nav.clientHeight;
              if(scrollHeight <= client){ indicator.style.opacity = '0'; return; }
              indicator.style.opacity = '0.9';
              var thumbPct = (client / scrollHeight) * 100;
              var ratio = nav.scrollTop / (scrollHeight - client);
              var translatePct = ratio * (100 - thumbPct);
              indicator.style.height = thumbPct + '%';
              indicator.style.top = translatePct + '%';
            }
            nav.addEventListener('scroll', refresh, { passive: true });
            window.addEventListener('resize', refresh);
            refresh();
          }
        });

        // ─── Mobile drawer ──────────────────────────────────────────
        function initDrawer() {
          var sidebar   = document.getElementById('app-sidebar');
          var hamburger = document.getElementById('hamburger-btn');
          var closeBtn  = document.getElementById('sidebar-close-btn');
          var backdrop  = document.getElementById('mobile-backdrop');
          if (!sidebar) return;

          function open() {
            sidebar.classList.add('sidebar-open');
            if (backdrop) backdrop.classList.add('open');
            if (hamburger) hamburger.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
          }
          function close() {
            sidebar.classList.remove('sidebar-open');
            if (backdrop) backdrop.classList.remove('open');
            if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          }

          if (hamburger) hamburger.addEventListener('click', open);
          if (closeBtn)  closeBtn.addEventListener('click', close);
          if (backdrop)  backdrop.addEventListener('click', close);

          // Cerrar al navegar en móvil
          sidebar.querySelectorAll('.sidebar-link').forEach(function(link) {
            link.addEventListener('click', function() {
              if (window.innerWidth <= 991) close();
            });
          });

          // Cerrar drawer si se redimensiona a desktop
          window.addEventListener('resize', function() {
            if (window.innerWidth > 991) close();
          });
        }

        document.addEventListener('DOMContentLoaded', initDrawer);
        document.addEventListener('turbo:load', initDrawer);
      })();
    </script>
  </body>
</html>