<div class="relative min-h-[85vh] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Orbes luminosos suaves -->
  <div class="absolute top-1/4 left-1/4 w-[420px] h-[420px] bg-cyan-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[420px] h-[420px] bg-indigo-600/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

    <!-- Columna Izquierda: Seguridad, Calma y Confianza -->
    <div class="hidden lg:flex lg:col-span-6 flex-col justify-center space-y-7 pr-6">
      <div class="inline-flex items-center gap-2 self-start px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-emerald-500/30 text-emerald-300 text-xs font-bold shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Acceso Seguro y Encriptado</span>
      </div>

      <div>
        <h1 class="text-4xl font-black text-white tracking-tight leading-tight mb-4">
          Tu operación y finanzas, <span class="gradient-text-cyan">bajo control total</span>.
        </h1>
        <p class="text-slate-400 text-base leading-relaxed">
          Entra a tu espacio privado para revisar eventos, confirmar abonos de clientes, liquidar nóminas y coordinar a tu equipo sin enredos.
        </p>
      </div>

      <div class="space-y-3.5">
        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-md">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-lg flex-shrink-0">🛡️</div>
          <div>
            <h3 class="text-sm font-extrabold text-white">Privacidad Multi-Tenant Aislada</h3>
            <p class="text-xs text-slate-400 mt-0.5 leading-relaxed">Tus eventos, contratos, comprobantes y finanzas están completamente aislados y protegidos.</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-md">
          <div class="w-10 h-10 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-lg flex-shrink-0">⚡</div>
          <div>
            <h3 class="text-sm font-extrabold text-white">Todo en Tiempo Real</h3>
            <p class="text-xs text-slate-400 mt-0.5 leading-relaxed">Notificaciones instantáneas cuando un cliente reporta un abono o solicita adicionales.</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-slate-900/50 border border-slate-800/80 backdrop-blur-md">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-lg flex-shrink-0">💬</div>
          <div>
            <h3 class="text-sm font-extrabold text-white">Respaldo Humano por WhatsApp</h3>
            <p class="text-xs text-slate-400 mt-0.5 leading-relaxed">¿Necesitas ayuda? Nuestro equipo te atiende directamente desde el botón de soporte.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Formulario de Inicio de Sesión -->
    <div class="lg:col-span-6 w-full max-w-md mx-auto">
      <div class="p-7 sm:p-9 rounded-3xl bg-slate-900/85 border border-slate-800 shadow-2xl backdrop-blur-xl">

        <!-- Encabezado -->
        <div class="text-center mb-6">
          <img src="/icons/logo.svg" alt="GigManager Logo" width="56" height="56" style="width: 56px; height: 56px; object-fit: contain;" class="w-14 h-14 rounded-2xl shadow-xl shadow-cyan-500/25 mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Bienvenido de nuevo</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Ingresa de forma segura a tu panel de GigManager</p>
        </div>

        <!-- Mensajes de Estado -->
        <% if flash[:alert].present? %>
          <div class="mb-5 p-4 rounded-2xl bg-rose-500/15 border border-rose-500/40 text-rose-200 text-sm shadow-xl shadow-rose-950/30 flex items-start gap-3">
            <span class="text-lg flex-shrink-0">❌</span>
            <div class="flex-1">
              <div class="font-black text-rose-300 text-xs uppercase tracking-wider mb-0.5">No se pudo iniciar sesión</div>
              <div class="text-xs text-rose-100 font-medium leading-relaxed"><%= flash[:alert] %></div>
            </div>
          </div>
        <% end %>

        <% if flash[:notice].present? %>
          <div class="mb-5 p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-200 text-sm shadow-xl shadow-emerald-950/30 flex items-start gap-3">
            <span class="text-lg flex-shrink-0">✅</span>
            <div class="flex-1">
              <div class="font-black text-emerald-300 text-xs uppercase tracking-wider mb-0.5">¡Listo!</div>
              <div class="text-xs text-emerald-100 font-medium leading-relaxed"><%= flash[:notice] %></div>
            </div>
          </div>
        <% end %>

        <!-- Botón de Inicio de Sesión con Google -->
        <div>
          <%= button_to user_google_oauth2_omniauth_authorize_path,
              method: :post,
              form: { data: { turbo: false } },
              data: { turbo: false },
              class: "w-full flex items-center justify-center gap-3 py-3.5 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold text-sm shadow-lg shadow-black/20 hover:shadow-xl transition-all cursor-pointer border border-slate-200" do %>
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Continuar con Google</span>
          <% end %>
        </div>

        <!-- Divisor Visual -->
        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-800"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-slate-900 px-3 text-slate-400 font-semibold tracking-wider">o entra con tu correo</span>
          </div>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4", data: { turbo: false } }) do |f| %>
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Correo Electrónico</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "tu@agrupacion.com",
                class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider">Contraseña</label>
              <% if devise_mapping.recoverable? %>
                <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-xs text-cyan-400 hover:text-cyan-300 transition-colors font-semibold" %>
              <% end %>
            </div>
            <div class="relative">
              <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", id: "login-password-field",
                  class: "w-full px-4 py-3 pr-12 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
              <button type="button" onclick="toggleAuthPassword('login-password-field', this)" aria-label="Mostrar u ocultar contraseña"
                      class="absolute inset-y-0 right-0 px-3.5 flex items-center text-slate-400 hover:text-cyan-400 text-sm cursor-pointer bg-transparent border-0">
                👁️
              </button>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center justify-between text-xs pt-1">
              <label class="flex items-center gap-2 cursor-pointer text-slate-300 select-none">
                <%= f.check_box :remember_me, class: "w-4 h-4 rounded text-cyan-500 bg-slate-950 border-slate-700 focus:ring-0 accent-cyan-500" %>
                <span>Mantener sesión iniciada</span>
              </label>
              <span class="text-slate-500 flex items-center gap-1">🔒 SSL</span>
            </div>
          <% end %>

          <div class="pt-2">
            <%= f.submit "Entrar al Panel →",
                class: "w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-slate-950 font-black text-sm shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 cursor-pointer transition-all text-center" %>
          </div>
        <% end %>

        <div class="mt-6 pt-5 border-t border-slate-800/80 text-center space-y-2">
          <div class="text-xs text-slate-400">
            <span>¿Aún no usas GigManager?</span>
            <%= link_to "Comenzar Prueba Gratis (30 Días) ⚡", new_user_registration_path, class: "font-extrabold text-cyan-400 hover:text-cyan-300 ml-1" %>
          </div>
          <p class="text-[11px] text-slate-500">Sin tarjeta de crédito • Configuración automática en 45 seg</p>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  function toggleAuthPassword(inputId, btn) {
    var input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  }
</script>