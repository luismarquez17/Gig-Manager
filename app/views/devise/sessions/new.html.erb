<div class="min-h-[85vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md space-y-8 p-8 sm:p-10 rounded-3xl bg-slate-900/80 border border-slate-800 shadow-2xl backdrop-blur-xl">
    
    <!-- Encabezado -->
    <div class="text-center">
      <img src="/icons/logo.svg" alt="GigManager Logo" class="w-14 h-14 rounded-2xl shadow-xl shadow-blue-500/30 mx-auto mb-4" />
      <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Iniciar Sesión</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Ingresa a tu panel de GigManager</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Correo Electrónico</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "tu@email.com", 
            class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Contraseña</label>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", 
            class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between text-xs pt-1">
          <label class="flex items-center gap-2 cursor-pointer text-slate-300">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded text-cyan-500 bg-slate-950 border-slate-700 focus:ring-0 accent-cyan-500" %>
            <span>Recordarme</span>
          </label>
        </div>
      <% end %>

      <div class="pt-3">
        <%= f.submit "Entrar al Panel", 
            class: "w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-slate-950 font-black text-sm shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 cursor-pointer transition-all text-center" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-slate-800/80 text-center text-xs text-slate-400">
      <span>¿No tienes una cuenta aún?</span>
      <%= link_to "Comenzar Prueba Gratis (30 Días)", new_user_registration_path, class: "font-bold text-cyan-400 hover:text-cyan-300 ml-1" %>
    </div>

  </div>
</div>