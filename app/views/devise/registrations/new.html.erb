<div class="min-h-[85vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md space-y-8 p-8 sm:p-10 rounded-3xl bg-slate-900/80 border border-slate-800 shadow-2xl backdrop-blur-xl">
    
    <!-- Encabezado -->
    <div class="text-center">
      <img src="/icons/logo.svg" alt="GigManager Logo" width="56" height="56" style="width: 56px; height: 56px; object-fit: contain;" class="w-14 h-14 rounded-2xl shadow-xl shadow-blue-500/30 mx-auto mb-4" />
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-400 text-xs font-bold mb-3">
        <span>✨</span>
        <span>Prueba de 30 Días Gratis</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Crea tu Agrupación</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Comienza a gestionar tus shows y finanzas hoy mismo</p>
    </div>

    <!-- Mensajes de Estado (Rojo cuando algo salió mal / Verde cuando salió bien) -->
    <% if flash[:alert].present? %>
      <div class="p-4 rounded-2xl bg-rose-500/15 border border-rose-500/40 text-rose-200 text-sm shadow-xl shadow-rose-950/30 flex items-start gap-3">
        <span class="text-lg flex-shrink-0">❌</span>
        <div class="flex-1">
          <div class="font-black text-rose-300 text-xs uppercase tracking-wider mb-0.5">Error al registrarse</div>
          <div class="text-xs text-rose-100 font-medium leading-relaxed"><%= flash[:alert] %></div>
        </div>
      </div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-200 text-sm shadow-xl shadow-emerald-950/30 flex items-start gap-3">
        <span class="text-lg flex-shrink-0">✅</span>
        <div class="flex-1">
          <div class="font-black text-emerald-300 text-xs uppercase tracking-wider mb-0.5">¡Operación exitosa!</div>
          <div class="text-xs text-emerald-100 font-medium leading-relaxed"><%= flash[:notice] %></div>
        </div>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-4", data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <% if @selected_modules.present? %>
        <%= hidden_field_tag :modules, @selected_modules.join(',') %>
        <div class="p-3 rounded-xl bg-cyan-950/40 border border-cyan-500/30 text-xs text-cyan-300 flex items-center justify-between">
          <span>🧩 Módulos Seleccionados:</span>
          <span class="font-black text-cyan-200"><%= @selected_modules.count %> módulos</span>
        </div>
      <% end %>

      <!-- Nombre Completo -->
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Tu Nombre y Apellido</label>
        <%= f.text_field :name, autofocus: true, placeholder: "Ej. Carlos Mendoza", 
            class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
      </div>

      <!-- Nombre de la Agrupación / Banda -->
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Nombre de tu Agrupación o Empresa</label>
        <%= text_field_tag :company_name, @company_name, placeholder: "Ej. Orquesta Los Titanes", 
            class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
      </div>

      <!-- Email -->
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Correo Electrónico</label>
        <%= f.email_field :email, autocomplete: "email", placeholder: "director@agrupacion.com", 
            class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
      </div>

      <!-- Contraseña -->
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Contraseña</label>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "Mínimo 6 caracteres", 
            class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
      </div>

      <!-- Confirmar Contraseña -->
      <div>
        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Confirmar Contraseña</label>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repite tu contraseña", 
            class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
      </div>

      <div class="pt-3">
        <%= f.submit "Comenzar Prueba Gratis (30 Días) ⚡", 
            class: "w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-slate-950 font-black text-sm shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 cursor-pointer transition-all text-center" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-slate-800/80 text-center text-xs text-slate-400">
      <span>¿Ya tienes una cuenta?</span>
      <%= link_to "Iniciar Sesión", new_user_session_path, class: "font-bold text-cyan-400 hover:text-cyan-300 ml-1" %>
    </div>

  </div>
</div>