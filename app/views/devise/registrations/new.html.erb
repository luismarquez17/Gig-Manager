<%
  active_plan = @selected_plan.presence || 'banda'
  active_modules = @selected_modules.presence || AppModule.modules_for_package(active_plan)
  pricing = @selected_pricing || AppModule.calculate_pricing(active_plan, active_modules)
  pkg_info = AppModule.package_info(active_plan)
%>

<div class="relative min-h-[88vh] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Orbes luminosos -->
  <div class="absolute top-1/4 left-1/3 w-[480px] h-[480px] bg-cyan-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[420px] h-[420px] bg-indigo-600/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Columna Izquierda: Combo Seleccionado + Promesa de Seguridad & Cero Fricción -->
    <div class="lg:col-span-5 space-y-5 order-2 lg:order-1">

      <!-- Tarjeta Resumen del Combo -->
      <div class="p-6 sm:p-7 rounded-3xl bg-gradient-to-b from-slate-900/95 to-slate-950 border border-cyan-500/35 shadow-2xl shadow-cyan-950/30 backdrop-blur-xl">
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/90 border border-emerald-500/40 text-emerald-300 text-[11px] font-black uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            30 Días Gratis Hoy
          </span>
          <span class="text-xs font-bold text-slate-400">Sin tarjeta</span>
        </div>

        <div class="flex items-center gap-3.5 mb-4">
          <div class="w-12 h-12 rounded-2xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-2xl flex-shrink-0">
            <%= pricing[:package_icon] || pkg_info[:icon] %>
          </div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-cyan-400">Tu Combo Seleccionado</div>
            <h3 class="text-lg font-black text-white leading-tight"><%= pricing[:custom_plan_name] %></h3>
          </div>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-baseline justify-between mb-4">
          <div>
            <span class="text-xs text-slate-400 block">Hoy pagas</span>
            <span class="text-2xl font-black text-emerald-400">$0.00</span>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400 block">Después de 30 días</span>
            <span class="text-base font-extrabold text-white">$<%= sprintf('%.0f', pricing[:total_price].to_f) %> <span class="text-xs font-medium text-slate-400">USD/mes</span></span>
          </div>
        </div>

        <!-- Módulos incluidos -->
        <div class="mb-5">
          <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 mb-2">
            Herramientas listas para ti (<%= pricing[:enabled_keys].count %>):
          </div>
          <div class="grid grid-cols-1 gap-1.5">
            <% pricing[:enabled_keys].each do |mod_key| %>
              <% mod = AppModule.find(mod_key) %>
              <% next unless mod %>
              <div class="flex items-center gap-2 text-xs text-slate-200 bg-slate-900/50 px-3 py-2 rounded-xl border border-slate-800/70">
                <span class="text-emerald-400 font-black">✓</span>
                <span><%= mod[:icon] %></span>
                <span class="font-semibold truncate"><%= mod[:name] %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Selector rápido de combo -->
        <div class="pt-4 border-t border-slate-800/80">
          <div class="text-[11px] font-bold text-slate-400 mb-2">¿Prefieres otro combo para tu prueba?</div>
          <div class="flex flex-wrap gap-1.5">
            <% AppModule.packages.each do |pkg| %>
              <% is_current = (pkg[:key] == active_plan) %>
              <%= link_to new_user_registration_path(plan: pkg[:key], company_name: @company_name),
                  class: "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[11px] font-bold transition-all #{is_current ? 'bg-cyan-500 text-slate-950 shadow' : 'bg-slate-900 text-slate-300 border border-slate-800 hover:border-cyan-500/40'}" do %>
                <span><%= pkg[:icon] %></span>
                <span><%= pkg[:key].capitalize %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Tarjetas de Tranquilidad -->
      <div class="p-5 rounded-3xl bg-slate-900/50 border border-slate-800/80 space-y-3">
        <div class="flex items-center gap-3 text-xs text-slate-300">
          <span class="text-emerald-400 font-black text-base">⚡</span>
          <span><strong>Configuración guiada de 5 preguntas:</strong> en menos de 1 minuto tu empresa queda lista.</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-slate-300">
          <span class="text-cyan-400 font-black text-base">🔒</span>
          <span><strong>Seguridad total:</strong> espacio privado aislado y cifrado para tus finanzas y clientes.</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-slate-300">
          <span class="text-indigo-400 font-black text-base">👥</span>
          <span><strong>Equipo ilimitado:</strong> invita gratis a tus músicos, staff o socios con un enlace.</span>
        </div>
      </div>

    </div>

    <!-- Columna Derecha: Formulario de Registro -->
    <div class="lg:col-span-7 w-full max-w-lg mx-auto order-1 lg:order-2">
      <div class="p-7 sm:p-9 rounded-3xl bg-slate-900/85 border border-slate-800 shadow-2xl backdrop-blur-xl">

        <div class="text-center mb-6">
          <img src="/icons/logo.svg" alt="GigManager Logo" width="52" height="52" style="width: 52px; height: 52px; object-fit: contain;" class="w-13 h-13 rounded-2xl shadow-xl shadow-cyan-500/25 mx-auto mb-3" />
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Activa tus 30 Días Gratis</h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Paso 1 de 2: Crea tu acceso y luego personaliza tu app en 5 preguntas rápidas</p>
        </div>

        <!-- Mensajes de Estado -->
        <% if flash[:alert].present? %>
          <div class="mb-5 p-4 rounded-2xl bg-rose-500/15 border border-rose-500/40 text-rose-200 text-sm flex items-start gap-3">
            <span class="text-lg flex-shrink-0">❌</span>
            <div class="flex-1 text-xs font-medium leading-relaxed"><%= flash[:alert] %></div>
          </div>
        <% end %>

        <!-- Botón Google (Mantiene el combo guardado en sesión) -->
        <div>
          <%= button_to user_google_oauth2_omniauth_authorize_path,
              method: :post,
              form: { data: { turbo: false } },
              data: { turbo: false },
              class: "w-full flex items-center justify-center gap-3 py-3.5 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold text-sm shadow-lg shadow-black/20 hover:shadow-xl transition-all cursor-pointer border border-slate-200" do %>
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Continuar rápido con Google</span>
          <% end %>
        </div>

        <div class="relative my-5">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-800"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-slate-900 px-3 text-slate-400 font-semibold tracking-wider">o regístrate con tu correo</span>
          </div>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4", data: { turbo: false } }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <%= hidden_field_tag :plan, active_plan %>
          <%= hidden_field_tag :modules, active_modules.join(',') %>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Tu Nombre</label>
              <%= f.text_field :name, autofocus: true, placeholder: "Ej. Carlos Mendoza",
                  class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Banda / Empresa <span class="text-slate-500 normal-case font-normal">(opcional)</span></label>
              <%= text_field_tag :company_name, @company_name, placeholder: "Ej. Orquesta Los Titanes",
                  class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all" %>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Correo Electrónico</label>
            <%= f.email_field :email, autocomplete: "email", placeholder: "director@tuagrupacion.com",
                class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Contraseña</label>
              <div class="relative">
                <%= f.password_field :password, autocomplete: "new-password", placeholder: "Mínimo 6 caracteres", id: "signup-password-field",
                    class: "w-full px-4 py-3 pr-11 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
                <button type="button" onclick="toggleSignupPassword('signup-password-field', this)" aria-label="Mostrar contraseña"
                        class="absolute inset-y-0 right-0 px-3 flex items-center text-slate-400 hover:text-cyan-400 text-sm cursor-pointer bg-transparent border-0">👁️</button>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Confirmar Contraseña</label>
              <div class="relative">
                <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repítela aquí", id: "signup-password-confirm-field",
                    class: "w-full px-4 py-3 pr-11 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all", required: true %>
                <button type="button" onclick="toggleSignupPassword('signup-password-confirm-field', this)" aria-label="Mostrar confirmación"
                        class="absolute inset-y-0 right-0 px-3 flex items-center text-slate-400 hover:text-cyan-400 text-sm cursor-pointer bg-transparent border-0">👁️</button>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <%= f.submit "Crear Cuenta y Configurar en 5 Pasos ⚡",
                class: "w-full py-4 px-5 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-slate-950 font-black text-sm shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 cursor-pointer transition-all text-center" %>
          </div>

          <p class="text-[11px] text-slate-500 text-center leading-relaxed">
            🔒 Sin cobros ni tarjetas hoy. Al finalizar tus 30 días decides si continúas con tu combo elegido.
          </p>
        <% end %>

        <div class="mt-5 pt-4 border-t border-slate-800/80 text-center text-xs text-slate-400">
          <span>¿Ya tienes una cuenta en GigManager?</span>
          <%= link_to "Iniciar Sesión →", new_user_session_path, class: "font-bold text-cyan-400 hover:text-cyan-300 ml-1" %>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  function toggleSignupPassword(inputId, btn) {
    var input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  }
</script>