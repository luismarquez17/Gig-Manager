<div style="max-width: 1100px; margin: 0 auto; padding: 20px 10px; font-family: 'Inter', sans-serif;">

  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 30px;">
    <div>
      <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: #eff6ff; border: 1px solid #bfdbfe; color: #2563eb; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px;">
        <span>👑 Superadmin Dashboard</span>
      </div>
      <h1 style="font-size: 2rem; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.5px;">Verificación de Pagos (Venezuela / Manual)</h1>
      <p style="color: #64748b; font-size: 0.9rem; margin: 4px 0 0 0;">Aprueba en 1 clic los pagos reportados por Pago Móvil Bancamiga, Zelle, Binance Pay o Transferencia.</p>
    </div>
    <%= link_to superadmin_companies_path, style: "padding: 10px 18px; border-radius: 10px; background: #e2e8f0; color: #334155; text-decoration: none; font-size: 0.88rem; font-weight: 700; transition: background 0.2s;" do %>
      ← Volver a Empresas
    <% end %>
  </div>

  <!-- Sección 1: Pagos Pendientes -->
  <div style="margin-bottom: 45px;">
    <h2 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
      <span>⏳</span>
      <span>Pagos Pendientes de Verificación (<%= @pending_payments.count %>)</span>
    </h2>

    <% if @pending_payments.empty? %>
      <div style="padding: 40px; text-align: center; border-radius: 20px; background: white; border: 1px solid #e2e8f0; color: #64748b;">
        <div style="font-size: 2.2rem; margin-bottom: 8px;">✨</div>
        <p style="font-weight: 600; margin: 0;">No hay pagos pendientes por revisar en este momento.</p>
      </div>
    <% else %>
      <div style="display: flex; flex-direction: column; gap: 15px;">
        <% @pending_payments.each do |payment| %>
          <div style="padding: 24px; border-radius: 20px; background: white; border: 2px solid #3b82f6; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; box-shadow: 0 8px 25px rgba(59,130,246,0.1);">
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span style="padding: 3px 10px; border-radius: 6px; font-size: 0.72rem; font-weight: 800; background: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                  PENDIENTE
                </span>
                <span style="font-size: 0.85rem; font-weight: 800; color: #4338ca;">Plan <%= payment.plan_tier.to_s.capitalize %></span>
                <span style="font-size: 0.78rem; color: #94a3b8;">hace <%= time_ago_in_words(payment.created_at) %></span>
              </div>
              <h3 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 2px 0;"><%= payment.company.name %></h3>
              <div style="font-size: 0.88rem; color: #334155; display: flex; flex-wrap: wrap; gap: 15px;">
                <span>👤 Reportado por: <strong><%= payment.user.display_name %></strong> (<%= payment.user.email %>)</span>
                <span>💳 Método: <strong><%= payment.payment_method_label %></strong></span>
                <span>🔢 Ref #: <strong style="color: #0284c7; font-family: monospace; font-size: 1rem;"><%= payment.reference_number %></strong></span>
                <span>💰 Monto: <strong style="color: #059669; font-weight: 800;">$<%= '%.2f' % payment.amount %> USD</strong></span>
              </div>
              <% if payment.notes.present? %>
                <p style="font-size: 0.8rem; color: #64748b; font-style: italic; background: #f8fafc; padding: 6px 12px; border-radius: 8px; margin: 4px 0 0 0; border: 1px solid #f1f5f9;">"<%= payment.notes %>"</p>
              <% end %>
            </div>

            <div style="display: flex; gap: 10px; align-items: center;">
              <%= button_to approve_superadmin_subscription_payment_path(payment), method: :post, data: { turbo: false }, style: "padding: 12px 20px; border-radius: 12px; background: #059669; color: white; font-weight: 800; font-size: 0.9rem; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(5,150,105,0.3);" do %>
                Aprobar y Activar 30 Días ✓
              <% end %>
              <%= button_to reject_superadmin_subscription_payment_path(payment), method: :post, data: { confirm: "¿Estás seguro de rechazar este pago?" }, style: "padding: 12px 16px; border-radius: 12px; background: #fff1f2; color: #be123c; border: 1px solid #fca5a5; font-weight: 700; font-size: 0.88rem; cursor: pointer;" do %>
                Rechazar ✕
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Sección 2: Historial Reciente -->
  <div>
    <h2 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
      <span>📜</span>
      <span>Historial de Pagos Procesados</span>
    </h2>

    <div style="background: white; border-radius: 20px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em;">
            <th style="padding: 14px 18px;">Empresa</th>
            <th style="padding: 14px 18px;">Plan</th>
            <th style="padding: 14px 18px;">Método / Ref</th>
            <th style="padding: 14px 18px;">Monto</th>
            <th style="padding: 14px 18px;">Estado</th>
            <th style="padding: 14px 18px;">Fecha</th>
            <th style="padding: 14px 18px;">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if @recent_payments.empty? %>
            <tr>
              <td colspan="7" style="padding: 30px; text-align: center; color: #94a3b8;">No hay pagos procesados recientemente.</td>
            </tr>
          <% else %>
            <% @recent_payments.each do |payment| %>
              <tr style="border-bottom: 1px solid #f1f5f9;">
                <td style="padding: 14px 18px; font-weight: 700; color: #0f172a;"><%= payment.company.name %></td>
                <td style="padding: 14px 18px;"><span style="padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe;"><%= payment.plan_tier.to_s.capitalize %></span></td>
                <td style="padding: 14px 18px;">
                  <div style="font-weight: 600; color: #1e293b;"><%= payment.payment_method_label %></div>
                  <div style="font-size: 0.78rem; font-family: monospace; color: #64748b;">#<%= payment.reference_number %></div>
                </td>
                <td style="padding: 14px 18px; font-weight: 800; color: #059669;">$<%= '%.2f' % payment.amount %></td>
                <td style="padding: 14px 18px;">
                  <% if payment.approved? %>
                    <span style="padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">APROBADO</span>
                  <% else %>
                    <span style="padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; background: #fff1f2; color: #be123c; border: 1px solid #fca5a5;">RECHAZADO</span>
                  <% end %>
                </td>
                <td style="padding: 14px 18px; font-size: 0.8rem; color: #64748b;"><%= payment.updated_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td style="padding: 14px 18px;">
                  <% if payment.whatsapp_confirmation_url.present? %>
                    <a href="<%= payment.whatsapp_confirmation_url %>" target="_blank" style="display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 8px; background: #ecfdf5; color: #059669; font-weight: 700; font-size: 0.8rem; text-decoration: none; border: 1px solid #a7f3d0;">
                      <span>💬 WhatsApp</span>
                    </a>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
