<style>
  @media (max-width: 768px) {
    .sp-mobile-header h1 {
      font-size: 1.5rem !important;
    }
    .sp-mobile-card {
      padding: 16px !important;
      border-radius: 16px !important;
      flex-direction: column !important;
      align-items: stretch !important;
    }
    .sp-mobile-actions {
      width: 100% !important;
      flex-direction: column !important;
    }
    .sp-mobile-actions button,
    .sp-mobile-actions form {
      width: 100% !important;
    }
    .sp-mobile-table-wrapper {
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch;
    }
    .sp-modal-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<div style="max-width: 1100px; margin: 0 auto; padding: 20px 10px; font-family: 'Inter', sans-serif;">

  <div class="sp-mobile-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 30px;">
    <div>
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 8px;">
        <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: #eff6ff; border: 1px solid #bfdbfe; color: #2563eb; font-size: 0.78rem; font-weight: 800; text-transform: uppercase;">
          <span>👑 Superadmin Dashboard</span>
        </div>
        <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: #ecfdf5; border: 1px solid #a7f3d0; color: #059669; font-size: 0.76rem; font-weight: 800;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
          <span>Alertas en Tiempo Real Activas</span>
        </div>
      </div>
      <h1 style="font-size: 2rem; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.5px;">Verificación de Pagos SaaS</h1>
      <p style="color: #64748b; font-size: 0.9rem; margin: 4px 0 0 0;">Revisa la foto del comprobante y los datos del reporte para aprobar y activar 30 días en 1 clic.</p>
    </div>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <%= link_to superadmin_dashboard_path, style: "padding: 10px 18px; border-radius: 10px; background: #3b82f6; color: white; text-decoration: none; font-size: 0.88rem; font-weight: 700; box-shadow: 0 4px 12px rgba(59,130,246,0.25);" do %>
        📊 Panel Universo
      <% end %>
      <%= link_to superadmin_companies_path, style: "padding: 10px 18px; border-radius: 10px; background: #e2e8f0; color: #334155; text-decoration: none; font-size: 0.88rem; font-weight: 700; transition: background 0.2s;" do %>
        🏢 Empresas
      <% end %>
    </div>
  </div>

  <!-- Sección 1: Pagos Pendientes (Se actualiza en tiempo real vía Turbo Streams) -->
  <div style="margin-bottom: 45px;">
    <h2 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
      <span>⏳</span>
      <span>Pagos Pendientes de Verificación (<span id="superadmin-pending-count-text"><%= @pending_payments.count %></span>)</span>
    </h2>

    <div id="superadmin-pending-payments-list" style="display: flex; flex-direction: column; gap: 15px;">
      <% if @pending_payments.empty? %>
        <div id="superadmin-no-pending-payments" style="padding: 40px; text-align: center; border-radius: 20px; background: white; border: 1px solid #e2e8f0; color: #64748b;">
          <div style="font-size: 2.2rem; margin-bottom: 8px;">✨</div>
          <p style="font-weight: 700; margin: 0; color: #334155;">No hay pagos pendientes por revisar en este momento.</p>
          <p style="font-size: 0.84rem; margin: 6px 0 0 0;">Cuando un líder envíe un reporte de pago con su captura, aparecerá aquí al instante con alerta sonora.</p>
        </div>
      <% else %>
        <% @pending_payments.each do |payment| %>
          <%= render partial: "superadmin/subscription_payments/pending_payment_card", locals: { payment: payment } %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Sección 2: Historial Reciente -->
  <div>
    <h2 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
      <span>📜</span>
      <span>Historial de Pagos Procesados</span>
    </h2>

    <div class="sp-mobile-table-wrapper" style="background: white; border-radius: 20px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em;">
            <th style="padding: 14px 18px;">Empresa</th>
            <th style="padding: 14px 18px;">Plan</th>
            <th style="padding: 14px 18px;">Método / Ref</th>
            <th style="padding: 14px 18px;">Captura</th>
            <th style="padding: 14px 18px;">Monto</th>
            <th style="padding: 14px 18px;">Estado</th>
            <th style="padding: 14px 18px;">Fecha</th>
            <th style="padding: 14px 18px;">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if @recent_payments.empty? %>
            <tr>
              <td colspan="8" style="padding: 30px; text-align: center; color: #94a3b8;">No hay pagos procesados recientemente.</td>
            </tr>
          <% else %>
            <% @recent_payments.each do |payment| %>
              <tr style="border-bottom: 1px solid #f1f5f9;">
                <td style="padding: 14px 18px; font-weight: 700; color: #0f172a;">
                  <div><%= payment.company&.name || 'Empresa' %></div>
                  <div style="font-size: 0.76rem; color: #64748b; font-weight: 500;"><%= payment.user&.email %></div>
                </td>
                <td style="padding: 14px 18px;"><span style="padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe;"><%= payment.plan_tier.to_s.capitalize %></span></td>
                <td style="padding: 14px 18px;">
                  <div style="font-weight: 600; color: #1e293b;"><%= payment.payment_method_label %></div>
                  <div style="font-size: 0.78rem; font-family: monospace; color: #64748b;">#<%= payment.reference_number %></div>
                </td>
                <td style="padding: 14px 18px;">
                  <% if payment.voucher_attached? %>
                    <button type="button"
                            onclick="openVoucherPreviewOnly('<%= payment.voucher_url_or_data %>', '<%= ERB::Util.html_escape(payment.company&.name || 'Empresa') %> • Ref #<%= ERB::Util.html_escape(payment.reference_number) %>')"
                            style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 8px; background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; font-weight: 700; font-size: 0.78rem; cursor: pointer;">
                      <span>📸</span> Ver Foto
                    </button>
                  <% else %>
                    <span style="font-size: 0.78rem; color: #94a3b8;">Sin foto</span>
                  <% end %>
                </td>
                <td style="padding: 14px 18px; font-weight: 800; color: #059669;">$<%= '%.2f' % payment.amount %></td>
                <td style="padding: 14px 18px;">
                  <% if payment.approved? %>
                    <span style="padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">APROBADO</span>
                  <% else %>
                    <span style="padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; background: #fff1f2; color: #be123c; border: 1px solid #fca5a5;" title="<%= payment.rejection_reason %>">RECHAZADO</span>
                  <% end %>
                </td>
                <td style="padding: 14px 18px; font-size: 0.8rem; color: #64748b;"><%= payment.updated_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td style="padding: 14px 18px;">
                  <% if payment.whatsapp_confirmation_url.present? %>
                    <a href="<%= payment.whatsapp_confirmation_url %>" target="_blank" style="display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 8px; background: #ecfdf5; color: #059669; font-weight: 700; font-size: 0.8rem; text-decoration: none; border: 1px solid #a7f3d0;">
                      <span>💬 WhatsApp</span>
                    </a>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- MODAL VISOR DE COMPROBANTE + APROBACIÓN / RECHAZO -->
<div id="sp-inspector-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box;">
  <div style="background: white; border-radius: 24px; max-width: 820px; width: 100%; max-height: 92vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,0.45); border: 1px solid #e2e8f0; padding: 26px; box-sizing: border-box; position: relative;">

    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid #e2e8f0;">
      <div>
        <span style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: #2563eb; background: #eff6ff; padding: 3px 10px; border-radius: 99px; border: 1px solid #bfdbfe;">Verificación de Comprobante</span>
        <h3 id="sp-modal-company" style="margin: 6px 0 0 0; font-size: 1.35rem; font-weight: 800; color: #0f172a;">Empresa</h3>
      </div>
      <button type="button" onclick="closePaymentInspectorModal()" style="width: 36px; height: 36px; border-radius: 50%; background: #f1f5f9; border: 1px solid #e2e8f0; color: #475569; font-size: 1.1rem; font-weight: 700; cursor: pointer;">✕</button>
    </div>

    <div class="sp-modal-grid" style="display: grid; grid-template-columns: 1.1fr 1fr; gap: 22px; align-items: start;">
      <!-- Columna Foto del Comprobante -->
      <div style="background: #0f172a; border-radius: 16px; padding: 14px; text-align: center; border: 1px solid #1e293b;">
        <div id="sp-modal-voucher-wrap">
          <img id="sp-modal-voucher-img" src="" alt="Comprobante" style="max-height: 400px; max-width: 100%; border-radius: 10px; object-fit: contain; margin: 0 auto; display: block;">
          <a id="sp-modal-voucher-link" href="#" target="_blank" style="display: inline-block; margin-top: 10px; font-size: 0.78rem; color: #38bdf8; font-weight: 700; text-decoration: none;">
            🔗 Abrir foto en pestaña completa
          </a>
        </div>
        <div id="sp-modal-no-voucher" style="display: none; padding: 50px 20px; color: #94a3b8;">
          <div style="font-size: 2.5rem; margin-bottom: 8px;">🧾</div>
          <div style="font-weight: 700; color: #e2e8f0; font-size: 0.92rem;">Sin fotografía adjunta</div>
          <div style="font-size: 0.8rem; margin-top: 4px;">El usuario reportó el pago únicamente con número de referencia.</div>
        </div>
      </div>

      <!-- Columna Datos + Acciones -->
      <div id="sp-modal-details-col" style="display: flex; flex-direction: column; gap: 14px;">
        <div style="background: #f8fafc; border-radius: 16px; padding: 16px; border: 1px solid #e2e8f0; font-size: 0.86rem; color: #334155; display: flex; flex-direction: column; gap: 8px;">
          <div style="display: flex; justify-content: space-between; gap: 10px;">
            <span style="color: #64748b;">Monto reportado:</span>
            <strong id="sp-modal-amount" style="color: #059669; font-size: 1.05rem;">$0.00 USD</strong>
          </div>
          <div style="display: flex; justify-content: space-between; gap: 10px;">
            <span style="color: #64748b;">Plan / Combo:</span>
            <strong id="sp-modal-plan" style="color: #4338ca;">-</strong>
          </div>
          <div style="display: flex; justify-content: space-between; gap: 10px;">
            <span style="color: #64748b;">Método:</span>
            <strong id="sp-modal-method">-</strong>
          </div>
          <div style="display: flex; justify-content: space-between; gap: 10px;">
            <span style="color: #64748b;">Nº Referencia:</span>
            <strong id="sp-modal-reference" style="color: #0284c7; font-family: monospace; font-size: 0.95rem;">-</strong>
          </div>
          <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 4px 0;">
          <div><span style="color: #64748b;">Reportado por:</span> <strong id="sp-modal-leader">-</strong></div>
          <div><span style="color: #64748b;">Correo:</span> <span id="sp-modal-email">-</span></div>
          <div><span style="color: #64748b;">Teléfono / WA:</span> <strong id="sp-modal-phone">-</strong></div>
          <div><span style="color: #64748b;">Fecha envío:</span> <span id="sp-modal-time">-</span></div>
          <div id="sp-modal-notes-wrap" style="display: none; background: white; padding: 8px 10px; border-radius: 8px; border: 1px solid #e2e8f0; font-style: italic; color: #475569;">
            "<span id="sp-modal-notes"></span>"
          </div>
        </div>

        <!-- Botones de Acción (solo cuando está pendiente) -->
        <div id="sp-modal-actions-wrap" style="display: flex; flex-direction: column; gap: 10px;">
          <form id="sp-modal-approve-form" action="#" method="post" data-turbo="false" onsubmit="return syncAndConfirmPaymentForm(this);" style="margin: 0;">
            <input type="hidden" name="authenticity_token" value="">
            <button type="submit" style="width: 100%; padding: 14px 18px; border-radius: 12px; background: linear-gradient(135deg, #059669, #10b981); color: white; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 6px 16px rgba(5,150,105,0.28);">
              ✅ Aprobar Pago y Activar 30 Días
            </button>
          </form>

          <form id="sp-modal-reject-form" action="#" method="post" data-turbo="false" onsubmit="return syncAndConfirmPaymentForm(this);" data-confirm-message="¿Seguro que deseas rechazar este reporte de pago?" style="background: #fff1f2; border: 1px solid #fecaca; border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 8px; margin: 0;">
            <input type="hidden" name="authenticity_token" value="">
            <label style="font-size: 0.76rem; font-weight: 800; color: #9f1239;">Motivo de rechazo (opcional):</label>
            <input type="text" name="reason" id="sp-modal-reject-reason" placeholder="Ej. Referencia no encontrada o captura ilegible" style="width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid #fda4af; font-size: 0.82rem; box-sizing: border-box;">
            <button type="submit" style="width: 100%; padding: 10px; border-radius: 10px; background: #be123c; color: white; font-weight: 800; font-size: 0.84rem; border: none; cursor: pointer;">
              ❌ Rechazar Comprobante
            </button>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function syncAndConfirmPaymentForm(form) {
    var tokenMeta = document.querySelector('meta[name="csrf-token"]');
    var tokenInput = form.querySelector('input[name="authenticity_token"]');
    if (tokenMeta && tokenInput) {
      tokenInput.value = tokenMeta.getAttribute('content') || '';
    }
    var msg = form.getAttribute('data-confirm-message');
    if (msg) {
      return window.confirm(msg);
    }
    return true;
  }

  function openPaymentInspectorModal(btn, focusReject) {
    var modal = document.getElementById('sp-inspector-modal');
    if (!modal || !btn) return;

    var company = btn.getAttribute('data-company') || 'Empresa';
    var amount = btn.getAttribute('data-amount') || '';
    var voucher = btn.getAttribute('data-voucher') || '';
    var notes = btn.getAttribute('data-notes') || '';

    document.getElementById('sp-modal-company').textContent = company;
    document.getElementById('sp-modal-amount').textContent = amount;
    document.getElementById('sp-modal-plan').textContent = btn.getAttribute('data-plan') || '-';
    document.getElementById('sp-modal-method').textContent = btn.getAttribute('data-method') || '-';
    document.getElementById('sp-modal-reference').textContent = '#' + (btn.getAttribute('data-reference') || '-');
    document.getElementById('sp-modal-leader').textContent = btn.getAttribute('data-leader') || '-';
    document.getElementById('sp-modal-email').textContent = btn.getAttribute('data-email') || '-';
    document.getElementById('sp-modal-phone').textContent = btn.getAttribute('data-phone') || '-';
    document.getElementById('sp-modal-time').textContent = btn.getAttribute('data-time') || '-';

    var notesWrap = document.getElementById('sp-modal-notes-wrap');
    if (notes.trim().length > 0) {
      document.getElementById('sp-modal-notes').textContent = notes;
      notesWrap.style.display = 'block';
    } else {
      notesWrap.style.display = 'none';
    }

    var voucherWrap = document.getElementById('sp-modal-voucher-wrap');
    var noVoucher = document.getElementById('sp-modal-no-voucher');
    if (voucher.length > 0) {
      document.getElementById('sp-modal-voucher-img').src = voucher;
      document.getElementById('sp-modal-voucher-link').href = voucher;
      voucherWrap.style.display = 'block';
      noVoucher.style.display = 'none';
    } else {
      voucherWrap.style.display = 'none';
      noVoucher.style.display = 'block';
    }

    var approveForm = document.getElementById('sp-modal-approve-form');
    var rejectForm = document.getElementById('sp-modal-reject-form');
    approveForm.action = btn.getAttribute('data-approve-url') || '#';
    approveForm.setAttribute('data-confirm-message', '¿Aprobar el pago de ' + company + ' (' + amount + ') y activar 30 días?');
    rejectForm.action = btn.getAttribute('data-reject-url') || '#';

    document.getElementById('sp-modal-details-col').style.display = 'flex';
    document.getElementById('sp-modal-actions-wrap').style.display = 'flex';
    modal.style.display = 'flex';

    if (focusReject) {
      setTimeout(function() {
        var rInput = document.getElementById('sp-modal-reject-reason');
        if (rInput) rInput.focus();
      }, 100);
    }
  }

  function openVoucherPreviewOnly(voucherSrc, title) {
    var modal = document.getElementById('sp-inspector-modal');
    if (!modal) return;
    document.getElementById('sp-modal-company').textContent = title || 'Comprobante de Pago';
    document.getElementById('sp-modal-voucher-img').src = voucherSrc;
    document.getElementById('sp-modal-voucher-link').href = voucherSrc;
    document.getElementById('sp-modal-voucher-wrap').style.display = 'block';
    document.getElementById('sp-modal-no-voucher').style.display = 'none';
    document.getElementById('sp-modal-actions-wrap').style.display = 'none';
    modal.style.display = 'flex';
  }

  function closePaymentInspectorModal() {
    var modal = document.getElementById('sp-inspector-modal');
    if (modal) modal.style.display = 'none';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closePaymentInspectorModal();
  });
</script>
