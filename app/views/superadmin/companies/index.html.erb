<div style="max-width: 1200px; margin: 0 auto;">
  
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
    <div>
      <h1 style="margin: 0; font-size: 1.8rem; font-weight: 800; color: #0f172a;">🏢 Directorio Completo de Empresas</h1>
      <p style="margin: 4px 0 0 0; color: #64748b; font-size: 0.9rem;">Empresas registradas en la plataforma Gig Manager</p>
    </div>

    <%= link_to new_superadmin_company_path, style: "background: #6366f1; color: white; padding: 12px 20px; border-radius: 10px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;" do %>
      <span>✨ Nueva Empresa</span>
    <% end %>
  </div>

  <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden;">
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
        <thead>
          <tr style="background: #f8fafc; color: #64748b; font-weight: 600; border-bottom: 1px solid #e2e8f0;">
            <th style="padding: 14px 20px;">Nombre / Slug</th>
            <th style="padding: 14px 20px;">Estado</th>
            <th style="padding: 14px 20px;">Cuota Mensual</th>
            <th style="padding: 14px 20px;">Jefe / Leader</th>
            <th style="padding: 14px 20px;">Usuarios / Shows</th>
            <th style="padding: 14px 20px; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @companies.each do |company| %>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 16px 20px;">
                <div style="font-weight: 700; color: #0f172a;"><%= company.name %></div>
                <div style="color: #64748b; font-size: 0.8rem; font-family: monospace;">/<%= company.slug %></div>
              </td>

              <td style="padding: 16px 20px;">
                <% case company.status.to_sym %>
                <% when :active %>
                  <span style="background: #dcfce7; color: #15803d; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px;">Activa</span>
                <% when :suspended %>
                  <span style="background: #ffe4e6; color: #be123c; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px;">Suspendida</span>
                <% when :past_due %>
                  <span style="background: #fef3c7; color: #b45309; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px;">Pago Vencido</span>
                <% when :trial %>
                  <span style="background: #dbeafe; color: #1d4ed8; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px;">Prueba</span>
                <% end %>
              </td>

              <td style="padding: 16px 20px; font-weight: 700; color: #0f172a;">
                <%= number_to_currency(company.monthly_fee, unit: company.currency + " ", precision: 2) %>/mes
              </td>

              <td style="padding: 16px 20px;">
                <% leader = company.primary_leader %>
                <% if leader %>
                  <div style="font-weight: 600; color: #334155;"><%= leader.display_name %></div>
                  <div style="font-size: 0.78rem; color: #64748b;"><%= leader.email %></div>
                <% else %>
                  <span style="color: #94a3b8; font-style: italic; font-size: 0.85rem;">Sin asignación</span>
                <% end %>
              </td>

              <td style="padding: 16px 20px; color: #475569;">
                <span style="font-weight: 600; color: #0f172a;"><%= company.users.count %></span> usuarios |
                <span style="font-weight: 600; color: #0f172a;"><%= company.gigs.count %></span> shows
              </td>

              <td style="padding: 16px 20px; text-align: right;">
                <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                  <% if company.primary_leader.present? && company.id != current_user.company_id %>
                    <span style="background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 0.78rem;" title="Esta empresa es privada. No es posible acceder a sus datos internos.">
                      🔒 Privada
                    </span>
                  <% else %>
                    <%= button_to switch_tenant_superadmin_company_path(company), method: :post, style: "background: #e0e7ff; color: #4338ca; border: none; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 0.8rem; cursor: pointer;" do %>
                      👁️ Ver como
                    <% end %>
                  <% end %>

                  <%= link_to superadmin_company_path(company), style: "background: #f1f5f9; color: #334155; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 0.8rem; text-decoration: none;" do %>
                    ⚙️ Gestionar
                  <% end %>
                </div>

              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
