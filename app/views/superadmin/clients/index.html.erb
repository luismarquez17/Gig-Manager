<div style="max-width: 1200px; margin: 0 auto; padding-bottom: 40px;">
  
  <%# Breadcrumb %>
  <div style="margin-bottom: 20px;">
    <%= link_to "← Volver al Panel Superadmin", superadmin_dashboard_path, style: "color: #6366f1; text-decoration: none; font-weight: 600; font-size: 0.9rem;" %>
  </div>

  <%# Header Banner %>
  <div style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); border-radius: 20px; padding: 32px; color: white; box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.3); border: 1px solid rgba(255,255,255,0.1); margin-bottom: 32px; position: relative; overflow: hidden;">
    <div style="position: absolute; right: -20px; top: -20px; font-size: 10rem; opacity: 0.05; pointer-events: none;">🎟️</div>
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(99, 102, 241, 0.2); border: 1px solid rgba(99, 102, 241, 0.4); color: #818cf8; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 12px;">
          <span>🌐 Control del Universo</span>
        </div>
        <h1 style="margin: 0; font-size: 2.2rem; font-weight: 800; tracking: -0.02em; color: white;">Clientes & Usuarios en Gig</h1>
        <p style="margin: 8px 0 0 0; color: #94a3b8; font-size: 1rem;">Visión completa de todos los clientes registrados por las agrupaciones y la tasa de activación de cuentas de usuario en el portal.</p>
      </div>
      <div>
        <%= link_to superadmin_dashboard_path, style: "display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.1); color: white; border: 1px solid rgba(255, 255, 255, 0.2); padding: 12px 20px; border-radius: 12px; font-weight: 700; text-decoration: none;" do %>
          <span>📊 Ver Métricas Globales</span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Tarjetas de Métricas Globales %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px;">
    
    <%# Total Clientes %>
    <div style="background: white; border-radius: 16px; padding: 22px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
        <span style="color: #64748b; font-weight: 600; font-size: 0.88rem;">Total Clientes</span>
        <div style="width: 38px; height: 38px; border-radius: 10px; background: #ecfeff; color: #0891b2; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">🎟️</div>
      </div>
      <div style="font-size: 2rem; font-weight: 800; color: #0f172a;">
        <%= @total_clients %>
      </div>
      <p style="margin: 4px 0 0 0; font-size: 0.82rem; color: #64748b;">
        Registrados en el universo
      </p>
    </div>

    <%# Con Usuario Creado %>
    <div style="background: white; border-radius: 16px; padding: 22px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
        <span style="color: #64748b; font-weight: 600; font-size: 0.88rem;">Con Usuario Creado</span>
        <div style="width: 38px; height: 38px; border-radius: 10px; background: #ecfdf5; color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">✓</div>
      </div>
      <div style="display: flex; align-items: baseline; gap: 8px;">
        <div style="font-size: 2rem; font-weight: 800; color: #15803d;">
          <%= @clients_with_user %>
        </div>
        <span style="background: #dcfce7; color: #166534; font-weight: 800; font-size: 0.78rem; padding: 2px 8px; border-radius: 12px;">
          <%= @adoption_rate %>% adopción
        </span>
      </div>
      <p style="margin: 4px 0 0 0; font-size: 0.82rem; color: #15803d; font-weight: 600;">
        Con acceso al portal cliente
      </p>
    </div>

    <%# Sin Usuario Creado %>
    <div style="background: white; border-radius: 16px; padding: 22px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
        <span style="color: #64748b; font-weight: 600; font-size: 0.88rem;">Sin Usuario en Gig</span>
        <div style="width: 38px; height: 38px; border-radius: 10px; background: #fffbeb; color: #b45309; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">⚠️</div>
      </div>
      <div style="font-size: 2rem; font-weight: 800; color: #b45309;">
        <%= @clients_without_user %>
      </div>
      <p style="margin: 4px 0 0 0; font-size: 0.82rem; color: #64748b;">
        Solo registrados en CRM / eventos
      </p>
    </div>

    <%# Con Shows Registrados %>
    <div style="background: white; border-radius: 16px; padding: 22px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
        <span style="color: #64748b; font-weight: 600; font-size: 0.88rem;">Clientes con Shows</span>
        <div style="width: 38px; height: 38px; border-radius: 10px; background: #faf5ff; color: #8b5cf6; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">🎸</div>
      </div>
      <div style="font-size: 2rem; font-weight: 800; color: #7e22ce;">
        <%= @clients_active %>
      </div>
      <p style="margin: 4px 0 0 0; font-size: 0.82rem; color: #64748b;">
        Han contratado al menos 1 show
      </p>
    </div>

  </div>

  <%# Barra de Búsqueda y Filtros %>
  <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 24px;">
    <%= form_with url: superadmin_clients_path, method: :get, local: true, style: "display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-end;" do %>
      
      <%# Búsqueda por texto %>
      <div style="flex: 2; min-width: 240px;">
        <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;">Buscar Cliente</label>
        <%= text_field_tag :query, params[:query], placeholder: "Nombre, email o teléfono...", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 0.9rem; box-sizing: border-box;" %>
      </div>

      <%# Filtro por Empresa %>
      <div style="flex: 1.5; min-width: 200px;">
        <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;">Empresa / Agrupación</label>
        <%= select_tag :company_id, options_from_collection_for_select(@companies, :id, :name, params[:company_id]), prompt: "Todas las empresas", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 0.9rem; box-sizing: border-box; background: white;" %>
      </div>

      <%# Filtro por Estado de Usuario %>
      <div style="flex: 1.5; min-width: 200px;">
        <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px;">Estado de Usuario en Gig</label>
        <%= select_tag :status, options_for_select([
              ["Todos los estados", ""],
              ["✓ Con Usuario Creado en Gig", "with_user"],
              ["⚠️ Sin Usuario Creado", "without_user"],
              ["🎸 Clientes con Shows", "with_gigs"]
            ], params[:status]), style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 0.9rem; box-sizing: border-box; background: white;" %>
      </div>

      <%# Botones de Acción %>
      <div style="display: flex; gap: 8px;">
        <%= submit_tag "Filtrar", style: "background: #6366f1; color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 700; font-size: 0.9rem; cursor: pointer;" %>
        <% if params[:query].present? || params[:company_id].present? || params[:status].present? %>
          <%= link_to "Limpiar", superadmin_clients_path, style: "background: #f1f5f9; color: #475569; padding: 10px 16px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center;" %>
        <% end %>
      </div>

    <% end %>
  </div>

  <%# Tabla de Clientes %>
  <div style="background: white; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      <div>
        <h2 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: #0f172a;">Listado de Clientes del Universo</h2>
        <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b;">
          Mostrando <%= @clients.size %> clientes
          <% if params[:company_id].present? %>
            <% comp = @companies.find { |c| c.id.to_s == params[:company_id].to_s } %>
            de <strong><%= comp&.name %></strong>
          <% end %>
          <% if params[:status].present? %>
            (filtro aplicado)
          <% end %>
        </p>
      </div>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
        <thead>
          <tr style="background: #f8fafc; color: #64748b; font-weight: 600; border-bottom: 1px solid #e2e8f0;">
            <th style="padding: 14px 20px;">Cliente</th>
            <th style="padding: 14px 20px;">Empresa</th>
            <th style="padding: 14px 20px;">Contacto</th>
            <th style="padding: 14px 20px;">Usuario en Gig</th>
            <th style="padding: 14px 20px;">Shows Contratados</th>
            <th style="padding: 14px 20px;">Fecha de Registro</th>
          </tr>
        </thead>
        <tbody>
          <% if @clients.empty? %>
            <tr>
              <td colspan="6" style="padding: 36px 20px; text-align: center; color: #94a3b8; font-style: italic;">
                No se encontraron clientes que coincidan con los filtros seleccionados.
              </td>
            </tr>
          <% else %>
            <% @clients.each do |client| %>
              <% c_user = client.gig_user %>
              <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s;">
                <td style="padding: 16px 20px;">
                  <div style="font-weight: 700; color: #0f172a; font-size: 0.95rem;">
                    <%= client.name %>
                  </div>
                  <% if client.notes.present? %>
                    <div style="font-size: 0.78rem; color: #94a3b8; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 2px;">
                      <%= client.notes %>
                    </div>
                  <% end %>
                </td>

                <td style="padding: 16px 20px;">
                  <% if client.company.present? %>
                    <%= link_to superadmin_company_path(client.company), style: "font-weight: 600; color: #6366f1; text-decoration: none; font-size: 0.9rem;" do %>
                      <%= client.company.name %>
                    <% end %>
                    <div style="color: #64748b; font-size: 0.78rem; font-family: monospace;">
                      /<%= client.company.slug %>
                    </div>
                  <% else %>
                    <span style="color: #94a3b8; font-style: italic;">Sin empresa</span>
                  <% end %>
                </td>

                <td style="padding: 16px 20px;">
                  <% if client.email.present? %>
                    <div style="color: #334155; font-size: 0.85rem;"><%= client.email %></div>
                  <% end %>
                  <% if client.phone.present? && client.phone != "0000000000" %>
                    <div style="color: #64748b; font-size: 0.8rem;"><%= client.phone %></div>
                  <% end %>
                  <% if client.email.blank? && (client.phone.blank? || client.phone == "0000000000") %>
                    <span style="color: #94a3b8; font-size: 0.8rem; font-style: italic;">Sin datos de contacto</span>
                  <% end %>
                </td>

                <td style="padding: 16px 20px;">
                  <% if c_user.present? %>
                    <span style="display: inline-flex; align-items: center; gap: 4px; background: #dcfce7; color: #15803d; font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px;">
                      ✓ Usuario Creado
                    </span>
                    <div style="font-size: 0.75rem; color: #64748b; margin-top: 3px;">
                      <%= c_user.email %>
                    </div>
                    <div style="font-size: 0.7rem; color: #94a3b8;">
                      Creado: <%= c_user.created_at.strftime("%d/%m/%Y") %>
                    </div>
                  <% else %>
                    <span style="display: inline-flex; align-items: center; gap: 4px; background: #fef3c7; color: #b45309; font-weight: 600; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px;">
                      ⚠️ Sin Usuario en Gig
                    </span>
                    <div style="font-size: 0.72rem; color: #94a3b8; margin-top: 2px;">Solo ficha de CRM / Shows</div>
                  <% end %>
                </td>

                <td style="padding: 16px 20px; color: #475569;">
                  <span style="font-weight: 700; color: #0f172a;"><%= client.gigs.size %></span> shows
                  <% if client.gigs.size > 0 %>
                    <div style="font-size: 0.75rem; color: #10b981; font-weight: 600;">
                      $<%= sprintf('%.2f', client.total_spent) %> USD
                    </div>
                  <% end %>
                </td>

                <td style="padding: 16px 20px; color: #64748b; font-size: 0.82rem;">
                  <%= client.created_at.strftime("%d/%m/%Y") %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
