<div style="background: white; padding: 30px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px rgba(0,0,0,0.05); font-family: 'Segoe UI', sans-serif; position: relative;">
  
  <%= link_to items_path, style: "position: absolute; top: 15px; right: 20px; text-decoration: none; color: #94a3b8; font-size: 1.2em;" do %> ✕ <% end %>

  <%= form_with(model: item, local: true) do |f| %>
    
    <%# 1. CATEGORÍA PRINCIPAL %>
    <div style="margin-bottom: 20px;">
      <%= f.label :category, "📂 Categoría del Equipo", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
      <%= f.select :category, 
          Item.categories, 
          { prompt: "--- Selecciona el tipo de equipo ---" }, 
          { id: "category-select", onchange: "updateFormLogic()", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; background: white; cursor: pointer;" } 
      %>
      
      <div style="margin-top: 8px; font-size: 0.85em;">
        ¿No ves la categoría que necesitas? 
        <a href="javascript:void(0);" onclick="toggleNewCategoryInlineForm();" style="color: #2563eb; font-weight: 600; text-decoration: none;">Crear una nueva categoría aquí</a>
      </div>
      
      <div id="inline-category-form-container" style="display: none; margin-top: 10px; padding: 15px; border-radius: 12px; background: #f8fafc; border: 1px solid #cbd5e1;">
        <p style="margin: 0 0 8px 0; font-size: 0.85em; font-weight: bold; color: #475569;">Crear nueva categoría:</p>
        <div style="display: flex; gap: 8px;">
          <input type="text" id="inline-category-name-input" placeholder="Ej: Cosas adicionales" style="flex-grow: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9em; outline: none;">
          <button type="button" onclick="submitNewCategoryInline();" style="background: #10b981; color: white; border: none; padding: 8px 12px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.9em; transition: 0.2s;">Agregar</button>
        </div>
        <p id="inline-category-error" style="display: none; margin: 5px 0 0 0; font-size: 0.8em; color: #ef4444; font-weight: bold;"></p>
      </div>
    </div>

    <%# 2. SUB-CATEGORÍA DINÁMICA DE CUALQUIER CATEGORÍA %>
    <div id="sub-category-wrapper" style="display: none; margin-bottom: 20px; padding: 15px; border-radius: 12px; border: 1px solid #cbd5e1; background: #f8fafc;">
      <label id="sub-category-label" style="display: block; font-weight: bold; margin-bottom: 8px; color: #334155;">
        🏷️ Sub-Categoría
      </label>
      
      <%= f.select :sub_category, 
          [], 
          { include_blank: "--- Ninguna / Seleccionar Sub-categoría ---" }, 
          { id: "sub-category-generic-select", class: "sub-select", style: "width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #cbd5e0; background: white;" } 
      %>
      
      <div style="margin-top: 8px; font-size: 0.85em;">
        ¿No ves la sub-categoría que necesitas? 
        <a href="javascript:void(0);" onclick="toggleNewGenericSubCategoryForm();" style="color: #2563eb; font-weight: 600; text-decoration: none;" id="toggle-subcat-link-text">
          Crear una nueva sub-categoría aquí
        </a>
      </div>
      
      <div id="inline-generic-subcat-form-container" style="display: none; margin-top: 10px; padding: 12px; border-radius: 10px; background: #ffffff; border: 1px solid #cbd5e1;">
        <p id="inline-generic-subcat-title" style="margin: 0 0 6px 0; font-size: 0.85em; font-weight: bold; color: #475569;">
          Crear nueva sub-categoría:
        </p>
        <div style="display: flex; gap: 8px;">
          <input type="text" id="inline-generic-subcat-input" placeholder="Ej: Sparkulas, Controladores, Cables..." style="flex-grow: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9em; outline: none;">
          <button type="button" onclick="submitNewGenericSubCategory();" style="background: #2563eb; color: white; border: none; padding: 8px 14px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.9em;">Agregar</button>
        </div>
        <p id="inline-generic-subcat-error" style="display: none; margin: 5px 0 0 0; font-size: 0.8em; color: #ef4444; font-weight: bold;"></p>
      </div>
    </div>

    <%# 3. NOMBRE DEL EQUIPO %>
    <div style="margin-bottom: 20px;">
      <%= f.label :name, "🏷️ Nombre del Equipo", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
      <%= f.text_field :name, placeholder: "Ej: Yamaha F310", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; box-sizing: border-box;" %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 10px;">
      <div>
        <%= f.label :status, "✨ Estado", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
        <%= f.select :status, ["Excelente", "Operativo", "Dañado"], {}, { id: "status-select", onchange: "updateFormLogic()", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; background: white;" } %>
      </div>
      <div>
        <%= f.label :quantity, "🔢 Cantidad", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
        <%= f.number_field :quantity, style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; box-sizing: border-box;" %>
      </div>
    </div>

    <%# AVISO DE TIRRO %>
    <div id="damage-notice" style="display: none; margin-bottom: 25px; background: #fef2f2; border: 2px dashed #ef4444; padding: 15px; border-radius: 12px; text-align: center;">
      <p style="margin: 0; color: #b91c1c; font-weight: 800; text-transform: uppercase; font-size: 0.85em;">
        ⚠️ MARCADO CON TIRRO OBLIGATORIO
      </p>
    </div>

    <div style="display: flex; gap: 10px; margin-top: 20px;">
      <%= link_to "Cancelar", items_path, style: "flex: 1; text-align: center; background: #f1f5f9; color: #64748b; padding: 14px; border-radius: 10px; text-decoration: none; font-weight: bold;" %>
      <%= f.submit item.new_record? ? "🚀 Registrar" : "💾 Guardar Cambios", 
          style: "flex: 2; background: #2563eb; color: white; padding: 14px; border: none; border-radius: 10px; font-weight: bold; cursor: pointer;" %>
    </div>
  <% end %>
</div>

<script>
  window.subCategoriesMap = <%= Item.sub_categories_grouped.to_json.html_safe %>;
  window.initialSubCategory = <%= item.sub_category.to_json.html_safe %>;

  function updateFormLogic() {
    const categorySelect = document.getElementById('category-select');
    const category = categorySelect ? categorySelect.value : '';
    const statusSelect = document.getElementById('status-select');
    const status = statusSelect ? statusSelect.value : '';
    
    const wrapper = document.getElementById('sub-category-wrapper');
    const label = document.getElementById('sub-category-label');
    const subCatSelect = document.getElementById('sub-category-generic-select');
    const toggleLinkText = document.getElementById('toggle-subcat-link-text');
    const damageNotice = document.getElementById('damage-notice');

    if (!category) {
      if (wrapper) wrapper.style.display = "none";
    } else {
      if (wrapper) wrapper.style.display = "block";
      if (label) label.innerText = "🏷️ Sub-Categoría de " + category;
      if (toggleLinkText) toggleLinkText.innerText = 'Crear nueva sub-categoría para "' + category + '" aquí';

      let currentVal = (subCatSelect && subCatSelect.value) ? subCatSelect.value : (window.initialSubCategory || '');
      const subcats = (window.subCategoriesMap && window.subCategoriesMap[category]) || [];
      
      if (subCatSelect) {
        subCatSelect.innerHTML = '';
        
        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.text = subcats.length > 0 ? '--- Seleccionar Sub-categoría (Opcional) ---' : '--- Sin sub-categorías registradas aún ---';
        subCatSelect.add(defaultOpt);

        subcats.forEach(function(scName) {
          const opt = document.createElement('option');
          opt.value = scName;
          opt.text = scName;
          subCatSelect.add(opt);
        });

        if (currentVal && subcats.includes(currentVal)) {
          subCatSelect.value = currentVal;
        } else if (window.initialSubCategory && subcats.includes(window.initialSubCategory)) {
          subCatSelect.value = window.initialSubCategory;
        }
      }
    }

    if (damageNotice) {
      damageNotice.style.display = (status === "Dañado") ? "block" : "none";
    }
  }

  function toggleNewCategoryInlineForm() {
    var container = document.getElementById('inline-category-form-container');
    if (container.style.display === 'none') {
      container.style.display = 'block';
      document.getElementById('inline-category-name-input').focus();
    } else {
      container.style.display = 'none';
    }
  }

  function submitNewCategoryInline() {
    var input = document.getElementById('inline-category-name-input');
    var name = input.value.trim();
    var errorLabel = document.getElementById('inline-category-error');
    if (!name) return;

    errorLabel.style.display = 'none';
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    fetch('/categories', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ category: { name: name } })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        var select = document.getElementById('category-select');
        var option = document.createElement('option');
        option.value = data.category.name;
        option.text = data.category.name;
        select.add(option);
        select.value = data.category.name;
        input.value = '';
        toggleNewCategoryInlineForm();
        updateFormLogic();
      } else {
        errorLabel.innerText = data.errors.join(', ');
        errorLabel.style.display = 'block';
      }
    })
    .catch(error => {
      errorLabel.innerText = 'Error al crear la categoría.';
      errorLabel.style.display = 'block';
      console.error(error);
    });
  }

  function toggleNewGenericSubCategoryForm() {
    var container = document.getElementById('inline-generic-subcat-form-container');
    if (container.style.display === 'none') {
      container.style.display = 'block';
      document.getElementById('inline-generic-subcat-input').focus();
    } else {
      container.style.display = 'none';
    }
  }

  function submitNewGenericSubCategory() {
    var categorySelect = document.getElementById('category-select');
    var category = categorySelect ? categorySelect.value : '';
    if (!category) {
      alert('Por favor selecciona primero una categoría principal.');
      return;
    }

    var input = document.getElementById('inline-generic-subcat-input');
    var name = input.value.trim();
    var errorLabel = document.getElementById('inline-generic-subcat-error');
    if (!name) return;

    errorLabel.style.display = 'none';
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    fetch('/sub_categories', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ sub_category: { name: name, category: category } })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        var newSubCat = data.sub_category.name;
        if (!window.subCategoriesMap) window.subCategoriesMap = {};
        if (!window.subCategoriesMap[category]) window.subCategoriesMap[category] = [];
        if (!window.subCategoriesMap[category].includes(newSubCat)) {
          window.subCategoriesMap[category].push(newSubCat);
        }

        var select = document.getElementById('sub-category-generic-select');
        var option = document.createElement('option');
        option.value = newSubCat;
        option.text = newSubCat;
        select.add(option);
        select.value = newSubCat;
        window.initialSubCategory = newSubCat;

        input.value = '';
        toggleNewGenericSubCategoryForm();
      } else {
        errorLabel.innerText = data.errors.join(', ');
        errorLabel.style.display = 'block';
      }
    })
    .catch(error => {
      errorLabel.innerText = 'Error al crear la sub-categoría.';
      errorLabel.style.display = 'block';
      console.error(error);
    });
  }

  // EJECUCIÓN INMEDIATA (Para Editar)
  document.addEventListener("turbo:load", updateFormLogic);
  document.addEventListener("DOMContentLoaded", updateFormLogic);
</script>