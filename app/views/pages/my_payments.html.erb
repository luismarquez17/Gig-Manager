<% worker_target = @worker || current_user %>

<div style="max-width: 960px; margin: 0 auto; font-family: 'Inter', sans-serif; color: var(--text-main, #1e293b); padding-bottom: 40px;">

  <style>
    .payment-row:hover {
      background: var(--bg-card-hover, rgba(0, 0, 0, 0.02)) !important;
    }
    [data-theme="dark"] .payment-row:hover,
    [data-theme="stage"] .payment-row:hover,
    [data-theme="gerovip"] .payment-row:hover {
      background: rgba(255, 255, 255, 0.04) !important;
    }
  </style>

  <%# --- BANNER SI EL LÍDER ESTÁ REVISANDO A UN TRABAJADOR --- %>
  <% if worker_target != current_user %>
    <div style="background: var(--bg-card-subtle, #eff6ff); border: 1.5px solid #bfdbfe; border-radius: 16px; padding: 14px 20px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; box-shadow: 0 2px 8px rgba(37, 99, 235, 0.06);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 1.4rem;">👤</span>
        <div>
          <div style="font-size: 0.95rem; font-weight: 800; color: #1e40af;">
            Visualizando Cuentas de: <%= worker_target.display_name rescue worker_target.email %>
          </div>
          <div style="font-size: 0.8rem; color: #3b82f6; margin-top: 1px;">
            <%= worker_target.email %> &nbsp;•&nbsp; <%= worker_target.role&.humanize %>
          </div>
        </div>
      </div>
      <div style="display: flex; gap: 8px;">
        <%= link_to employee_payments_path, class: "btn-main btn-gray-custom", style: "font-size: 0.82rem; padding: 7px 14px;" do %>
          ← Volver a Nómina General
        <% end %>
      </div>
    </div>
  <% end %>

  <%# --- HEADER --- %>
  <header style="margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <h1 style="font-size: 2em; font-weight: 800; margin: 0; color: var(--text-heading, #0f172a); letter-spacing: -0.5px;">
          💵 Cuentas y Pagos por Show
        </h1>
        <p style="color: var(--text-muted, #64748b); margin-top: 6px; font-size: 1em;">
          <%= worker_target == current_user ? 'Historial completo de tus pagos y balances por cada evento.' : "Historial de pagos y balances de #{worker_target.display_name rescue worker_target.email}." %>
        </p>
      </div>
      
      <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <% if worker_target == current_user %>
          <%= link_to new_worker_report_employee_payments_path, class: "btn-main btn-success-custom", style: "box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25); display: inline-flex; align-items: center; gap: 6px;" do %>
            <span>➕</span> Reportar Pago Recibido
          <% end %>

          <%= link_to root_path, class: "btn-main btn-gray-custom" do %>
            ← Dashboard
          <% end %>
        <% else %>
          <%= link_to new_employee_payment_path(user_id: worker_target.id), class: "btn-main btn-primary-custom", style: "display: inline-flex; align-items: center; gap: 6px;" do %>
            <span>💳</span> Registrar Pago a este Trabajador
          <% end %>

          <%= link_to employee_payments_path, class: "btn-main btn-gray-custom" do %>
            ← Nómina General
          <% end %>
        <% end %>
      </div>
    </div>
  </header>

  <%# --- PAGOS REPORTADOS PENDIENTES DE APROBACIÓN POR EL LÍDER --- %>
  <% pending_reports = worker_target.employee_payments.pending_approval.includes(:gig).order(created_at: :desc) %>
  <% if pending_reports.any? %>
    <div style="background: #fffbeb; border: 2px solid #fde68a; border-radius: 18px; padding: 20px; margin-bottom: 25px; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.08);">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
        <span style="font-size: 1.5em;">⏳</span>
        <div>
          <h3 style="margin: 0; font-size: 1.1em; font-weight: 800; color: #92400e;">
            Pagos Reportados en Revisión (<%= pending_reports.count %>)
          </h3>
          <p style="margin: 2px 0 0 0; font-size: 0.85em; color: #b45309;">
            Estos pagos están pendientes de confirmación por el líder. Una vez aprobados, se reflejarán en el balance saldado.
          </p>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 8px;">
        <% pending_reports.each do |rep| %>
          <div style="background: var(--bg-card, white); border-radius: 12px; padding: 12px 16px; border: 1px solid #fef3c7; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <div style="font-weight: 700; color: var(--text-heading, #1e293b); font-size: 0.95em;">
                <%= rep.gig ? (rep.gig.client&.name || "Show del #{rep.gig.date}") : "Pago General" %>
                <span style="font-size: 0.82em; color: var(--text-muted, #64748b); font-weight: 500; margin-left: 6px;">
                  (Fecha de pago: <%= rep.date_paid&.strftime('%d/%m/%Y') %>)
                </span>
              </div>
              <% if rep.notes.present? %>
                <div style="font-size: 0.82em; color: var(--text-muted, #64748b); margin-top: 2px;">
                  📝 <%= rep.notes %>
                </div>
              <% end %>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="font-size: 1.1em; font-weight: 900; color: #b45309;">
                <%= number_to_currency(rep.amount, unit: rep.currency) %>
              </span>
              <span style="background: #fef3c7; color: #92400e; padding: 4px 10px; border-radius: 99px; font-size: 0.78em; font-weight: 800; border: 1px solid #fde68a;">
                ⏳ Esperando Aprobación
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# --- SUMMARY CARDS --- %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 28px;">

    <div style="background: var(--bg-card, white); border-radius: 16px; padding: 20px; border: 1px solid var(--border-color, #e2e8f0); box-shadow: var(--shadow-card, 0 4px 6px -1px rgba(0,0,0,0.03));">
      <div style="font-size: 0.8em; font-weight: 700; color: var(--text-muted, #64748b); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">Total Esperado</div>
      <div style="font-size: 1.8em; font-weight: 900; color: var(--text-heading, #1e293b);"><%= number_to_currency(@total_expected, unit: '$') %></div>
      <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 4px;">Acuerdo total de pagos</div>
    </div>

    <div style="background: var(--bg-card, white); border-radius: 16px; padding: 20px; border: 1px solid var(--border-color, #e2e8f0); box-shadow: var(--shadow-card, 0 4px 6px -1px rgba(0,0,0,0.03));">
      <div style="font-size: 0.8em; font-weight: 700; color: #15803d; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">Total Cobrado</div>
      <div style="font-size: 1.8em; font-weight: 900; color: #16a34a;"><%= number_to_currency(@total_paid, unit: '$') %></div>
      <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 4px;">Pagos ya confirmados</div>
    </div>

    <div style="background: <%= @total_owed > 0 ? '#fffbeb' : '#f0fdf4' %>; border-radius: 16px; padding: 20px; border: 1px solid <%= @total_owed > 0 ? '#fde68a' : '#bbf7d0' %>; box-shadow: var(--shadow-card, 0 4px 6px -1px rgba(0,0,0,0.03));">
      <div style="font-size: 0.8em; font-weight: 700; color: <%= @total_owed > 0 ? '#b45309' : '#15803d' %>; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">
        <%= @total_owed > 0 ? 'Por Cobrar' : 'Al Día' %>
      </div>
      <div style="font-size: 1.8em; font-weight: 900; color: <%= @total_owed > 0 ? '#d97706' : '#16a34a' %>;"><%= number_to_currency(@total_owed, unit: '$') %></div>
      <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 4px;">Saldo pendiente</div>
    </div>

    <% items = @worker_payment_items || [] %>
    <% paid_count = items.count { |i| i[:pending_amount] <= 0 } %>
    <% pending_count = items.count { |i| !i[:is_future] && i[:pending_amount] > 0 } %>
    <% future_count = items.count { |i| i[:is_future] && i[:pending_amount] > 0 } %>
    <div style="background: var(--bg-card, white); border-radius: 16px; padding: 20px; border: 1px solid var(--border-color, #e2e8f0); box-shadow: var(--shadow-card, 0 4px 6px -1px rgba(0,0,0,0.03));">
      <div style="font-size: 0.8em; font-weight: 700; color: var(--text-muted, #64748b); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">Estado Shows</div>
      <div style="display: flex; gap: 12px; align-items: center; margin-top: 6px; flex-wrap: wrap;">
        <div style="text-align: center;">
          <div style="font-size: 1.5em; font-weight: 900; color: #16a34a;"><%= paid_count %></div>
          <div style="font-size: 0.75em; color: var(--text-muted, #94a3b8); font-weight: 600;">Pagados</div>
        </div>
        <div style="width: 1px; height: 32px; background: var(--border-color, #e2e8f0);"></div>
        <div style="text-align: center;">
          <div style="font-size: 1.5em; font-weight: 900; color: <%= pending_count > 0 ? '#ea580c' : '#16a34a' %>;"><%= pending_count %></div>
          <div style="font-size: 0.75em; color: var(--text-muted, #94a3b8); font-weight: 600;">Deuda Pasada</div>
        </div>
        <% if future_count > 0 %>
          <div style="width: 1px; height: 32px; background: var(--border-color, #e2e8f0);"></div>
          <div style="text-align: center;">
            <div style="font-size: 1.5em; font-weight: 900; color: #2563eb;"><%= future_count %></div>
            <div style="font-size: 0.75em; color: #60a5fa; font-weight: 600;">Programados</div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <%# --- PAYMENTS TABLE --- %>
  <div style="background: var(--bg-card, white); border-radius: 20px; border: 1px solid var(--border-color, #e2e8f0); box-shadow: var(--shadow-card, 0 4px 6px -1px rgba(0,0,0,0.03)); overflow: hidden;">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-subtle, #f1f5f9); display: flex; justify-content: space-between; align-items: center;">
      <h2 style="margin: 0; font-size: 1.1em; font-weight: 800; color: var(--text-heading, #0f172a);">Detalle por Show</h2>
      <span style="font-size: 0.85em; color: var(--text-muted, #94a3b8);"><%= items.count %> registro<%= items.count == 1 ? '' : 's' %></span>
    </div>

    <% if items.present? %>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9em; min-width: 650px;">
          <thead>
            <tr style="background: var(--bg-card-subtle, #f8fafc); border-bottom: 1px solid var(--border-subtle, #f1f5f9);">
              <th style="padding: 14px 20px; color: var(--text-muted, #64748b); font-weight: 700; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.05em;">Evento / Show</th>
              <th style="padding: 14px 12px; text-align: right; color: var(--text-muted, #64748b); font-weight: 700; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.05em;">Acordado</th>
              <th style="padding: 14px 12px; text-align: right; color: var(--text-muted, #64748b); font-weight: 700; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.05em;">Cobrado</th>
              <th style="padding: 14px 12px; text-align: right; color: var(--text-muted, #64748b); font-weight: 700; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.05em;">Pendiente</th>
              <th style="padding: 14px 16px; text-align: center; color: var(--text-muted, #64748b); font-weight: 700; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.05em;">Estado</th>
              <th style="padding: 14px 20px; text-align: center; color: var(--text-muted, #64748b); font-weight: 700; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.05em;">Acción</th>
            </tr>
          </thead>
          <tbody>
            <% items.each do |item| %>
              <% pending = item[:pending_amount] %>
              <% pending_approval = item[:pending_approval_amount].to_f %>
              <tr class="payment-row" style="border-bottom: 1px solid var(--border-subtle, #f8fafc); transition: background 0.15s;">
                <td style="padding: 16px 20px; font-weight: 600; color: var(--text-heading, #0f172a);">
                  <% if item[:gig].present? %>
                    <%= item[:gig].client_display_name %>
                    <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 2px; font-weight: 500;">
                      📅 <%= item[:gig].date&.strftime('%d de %B de %Y') || 'Sin fecha definida' %> &nbsp;·&nbsp; 📍 <%= item[:gig].location.presence || 'Ubicación a coordinar' %>
                    </div>
                  <% else %>
                    <%= item[:description] || 'Pago Directo' %>
                    <div style="font-size: 0.8em; color: var(--text-muted, #94a3b8); margin-top: 2px;">
                      <%= item[:date]&.strftime('%d %b %Y') %>
                    </div>
                  <% end %>
                </td>
                <td style="padding: 16px 12px; text-align: right; font-weight: 700; color: var(--text-heading, #1e293b);">
                  <%= number_to_currency(item[:agreed_amount], unit: '$') %>
                </td>
                <td style="padding: 16px 12px; text-align: right; font-weight: 700; color: #16a34a;">
                  <%= number_to_currency(item[:paid_amount], unit: '$') %>
                </td>
                <td style="padding: 16px 12px; text-align: right; font-weight: 800; color: <%= pending > 0 ? (item[:is_future] ? '#2563eb' : '#d97706') : '#16a34a' %>;">
                  <%= number_to_currency(pending, unit: '$') %>
                  <% if item[:is_future] && pending > 0 %>
                    <div style="font-size: 0.72em; color: #64748b; font-weight: 600;">(al celebrarse)</div>
                  <% end %>
                  <% if pending_approval > 0 %>
                    <div style="font-size: 0.75em; color: #b45309; font-weight: 600;">
                      (⏳ <%= number_to_currency(pending_approval, unit: '$') %> en revisión)
                    </div>
                  <% end %>
                </td>
                <td style="padding: 16px 16px; text-align: center;">
                  <% if pending <= 0 %>
                    <span style="background: #dcfce7; color: #15803d; padding: 4px 10px; border-radius: 99px; font-size: 0.8em; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                      ✓ Pagado
                    </span>
                  <% elsif pending_approval > 0 %>
                    <span style="background: #fef3c7; color: #92400e; padding: 4px 10px; border-radius: 99px; font-size: 0.8em; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                      ⏳ Revisión
                    </span>
                  <% elsif item[:is_future] %>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 4px 10px; border-radius: 99px; font-size: 0.8em; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                      📅 Próximo <%= venue_mode? ? 'Evento' : 'Show' %> (Por celebrarse)
                    </span>
                  <% else %>
                    <span style="background: #fee2e2; color: #b91c1c; padding: 4px 10px; border-radius: 99px; font-size: 0.8em; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                      ⏳ Deuda vencida
                    </span>
                  <% end %>
                </td>
                <td style="padding: 16px 20px; text-align: center;">
                  <% if pending > 0 && worker_target == current_user %>
                    <%= link_to new_worker_report_employee_payments_path(gig_id: item[:gig]&.id), class: "btn-main", style: "background: linear-gradient(135deg, #{item[:is_future] ? '#4f46e5, #3730a3' : '#f59e0b, #d97706'}); color: white; padding: 6px 12px; border-radius: 8px; font-size: 0.82em; font-weight: 700; text-decoration: none; box-shadow: 0 2px 6px rgba(0,0,0,0.15);" do %>
                      <%= item[:is_future] ? '💵 Reportar Anticipo' : '💵 Reportar Pago' %>
                    <% end %>
                  <% elsif pending > 0 && (current_user.leader? || current_user.superadmin?) %>
                    <%= link_to new_employee_payment_path(user_id: worker_target.id, gig_id: item[:gig]&.id), class: "btn-main btn-primary-custom", style: "padding: 6px 12px; border-radius: 8px; font-size: 0.82em; font-weight: 700; text-decoration: none;" do %>
                      <%= item[:is_future] ? '💳 Anticipo' : '💳 Pagar' %>
                    <% end %>
                  <% else %>
                    <span style="color: var(--text-muted, #94a3b8); font-size: 0.85em;">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# --- TOTALS ROW --- %>
      <div style="padding: 16px 20px; background: var(--bg-card-subtle, #f8fafc); border-top: 2px solid var(--border-subtle, #f1f5f9); display: flex; justify-content: flex-end; gap: 32px; flex-wrap: wrap;">
        <div style="text-align: right;">
          <div style="font-size: 0.75em; color: var(--text-muted, #94a3b8); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Total Esperado</div>
          <div style="font-size: 1.1em; font-weight: 800; color: var(--text-heading, #1e293b);"><%= number_to_currency(@total_expected, unit: '$') %></div>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 0.75em; color: #15803d; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Total Cobrado</div>
          <div style="font-size: 1.1em; font-weight: 800; color: #16a34a;"><%= number_to_currency(@total_paid, unit: '$') %></div>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 0.75em; color: <%= @total_owed > 0 ? '#b45309' : '#15803d' %>; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Pendiente Total</div>
          <div style="font-size: 1.1em; font-weight: 800; color: <%= @total_owed > 0 ? '#d97706' : '#16a34a' %>;"><%= number_to_currency(@total_owed, unit: '$') %></div>
        </div>
      </div>

    <% else %>
      <div style="padding: 50px 30px; text-align: center; color: var(--text-muted, #94a3b8);">
        <div style="font-size: 3em; margin-bottom: 12px;">💳</div>
        <div style="font-size: 1.1em; font-weight: 700; color: var(--text-muted, #64748b); margin-bottom: 6px;">Sin registros de pago</div>
        <div style="font-size: 0.9em;">No hay pagos registrados para esta cuenta por ahora.</div>
      </div>
    <% end %>
  </div>

  <%# --- HISTORIAL DE RECIBOS DE NÓMINA OFICIALES --- %>
  <% approved_payments = @employee_payments.select(&:approved?) %>
  <% if approved_payments.any? %>
    <div style="margin-top: 30px; background: var(--bg-card, white); border-radius: 20px; border: 1px solid var(--border-color, #e2e8f0); box-shadow: var(--shadow-card, 0 4px 6px -1px rgba(0,0,0,0.03)); overflow: hidden;">
      <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-subtle, #f1f5f9); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div>
          <h2 style="margin: 0; font-size: 1.1em; font-weight: 800; color: var(--text-heading, #0f172a); display: flex; align-items: center; gap: 8px;">
            <span>🧾</span> <%= worker_target == current_user ? 'Tus Comprobantes Oficiales de Pago' : "Comprobantes Oficiales de Pago de #{worker_target.display_name rescue worker_target.email}" %>
          </h2>
          <p style="margin: 3px 0 0 0; color: var(--text-muted, #64748b); font-size: 0.85em;">
            Recibos digitales certificados por el líder con folio y fecha de liquidación.
          </p>
        </div>
        <span style="font-size: 0.8em; font-weight: 700; color: #16a34a; background: #dcfce7; padding: 4px 10px; border-radius: 99px;">
          <%= approved_payments.count %> comprobante<%= approved_payments.count == 1 ? '' : 's' %>
        </span>
      </div>

      <div style="display: flex; flex-direction: column;">
        <% approved_payments.each do |p| %>
          <div class="payment-row" style="padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--border-subtle, #f8fafc); transition: background 0.15s;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="font-size: 1.4em; background: #eff6ff; color: #1e40af; width: 40px; height: 40px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-weight: 800;">
                📄
              </span>
              <div>
                <div style="font-weight: 800; color: var(--text-heading, #0f172a); font-size: 0.95em;">
                  <%= p.gig ? p.gig.client_display_name : "Liquidación General / Anticipo" %>
                  <span style="color: var(--text-muted, #64748b); font-weight: 600; font-size: 0.85em; font-family: monospace; margin-left: 6px;">
                    (<%= p.receipt_display_number %>)
                  </span>
                </div>
                <div style="font-size: 0.82em; color: var(--text-muted, #64748b); margin-top: 2px;">
                  Fecha: <%= p.date_paid&.strftime('%d/%m/%Y') || p.created_at.strftime('%d/%m/%Y') %> · Método: <%= p.payment_method || 'Efectivo' %>
                  <% if p.notes.present? %>
                    · <em>"<%= p.notes %>"</em>
                  <% end %>
                </div>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 14px;">
              <div style="text-align: right;">
                <div style="font-size: 1.2em; font-weight: 900; color: #15803d;">
                  <%= number_to_currency(p.amount, unit: '$') %>
                </div>
                <div style="font-size: 0.75em; color: var(--text-muted, #64748b); font-weight: 600;">Confirmado</div>
              </div>

              <div style="display: flex; gap: 8px;">
                <%= link_to receipt_employee_payment_path(p), target: '_blank', style: "background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; padding: 7px 12px; border-radius: 8px; font-size: 0.82em; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" do %>
                  <span>📄</span> Ver Recibo
                <% end %>

                <%
                  wa_text = p.whatsapp_receipt_text(receipt_employee_payment_url(p))
                  wa_url = "https://web.whatsapp.com/send?text=#{ERB::Util.url_encode(wa_text)}"
                %>
                <a href="<%= wa_url %>" target="_blank" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 7px 12px; border-radius: 8px; font-size: 0.82em; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                  <span>📲</span> WhatsApp
                </a>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
