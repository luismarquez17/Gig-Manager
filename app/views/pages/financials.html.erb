<div style="max-width: 1200px; margin: 0 auto; font-family: 'Inter', 'Segoe UI', sans-serif;">

  <%# --- HEADER --- %>
  <header style="margin-bottom: 35px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px;">
      <div>
        <h1 style="color: #0f172a; font-size: 2.2em; font-weight: 800; margin: 0; letter-spacing: -0.5px;">📊 Métricas Financieras y Flujo de Caja</h1>
        <p style="color: #64748b; font-size: 1.05em; margin-top: 6px;">
          Análisis de ingresos reales, egresos de nómina, gastos de taller, inversiones y rentabilidad (100% en USD).
        </p>
      </div>
      <div>
        <span style="display: inline-flex; align-items: center; gap: 6px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; padding: 6px 14px; border-radius: 9999px; font-weight: 700; font-size: 0.85em;">
          💵 Moneda: USD
        </span>
      </div>
    </div>
  </header>

  <%# --- TARJETAS DE MÉTRICAS PRINCIPALES (GRID 3x2) --- %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 40px;">
    
    <%# 1. TOTAL COBRADO REAL / ENTRADAS %>
    <div style="background: white; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.01); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #64748b; font-weight: 700; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px;">1. Cobrado Real</span>
          <span style="background: #dcfce7; color: #166534; font-size: 0.72em; font-weight: 800; padding: 2px 8px; border-radius: 6px;">Ingresos</span>
        </div>
        <h2 style="font-size: 1.9em; margin: 0; color: #10b981; font-weight: 800;">
          $ <%= number_with_precision(@total_received_usd, precision: 2) %>
        </h2>
      </div>
      <div style="margin-top: 14px; font-size: 0.82em; color: #64748b; line-height: 1.4; border-top: 1px solid #f1f5f9; padding-top: 10px;">
        <div style="font-weight: 600; color: #334155;">💵 Pagos confirmados de clientes (Gig Payments).</div>
        <div style="color: #94a3b8; margin-top: 4px;">
          Presupuestado: $<%= number_with_precision(@budgeted_usd, precision: 2) %> <% if @total_cash_deposits > 0 %> | Aportes Caja: +$<%= number_with_precision(@total_cash_deposits, precision: 2) %><% end %>
        </div>
      </div>
    </div>

    <%# 2. NÓMINA PAGADA %>
    <div style="background: white; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.01); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #64748b; font-weight: 700; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px;">2. Nómina Pagada</span>
          <span style="background: #dbeafe; color: #1e40af; font-size: 0.72em; font-weight: 800; padding: 2px 8px; border-radius: 6px;">Personal</span>
        </div>
        <h2 style="font-size: 1.9em; margin: 0; color: #2563eb; font-weight: 800;">
          $ <%= number_with_precision(@total_payroll_paid, precision: 2) %>
        </h2>
      </div>
      <div style="margin-top: 14px; font-size: 0.82em; color: #64748b; line-height: 1.4; border-top: 1px solid #f1f5f9; padding-top: 10px;">
        <div style="font-weight: 600; color: #334155;">👥 Salarios y honorarios pagados a músicos y staff.</div>
        <div style="color: #94a3b8; margin-top: 4px;">
          Suma de pagos aprobados y registrados en el sistema.
        </div>
      </div>
    </div>

    <%# 3. GASTOS DE TALLER / REPARACIONES %>
    <div style="background: white; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.01); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #64748b; font-weight: 700; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px;">3. Inversión en Reparaciones</span>
          <span style="background: #ffe4e6; color: #9f1239; font-size: 0.72em; font-weight: 800; padding: 2px 8px; border-radius: 6px;">Taller</span>
        </div>
        <h2 style="font-size: 1.9em; margin: 0; color: #e11d48; font-weight: 800;">
          $ <%= number_with_precision(@total_maintenance_cost, precision: 2) %>
        </h2>
      </div>
      <div style="margin-top: 14px; font-size: 0.82em; color: #64748b; line-height: 1.4; border-top: 1px solid #f1f5f9; padding-top: 10px;">
        <div style="font-weight: 600; color: #334155;">🔧 Mantenimiento y reparaciones de instrumentos.</div>
        <div style="color: #94a3b8; margin-top: 4px;">
          <%= @maintenance_count %> <%= @maintenance_count == 1 ? "servicio registrado" : "servicios registrados" %> en el historial de taller.
        </div>
      </div>
    </div>

    <%# 4. TOTAL INVERSIONES EN EQUIPOS %>
    <div style="background: white; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.01); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #64748b; font-weight: 700; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px;">4. Inversión en Equipos</span>
          <span style="background: #ede9fe; color: #5b21b6; font-size: 0.72em; font-weight: 800; padding: 2px 8px; border-radius: 6px;">Activos</span>
        </div>
        <h2 style="font-size: 1.9em; margin: 0; color: #8b5cf6; font-weight: 800;">
          $ <%= number_with_precision(@total_invested_usd, precision: 2) %>
        </h2>
      </div>
      <div style="margin-top: 14px; font-size: 0.82em; color: #64748b; line-height: 1.4; border-top: 1px solid #f1f5f9; padding-top: 10px;">
        <div style="font-weight: 600; color: #334155;">📦 <%= @investments_count %> <%= @investments_count == 1 ? "compra de equipo" : "compras de equipos" %> para la banda.</div>
        <div style="margin-top: 4px;">
          <%= link_to "Ver detalle de inversiones →", investments_path, style: "color: #8b5cf6; text-decoration: none; font-weight: 700;" %>
        </div>
      </div>
    </div>

    <%# 5. GANANCIA NETA REAL (CAJA REAL) %>
    <div style="background: white; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.01); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #64748b; font-weight: 700; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px;">5. Saldo Real / Caja</span>
          <span style="background: <%= @net_profit_usd >= 0 ? '#dcfce7' : '#fee2e2' %>; color: <%= @net_profit_usd >= 0 ? '#166534' : '#991b1b' %>; font-size: 0.72em; font-weight: 800; padding: 2px 8px; border-radius: 6px;">
            <%= @net_profit_usd >= 0 ? 'Superávit' : 'Déficit' %>
          </span>
        </div>
        <h2 style="font-size: 1.9em; margin: 0; color: <%= @net_profit_usd >= 0 ? '#10b981' : '#ef4444' %>; font-weight: 800;">
          <%= @net_profit_usd >= 0 ? '+ ' : '- ' %>$ <%= number_with_precision(@net_profit_usd.abs, precision: 2) %>
        </h2>
      </div>
      <div style="margin-top: 14px; font-size: 0.82em; color: #64748b; line-height: 1.4; border-top: 1px solid #f1f5f9; padding-top: 10px;">
        <div style="font-weight: 600; color: #334155;">🏦 Saldo Disponible en Caja:</div>
        <div style="color: #94a3b8; margin-top: 4px; font-size: 0.95em;">
          <%= link_to "Ir a Caja General y Movimientos →", cash_adjustments_path, style: "color: #2563eb; font-weight: 700; text-decoration: none;" %>
        </div>
      </div>
    </div>

    <%# 6. RENTABILIDAD & ROI %>
    <div style="background: white; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.01); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #64748b; font-weight: 700; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px;">6. Rentabilidad y Retorno</span>
          <span style="background: #fef3c7; color: #92400e; font-size: 0.72em; font-weight: 800; padding: 2px 8px; border-radius: 6px;">Rendimiento</span>
        </div>
        <h2 style="font-size: 1.9em; margin: 0; color: #0f172a; font-weight: 800;">
          <%= number_to_percentage(@profit_margin_pct, precision: 1) %>
        </h2>
      </div>
      <div style="margin-top: 14px; font-size: 0.82em; color: #64748b; line-height: 1.4; border-top: 1px solid #f1f5f9; padding-top: 10px;">
        <div style="font-weight: 600; color: #334155;">📈 Margen de ganancia sobre lo cobrado.</div>
        <div style="color: #94a3b8; margin-top: 4px;">
          ROI sobre Inversión en Equipos: <strong style="color: <%= @roi_usd >= 0 ? '#10b981' : '#ef4444' %>;"><%= number_to_percentage(@roi_usd, precision: 1) %></strong>
        </div>
      </div>
    </div>

  </div>

  <%# --- HISTORIAL FINANCIERO MENSUAL DETALLADO --- %>
  <div style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); margin-bottom: 40px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 22px;">
      <div>
        <h3 style="margin: 0; font-size: 1.25em; color: #1e293b; font-weight: 800;">📅 Historial Financiero Mensual Detallado</h3>
        <p style="margin: 4px 0 0 0; font-size: 0.9em; color: #64748b;">
          Desglose mes a mes con cobros reales, nómina liquidada, gastos de taller, compras y utilidad neta.
        </p>
      </div>
    </div>

    <% if @monthly_breakdown.present? && @monthly_breakdown.any? %>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9em;">
          <thead>
            <tr style="border-bottom: 2px solid #e2e8f0; color: #475569; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.5px;">
              <th style="padding: 12px 14px;">Mes</th>
              <th style="padding: 12px 14px; text-align: center;">Shows</th>
              <th style="padding: 12px 14px; text-align: right; color: #059669;">Cobrado Real</th>
              <th style="padding: 12px 14px; text-align: right; color: #2563eb;">Nómina Pagada</th>
              <th style="padding: 12px 14px; text-align: right; color: #e11d48;">Reparaciones</th>
              <th style="padding: 12px 14px; text-align: right; color: #7c3aed;">Equipos</th>
              <th style="padding: 12px 14px; text-align: right; color: #475569;">Total Egresos</th>
              <th style="padding: 12px 14px; text-align: right; font-weight: 800;">Utilidad Neta</th>
              <th style="padding: 12px 14px; text-align: right;">Margen %</th>
            </tr>
          </thead>
          <tbody>
            <% @monthly_breakdown.each do |m| %>
              <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.2s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                <td style="padding: 14px; font-weight: 700; color: #0f172a; white-space: nowrap;">
                  <%= m[:month_name] || m[:month_label] %>
                </td>
                <td style="padding: 14px; text-align: center;">
                  <span style="background: #f1f5f9; color: #334155; font-weight: 700; padding: 3px 10px; border-radius: 9999px; font-size: 0.85em;">
                    <%= m[:gigs_count] %>
                  </span>
                </td>
                <td style="padding: 14px; text-align: right; font-weight: 700; color: #10b981;">
                  $ <%= number_with_precision(m[:received], precision: 2) %>
                </td>
                <td style="padding: 14px; text-align: right; color: #334155;">
                  $ <%= number_with_precision(m[:payroll], precision: 2) %>
                </td>
                <td style="padding: 14px; text-align: right; color: #334155;">
                  $ <%= number_with_precision(m[:maintenance], precision: 2) %>
                </td>
                <td style="padding: 14px; text-align: right; color: #334155;">
                  $ <%= number_with_precision(m[:investments], precision: 2) %>
                </td>
                <td style="padding: 14px; text-align: right; font-weight: 600; color: #64748b;">
                  $ <%= number_with_precision(m[:total_outflow], precision: 2) %>
                </td>
                <td style="padding: 14px; text-align: right; font-weight: 800; color: <%= m[:net_profit] >= 0 ? '#10b981' : '#ef4444' %>;">
                  <%= m[:net_profit] >= 0 ? '+ ' : '- ' %>$ <%= number_with_precision(m[:net_profit].abs, precision: 2) %>
                </td>
                <td style="padding: 14px; text-align: right;">
                  <span style="background: <%= m[:margin_pct] >= 0 ? '#ecfdf5' : '#fef2f2' %>; color: <%= m[:margin_pct] >= 0 ? '#065f46' : '#991b1b' %>; padding: 4px 8px; border-radius: 6px; font-weight: 700; font-size: 0.85em;">
                    <%= number_to_percentage(m[:margin_pct], precision: 1) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div style="text-align: center; padding: 40px; color: #94a3b8; font-style: italic;">
        No hay registros financieros suficientes para mostrar el desglose mensual.
      </div>
    <% end %>
  </div>

  <%# --- DOS COLUMNAS: CLIENTES CLAVE Y LOCACIONES --- %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; margin-bottom: 40px;">
    
    <%# Columna 1: Clientes Clave %>
    <div style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="margin: 0; font-size: 1.2em; color: #1e293b; font-weight: 800; display: flex; align-items: center; gap: 8px;">
          👤 Clientes Clave (Mayor Facturación)
        </h3>
        <span style="font-size: 0.8em; color: #64748b; font-weight: 600;">Top 5</span>
      </div>
      
      <% if @top_clients.any? %>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <% @top_clients.each_with_index do |client, index| %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; background: #f8fafc; border-radius: 14px; border: 1px solid #f1f5f9;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <span style="background: #e2e8f0; color: #334155; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 800; font-size: 0.85em;">
                  <%= index + 1 %>
                </span>
                <div>
                  <%= link_to client.name, client_path(client), style: "text-decoration: none; font-weight: 700; color: #0f172a; font-size: 0.95em;" %>
                  <small style="display: block; color: #94a3b8; font-size: 0.8em; margin-top: 2px;">
                    <%= client.gigs_count %> <%= client.gigs_count == 1 ? "show realizado/agendado" : "shows realizados/agendados" %>
                  </small>
                </div>
              </div>
              <div style="text-align: right;">
                <span style="font-weight: 800; color: #10b981; font-size: 1.1em; display: block;">
                  $ <%= number_with_precision(client.total_spent, precision: 2) %>
                </span>
                <span style="font-size: 0.75em; color: #94a3b8;">facturado</span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color: #94a3b8; font-style: italic; text-align: center; padding: 20px;">No hay clientes registrados.</p>
      <% end %>
    </div>

    <%# Columna 2: Locaciones más frecuentes %>
    <div style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; padding: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="margin: 0; font-size: 1.2em; color: #1e293b; font-weight: 800; display: flex; align-items: center; gap: 8px;">
          📍 Locaciones más Frecuentes
        </h3>
        <span style="font-size: 0.8em; color: #64748b; font-weight: 600;">Top 5</span>
      </div>
      
      <% if @top_locations.any? %>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <% @top_locations.each_with_index do |(location, count), index| %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; background: #f8fafc; border-radius: 14px; border: 1px solid #f1f5f9;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <span style="background: #eff6ff; color: #2563eb; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 800; font-size: 0.85em;">
                  <%= index + 1 %>
                </span>
                <span style="font-weight: 700; color: #334155; font-size: 0.95em;"><%= location %></span>
              </div>
              <span style="background: #dbeafe; color: #1e40af; padding: 5px 12px; border-radius: 8px; font-weight: 800; font-size: 0.85em;">
                <%= count %> <%= count == 1 ? "show" : "shows" %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color: #94a3b8; font-style: italic; text-align: center; padding: 20px;">No hay locaciones registradas.</p>
      <% end %>
    </div>

  </div>

</div>
