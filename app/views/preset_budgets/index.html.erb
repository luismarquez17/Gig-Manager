<div style="max-width: 1200px; margin: 0 auto; font-family: 'Inter', 'Segoe UI', sans-serif;">

  <%# --- HEADER --- %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
    <div>
      <h1 style="color: #0f172a; margin: 0; font-weight: 800; font-size: 2.2em; letter-spacing: -0.5px;">📋 Presupuestos Base</h1>
      <p style="color: #64748b; margin: 5px 0 0 0; font-size: 1.05em;">Diseña y guarda paquetes de servicios estándar para enviárselos al instante a tus clientes.</p>
    </div>
    <% unless current_user.client? %>
      <%= link_to '➕ Nuevo Presupuesto Base', new_preset_budget_path, style: "background: #2563eb; color: white; padding: 14px 24px; text-decoration: none; border-radius: 10px; font-weight: bold; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2); transition: 0.2s;", onmouseover: "this.style.background='#1d4ed8'", onmouseout: "this.style.background='#2563eb'" %>
    <% end %>
  </div>

  <% if current_user.client? %>
    <div style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); padding: 30px; border-radius: 20px; color: white; margin-bottom: 35px; box-shadow: 0 10px 20px rgba(59, 130, 246, 0.15); display: flex; align-items: center; gap: 25px; flex-wrap: wrap;">
      <div style="font-size: 3.5em;">✨</div>
      <div style="flex: 1; min-width: 250px;">
        <h3 style="margin: 0; font-size: 1.3em; font-weight: 800; font-family: 'Inter', sans-serif;">¡Potencia tu evento con adicionales increíbles!</h3>
        <p style="margin: 8px 0 0 0; font-size: 0.95em; opacity: 0.9; line-height: 1.5;">
          Contamos con equipos de efectos especiales de última generación y horas extra opcionales para hacer tu fiesta única.
          <strong style="color: #6ee7b7;">Pregunta a tu organizador por nuestras máquinas de sparkulas, subwoofers premium y puentes de luces robóticas.</strong>
        </p>
      </div>
      <div>
        <% wa_msg = "Hola! Estoy revisando los presupuestos base de la empresa y me gustaría cotizar algunos adicionales para mi evento." %>
        <a href="https://wa.me/584140000000?text=<%= ERB::Util.url_encode(wa_msg) %>" target="_blank" style="background: #10b981; color: white; padding: 14px 24px; text-decoration: none; border-radius: 12px; font-weight: bold; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
          💬 Consultar Adicionales
        </a>
      </div>
    </div>
  <% end %>

  <%# --- GRID DE TARJETAS --- %>
  <% if @preset_budgets.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 26px;">
      <% @preset_budgets.each do |budget| %>
        <div class="preset-admin-card" style="background: white; border: 1px solid #e2e8f0; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.04); display: flex; flex-direction: column; height: 100%; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 16px 32px rgba(15,23,42,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.04)';">
          
          <%# Preview de Imagen Adaptativa %>
          <div style="min-height: 230px; max-height: 280px; background: #0f172a; display: flex; justify-content: center; align-items: center; position: relative; overflow: hidden; border-bottom: 1px solid #e2e8f0;">
            <% if budget.image.attached? %>
              <% img_url = rails_blob_path(budget.image, only_path: true) rescue url_for(budget.image) %>
              
              <%# Fondo difuminado dinámico %>
              <%= image_tag budget.image, style: "position: absolute; inset: -15px; width: calc(100% + 30px); height: calc(100% + 30px); object-fit: cover; filter: blur(20px) brightness(0.35); transform: scale(1.15); pointer-events: none;", alt: "", "aria-hidden": "true" %>
              
              <%# Imagen completa con su proporción original sin recortar %>
              <%= image_tag budget.image, style: "position: relative; max-width: 90%; max-height: 240px; width: auto; height: auto; object-fit: contain; border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.5); z-index: 2; transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);", class: "preset-admin-img", alt: budget.title %>

              <%# Botón de Zoom %>
              <button type="button" onclick="openImageModal('<%= img_url %>', '<%= j budget.title %>')" style="position: absolute; top: 12px; left: 12px; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.25); color: white; padding: 6px 12px; border-radius: 99px; font-size: 0.78rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 5px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); transition: all 0.2s; z-index: 5;" onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='rgba(15, 23, 42, 0.8)'">
                🔍 Ver Flyer HD
              </button>
            <% else %>
              <div style="text-align: center; color: #94a3b8; padding: 20px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <div style="font-size: 48px; margin-bottom: 6px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));">🎛️</div>
                <strong style="color: #cbd5e1; font-size: 0.92rem;">Sin Flyer Cargado</strong>
                <span style="font-size: 0.75rem; color: #64748b; margin-top: 3px;">Sube una imagen para enriquecer la propuesta</span>
              </div>
            <% end %>
            
            <%# Badge de Precio con Glassmorphism %>
            <div style="position: absolute; bottom: 12px; right: 12px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); color: #34d399; padding: 7px 14px; border-radius: 12px; font-weight: 900; font-size: 1.05rem; box-shadow: 0 4px 15px rgba(0,0,0,0.35); display: flex; align-items: baseline; gap: 4px; z-index: 5;">
              <%= number_to_currency(budget.price, unit: budget.currency == "USD" ? "$" : "Bs. ", precision: 2) %>
              <span style="font-size: 0.72rem; color: #94a3b8; font-weight: 700;"><%= budget.currency %></span>
            </div>
          </div>

          <%# Contenido de la Tarjeta %>
          <div style="padding: 22px; display: flex; flex-direction: column; flex-grow: 1; gap: 10px;">
            <h3 style="margin: 0; color: #0f172a; font-size: 1.25em; font-weight: 800;"><%= budget.title %></h3>
            
            <p style="margin: 0; color: #475569; font-size: 0.9em; line-height: 1.6; flex-grow: 1; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; white-space: pre-line;">
              <%= budget.description %>
            </p>

            <div style="display: flex; gap: 8px; margin-top: 15px; border-top: 1px solid #f1f5f9; padding-top: 15px; flex-wrap: wrap;">
              <%= link_to '🔍 Detalles', preset_budget_path(budget), style: "flex: 1; min-width: 80px; text-align: center; background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; padding: 9px 0; border-radius: 10px; text-decoration: none; font-size: 0.85em; font-weight: 700; transition: 0.2s;", onmouseover: "this.style.background='#dbeafe'", onmouseout: "this.style.background='#eff6ff'" %>
              <% if current_user.leader? %>
                <%= link_to '🖨️ PDF', print_preset_budget_path(budget), target: '_blank', style: "flex: 1; min-width: 80px; text-align: center; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; padding: 9px 0; border-radius: 10px; text-decoration: none; font-size: 0.85em; font-weight: 700; transition: 0.2s;", onmouseover: "this.style.background='#d1fae5'", onmouseout: "this.style.background='#ecfdf5'" %>
              <% end %>
              <% unless current_user.client? %>
                <%= link_to '⚙️', edit_preset_budget_path(budget), style: "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 9px 13px; border-radius: 10px; text-decoration: none; font-size: 0.85em; font-weight: bold; display: flex; align-items: center; justify-content: center;", title: "Editar" %>
                
                <%= button_to preset_budget_path(budget), method: :delete, data: { turbo_confirm: "¿Estás seguro de eliminar este presupuesto base?" }, style: "background: #fff5f5; color: #c53030; border: 1px solid #feb2b2; padding: 9px 13px; border-radius: 10px; font-size: 0.85em; font-weight: bold; display: flex; align-items: center; justify-content: center; cursor: pointer;", title: "Eliminar" do %>
                  🗑️
                <% end %>
              <% end %>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 20px; padding: 60px 20px; text-align: center; color: #94a3b8; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
      <div style="font-size: 60px; margin-bottom: 15px;">📁</div>
      <% if current_user.client? %>
        <h3 style="margin: 0; color: #475569; font-size: 1.3em;">No hay presupuestos base disponibles</h3>
        <p style="margin: 5px 0 0 0; font-size: 0.95em;">Por el momento no hay paquetes configurados en la lista. Contacta a tu organizador para una cotización personalizada.</p>
      <% else %>
        <h3 style="margin: 0; color: #475569; font-size: 1.3em;">Aún no has creado presupuestos base</h3>
        <p style="margin: 5px 0 20px 0; font-size: 0.95em;">Crea tu primer paquete de servicios para agilizar el envío de cotizaciones a tus clientes.</p>
        <%= link_to '➕ Crear Primer Presupuesto Base', new_preset_budget_path, style: "background: #2563eb; color: white; padding: 12px 24px; text-decoration: none; border-radius: 10px; font-weight: bold; display: inline-block;" %>
      <% end %>
    </div>
  <% end %>

</div>

<%# --- LIGHTBOX MODAL --- %>
<div id="image-modal" style="display: none; position: fixed; inset: 0; background: rgba(5, 8, 18, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;" onclick="closeImageModal()">
  <div style="position: relative; max-width: 900px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; align-items: center;" onclick="event.stopPropagation()">
    <button type="button" onclick="closeImageModal()" style="position: absolute; top: -45px; right: 0; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); color: white; width: 38px; height: 38px; border-radius: 50%; font-size: 1.2rem; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.8)'" onmouseout="this.style.background='rgba(255, 255, 255, 0.15)'">✕</button>
    <img id="image-modal-img" src="" alt="Flyer del Paquete" style="max-width: 100%; max-height: 82vh; border-radius: 16px; object-fit: contain; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7); border: 1px solid rgba(255, 255, 255, 0.15);">
    <div id="image-modal-caption" style="color: #f8fafc; font-size: 1.1rem; font-weight: 800; margin-top: 14px; text-align: center;"></div>
  </div>
</div>

<script>
  function openImageModal(imgSrc, caption) {
    var modal = document.getElementById('image-modal');
    var modalImg = document.getElementById('image-modal-img');
    var modalCap = document.getElementById('image-modal-caption');
    if (modal && modalImg) {
      modalImg.src = imgSrc;
      if (modalCap) modalCap.textContent = caption || '';
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeImageModal() {
    var modal = document.getElementById('image-modal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeImageModal();
  });
</script>
