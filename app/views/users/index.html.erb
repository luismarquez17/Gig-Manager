<div style="max-width: 1000px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <h1 style="color: #1e293b; margin: 0; font-weight: 800; font-size: 2em; letter-spacing: -0.5px;">👥 Gestión de Usuarios</h1>
      <p style="color: #64748b; margin: 5px 0 0 0;">Asigna roles de Staff, Músico o Líder a los integrantes de tu agrupación.</p>
    </div>
  </div>

  <!-- Caja de Enlace de Invitación Directa para el Equipo -->
  <% if current_company.present? %>
    <div style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white; padding: 20px; border-radius: 16px; margin-bottom: 25px; border: 1px solid #334155; shadow: 0 10px 25px rgba(0,0,0,0.1);">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px;">
        <div>
          <div style="font-size: 0.78rem; font-weight: 800; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">🔗 Enlace de Registro para tu Equipo</div>
          <div style="font-size: 0.95rem; color: #cbd5e1;">Comparte este enlace a tus nuevos músicos o trabajadores para que se unan directamente a <strong style="color: white;"><%= current_company.name %></strong>:</div>
          <div style="margin-top: 8px; font-family: monospace; font-size: 0.9em; background: rgba(255,255,255,0.08); padding: 8px 14px; border-radius: 8px; color: #a7f3d0; word-break: break-all; display: inline-block;">
            <%= join_company_url(slug: current_company.slug) %>
          </div>
        </div>
        <button onclick="navigator.clipboard.writeText('<%= join_company_url(slug: current_company.slug) %>'); alert('¡Enlace de invitación copiado al portapapeles! 📋');" style="background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%); color: white; border: none; padding: 10px 18px; border-radius: 10px; font-weight: 800; cursor: pointer; font-size: 0.88rem; box-shadow: 0 4px 12px rgba(37,99,235,0.3); transition: transform 0.2s;">
          Copiar Enlace 📋
        </button>
      </div>
    </div>
  <% end %>

  <!-- Formulario para Agregar o Vincular Trabajador Directamente -->
  <div style="background: white; border-radius: 16px; padding: 22px; margin-bottom: 25px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
    <h3 style="margin: 0 0 8px 0; color: #0f172a; font-size: 1.15em; display: flex; align-items: center; gap: 8px;">
      <span>➕</span> <span>Agregar o Vincular Trabajador (Staff / Músico)</span>
    </h3>
    <p style="margin: 0 0 16px 0; font-size: 0.88em; color: #64748b;">
      Ingresa el correo del trabajador. Si ya se registró por su cuenta en la app, se vinculará automáticamente a <strong><%= current_company.name %></strong> con el rol que elijas para que puedas asignarlo a shows y pagos.
    </p>

    <%= form_with model: @new_user, url: create_worker_users_path, method: :post, local: true, style: "display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; align-items: flex-end;" do |f| %>
      <div>
        <label style="display: block; font-size: 0.82em; font-weight: 700; color: #475569; margin-bottom: 4px;">Correo Electrónico *</label>
        <%= f.email_field :email, placeholder: "ejemplo@correo.com", required: true, style: "width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none; background: white;" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.82em; font-weight: 700; color: #475569; margin-bottom: 4px;">Nombre Completo (Opcional)</label>
        <%= f.text_field :name, placeholder: "Nombre y Apellido", style: "width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none; background: white;" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.82em; font-weight: 700; color: #475569; margin-bottom: 4px;">Rol en la Empresa *</label>
        <%= f.select :role, [['Staff (Técnico/Equipo)', 'staff'], ['Músico', 'musician'], ['Líder / Admin', 'leader']], {}, style: "width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none; background: white;" %>
      </div>

      <div>
        <label style="display: block; font-size: 0.82em; font-weight: 700; color: #475569; margin-bottom: 4px;">Contraseña (Opcional)</label>
        <%= f.password_field :password, placeholder: "Auto-generada si se deja vacío", style: "width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none; background: white;" %>
      </div>

      <div>
        <%= f.submit "➕ Vincular / Agregar", style: "width: 100%; background: #2563eb; color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.9em; box-shadow: 0 2px 8px rgba(37,99,235,0.25);" %>
      </div>
    <% end %>
  </div>

  <div style="background: white; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
          <th style="padding: 15px 20px; text-align: left; color: #475569; font-size: 0.85em; font-weight: 800; text-transform: uppercase;">Usuario / Nombre</th>
          <th style="padding: 15px 20px; text-align: left; color: #475569; font-size: 0.85em; font-weight: 800; text-transform: uppercase;">Rol Actual</th>
          <th style="padding: 15px 20px; text-align: left; color: #475569; font-size: 0.85em; font-weight: 800; text-transform: uppercase;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 15px 20px;">
              <div style="font-weight: 700; color: #1e293b;"><%= user.display_name %></div>
              <div style="font-size: 0.82em; color: #64748b;"><%= user.email %></div>
            </td>
            <td style="padding: 15px 20px;">
              <%
                role_style = if user.leader?
                  "background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; box-shadow: 0 0 8px rgba(37,99,235,0.18);"
                elsif user.staff?
                  "background: #ecfdf5; color: #059669; border: 1px solid #6ee7b7; box-shadow: 0 0 8px rgba(5,150,105,0.18);"
                elsif user.musician?
                  "background: #fdf4ff; color: #a21caf; border: 1px solid #e879f9; box-shadow: 0 0 8px rgba(162,28,175,0.2);"
                else
                  "background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0;"
                end

                role_icon = if user.leader?
                  "👑"
                elsif user.staff?
                  "🔧"
                elsif user.musician?
                  "🎵"
                else
                  "👤"
                end
              %>
              <span style="padding: 5px 12px; border-radius: 20px; font-size: 0.78em; font-weight: 800; text-transform: uppercase; display: inline-flex; align-items: center; gap: 5px; <%= role_style %>">
                <%= role_icon %> <%= user.role %>
              </span>
            </td>
            <td style="padding: 15px 20px;">
              <div style="display: flex; gap: 12px; align-items: center;">
                <% if current_user == user %>
                  <span style="color: #94a3b8; font-size: 0.85em; font-style: italic;">(Tú)</span>
                <% else %>
                  <%= form_with url: update_role_user_path(user), method: :patch, local: true, style: "display: flex; gap: 10px; align-items: center; margin: 0;" do |f| %>
                    <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] }, { selected: user.role }, style: "padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; outline: none;" %>
                    <%= f.submit "Actualizar Rol", style: "background: #1e293b; color: white; border: none; padding: 8px 12px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.85em;" %>
                  <% end %>
                <% end %>
                <%= link_to "✏️ Editar Perfil", edit_user_path(user), style: "background: #2563eb; color: white; text-decoration: none; padding: 8px 12px; border-radius: 8px; font-weight: bold; font-size: 0.85em; display: inline-block;" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
