<%
  role_title = if @user.client?
                 "Cliente"
               elsif @user.musician?
                 "Músico"
               elsif @user.staff?
                 "Staff"
               elsif @user.leader?
                 "Líder"
               else
                 "Usuario"
               end

  back_path = current_user.leader? ? users_path : root_path
%>

<div style="max-width: 600px; margin: 0 auto; font-family: 'Segoe UI', sans-serif;">
  <div style="margin-bottom: 25px;">
    <%= link_to "⬅ Volver al #{current_user.leader? ? 'Listado' : 'Inicio'}", back_path, style: "color: #64748b; text-decoration: none; font-weight: bold; font-size: 0.9em; display: inline-block; margin-bottom: 10px;" %>
    <h1 style="color: #1e293b; margin: 0; font-weight: 800; font-size: 2em; letter-spacing: -0.5px;">👤 Editar Perfil de <%= role_title %></h1>
    <p style="color: #64748b; margin: 5px 0 0 0;">
      <% if @user.client? %>
        Configura tus datos personales y teléfono de contacto.
      <% else %>
        Configura los datos del trabajador que verá el cliente en su portal.
      <% end %>
    </p>
  </div>

  <div style="background: white; padding: 30px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">
    <%= form_with(model: @user, local: true) do |f| %>
      
      <% if @user.errors.any? %>
        <div style="background: #fff1f2; border: 1px solid #fca5a5; color: #be123c; padding: 15px; border-radius: 12px; margin-bottom: 20px; font-size: 0.9em;">
          <h4 style="margin: 0 0 8px 0; font-weight: 700;">No se pudo guardar el perfil:</h4>
          <ul style="margin: 0; padding-left: 20px;">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# --- FOTO DE PERFIL / AVATAR --- %>
      <div style="margin-bottom: 25px; text-align: center; background: #f8fafc; padding: 20px; border-radius: 15px; border: 1px dashed #cbd5e1;">
        <div style="margin-bottom: 15px; display: flex; justify-content: center;">
          <% if @user.avatar_attached? %>
            <div style="width: 100px; height: 100px; border-radius: 50%; overflow: hidden; border: 3px solid #2563eb; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.15); display: flex; align-items: center; justify-content: center;">
              <%= image_tag @user.avatar_url_or_data, style: "width: 100%; height: 100%; object-fit: cover;" %>
            </div>
          <% else %>
            <div style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%); display: flex; align-items: center; justify-content: center; font-size: 2em; font-weight: 800; color: white; border: 3px solid #e2e8f0;">
              <%= @user.display_name[0].upcase %>
            </div>
          <% end %>
        </div>
        <%= f.label :avatar, "📷 Subir Foto de Perfil", style: "display: block; font-weight: bold; color: #475569; margin-bottom: 10px; cursor: pointer;" %>
        <%= f.file_field :avatar, accept: 'image/*', style: "font-size: 0.9em; color: #64748b;" %>
      </div>

      <%# --- NOMBRE --- %>
      <div style="margin-bottom: 20px;">
        <%= f.label :name, "✏️ Nombre y Apellido (Cómo aparecerá en el portal)", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
        <%= f.text_field :name, placeholder: "Ej: Juan Pérez", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; box-sizing: border-box; font-size: 1em;" %>
        <p style="margin: 5px 0 0 0; font-size: 0.8em; color: #94a3b8;">Si lo dejas en blanco, se usará la parte del correo electrónico como nombre.</p>
      </div>

      <%# --- DATOS DE CONTACTO (TELÉFONO) --- %>
      <div style="margin-bottom: 20px;">
        <%= f.label :phone, "📞 Teléfono / WhatsApp", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
        <%= f.telephone_field :phone, placeholder: "Ej: 04121234567 / +584141234567", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; box-sizing: border-box; font-size: 1em;" %>
        <p style="margin: 5px 0 0 0; font-size: 0.8em; color: #94a3b8;">Utilizado para compartir pautas de shows y notificaciones por WhatsApp.</p>
      </div>

      <%# --- TRABAJADOR EVENTUAL / ASIGNACIÓN DE CORREO --- %>
      <% if @user.eventual? && (current_user.leader? || current_user.superadmin?) %>
        <div style="background: #fffbeb; border: 1.5px solid #fde68a; border-radius: 14px; padding: 16px; margin-bottom: 22px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span style="font-size: 1.2rem;">⚡</span>
            <h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #92400e;">
              Trabajador Eventual (Sin Cuenta de Inicio de Sesión)
            </h4>
          </div>
          <p style="margin: 0 0 12px 0; font-size: 0.85rem; color: #78350f; line-height: 1.45;">
            Si deseas que este trabajador pueda iniciar sesión en la aplicación, asígnale su correo electrónico oficial a continuación. Conservará todo su historial previo de eventos, pagos y balances.
          </p>
          <div>
            <%= f.label :email, "📧 Correo Electrónico para Inicio de Sesión", style: "display: block; font-weight: 800; color: #92400e; margin-bottom: 4px; font-size: 0.85rem;" %>
            <%= f.email_field :email, value: (@user.placeholder_email? ? '' : @user.email), placeholder: "correo@trabajador.com", style: "width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e0; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem; background: white;" %>
          </div>
        </div>
      <% end %>

      <%# --- DATOS DE CLIENTE --- %>
      <% if @user.client? && @user.client.present? %>
        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;">📞 Teléfono de Cliente</label>
          <%= text_field_tag "user[client_phone]", @user.client.phone, placeholder: "Ej: +584141234567", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; box-sizing: border-box; font-size: 1em;" %>
        </div>
      <% end %>

      <%# --- DATOS DE TRABAJADOR (Solo si no es cliente) --- %>
      <% unless @user.client? %>
        <%# --- ESPECIALIDAD --- %>
        <div style="margin-bottom: 20px;">
          <%= f.label :specialty, "🎸 Especialidad o Cargo", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
          <%= f.text_field :specialty, placeholder: "Ej: DJ Principal, Mesonero, Técnico de Sonido, Protocolo", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; box-sizing: border-box; font-size: 1em;" %>
        </div>

        <%# --- BIO --- %>
        <div style="margin-bottom: 25px;">
          <%= f.label :bio, "📝 Biografía Corta / Notas", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px;" %>
          <%= f.text_area :bio, rows: 4, placeholder: "Ej: Experiencia animando eventos, manejo de audio en vivo, etc...", style: "width: 100%; padding: 12px; border: 1px solid #cbd5e0; border-radius: 10px; box-sizing: border-box; font-size: 1em; resize: vertical; font-family: inherit;" %>
        </div>
      <% end %>

      <%# --- CAMBIO DE CONTRASEÑA --- %>

      <div style="margin-top: 25px; margin-bottom: 25px; background: #f8fafc; padding: 20px; border-radius: 15px; border: 1px solid #e2e8f0;">
        <h4 style="margin: 0 0 10px 0; color: #1e293b; font-weight: 700; font-size: 1.05em; display: flex; align-items: center; gap: 8px;">
          <span>🔑 Cambiar Contraseña</span>
        </h4>
        <p style="margin: 0 0 15px 0; font-size: 0.85em; color: #64748b;">
          Déjalo en blanco si no deseas cambiar tu contraseña actual.
        </p>

        <div style="margin-bottom: 15px;">
          <%= f.label :password, "Nueva Contraseña", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 6px; font-size: 0.9em;" %>
          <%= f.password_field :password, placeholder: "Mínimo 6 caracteres", style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 8px; box-sizing: border-box; font-size: 0.95em;" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar Nueva Contraseña", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 6px; font-size: 0.9em;" %>
          <%= f.password_field :password_confirmation, placeholder: "Repite la nueva contraseña", style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 8px; box-sizing: border-box; font-size: 0.95em;" %>
        </div>
      </div>

      <%# --- PERSONALIZACIÓN DE APARIENCIA & TEMA --- %>
      <div style="margin-top: 25px; margin-bottom: 25px; background: var(--bg-card-subtle, #f8fafc); padding: 20px; border-radius: 15px; border: 1px solid var(--border-color, #e2e8f0); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="font-size: 1.6rem; background: var(--color-primary-glow, rgba(37,99,235,0.1)); color: var(--color-primary, #2563eb); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
            🎨
          </div>
          <div>
            <h4 style="margin: 0; color: var(--text-heading, #1e293b); font-weight: 700; font-size: 1rem;">Tema y Apariencia Visual</h4>
            <p style="margin: 2px 0 0 0; font-size: 0.82rem; color: var(--text-muted, #64748b);">Personaliza colores, modo oscuro, densidad y alertas de audio.</p>
          </div>
        </div>
        <button type="button" onclick="openThemeCustomizer()" style="background: var(--bg-card, white); border: 1.5px solid var(--border-color, #cbd5e0); color: var(--text-main, #1e293b); padding: 8px 16px; border-radius: 10px; font-weight: 700; font-size: 0.88rem; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
          🎨 Personalizar Tema
        </button>
      </div>

      <div style="display: flex; flex-direction: column; gap: 12px;">
        <%= f.submit "💾 Guardar Perfil", style: "width: 100%; background: var(--color-primary-gradient, #2563eb); color: var(--color-primary-text, white); padding: 16px; border: none; border-radius: 12px; font-weight: bold; font-size: 1.1em; cursor: pointer; box-shadow: var(--shadow-primary, 0 4px 12px rgba(37, 99, 235, 0.2));" %>
        <%= link_to "🚫 Cancelar", back_path, style: "text-align: center; text-decoration: none; color: #64748b; font-weight: 600; font-size: 0.9em; padding: 10px; border: 1px solid #e2e8f0; border-radius: 12px;" %>
      </div>
    <% end %>
  </div>
</div>
