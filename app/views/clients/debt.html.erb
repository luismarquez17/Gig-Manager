<%# --- SCRIPTS DE SIMULACIÓN Y CALCULADORA --- %>
<script>
  const TOTAL_DEBT = <%= @total_debt.to_f %>;
  const EFFECTIVE_RATE = <%= effective_rate.to_f %>;

  // Actualiza el simulador dinámico cuando se ingresa el monto
  function updateSimulator(val) {
    let pool = parseFloat(val) || 0.0;
    if (pool < 0) pool = 0;

    const rows = document.querySelectorAll('.sim-row');
    let totalAllocated = 0.0;
    let settledCount = 0;
    let partialCount = 0;

    rows.forEach(row => {
      const pending = parseFloat(row.getAttribute('data-pending')) || 0.0;
      const allocatedCell = row.querySelector('.sim-allocated-cell');
      const remainingCell = row.querySelector('.sim-remaining-cell');
      const badgeCell = row.querySelector('.sim-badge-cell');

      let allocated = 0.0;
      if (pool > 0 && pending > 0) {
        allocated = Math.min(pending, pool);
        // Redondear a 2 decimales
        allocated = Math.round(allocated * 100) / 100;
        pool = Math.max(0, pool - allocated);
      }

      const remAfter = Math.max(0, Math.round((pending - allocated) * 100) / 100);
      totalAllocated += allocated;

      allocatedCell.textContent = '+ $ ' + allocated.toFixed(2);

      if (allocated > 0) {
        row.style.background = remAfter === 0 ? 'rgba(16, 185, 129, 0.08)' : 'rgba(245, 158, 11, 0.08)';
      } else {
        row.style.background = 'transparent';
      }

      remainingCell.textContent = '$ ' + remAfter.toFixed(2);
      if (remAfter === 0 && allocated > 0) {
        remainingCell.style.color = '#10b981';
      } else if (remAfter > 0 && allocated > 0) {
        remainingCell.style.color = '#f59e0b';
      } else {
        remainingCell.style.color = '#ef4444';
      }

      if (allocated <= 0) {
        badgeCell.innerHTML = '<span style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-muted); padding: 3px 8px; border-radius: 6px; font-size: 0.75em; font-weight: 700;">Sin abonar</span>';
      } else if (remAfter === 0) {
        settledCount++;
        badgeCell.innerHTML = '<span style="background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 3px 8px; border-radius: 6px; font-size: 0.75em; font-weight: 800;">✅ Saldado 100%</span>';
      } else {
        partialCount++;
        badgeCell.innerHTML = '<span style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a; padding: 3px 8px; border-radius: 6px; font-size: 0.75em; font-weight: 800;">⏳ Abono Parcial</span>';
      }
    });

    const newTotalDebt = Math.max(0, TOTAL_DEBT - totalAllocated);
    document.getElementById('sim-total-allocated').textContent = '$ ' + totalAllocated.toFixed(2);
    document.getElementById('sim-new-total-debt').textContent = '$ ' + newTotalDebt.toFixed(2);

    const overallBadge = document.getElementById('sim-overall-badge');
    if (totalAllocated > 0) {
      overallBadge.innerHTML = `<span style="background: #10b981; color: white; padding: 3px 10px; border-radius: 12px; font-weight: 800;">🎯 ${settledCount} show(s) saldados, ${partialCount} parcial(es)</span>`;
    } else {
      overallBadge.textContent = 'Ingresa un monto arriba para ver la simulación';
    }
  }

  function setQuickAmount(amt) {
    const input = document.getElementById('debt_payment_amount');
    input.value = amt.toFixed(2);
    updateSimulator(amt);
    input.focus();
  }

  // Calculadora VES <-> USD
  function toggleRateCalculator() {
    const widget = document.getElementById('currency-converter-widget');
    const btnText = document.getElementById('calc-toggle-text');
    if (widget.style.display === 'none' || widget.style.display === '') {
      widget.style.display = 'block';
      btnText.textContent = 'Ocultar Calculadora';
    } else {
      widget.style.display = 'none';
      btnText.textContent = 'Calculadora VES / USD';
    }
  }

  function calcVesToUsd() {
    const ves = parseFloat(document.getElementById('calc_ves_input').value) || 0;
    if (EFFECTIVE_RATE > 0) {
      const usd = ves / EFFECTIVE_RATE;
      document.getElementById('calc_usd_input').value = usd.toFixed(2);
    }
  }

  function calcUsdToVes() {
    const usd = parseFloat(document.getElementById('calc_usd_input').value) || 0;
    if (EFFECTIVE_RATE > 0) {
      const ves = usd * EFFECTIVE_RATE;
      document.getElementById('calc_ves_input').value = ves.toFixed(2);
    }
  }

  function applyConvertedAmountToAbono() {
    const usd = parseFloat(document.getElementById('calc_usd_input').value) || 0;
    if (usd > 0) {
      setQuickAmount(usd);
      const widget = document.getElementById('currency-converter-widget');
      widget.style.display = 'none';
      document.getElementById('calc-toggle-text').textContent = 'Calculadora VES / USD';
    }
  }
</script>
